{
  "ref": "statistics/climate-graph@1",
  "family": "statistics",
  "name": "climate-graph",
  "version": 1,
  "title": "Climate graph",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "rainfall": {
        "type": "array",
        "minItems": 12,
        "maxItems": 12,
        "items": {
          "type": "number",
          "minimum": 0
        }
      },
      "temperature": {
        "type": "array",
        "minItems": 12,
        "maxItems": 12,
        "items": {
          "type": "number"
        }
      },
      "axes": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rainfallLabel": {
            "type": "string"
          },
          "tempLabel": {
            "type": "string"
          },
          "rainfallMax": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "rainfallStep": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "tempMin": {
            "type": "number"
          },
          "tempMax": {
            "type": "number"
          },
          "tempStep": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "bars": {
            "type": "boolean"
          },
          "temperature": {
            "type": "boolean"
          },
          "grid": {
            "type": "boolean"
          },
          "readings": {
            "type": "boolean"
          }
        }
      },
      "readings": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "occlude": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "annualRainfall",
                "meanRainfall",
                "meanTemp",
                "tempRange",
                "wettestMonth",
                "driestMonth",
                "hottestMonth",
                "coldestMonth"
              ]
            }
          },
          "highlight": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "annualRainfall",
                "meanRainfall",
                "meanTemp",
                "tempRange",
                "wettestMonth",
                "driestMonth",
                "hottestMonth",
                "coldestMonth"
              ]
            }
          }
        }
      },
      "readMonth": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "quantity": {
            "type": "string",
            "enum": [
              "rainfall",
              "temperature"
            ]
          },
          "occlude": {
            "type": "boolean"
          }
        },
        "required": [
          "index",
          "quantity"
        ]
      },
      "highlightMonths": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "rainfall",
      "temperature"
    ]
  },
