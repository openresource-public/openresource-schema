{
  "ref": "statistics/sample-space-grid@1",
  "family": "statistics",
  "name": "sample-space-grid",
  "version": 1,
  "title": "Sample-space diagram",
  "responseModes": [
    "fill-derived"
  ],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "$defs": {
      "leaf": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "of": {
            "type": "string",
            "enum": [
              "value",
              "row",
              "col"
            ]
          },
          "op": {
            "type": "string",
            "enum": [
              "eq",
              "ne",
              "lt",
              "le",
              "gt",
              "ge",
              "even",
              "odd",
              "in"
            ]
          },
          "value": {
            "type": [
              "number",
              "string"
            ]
          },
          "values": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": [
                "number",
                "string"
              ]
            }
          }
        },
        "required": [
          "op"
        ]
      },
      "axis": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "outcomes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": [
                "number",
                "string"
              ]
            }
          }
        },
        "required": [
          "outcomes"
        ]
      }
    },
    "properties": {
      "rows": {
        "$ref": "#/$defs/axis"
      },
      "cols": {
        "$ref": "#/$defs/axis"
      },
      "combine": {
        "type": "string",
        "enum": [
          "sum",
          "difference",
          "product",
          "max",
          "min",
          "pair",
          "concat"
        ]
      },
      "events": {
        "type": "array",
        "maxItems": 2,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string"
            },
            "match": {
              "oneOf": [
                {
                  "$ref": "#/$defs/leaf"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "all": {
                      "type": "array",
                      "minItems": 2,
                      "items": {
                        "$ref": "#/$defs/leaf"
                      }
                    }
                  },
                  "required": [
                    "all"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "any": {
                      "type": "array",
                      "minItems": 2,
                      "items": {
                        "$ref": "#/$defs/leaf"
                      }
                    }
                  },
                  "required": [
                    "any"
                  ]
                }
              ]
            }
          },
          "required": [
            "label",
            "match"
          ]
        }
      },
      "cells": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "row": {
              "type": "integer",
              "minimum": 1
            },
            "col": {
              "type": "integer",
              "minimum": 1
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "row",
            "col"
          ]
        }
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "values": {
            "type": "boolean"
          },
          "probability": {
            "type": "boolean"
          },
          "corner": {
            "type": "boolean"
          },
          "legend": {
            "type": "boolean"
          }
        }
      },
      "occludeResult": {
        "type": "boolean"
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "rows",
      "cols"
    ]
  },
  "examples": [
    {
      "params": {
        "header": "Two dice — the total score",
        "rows": {
          "name": "First dice",
          "outcomes": [
            1,
            2,
            3,
            4,
            5,
            6
          ]
        },
        "cols": {
          "name": "Second dice",
          "outcomes": [
            1,
            2,
            3,
            4,
            5,
            6
          ]
        },
        "combine": "sum",
        "events": [
          {
            "label": "total = 7",
            "match": {
              "op": "eq",
              "value": 7
            }
          }
        ],
        "caption": "Each cell is the total of the two dice. The seven cells giving a total of 7 are shaded."
      }
    },
    {
      "params": {
        "rows": {
          "name": "First dice",
          "outcomes": [
            1,
            2,
            3,
            4,
            5,
            6
          ]
        },
        "cols": {
          "name": "Second dice",
          "outcomes": [
            1,
            2,
            3,
            4,
            5,
            6
          ]
        },
        "combine": "sum",
        "show": {
          "values": false,
          "probability": false
        }
      }
    },
    {
      "params": {
        "rows": {
          "name": "First dice",
          "outcomes": [
            1,
            2,
            3,
            4,
            5,
            6
          ]
        },
        "cols": {
          "name": "Second dice",
          "outcomes": [
            1,
            2,
            3,
            4,
            5,
            6
          ]
        },
        "combine": "sum",
        "cells": [
          {
            "row": 3,
            "col": 4,
            "occlude": true
          },
          {
            "row": 5,
            "col": 2,
            "occlude": true
          },
          {
            "row": 6,
            "col": 6,
            "occlude": true
          }
        ],
        "caption": "Three totals are missing — work them out."
      }
    },
    {
      "params": {
        "header": "An even total, and a total over 8",
        "rows": {
          "name": "First dice",
          "outcomes": [
            1,
            2,
            3,
            4,
            5,
            6
          ]
        },
        "cols": {
          "name": "Second dice",
          "outcomes": [
            1,
            2,
            3,
            4,
            5,
            6
          ]
        },
        "combine": "sum",
        "events": [
          {
            "label": "even total",
            "match": {
              "op": "even"
            }
          },
          {
            "label": "total > 8",
            "match": {
              "op": "gt",
              "value": 8
            }
          }
        ],
        "caption": "Blue = even total, green = total over 8, amber = both."
      }
    },
    {
      "params": {
        "header": "Two coins",
        "rows": {
          "name": "Coin 1",
          "outcomes": [
            "H",
            "T"
          ]
        },
        "cols": {
          "name": "Coin 2",
          "outcomes": [
            "H",
            "T"
          ]
        },
        "combine": "concat",
        "events": [
          {
            "label": "at least one head",
            "match": {
              "any": [
                {
                  "of": "row",
                  "op": "eq",
                  "value": "H"
                },
                {
                  "of": "col",
                  "op": "eq",
                  "value": "H"
                }
              ]
            }
          }
        ],
        "caption": "The four equally likely outcomes of tossing two coins."
      }
    },
    {
      "params": {
        "header": "Two spinners — the product",
        "rows": {
          "name": "Spinner A",
          "outcomes": [
            1,
            2,
            3,
            4
          ]
        },
        "cols": {
          "name": "Spinner B",
          "outcomes": [
            1,
            2,
            3,
            4,
            5
          ]
        },
        "combine": "product",
        "events": [
          {
            "label": "a multiple of 5",
            "match": {
              "op": "in",
              "values": [
                5,
                10,
                15,
                20
              ]
            }
          }
        ],
        "occludeResult": true,
        "caption": "Each cell is A × B. Shade the multiples of 5, then work out the probability."
      }
    }
  ]
}
