{
  "ref": "statistics/bar-chart@2",
  "family": "statistics",
  "name": "bar-chart",
  "version": 2,
  "title": "Bar chart",
  "responseModes": [
    "place-derived"
  ],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "axes": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "yMax": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "yStep": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "yTicks": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "number"
            }
          },
          "ySnap": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "dragReadout": {
            "type": "boolean"
          },
          "yLabel": {
            "type": "string"
          },
          "xLabel": {
            "type": "string"
          }
        }
      },
      "grid": {
        "type": "boolean"
      },
      "categories": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string"
            },
            "highlight": {
              "type": "boolean"
            },
            "occlude": {
              "type": "boolean"
            }
          },
          "required": [
            "label"
          ]
        }
      },
      "series": {
        "type": "array",
        "maxItems": 2,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0
              }
            },
            "draw": {
              "type": "array",
              "items": {
                "type": "boolean"
              }
            }
          },
          "required": [
            "values"
          ]
        }
      },
      "hideLegend": {
        "type": "boolean"
      },
      "showValues": {
        "type": "boolean"
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "categories"
    ]
  },
  "examples": [
    {
      "params": {
        "axes": {
          "yLabel": "Number of pupils",
          "yStep": 5
        },
        "categories": [
          {
            "label": "Football"
          },
          {
            "label": "Netball"
          },
          {
            "label": "Hockey"
          },
          {
            "label": "Tennis"
          },
          {
            "label": "Rugby"
          }
        ],
        "series": [
          {
            "values": [
              18,
              12,
              9,
              14,
              7
            ]
          }
        ],
        "showValues": true,
        "caption": "Favourite sport of a class of 60 pupils"
      }
    },
    {
      "params": {
        "axes": {
          "yLabel": "Number sold",
          "yStep": 10
        },
        "categories": [
          {
            "label": "Spring"
          },
          {
            "label": "Summer"
          },
          {
            "label": "Autumn"
          },
          {
            "label": "Winter"
          }
        ],
        "series": [
          {
            "name": "2022",
            "values": [
              25,
              48,
              30,
              18
            ]
          },
          {
            "name": "2023",
            "values": [
              32,
              55,
              28,
              22
            ]
          }
        ],
        "caption": "Ice creams sold by season in 2022 and 2023"
      }
    },
    {
      "params": {
        "axes": {
          "yLabel": "Frequency",
          "yStep": 4
        },
        "categories": [
          {
            "label": "Red"
          },
          {
            "label": "Blue"
          },
          {
            "label": "Green",
            "occlude": true,
            "highlight": true
          },
          {
            "label": "Yellow"
          }
        ],
        "series": [
          {
            "values": [
              10,
              16,
              12,
              6
            ]
          }
        ],
        "showValues": true
      }
    },
    {
      "params": {
        "axes": {
          "yLabel": "Frequency",
          "yMax": 20,
          "yStep": 5,
          "ySnap": 1
        },
        "categories": [
          {
            "label": "Apple"
          },
          {
            "label": "Banana"
          },
          {
            "label": "Cherry"
          },
          {
            "label": "Melon"
          }
        ],
        "series": [
          {
            "values": [
              12,
              7,
              15,
              9
            ],
            "draw": [
              false,
              true,
              true,
              true
            ]
          }
        ]
      }
    },
    {
      "params": {
        "axes": {
          "yLabel": "Distance (miles)",
          "yMax": 8,
          "yStep": 2,
          "ySnap": 1
        },
        "categories": [
          {
            "label": "Mon"
          },
          {
            "label": "Tue"
          },
          {
            "label": "Wed"
          },
          {
            "label": "Thu"
          },
          {
            "label": "Fri"
          }
        ],
        "series": [
          {
            "name": "Rose",
            "values": [
              4,
              5,
              3,
              6,
              2
            ],
            "draw": [
              false,
              false,
              false,
              true,
              false
            ]
          },
          {
            "name": "Paula",
            "values": [
              3,
              4,
              5,
              5,
              6
            ]
          }
        ]
      }
    },
    {
      "params": {
        "axes": {
          "yTicks": [
            0,
            4,
            8,
            12,
            16,
            18,
            22,
            26,
            30
          ]
        },
        "hideLegend": true,
        "categories": [
          {
            "label": "Andy"
          },
          {
            "label": "Beth"
          },
          {
            "label": "Cai"
          },
          {
            "label": "Dev"
          },
          {
            "label": "Eden"
          }
        ],
        "series": [
          {
            "name": "Maths",
            "values": [
              22,
              14,
              26,
              8,
              18
            ]
          },
          {
            "name": "English",
            "values": [
              16,
              20,
              12,
              24,
              10
            ]
          }
        ]
      }
    }
  ]
}
