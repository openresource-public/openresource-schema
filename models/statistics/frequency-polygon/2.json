{
  "ref": "statistics/frequency-polygon@2",
  "family": "statistics",
  "name": "frequency-polygon",
  "version": 2,
  "title": "Frequency polygon",
  "responseModes": [
    "place-derived"
  ],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "series": {
        "type": "array",
        "maxItems": 3,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "classes": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "from": {
                    "type": "number"
                  },
                  "to": {
                    "type": "number"
                  },
                  "frequency": {
                    "type": "number",
                    "minimum": 0
                  },
                  "occlude": {
                    "type": "boolean"
                  },
                  "highlight": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "from",
                  "to",
                  "frequency"
                ]
              }
            },
            "join": {
              "type": "boolean"
            },
            "showValues": {
              "type": "boolean"
            }
          },
          "required": [
            "classes"
          ]
        }
      },
      "showPolygons": {
        "type": "boolean"
      },
      "axes": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "x": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "xStep": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "xLabelStep": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "xLabel": {
            "type": "string"
          },
          "yMax": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "yStep": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "yLabelStep": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "yLabel": {
            "type": "string"
          },
          "showNumbers": {
            "type": "boolean"
          }
        }
      },
      "grid": {
        "type": "boolean"
      },
      "showKey": {
        "type": "boolean"
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "series"
    ]
  },
  "examples": [
    {
      "params": {
        "header": "Length of phone calls",
        "axes": {
          "xLabel": "Length (minutes)"
        },
        "series": [
          {
            "showValues": true,
            "classes": [
              {
                "from": 0,
                "to": 4,
                "frequency": 5
              },
              {
                "from": 4,
                "to": 8,
                "frequency": 11
              },
              {
                "from": 8,
                "to": 12,
                "frequency": 17
              },
              {
                "from": 12,
                "to": 16,
                "frequency": 8
              },
              {
                "from": 16,
                "to": 20,
                "frequency": 2
              }
            ]
          }
        ],
        "caption": "Each point sits at the midpoint of its class — 2, 6, 10, 14 and 18 minutes"
      }
    },
    {
      "params": {
        "axes": {
          "xLabel": "Mass (grams)",
          "x": [
            50,
            100
          ],
          "xStep": 10
        },
        "series": [
          {
            "classes": [
              {
                "from": 50,
                "to": 60,
                "frequency": 4
              },
              {
                "from": 60,
                "to": 70,
                "frequency": 9
              },
              {
                "from": 70,
                "to": 80,
                "frequency": 13
              },
              {
                "from": 80,
                "to": 90,
                "frequency": 7
              },
              {
                "from": 90,
                "to": 100,
                "frequency": 3
              }
            ]
          }
        ],
        "showPolygons": false
      }
    },
    {
      "params": {
        "axes": {
          "xLabel": "Time on homework (minutes)",
          "x": [
            0,
            50
          ],
          "xStep": 10
        },
        "series": [
          {
            "classes": [
              {
                "from": 0,
                "to": 10,
                "frequency": 3
              },
              {
                "from": 10,
                "to": 20,
                "frequency": 8
              },
              {
                "from": 20,
                "to": 30,
                "frequency": 14
              },
              {
                "from": 30,
                "to": 40,
                "frequency": 9
              },
              {
                "from": 40,
                "to": 50,
                "frequency": 6
              }
            ]
          }
        ],
        "showPolygons": false,
        "caption": "Drag one point for each class onto the grid to draw the frequency polygon."
      }
    },
    {
      "params": {
        "axes": {
          "xLabel": "Time (seconds)"
        },
        "series": [
          {
            "classes": [
              {
                "from": 20,
                "to": 30,
                "frequency": 6
              },
              {
                "from": 30,
                "to": 40,
                "frequency": 14
              },
              {
                "from": 40,
                "to": 50,
                "frequency": 11,
                "occlude": true
              },
              {
                "from": 50,
                "to": 60,
                "frequency": 5,
                "occlude": true
              }
            ]
          }
        ],
        "caption": "The first two points are plotted. Complete the frequency polygon."
      }
    },
    {
      "params": {
        "header": "Heights of pupils",
        "axes": {
          "xLabel": "Height (cm)",
          "x": [
            130,
            180
          ],
          "xStep": 10
        },
        "series": [
          {
            "name": "Boys",
            "classes": [
              {
                "from": 130,
                "to": 140,
                "frequency": 3
              },
              {
                "from": 140,
                "to": 150,
                "frequency": 8
              },
              {
                "from": 150,
                "to": 160,
                "frequency": 14
              },
              {
                "from": 160,
                "to": 170,
                "frequency": 10
              },
              {
                "from": 170,
                "to": 180,
                "frequency": 5
              }
            ]
          },
          {
            "name": "Girls",
            "classes": [
              {
                "from": 130,
                "to": 140,
                "frequency": 6
              },
              {
                "from": 140,
                "to": 150,
                "frequency": 12
              },
              {
                "from": 150,
                "to": 160,
                "frequency": 11
              },
              {
                "from": 160,
                "to": 170,
                "frequency": 8
              },
              {
                "from": 170,
                "to": 180,
                "frequency": 3
              }
            ]
          }
        ]
      }
    },
    {
      "params": {
        "axes": {
          "xLabel": "Distance (km)"
        },
        "series": [
          {
            "join": false,
            "classes": [
              {
                "from": 0,
                "to": 2,
                "frequency": 7
              },
              {
                "from": 2,
                "to": 4,
                "frequency": 12
              },
              {
                "from": 4,
                "to": 6,
                "frequency": 9
              },
              {
                "from": 6,
                "to": 8,
                "frequency": 4
              }
            ]
          }
        ],
        "caption": "A × at each midpoint: 1, 3, 5 and 7 km. Now join them in order."
      }
    },
    {
      "params": {
        "axes": {
          "xLabel": "Wingspan (cm)",
          "showNumbers": false
        },
        "series": [
          {
            "classes": [
              {
                "from": 10,
                "to": 20,
                "frequency": 9
              },
              {
                "from": 20,
                "to": 30,
                "frequency": 23
              },
              {
                "from": 30,
                "to": 40,
                "frequency": 31
              },
              {
                "from": 40,
                "to": 50,
                "frequency": 12
              }
            ]
          }
        ],
        "showPolygons": false
      }
    },
    {
      "params": {
        "axes": {
          "xLabel": "Score"
        },
        "series": [
          {
            "showValues": true,
            "classes": [
              {
                "from": 0,
                "to": 10,
                "frequency": 3
              },
              {
                "from": 10,
                "to": 20,
                "frequency": 9
              },
              {
                "from": 20,
                "to": 30,
                "frequency": 16,
                "highlight": true
              },
              {
                "from": 30,
                "to": 40,
                "frequency": 12
              },
              {
                "from": 40,
                "to": 50,
                "frequency": 6
              }
            ]
          }
        ],
        "caption": "The highest point marks the modal class, 20–30."
      }
    }
  ]
}
