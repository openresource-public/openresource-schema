{
  "ref": "statistics/time-series@1",
  "family": "statistics",
  "name": "time-series",
  "version": 1,
  "title": "Time-series graph",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "series": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "values": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "number"
            }
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "name": {
            "type": "string"
          },
          "showValues": {
            "type": "boolean"
          },
          "occlude": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "highlight": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "required": [
          "values"
        ]
      },
      "movingAverage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "window": {
            "type": "integer",
            "minimum": 2,
            "maximum": 12
          },
          "showValues": {
            "type": "boolean"
          },
          "occlude": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "connect": {
            "type": "boolean"
          }
        }
      },
      "trend": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "through": {
            "type": "string",
            "enum": [
              "moving-average",
              "data"
            ]
          },
          "label": {
            "type": "string"
          }
        }
      },
      "season": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "length": {
            "type": "integer",
            "minimum": 2
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "length"
        ]
      },
      "readAt": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1
          },
          "occlude": {
            "type": "boolean"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "index"
        ]
      },
      "axes": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "y": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "yStep": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "yLabel": {
            "type": "string"
          },
          "xLabel": {
            "type": "string"
          }
        }
      },
      "grid": {
        "type": "boolean"
      },
      "showMarkers": {
        "type": "boolean"
      },
      "showKey": {
        "type": "boolean"
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "series"
    ]
  },
  "examples": [
    {
      "params": {
        "header": "Quarterly sales",
        "axes": {
          "y": [
            0,
            45
          ],
          "yStep": 5,
          "yLabel": "Sales (£1000s)",
          "xLabel": "Quarter"
        },
        "series": {
          "name": "Sales",
          "values": [
            18,
            24,
            31,
            22,
            21,
            28,
            36,
            26,
            25,
            33,
            41,
            30
          ],
          "labels": [
            "Q1",
            "Q2",
            "Q3",
            "Q4",
            "Q1",
            "Q2",
            "Q3",
            "Q4",
            "Q1",
            "Q2",
            "Q3",
            "Q4"
          ]
        },
        "movingAverage": {
          "window": 4
        },
        "trend": {
          "through": "moving-average",
          "label": "trend"
        },
        "season": {
          "length": 4,
          "labels": [
            "Year 1",
            "Year 2",
            "Year 3"
          ]
        },
        "showKey": true,
        "caption": "The 4-point moving average smooths the seasonal pattern to reveal the trend"
      }
    },
    {
      "params": {
        "header": "Monthly visitors",
        "axes": {
          "y": [
            0,
            200
          ],
          "yStep": 20,
          "yLabel": "Visitors (thousands)",
          "xLabel": "Month"
        },
        "series": {
          "values": [
            120,
            135,
            110,
            150,
            140,
            165
          ],
          "labels": [
            "Jan",
            "Feb",
            "Mar",
            "Apr",
            "May",
            "Jun"
          ]
        }
      }
    },
    {
      "params": {
        "header": "Daily high temperature",
        "axes": {
          "y": [
            0,
            25
          ],
          "yStep": 5,
          "yLabel": "Temperature (°C)",
          "xLabel": "Day"
        },
        "series": {
          "values": [
            14,
            16,
            19,
            17,
            21,
            23,
            20
          ],
          "labels": [
            "Mon",
            "Tue",
            "Wed",
            "Thu",
            "Fri",
            "Sat",
            "Sun"
          ],
          "showValues": true,
          "highlight": [
            5
          ]
        },
        "readAt": {
          "index": 5
        }
      }
    },
    {
      "params": {
        "header": "Energy use",
        "axes": {
          "y": [
            0,
            60
          ],
          "yStep": 10,
          "yLabel": "Energy (kWh)",
          "xLabel": "Quarter"
        },
        "series": {
          "values": [
            40,
            52,
            30,
            26,
            44,
            56,
            34,
            30
          ],
          "labels": [
            "Q1",
            "Q2",
            "Q3",
            "Q4",
            "Q1",
            "Q2",
            "Q3",
            "Q4"
          ]
        },
        "movingAverage": {
          "window": 4,
          "showValues": true,
          "occlude": [
            3,
            4,
            5
          ]
        },
        "season": {
          "length": 4,
          "labels": [
            "2022",
            "2023"
          ]
        },
        "caption": "The first two 4-point moving averages are shown — work out the rest"
      }
    },
    {
      "params": {
        "header": "Ice cream sales",
        "axes": {
          "y": [
            0,
            80
          ],
          "yStep": 10,
          "yLabel": "Sales (£100s)",
          "xLabel": "Quarter"
        },
        "series": {
          "values": [
            20,
            55,
            70,
            35,
            28,
            62,
            78,
            42
          ],
          "labels": [
            "Q1",
            "Q2",
            "Q3",
            "Q4",
            "Q1",
            "Q2",
            "Q3",
            "Q4"
          ]
        },
        "movingAverage": {
          "window": 4
        },
        "season": {
          "length": 4,
          "labels": [
            "Year 1",
            "Year 2"
          ]
        },
        "showKey": true
      }
    },
    {
      "params": {
        "header": "Annual rainfall",
        "axes": {
          "y": [
            0,
            1200
          ],
          "yStep": 200,
          "yLabel": "Rainfall (mm)",
          "xLabel": "Year"
        },
        "series": {
          "values": [
            820,
            760,
            900,
            850,
            980,
            1020,
            960,
            1080
          ],
          "labels": [
            "2016",
            "2017",
            "2018",
            "2019",
            "2020",
            "2021",
            "2022",
            "2023"
          ]
        },
        "trend": {
          "through": "data",
          "label": "trend"
        },
        "showKey": true,
        "caption": "Annual data has no seasonal cycle — fit a trend line to the points"
      }
    }
  ]
}
