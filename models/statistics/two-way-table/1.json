{
  "ref": "statistics/two-way-table@1",
  "family": "statistics",
  "name": "two-way-table",
  "version": 1,
  "title": "Two-way table",
  "responseModes": [
    "fill-derived"
  ],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "rows": {
        "type": "array",
        "minItems": 1,
        "maxItems": 6,
        "items": {
          "type": "string"
        }
      },
      "cols": {
        "type": "array",
        "minItems": 1,
        "maxItems": 6,
        "items": {
          "type": "string"
        }
      },
      "data": {
        "type": "array",
        "minItems": 1,
        "maxItems": 6,
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "number"
          }
        }
      },
      "cells": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "row": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            },
            "col": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            },
            "occlude": {
              "type": "boolean"
            },
            "blank": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "row",
            "col"
          ]
        }
      },
      "probability": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "row": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "col": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "over": {
            "type": "string",
            "enum": [
              "grand",
              "row",
              "col"
            ]
          },
          "label": {
            "type": "string"
          },
          "occlude": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          }
        }
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "values": {
            "type": "boolean"
          },
          "rowTotals": {
            "type": "boolean"
          },
          "colTotals": {
            "type": "boolean"
          },
          "grandTotal": {
            "type": "boolean"
          }
        }
      },
      "totalLabel": {
        "type": "string"
      },
      "cornerLabel": {
        "type": "string"
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "rows",
      "cols",
      "data"
    ]
  },
  "examples": [
    {
      "params": {
        "header": "How students travel to school",
        "rows": [
          "Boys",
          "Girls"
        ],
        "cols": [
          "Walk",
          "Bus",
          "Cycle"
        ],
        "data": [
          [
            9,
            12,
            7
          ],
          [
            14,
            11,
            7
          ]
        ]
      }
    },
    {
      "params": {
        "rows": [
          "Adults",
          "Children"
        ],
        "cols": [
          "Tea",
          "Coffee",
          "Juice"
        ],
        "data": [
          [
            15,
            22,
            5
          ],
          [
            3,
            1,
            24
          ]
        ],
        "show": {
          "values": false
        }
      }
    },
    {
      "params": {
        "rows": [
          "Cats",
          "Dogs"
        ],
        "cols": [
          "Under 1 yr",
          "1–5 yrs",
          "Over 5 yrs"
        ],
        "data": [
          [
            8,
            16,
            6
          ],
          [
            5,
            18,
            13
          ]
        ],
        "cells": [
          {
            "row": 1,
            "col": 2,
            "occlude": true
          },
          {
            "row": 2,
            "col": 1,
            "occlude": true
          }
        ]
      }
    },
    {
      "params": {
        "rows": [
          "Year 9",
          "Year 10"
        ],
        "cols": [
          "Drama",
          "Art",
          "Music"
        ],
        "data": [
          [
            12,
            18,
            10
          ],
          [
            9,
            16,
            15
          ]
        ],
        "probability": {
          "col": 1,
          "over": "grand",
          "label": "P(drama)",
          "highlight": true
        },
        "caption": "One student is chosen at random."
      }
    },
    {
      "params": {
        "rows": [
          "Boys",
          "Girls"
        ],
        "cols": [
          "Walk",
          "Bus",
          "Cycle"
        ],
        "data": [
          [
            9,
            12,
            7
          ],
          [
            14,
            11,
            7
          ]
        ],
        "probability": {
          "row": 2,
          "col": 3,
          "over": "row",
          "label": "P(cycles | girl)",
          "highlight": true
        },
        "caption": "A girl is chosen at random. Find the probability she cycles."
      }
    },
    {
      "params": {
        "header": "Left- or right-handed?",
        "rows": [
          "Left-handed",
          "Right-handed"
        ],
        "cols": [
          "Tennis",
          "Squash",
          "Badminton"
        ],
        "data": [
          [
            4,
            3,
            6
          ],
          [
            21,
            12,
            14
          ]
        ],
        "cells": [
          {
            "row": 1,
            "col": 1,
            "occlude": true
          },
          {
            "row": 2,
            "col": 3,
            "occlude": true
          },
          {
            "row": 0,
            "col": 2,
            "occlude": true
          }
        ],
        "probability": {
          "row": 1,
          "col": 2,
          "over": "grand",
          "label": "P(left-handed and squash)",
          "occlude": true
        }
      }
    }
  ]
}
