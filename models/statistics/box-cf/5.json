{
  "ref": "statistics/box-cf@5",
  "family": "statistics",
  "name": "box-cf",
  "version": 5,
  "title": "Cumulative frequency & box plot",
  "responseModes": [
    "place-derived"
  ],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "distributions": {
        "type": "array",
        "minItems": 1,
        "maxItems": 2,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string"
            },
            "grouped": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "from": {
                    "type": "number"
                  },
                  "to": {
                    "type": "number"
                  },
                  "frequency": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "from",
                  "to",
                  "frequency"
                ]
              }
            },
            "values": {
              "type": "array",
              "minItems": 4,
              "items": {
                "type": "number"
              }
            },
            "summary": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "min": {
                  "type": "number"
                },
                "lowerQuartile": {
                  "type": "number"
                },
                "median": {
                  "type": "number"
                },
                "upperQuartile": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "outliers": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                }
              },
              "required": [
                "min",
                "lowerQuartile",
                "median",
                "upperQuartile",
                "max"
              ]
            },
            "outliers": {
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "fence": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  }
                }
              ]
            },
            "occlude": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "min",
                  "lowerQuartile",
                  "median",
                  "upperQuartile",
                  "max",
                  "iqr",
                  "outliers"
                ]
              }
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "oneOf": [
            {
              "required": [
                "grouped"
              ]
            },
            {
              "required": [
                "values"
              ]
            },
            {
              "required": [
                "summary"
              ]
            }
          ]
        }
      },
      "axes": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "x": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "xStep": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "xLabel": {
            "type": "string"
          },
          "cfMax": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "cfStep": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "cfLabel": {
            "type": "string"
          }
        }
      },
      "grid": {
        "type": "boolean"
      },
      "curveStyle": {
        "type": "string",
        "enum": [
          "smooth",
          "straight"
        ]
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "curve": {
            "type": "boolean"
          },
          "box": {
            "type": "boolean"
          },
          "values": {
            "type": "boolean"
          },
          "iqr": {
            "type": "boolean"
          },
          "points": {
            "type": "boolean"
          },
          "firstSegment": {
            "type": "boolean"
          },
          "fences": {
            "type": "boolean"
          }
        }
      },
      "readOff": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "quartile": {
              "type": "string",
              "enum": [
                "median",
                "lowerQuartile",
                "upperQuartile"
              ]
            },
            "percentile": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "atValue": {
              "type": "number"
            },
            "distribution": {
              "type": "integer",
              "minimum": 1
            },
            "label": {
              "type": "string"
            },
            "occlude": {
              "type": "boolean"
            }
          },
          "oneOf": [
            {
              "required": [
                "quartile"
              ]
            },
            {
              "required": [
                "percentile"
              ]
            },
            {
              "required": [
                "atValue"
              ]
            }
          ]
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      },
      "draggable": {
        "type": "boolean"
      },
      "plotCurve": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tolerance": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        ]
      }
    },
    "required": [
      "distributions"
    ]
  },
  "examples": [
