{
  "ref": "statistics/population-pyramid@1",
  "family": "statistics",
  "name": "population-pyramid",
  "version": 1,
  "title": "Population pyramid",
  "responseModes": [
    "place-derived"
  ],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "places": {
        "type": "array",
        "minItems": 1,
        "maxItems": 2,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string"
            },
            "bands": {
              "type": "array",
              "minItems": 1,
              "maxItems": 24,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "from": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 120
                  },
                  "to": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 120
                  },
                  "male": {
                    "type": "number",
                    "minimum": 0
                  },
                  "female": {
                    "type": "number",
                    "minimum": 0
                  },
                  "occlude": {
                    "type": "string",
                    "enum": [
                      "male",
                      "female",
                      "both"
                    ]
                  },
                  "blank": {
                    "type": "string",
                    "enum": [
                      "male",
                      "female",
                      "both"
                    ]
                  },
                  "highlight": {
                    "type": "string",
                    "enum": [
                      "male",
                      "female",
                      "both"
                    ]
                  }
                },
                "required": [
                  "from",
                  "male",
                  "female"
                ]
              }
            }
          },
          "required": [
            "bands"
          ]
        }
      },
      "unit": {
        "type": "string",
        "enum": [
          "percent",
          "millions",
          "thousands",
          "people"
        ]
      },
      "axes": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "max": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "step": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "label": {
            "type": "string"
          },
          "dragReadout": {
            "type": "boolean"
          }
        }
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "male": {
            "type": "boolean"
          },
          "female": {
            "type": "boolean"
          },
          "values": {
            "type": "boolean"
          },
          "grid": {
            "type": "boolean"
          },
          "readings": {
            "type": "boolean"
          },
          "sexLabels": {
            "type": "boolean"
          }
        }
      },
      "readings": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "occlude": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "total",
                "widestBand",
                "young",
                "old",
                "dependency",
                "shape"
              ]
            }
          },
          "highlight": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "total",
                "widestBand",
                "young",
                "old",
                "dependency",
                "shape"
              ]
            }
          }
        }
      },
      "readBand": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "place": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          },
          "index": {
            "type": "integer",
            "minimum": 1,
            "maximum": 24
          },
          "quantity": {
            "type": "string",
            "enum": [
              "male",
              "female",
              "total"
            ]
          },
          "occlude": {
            "type": "boolean"
          }
        },
        "required": [
          "index",
          "quantity"
        ]
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "places"
    ]
  },
