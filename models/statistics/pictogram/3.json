{
  "ref": "statistics/pictogram@3",
  "family": "statistics",
  "name": "pictogram",
  "version": 3,
  "title": "Pictogram",
  "responseModes": [
    "fill-derived"
  ],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "key": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "value": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "icon": {
            "type": "string",
            "enum": [
              "circle",
              "square",
              "triangle",
              "star",
              "heart",
              "person",
              "apple",
              "flower",
              "grid-square"
            ]
          },
          "gridN": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          }
        },
        "required": [
          "value"
        ]
      },
      "categories": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string"
            },
            "frequency": {
              "type": "number",
              "minimum": 0
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            },
            "blank": {
              "type": "boolean"
            }
          },
          "required": [
            "label",
            "frequency"
          ]
        }
      },
      "showFrequencies": {
        "type": "boolean"
      },
      "showKey": {
        "type": "boolean"
      },
      "occludeKey": {
        "type": "boolean"
      },
      "showIcons": {
        "type": "boolean"
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "key",
      "categories"
    ]
  },
  "examples": [
    {
