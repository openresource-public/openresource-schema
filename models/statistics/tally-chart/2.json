{
  "ref": "statistics/tally-chart@2",
  "family": "statistics",
  "name": "tally-chart",
  "version": 2,
  "title": "Tally chart",
  "responseModes": [
    "fill-derived"
  ],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "rows": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string"
            },
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "frequency": {
              "type": "integer",
              "minimum": 0
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            },
            "blank": {
              "type": "boolean"
            }
          },
          "required": [
            "label",
            "count"
          ]
        }
      },
      "categoryHeader": {
        "type": "string"
      },
      "showFrequencies": {
        "type": "boolean"
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "rows"
    ]
  },
  "examples": [
    {
      "params": {
        "header": "Favourite fruit",
        "categoryHeader": "Fruit",
        "rows": [
          {
            "label": "Apple",
            "count": 7
          },
          {
            "label": "Banana",
            "count": 12
          },
          {
            "label": "Orange",
            "count": 5
          },
          {
            "label": "Pear",
            "count": 9
          }
        ],
        "showFrequencies": true
      }
    },
    {
      "params": {
        "header": "Cars passing the school",
        "categoryHeader": "Colour",
        "rows": [
          {
            "label": "Red",
            "count": 8
          },
          {
            "label": "Blue",
            "count": 14,
            "occlude": true,
            "highlight": true
          },
          {
            "label": "Silver",
            "count": 11
          },
          {
            "label": "Black",
            "count": 6
          }
        ],
        "showFrequencies": true
      }
    },
    {
      "params": {
        "header": "Goals scored each match",
        "categoryHeader": "Match",
        "rows": [
          {
            "label": "Match 1",
            "count": 6
          },
          {
            "label": "Match 2",
            "count": 9,
            "occlude": true
          },
          {
            "label": "Match 3",
            "count": 13,
            "occlude": true
          },
          {
            "label": "Match 4",
            "count": 7,
            "blank": true
          }
        ],
        "showFrequencies": true
      }
    },
    {
      "params": {
        "header": "Pets owned",
        "categoryHeader": "Pet",
        "rows": [
          {
            "label": "Dog",
            "count": 9
          },
          {
            "label": "Cat",
            "count": 12,
            "frequency": 13,
            "highlight": true
          },
          {
            "label": "Fish",
            "count": 6
          },
          {
            "label": "Rabbit",
            "count": 4
          }
        ],
        "showFrequencies": true
      }
    },
    {
      "params": {
        "header": "Ways pupils travel to school",
        "categoryHeader": "Method",
        "rows": [
          {
            "label": "Walk",
            "count": 15,
            "blank": true
          },
          {
            "label": "Car",
            "count": 8,
            "blank": true
          },
          {
            "label": "Bus",
            "count": 11,
            "blank": true
          },
          {
            "label": "Cycle",
            "count": 4,
            "blank": true
          }
        ],
        "showFrequencies": true
      }
    },
    {
      "params": {
        "categoryHeader": "Team",
        "rows": [
          {
            "label": "Lions",
            "count": 10
          },
          {
            "label": "Tigers",
            "count": 13
          },
          {
            "label": "Bears",
            "count": 7
          }
        ],
        "showFrequencies": false
      }
    }
  ]
}
