{
  "ref": "statistics/histogram@3",
  "family": "statistics",
  "name": "histogram",
  "version": 3,
  "title": "Histogram",
  "responseModes": [
    "draw-histogram"
  ],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "axes": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "x": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "xStep": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "fdMax": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "fdStep": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "xMinor": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "fdMinor": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "fdNumbers": {
            "type": "boolean"
          },
          "xLabel": {
            "type": "string"
          },
          "yLabel": {
            "type": "string"
          }
        }
      },
      "grid": {
        "type": "boolean"
      },
      "classes": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "number"
            },
            "to": {
              "type": "number"
            },
            "frequency": {
              "type": "number",
              "minimum": 0
            },
            "highlight": {
              "type": "boolean"
            },
            "occludeFrequency": {
              "type": "boolean"
            },
            "given": {
              "type": "boolean"
            }
          },
          "required": [
            "from",
            "to",
            "frequency"
          ]
        }
      },
      "showFrequencies": {
        "type": "boolean"
      },
      "estimate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "number"
          },
          "to": {
            "type": "number"
          },
          "occlude": {
            "type": "boolean"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "from",
          "to"
        ]
      },
      "drawHistogram": {
        "type": "boolean"
      },
      "drawHistogramGuides": {
        "type": "boolean"
      },
      "boundaryLabels": {
        "type": "string",
        "enum": [
          "auto",
          "always",
          "never"
        ]
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      },
      "draggable": {
        "type": "boolean"
      }
    },
    "required": [
      "classes"
    ]
  },
  "examples": [
    {
      "params": {
        "axes": {
          "x": [
            0,
            50
          ],
          "xStep": 10,
          "xLabel": "Time (minutes)"
        },
        "classes": [
          {
            "from": 0,
            "to": 10,
            "frequency": 5
          },
          {
            "from": 10,
            "to": 20,
            "frequency": 12
          },
          {
            "from": 20,
            "to": 30,
            "frequency": 18
          },
          {
            "from": 30,
            "to": 40,
            "frequency": 9
          },
          {
            "from": 40,
            "to": 50,
            "frequency": 3
          }
        ],
        "showFrequencies": true,
        "caption": "Equal widths: the bar heights are in the same ratio as the frequencies"
      }
    },
    {
      "params": {
        "axes": {
          "x": [
            0,
            70
          ],
          "xStep": 10,
          "xLabel": "Mass (kg)"
        },
        "classes": [
          {
            "from": 0,
            "to": 10,
            "frequency": 20
          },
          {
            "from": 10,
            "to": 20,
            "frequency": 30
          },
          {
            "from": 20,
            "to": 40,
            "frequency": 40
          },
          {
            "from": 40,
            "to": 70,
            "frequency": 15
          }
        ],
        "showFrequencies": true,
        "caption": "Unequal widths: height is frequency density, so the area is the frequency"
      }
    },
    {
      "params": {
        "axes": {
          "x": [
            0,
            70
          ],
          "xStep": 10,
          "xLabel": "Mass (kg)"
        },
        "classes": [
          {
            "from": 0,
            "to": 10,
            "frequency": 20
          },
          {
            "from": 10,
            "to": 20,
            "frequency": 30
          },
          {
            "from": 20,
            "to": 40,
            "frequency": 40
          },
          {
            "from": 40,
            "to": 70,
            "frequency": 15
          }
        ],
        "estimate": {
          "from": 25,
          "to": 35,
          "occlude": true
        }
      }
    },
    {
      "params": {
        "axes": {
          "x": [
            0,
            40
          ],
          "xStep": 5,
          "xLabel": "Length (cm)"
        },
        "classes": [
          {
            "from": 0,
            "to": 10,
            "frequency": 16
          },
          {
            "from": 10,
            "to": 15,
            "frequency": 20,
            "occludeFrequency": true,
            "highlight": true
          },
          {
            "from": 15,
            "to": 25,
            "frequency": 14
          },
          {
            "from": 25,
            "to": 40,
            "frequency": 9
          }
        ]
      }
    },
    {
      "params": {
        "axes": {
          "x": [
            0,
            60
          ],
          "xStep": 10,
          "fdMax": 5,
          "fdStep": 1,
          "xLabel": "Speed (mph)"
        },
        "drawHistogram": true,
        "classes": [
          {
            "from": 0,
            "to": 20,
            "frequency": 24
          },
          {
            "from": 20,
            "to": 30,
            "frequency": 26
          },
          {
            "from": 30,
            "to": 35,
            "frequency": 21
          },
          {
            "from": 35,
            "to": 60,
            "frequency": 15
          }
        ],
        "caption": "On the grid, draw a histogram for the information in the table"
      }
    },
    {
      "params": {
        "axes": {
          "x": [
            0,
            20
          ],
          "xStep": 5,
          "fdMax": 12,
          "fdStep": 2,
          "xLabel": "Time (s)"
        },
        "drawHistogram": true,
        "classes": [
          {
            "from": 0,
            "to": 5,
            "frequency": 10
          },
          {
            "from": 5,
            "to": 10,
            "frequency": 40,
            "given": true
          },
          {
            "from": 10,
            "to": 12,
            "frequency": 20
          },
          {
            "from": 12,
            "to": 20,
            "frequency": 8,
            "given": true
          }
        ]
      }
    },
    {
      "params": {
        "axes": {
          "x": [
            0,
            21
          ],
          "xStep": 2,
          "fdMax": 5,
          "fdStep": 1,
          "xMinor": 1,
          "fdNumbers": false,
          "xLabel": "Reaction time (s)"
        },
        "drawHistogram": true,
        "drawHistogramGuides": false,
        "boundaryLabels": "never",
        "classes": [
          {
            "from": 0.5,
            "to": 5.5,
            "frequency": 10
          },
          {
            "from": 5.5,
            "to": 10.5,
            "frequency": 20,
            "given": true
          },
          {
            "from": 10.5,
            "to": 14.5,
            "frequency": 14
          },
          {
            "from": 14.5,
            "to": 20.5,
            "frequency": 9
          }
        ],
        "caption": "The times are to the nearest second. Use the table to complete the histogram"
      }
    },
    {
      "params": {
        "axes": {
          "x": [
            0,
            31
          ],
          "xStep": 5,
          "fdMax": 4,
          "fdStep": 1,
          "xLabel": "Mass (g)"
        },
        "drawHistogram": true,
        "classes": [
          {
            "from": 0.5,
            "to": 10.5,
            "frequency": 20
          },
          {
            "from": 10.5,
            "to": 20.5,
            "frequency": 35
          },
          {
            "from": 20.5,
            "to": 30.5,
            "frequency": 15
          }
        ],
        "caption": "On the grid, draw a histogram for the information in the table"
      }
    }
  ]
}
