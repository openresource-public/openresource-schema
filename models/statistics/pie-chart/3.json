          "total": {
            "type": "boolean"
          },
          "legend": {
            "type": "boolean"
          },
          "sectors": {
            "type": "boolean"
          }
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
