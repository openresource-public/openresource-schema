{
  "ref": "biology/food-web@1",
  "family": "biology",
  "name": "food-web",
  "version": 1,
  "title": "Food chain / food web",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "organisms": {
        "type": "array",
        "minItems": 2,
        "maxItems": 16,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "label": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "decomposer"
              ]
            },
            "occlude": {
              "type": "boolean"
            },
            "occludeRole": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "label"
          ]
        }
      },
      "arrows": {
        "type": "array",
        "minItems": 1,
        "maxItems": 32,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "string"
            },
            "to": {
              "type": "string"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "from",
            "to"
          ]
        }
      },
      "remove": {
        "type": "string"
      },
      "reveal": {
        "type": "integer",
        "minimum": 0
      },
      "colorByLevel": {
        "type": "boolean"
      },
      "layout": {
        "type": "string",
        "enum": [
          "vertical",
          "horizontal"
        ]
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "roles": {
            "type": "boolean"
          },
          "levels": {
            "type": "boolean"
          },
          "convention": {
            "type": "boolean"
          }
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "organisms",
      "arrows"
    ]
  },
  "examples": [
    {
      "params": {
        "header": "A grassland food web",
        "organisms": [
          {
            "id": "grass",
            "label": "Grass"
          },
