{
  "ref": "biology/punnett-square@1",
  "family": "biology",
  "name": "punnett-square",
  "version": 1,
  "title": "Punnett square",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "parents": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "string"
        }
      },
      "genes": {
        "type": "array",
        "minItems": 1,
        "maxItems": 2,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dominant": {
              "type": "string"
            },
            "dominantPhenotype": {
              "type": "string"
            },
            "recessivePhenotype": {
              "type": "string"
            },
            "trait": {
              "type": "string"
            }
          },
          "required": [
            "dominant",
            "dominantPhenotype",
            "recessivePhenotype"
          ]
        }
      },
      "cells": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "row": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "col": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "occlude": {
              "type": "boolean"
            },
            "blank": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "row",
            "col"
          ]
        }
      },
      "gametes": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "side": {
              "type": "string",
              "enum": [
                "top",
                "left"
              ]
            },
            "index": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "side",
            "index"
          ]
        }
      },
      "ratios": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "genotype": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "occlude": {
                "type": "boolean"
              },
              "highlight": {
                "type": "boolean"
              }
            }
          },
          "phenotype": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "occlude": {
                "type": "boolean"
              },
              "highlight": {
                "type": "boolean"
              },
              "highlightClass": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              }
            }
          }
        }
      },
      "colorByPhenotype": {
        "type": "boolean"
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cellValues": {
            "type": "boolean"
          },
          "gametes": {
            "type": "boolean"
          },
          "genotypeRatio": {
            "type": "boolean"
          },
          "phenotypeRatio": {
            "type": "boolean"
          },
          "parents": {
            "type": "boolean"
          }
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "parents",
      "genes"
    ]
  },
  "examples": [
    {
      "params": {
        "header": "Cross two heterozygous brown-eyed parents",
        "parents": [
          "Bb",
          "Bb"
        ],
        "genes": [
          {
            "dominant": "B",
            "dominantPhenotype": "Brown eyes",
            "recessivePhenotype": "Blue eyes",
            "trait": "Eye colour"
          }
        ],
        "colorByPhenotype": true
      }
    },
    {
      "params": {
        "parents": [
          "Tt",
          "Tt"
        ],
        "genes": [
          {
            "dominant": "T",
            "dominantPhenotype": "Tall",
            "recessivePhenotype": "Short",
            "trait": "Height"
          }
        ],
        "show": {
          "cellValues": false,
          "genotypeRatio": false,
          "phenotypeRatio": false
        }
      }
    },
    {
      "params": {
        "parents": [
          "Rr",
          "Rr"
        ],
        "genes": [
          {
            "dominant": "R",
            "dominantPhenotype": "Red flower",
            "recessivePhenotype": "White flower",
            "trait": "Flower colour"
          }
        ],
        "cells": [
          {
            "row": 2,
            "col": 2,
            "occlude": true
          }
        ]
      }
    },
    {
      "params": {
        "header": "Test cross with a homozygous recessive parent",
        "parents": [
          "Bb",
          "bb"
        ],
        "genes": [
          {
            "dominant": "B",
            "dominantPhenotype": "Black fur",
            "recessivePhenotype": "White fur",
            "trait": "Fur colour"
          }
        ],
        "colorByPhenotype": true,
        "caption": "A test cross reveals whether the black parent is heterozygous."
      }
    },
    {
      "params": {
        "parents": [
          "Gg",
          "Gg"
        ],
        "genes": [
          {
            "dominant": "G",
            "dominantPhenotype": "Green pod",
            "recessivePhenotype": "Yellow pod",
            "trait": "Pod colour"
          }
        ],
        "colorByPhenotype": true,
        "ratios": {
          "genotype": {
            "occlude": true
          },
          "phenotype": {
            "occlude": true
          }
        }
      }
    },
    {
      "params": {
        "header": "Dihybrid cross: seed shape and colour",
        "parents": [
          "RrYy",
          "RrYy"
        ],
        "genes": [
          {
            "dominant": "R",
            "dominantPhenotype": "Round",
            "recessivePhenotype": "Wrinkled",
            "trait": "Seed shape"
          },
          {
            "dominant": "Y",
            "dominantPhenotype": "Yellow",
            "recessivePhenotype": "Green",
            "trait": "Seed colour"
          }
        ],
        "colorByPhenotype": true,
        "show": {
          "genotypeRatio": false
        }
      }
    }
  ]
}
