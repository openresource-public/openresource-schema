{
  "ref": "graphing/first-principles@2",
  "family": "graphing",
  "name": "first-principles",
  "version": 2,
  "title": "Differentiation from first principles",
  "responseModes": [
    "draw-tangent"
  ],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "axes": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "x": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "y": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "xStep": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "yStep": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "equalAspect": {
            "type": "boolean"
          },
          "degrees": {
            "type": "boolean"
          },
          "labels": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "string"
              },
              "y": {
                "type": "string"
              }
            }
          }
        }
      },
      "grid": {
        "type": "boolean"
      },
      "fn": {
        "type": "string"
      },
      "label": {
        "type": "string"
      },
      "point": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "x": {
            "type": "number"
          },
          "label": {
            "type": "string"
          },
          "tangent": {
            "type": "boolean"
          },
          "showGradient": {
            "type": "boolean"
          },
          "occludeGradient": {
            "type": "boolean"
          },
          "guides": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          }
        },
        "required": [
          "x"
        ]
      },
      "chords": {
        "type": "array",
        "maxItems": 4,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "h": {
              "type": "number"
            },
            "triangle": {
              "type": "boolean"
            },
            "label": {
              "type": "string"
            },
            "occludeGradient": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "h"
          ]
        }
      },
      "gradientCurve": {
        "type": "boolean"
      },
      "hSlider": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "min": {
            "type": "number",
            "minimum": 0
          },
          "max": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "value": {
            "type": "number"
          },
          "step": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "min",
          "max"
        ]
      },
      "drawTangent": {
        "type": "boolean"
      },
      "gradientTolerance": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      },
      "draggable": {
        "type": "boolean"
      }
    },
    "required": [
      "fn"
    ]
  },
  "examples": [
    {
      "params": {
        "axes": {
          "x": [
            -1,
            4
          ],
          "y": [
            -1,
            9
          ]
        },
        "fn": "x^2",
        "label": "y = x²",
        "point": {
          "x": 1,
          "label": "P",
          "guides": true
        },
        "caption": "The tangent to y = x² at P(1, 1)"
      }
    },
    {
      "params": {
        "axes": {
          "x": [
            -1,
            5
          ],
          "y": [
            -2,
            12
          ]
        },
        "fn": "x^2",
        "label": "y = x²",
        "point": {
          "x": 1,
          "label": "P"
        },
        "chords": [
          {
            "h": 3
          },
          {
            "h": 2
          },
          {
            "h": 1,
            "highlight": true
          }
        ],
        "caption": "As h → 0 the chord gradient → the tangent gradient"
      }
    },
    {
      "params": {
        "axes": {
          "x": [
            -1,
            5
          ],
          "y": [
            -2,
            12
          ]
        },
        "fn": "x^2",
        "label": "y = x²",
        "point": {
          "x": 1,
          "label": "P"
        },
        "hSlider": {
          "min": 0,
          "max": 3,
          "value": 3,
          "step": 0.1
        },
        "caption": "Drag h towards 0 — the chord approaches the tangent"
      }
    },
    {
      "params": {
        "axes": {
          "x": [
            -3,
            3
          ],
          "y": [
            -6,
            6
          ]
        },
        "fn": "x^3 - 3x",
        "label": "y = x³ − 3x",
        "point": {
          "x": 2,
          "label": "P",
          "occludeGradient": true,
          "highlight": true,
          "guides": true
        }
      }
    },
    {
      "params": {
        "axes": {
          "x": [
            -1,
            5
          ],
          "y": [
            -2,
            12
          ]
        },
        "fn": "x^2",
        "label": "y = x²",
        "point": {
          "x": 1,
          "label": "P"
        },
        "chords": [
          {
            "h": 2,
            "triangle": true,
            "highlight": true
          }
        ],
        "caption": "Gradient of the chord = δy ÷ δx"
      }
    },
    {
      "params": {
        "axes": {
          "x": [
            -1,
            4
          ],
          "y": [
            -1,
            9
          ]
        },
        "fn": "x^2",
        "label": "y = x²",
        "point": {
          "x": 2,
          "tangent": false
        }
      }
    },
    {
      "params": {
        "axes": {
          "x": [
            -3,
            3
          ],
          "y": [
            -4,
            8
          ]
        },
        "fn": "x^2",
        "label": "y = x²",
        "point": {
          "x": 1.5,
          "label": "P"
        },
        "gradientCurve": true,
        "caption": "The gradient of y = x² at each point traces y = 2x"
      }
    },
    {
      "params": {
        "axes": {
          "x": [
            0,
            60
          ],
          "y": [
            0,
            55
          ],
          "xStep": 10,
          "yStep": 5,
          "labels": {
            "x": "time (s)",
            "y": "volume of gas (cm³)"
          }
        },
        "fn": "50(1 - exp(-0.1x))",
        "point": {
          "x": 30
        },
        "drawTangent": true,
        "gradientTolerance": 0.1
      }
    },
    {
      "params": {
        "axes": {
          "x": [
            -1,
            4
          ],
          "y": [
            -1,
            9
          ]
        },
        "fn": "x^2",
        "label": "y = x²",
        "point": {
          "x": 2
        },
        "drawTangent": true
      }
    },
    {
      "params": {
        "axes": {
          "x": [
            0,
            60
          ],
          "y": [
            0,
            55
          ],
          "xStep": 10,
          "yStep": 5,
          "labels": {
            "x": "time (s)",
            "y": "volume of gas (cm³)"
          }
        },
        "fn": "50(1 - exp(-0.1x))",
        "point": {
          "x": 30,
          "label": "P",
          "guides": true
        },
        "caption": "The gradient of the tangent at t = 30 s is the rate of reaction at that instant"
      }
    }
  ]
}
