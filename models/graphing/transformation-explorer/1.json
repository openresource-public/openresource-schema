{
  "ref": "graphing/transformation-explorer@1",
  "family": "graphing",
  "name": "transformation-explorer",
  "version": 1,
  "title": "Transformation explorer",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "base": {
        "type": "string",
        "enum": [
          "quadratic",
          "cubic",
          "modulus",
          "reciprocal",
          "sine",
          "cosine",
          "sqrt"
        ]
      },
      "a": {
        "type": "number"
      },
      "b": {
        "type": "number"
      },
      "c": {
        "type": "number"
      },
      "reflectX": {
        "type": "boolean"
      },
      "reflectY": {
        "type": "boolean"
      },
      "samples": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "maxItems": 4
      },
      "axes": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "x": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "y": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "xStep": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "yStep": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      },
      "occlude": {
        "type": "string",
        "enum": [
          "equation",
          "points"
        ]
      },
      "highlight": {
        "type": "boolean"
      },
      "showBase": {
        "type": "boolean"
      },
      "showImage": {
        "type": "boolean"
      },
      "showPoints": {
        "type": "boolean"
      },
      "showDescription": {
        "type": "boolean"
      },
      "showGrid": {
        "type": "boolean"
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      },
      "draggable": {
        "type": "boolean"
      }
    }
  },
  "examples": [
    {
      "params": {
        "base": "quadratic",
        "c": 3,
        "samples": [
          -2,
          1
        ],
        "axes": {
          "x": [
            -5,
            5
          ],
          "y": [
            -2,
            9
          ]
        }
      }
    },
    {
      "params": {
        "base": "quadratic",
        "b": 2,
        "samples": [
          0,
          2
        ],
        "occlude": "equation",
        "axes": {
          "x": [
            -4,
            6
          ],
          "y": [
            -1,
            8
          ]
        }
      }
    },
    {
      "params": {
        "base": "cubic",
        "c": -2,
        "showImage": false,
        "showDescription": false,
        "axes": {
          "x": [
            -3,
            3
          ],
          "y": [
            -6,
            6
          ]
        }
      }
    },
    {
      "params": {
        "base": "sine",
        "a": 2,
        "samples": [
          1.5707963
        ],
        "occlude": "points",
        "highlight": true,
        "axes": {
          "x": [
            -3.2,
            3.2
          ],
          "y": [
            -2.5,
            2.5
          ],
          "xStep": 1.5707963,
          "yStep": 1
        }
      }
    },
    {
      "params": {
        "base": "sqrt",
        "a": 2,
        "b": 3,
        "c": 1,
        "reflectX": true,
        "samples": [
          0,
          4
        ],
        "axes": {
          "x": [
            -1,
            9
          ],
          "y": [
            -6,
            5
          ]
        },
        "header": "A combined transformation"
      }
    },
    {
      "params": {
        "base": "cosine",
        "a": 1,
        "b": 0,
        "c": 0,
        "draggable": true,
        "axes": {
          "x": [
            -3.2,
            3.2
          ],
          "y": [
            -3,
            3
          ],
          "xStep": 1.5707963,
          "yStep": 1
        }
      }
    }
  ]
}
