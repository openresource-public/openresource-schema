{
  "ref": "graphing/circle-graph@1",
  "family": "graphing",
  "name": "circle-graph",
  "version": 1,
  "title": "Circle on coordinate axes",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "circle": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "center": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "radius": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "centerLabel": {
            "type": "string"
          }
        },
        "required": [
          "radius"
        ]
      },
      "axes": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "x": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "y": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "step": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "labelStep": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      },
      "grid": {
        "type": "boolean"
      },
      "points": {
        "type": "array",
        "maxItems": 4,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "at": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "label": {
              "type": "string"
            },
            "radius": {
              "type": "boolean"
            },
            "tangent": {
              "type": "boolean"
            },
            "rightAngle": {
              "type": "boolean"
            },
            "showCoords": {
              "type": "boolean"
            },
            "occlude": {
              "type": "boolean"
            },
            "occludeTangent": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "at"
          ]
        }
      },
      "lines": {
        "type": "array",
        "maxItems": 3,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "expr": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "showIntersections": {
              "type": "boolean"
            },
            "occludeIntersections": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "expr"
          ]
        }
      },
      "tangentForm": {
        "type": "string",
        "enum": [
          "gradient-intercept",
          "normal",
          "both"
        ]
      },
      "showTangentEquation": {
        "type": "boolean"
      },
      "showEquation": {
        "type": "boolean"
      },
      "occludeEquation": {
        "type": "boolean"
      },
      "showRadiusLength": {
        "type": "boolean"
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      },
      "draggable": {
        "type": "boolean"
      }
    },
    "required": [
      "circle"
    ]
  },
  "examples": [
    {
      "params": {
        "axes": {
          "x": [
            -6,
            6
          ],
          "y": [
            -6,
            6
          ]
        },
        "circle": {
          "radius": 5
        },
        "points": [
          {
            "at": [
              3,
              4
            ],
            "label": "P",
            "radius": true,
            "tangent": true
          }
        ],
        "caption": "The tangent to the circle at P is perpendicular to the radius OP"
      }
    },
    {
      "params": {
        "axes": {
          "x": [
            -7,
            7
          ],
          "y": [
            -7,
            7
          ]
        },
        "circle": {
          "radius": 5,
          "centerLabel": "O"
        },
        "points": [
          {
            "at": [
              -4,
              3
            ],
            "label": "A"
          }
        ]
      }
    },
    {
      "params": {
        "axes": {
          "x": [
            -11,
            11
          ],
          "y": [
            -11,
            11
          ],
          "labelStep": 2
        },
        "circle": {
          "radius": 10
        },
        "points": [
          {
            "at": [
              6,
              8
            ],
            "label": "T",
            "radius": true,
            "tangent": true,
            "occludeTangent": true,
            "highlight": true
          }
        ]
      }
    },
    {
      "params": {
        "axes": {
          "x": [
            -4,
            8
          ],
          "y": [
            -5,
            7
          ]
        },
        "circle": {
          "center": [
            2,
            1
          ],
          "radius": 5,
          "centerLabel": "C"
        },
        "points": [
          {
            "at": [
              5,
              5
            ],
            "label": "P",
            "radius": true,
            "tangent": true
          }
        ],
        "tangentForm": "both",
        "showRadiusLength": true,
        "caption": "The tangent at P is perpendicular to the radius CP"
      }
    },
    {
      "params": {
        "axes": {
          "x": [
            -7,
            7
          ],
          "y": [
            -7,
            7
          ]
        },
        "circle": {
          "radius": 5
        },
        "lines": [
          {
            "expr": "y = x + 1",
            "label": "y = x + 1"
          }
        ]
      }
    },
    {
      "params": {
        "axes": {
          "x": [
            -6,
            6
          ],
          "y": [
            -6,
            6
          ]
        },
        "circle": {
          "radius": 5,
          "centerLabel": "O"
        },
        "points": [
          {
            "at": [
              4,
              3
            ],
            "label": "P",
            "radius": true,
            "tangent": true
          }
        ],
        "draggable": true
      }
    }
  ]
}
