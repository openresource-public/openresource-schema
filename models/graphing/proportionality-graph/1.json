{
  "ref": "graphing/proportionality-graph@1",
  "family": "graphing",
  "name": "proportionality-graph",
  "version": 1,
  "title": "Proportionality sketch graph",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "panels": {
        "type": "array",
        "minItems": 1,
        "maxItems": 4,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "relationship": {
              "type": "string",
              "enum": [
                "direct",
                "inverse",
                "direct-square",
                "inverse-square"
              ]
            },
            "tag": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "occlude": {
              "type": "boolean"
            },
            "curveLabel": {
              "type": "string"
            },
            "highlight": {
              "type": "boolean"
            },
            "quadrants": {
              "type": "string",
              "enum": [
                "all",
                "first"
              ]
            }
          },
          "required": []
        }
      },
      "columns": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "axisLabels": {
            "type": "boolean"
          },
          "originLabel": {
            "type": "boolean"
          }
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "panels"
    ]
  },
  "examples": [
    {
      "params": {
        "header": "Here are four graphs",
        "panels": [
          {
            "tag": "A",
            "relationship": "inverse"
          },
          {
            "tag": "B",
            "relationship": "direct"
          },
          {
            "tag": "C",
            "relationship": "inverse-square"
          },
          {
            "tag": "D",
            "relationship": "direct-square"
          }
        ]
      }
    },
    {
      "params": {
        "panels": [
          {
            "relationship": "direct",
            "label": "y is directly proportional to x",
            "curveLabel": "y = kx"
          }
        ]
      }
    },
    {
      "params": {
        "panels": [
          {
            "relationship": "inverse-square",
            "label": "y is inversely proportional to x²",
            "occlude": true
          }
        ]
      }
    },
    {
      "params": {
        "panels": [
          {
            "tag": "A"
          },
          {
            "tag": "B"
          },
          {
            "tag": "C"
          },
          {
            "tag": "D"
          }
        ]
      }
    },
    {
      "params": {
        "header": "Two decreasing relationships",
        "panels": [
          {
            "tag": "A",
            "relationship": "inverse",
            "quadrants": "first",
            "label": "y ∝ 1/x"
          },
          {
            "tag": "B",
            "relationship": "inverse-square",
            "quadrants": "first",
            "label": "y ∝ 1/x²"
          }
        ]
      }
    },
    {
      "params": {
        "panels": [
          {
            "tag": "A",
            "relationship": "inverse"
          },
          {
            "tag": "B",
            "relationship": "direct-square",
            "highlight": true
          },
          {
            "tag": "C",
            "relationship": "direct"
          },
          {
            "tag": "D",
            "relationship": "inverse-square"
          }
        ]
      }
    }
  ]
}
