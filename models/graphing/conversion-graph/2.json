{
  "ref": "graphing/conversion-graph@2",
  "family": "graphing",
  "name": "conversion-graph",
  "version": 2,
  "title": "Conversion graph",
  "responseModes": [
    "read-off"
  ],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "axes": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "x": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "range": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "step": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "labelStep": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "label",
              "range"
            ]
          },
          "y": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "range": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "step": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "labelStep": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "label",
              "range"
            ]
          }
        },
        "required": [
          "x",
          "y"
        ]
      },
      "line": {
        "type": "object",
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "rate"
            ]
          },
          {
            "required": [
              "points"
            ]
          }
        ],
        "properties": {
          "rate": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "points": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "label": {
            "type": "string"
          },
          "showLabel": {
            "type": "boolean"
          },
          "occlude": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          }
        }
      },
      "readOffs": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "string",
              "enum": [
                "x",
                "y"
              ]
            },
            "value": {
              "type": "number"
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            },
            "label": {
              "type": "string"
            }
          },
          "required": [
            "from",
            "value"
          ]
        }
      },
      "readOff": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string",
            "enum": [
              "x",
              "y"
            ]
          },
          "value": {
            "type": "number"
          },
          "tolerance": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "from",
          "value"
        ]
      },
      "points": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "label": {
              "type": "string"
            },
            "occlude": {
              "type": "boolean"
            }
          },
          "required": [
            "x",
            "y"
          ]
        }
      },
      "showGrid": {
        "type": "boolean"
      },
      "header": {
        "type": "string"
      }
    },
    "required": [
      "axes"
    ]
  },
