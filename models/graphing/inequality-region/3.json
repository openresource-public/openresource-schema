{
  "ref": "graphing/inequality-region@3",
  "family": "graphing",
  "name": "inequality-region",
  "version": 3,
  "title": "Graphical inequalities (regions)",
  "responseModes": [
    "shade-region",
    "mark-cross",
    "construct-region"
  ],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "axes": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "x": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "y": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "xStep": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "yStep": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "equalAspect": {
            "type": "boolean"
          }
        }
      },
      "grid": {
        "type": "boolean"
      },
      "inequalities": {
        "type": "array",
        "minItems": 1,
        "maxItems": 5,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "expr": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "highlight": {
              "type": "boolean"
            },
            "hidden": {
              "type": "boolean"
            }
          },
          "required": [
            "expr"
          ]
        }
      },
      "region": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "shade": {
            "type": "string",
            "enum": [
              "wanted",
              "unwanted"
            ]
          },
          "label": {
            "type": "string"
          },
          "occlude": {
            "type": "boolean"
          },
          "integerPoints": {
            "type": "boolean"
          },
          "vertices": {
            "type": "boolean"
          },
          "showVertexCoords": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          }
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      },
      "draggable": {
        "type": "boolean"
      },
      "shadeConvention": {
        "type": "string",
        "enum": [
          "wanted",
          "unwanted"
        ]
      },
      "constructRegion": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "starts": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "required": [
      "inequalities"
    ]
  },
  "examples": [
    {
      "params": {
        "axes": {
          "x": [
            -5,
            5
          ],
          "y": [
            -5,
            5
          ]
        },
        "inequalities": [
          {
            "expr": "y > 2x + 1",
            "label": "y = 2x + 1"
          }
        ],
        "region": {
          "shade": "wanted",
          "highlight": true
        }
      }
    },
    {
      "params": {
        "axes": {
          "x": [
            -1,
            8
          ],
          "y": [
            -1,
            6
          ]
        },
        "inequalities": [
          {
            "expr": "y >= 1",
            "label": "y = 1"
          },
          {
            "expr": "y <= x + 1",
            "label": "y = x + 1"
          },
          {
            "expr": "x + y <= 7",
            "label": "x + y = 7"
          }
        ],
        "region": {
          "shade": "unwanted",
          "label": "R",
          "integerPoints": true
        }
      }
    },
    {
      "params": {
        "axes": {
          "x": [
            -1,
            8
          ],
          "y": [
            -1,
            8
          ]
        },
        "inequalities": [
          {
            "expr": "x >= 0"
          },
          {
            "expr": "y >= 0"
          },
          {
            "expr": "x + y <= 6",
            "label": "x + y = 6"
          },
          {
            "expr": "y <= 2x",
            "label": "y = 2x"
          }
        ],
        "region": {
          "shade": "wanted",
          "label": "R",
          "vertices": true,
          "showVertexCoords": true
        },
        "caption": "The feasible region and its corner points"
      }
    },
    {
      "params": {
        "axes": {
          "x": [
            -1,
            6
          ],
          "y": [
            -1,
            6
          ]
        },
        "inequalities": [
          {
            "expr": "y < x"
          },
          {
            "expr": "y > 0"
          },
          {
            "expr": "x < 5"
          }
        ],
        "region": {
          "shade": "wanted",
          "integerPoints": true
        }
      }
    },
    {
      "params": {
        "axes": {
          "x": [
            -5,
            5
          ],
          "y": [
            -5,
            5
          ]
        },
        "inequalities": [
          {
            "expr": "2x + 3y <= 6",
            "label": "2x + 3y = 6"
          }
        ],
        "region": {
          "shade": "wanted"
        },
        "caption": "y on or below the line: the boundary is solid because of ≤"
      }
    },
    {
      "params": {
        "axes": {
          "x": [
            -1,
            7
          ],
          "y": [
            -1,
            7
          ]
        },
        "inequalities": [
          {
            "expr": "y <= 5",
            "label": "y = 5"
          },
          {
            "expr": "y >= x",
            "label": "y = x"
          },
          {
            "expr": "x >= 1",
            "label": "x = 1"
          }
        ]
      }
    },
    {
      "params": {
        "axes": {
          "x": [
            -6,
            6
          ],
          "y": [
            -6,
            6
          ],
          "xStep": 1,
          "yStep": 1,
          "equalAspect": true
        },
        "inequalities": [
          {
            "expr": "x + y < 5"
          },
          {
            "expr": "y > x - 2"
          },
          {
            "expr": "y >= -1"
          }
        ],
        "constructRegion": {
          "starts": [
            [
              [
                -4,
                4
              ],
              [
                4,
                4
              ]
            ],
            [
              [
                -3,
                -5
              ],
              [
                -3,
                5
              ]
            ],
            [
              [
                -5,
                -4
              ],
              [
                5,
                3
              ]
            ]
          ]
        }
      }
    }
  ]
}
