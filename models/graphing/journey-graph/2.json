{
  "ref": "graphing/journey-graph@2",
  "family": "graphing",
  "name": "journey-graph",
  "version": 2,
  "title": "Journey graph (distance–time / speed–time)",
  "responseModes": [
    "draw-journey",
    "read-off"
  ],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "kind": {
        "type": "string",
        "enum": [
          "distance-time",
          "speed-time",
          "velocity-time"
        ]
      },
      "journeys": {
        "type": "array",
        "maxItems": 2,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "points": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              }
            },
            "label": {
              "type": "string"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "points"
          ]
        }
      },
      "axes": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "time": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "value": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "timeStep": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "valueStep": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "timeTicks": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "at": {
                      "type": "number"
                    },
                    "label": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "at"
                  ]
                }
              ]
            }
          },
          "valueTicks": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "at": {
                      "type": "number"
                    },
                    "label": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "at"
                  ]
                }
              ]
            }
          }
        }
      },
      "axisNames": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "time": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      },
      "unit": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "time": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "gradient": {
            "type": "string"
          },
          "area": {
            "type": "string"
          }
        }
      },
      "grid": {
        "type": "boolean"
      },
      "sketch": {
        "type": "boolean"
      },
      "showGradients": {
        "type": "boolean"
      },
      "segments": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "index": {
              "type": "integer",
              "minimum": 0
            },
            "journey": {
              "type": "integer",
              "minimum": 0
            },
            "label": {
              "type": "string"
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "index"
          ]
        }
      },
      "area": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "journey": {
            "type": "integer",
            "minimum": 0
          },
          "from": {
            "type": "number"
          },
          "to": {
            "type": "number"
          },
          "showValue": {
            "type": "boolean"
          },
          "occlude": {
            "type": "boolean"
          },
          "label": {
            "type": "string"
          },
          "highlight": {
            "type": "boolean"
          }
        }
      },
      "marks": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "t": {
              "type": "number"
            },
            "journey": {
              "type": "integer",
              "minimum": 0
            },
            "label": {
              "type": "string"
            },
            "occlude": {
              "type": "boolean"
            },
            "guides": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "t"
          ]
        }
      },
      "drops": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "t": {
              "type": "number"
            },
            "journey": {
              "type": "integer",
              "minimum": 0
            },
            "down": {
              "type": "boolean"
            },
            "across": {
              "type": "boolean"
            }
          },
          "required": [
            "t"
          ]
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      },
      "draggable": {
        "type": "boolean"
      },
      "drawJourney": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "points": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "tolerance": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "points"
        ]
      },
      "readOff": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string",
            "enum": [
              "x",
              "y"
            ]
          },
          "value": {
            "type": "number"
          },
          "journey": {
            "type": "integer",
            "minimum": 0
          },
          "tolerance": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "from",
          "value"
        ]
      }
    },
    "required": [
      "kind",
      "journeys"
    ]
  },
  "examples": [
    {
      "params": {
        "kind": "speed-time",
        "journeys": [
          {
            "points": [
              [
                0,
                0
              ],
              [
                4,
                20
              ],
              [
                10,
                20
              ],
              [
                14,
                0
              ]
            ]
          }
        ],
        "axisNames": {
          "time": "Time (s)",
          "value": "Speed (m/s)"
        },
        "unit": {
          "time": "s",
          "value": "m/s",
          "gradient": "m/s²",
          "area": "m"
        },
        "showGradients": true,
        "area": {
          "highlight": true,
          "label": "distance"
        }
      }
    },
    {
      "params": {
        "kind": "distance-time",
