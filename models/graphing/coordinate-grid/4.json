{
  "ref": "graphing/coordinate-grid@4",
  "family": "graphing",
  "name": "coordinate-grid",
  "version": 4,
  "title": "Coordinate grid",
  "responseModes": [
    "place-point",
    "select-point",
    "place-line"
  ],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "axes": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "x": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "y": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "step": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "yStep": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "labelStep": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "yLabelStep": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "showNumbers": {
            "type": "boolean"
          },
          "squareCells": {
            "type": "boolean"
          },
          "majorGrid": {
            "type": "boolean"
          }
        },
        "required": [
          "x",
          "y"
        ]
      },
      "grid": {
        "type": "boolean"
      },
      "points": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "label": {
              "type": "string"
            },
            "style": {
              "type": "string",
              "enum": [
                "dot",
                "open",
                "cross"
              ]
            },
            "occlude": {
              "type": "boolean"
            },
            "color": {
              "type": "string"
            }
          },
          "required": [
            "x",
            "y"
          ]
        }
      },
      "segments": {
        "type": "array",
        "items": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 2,
              "maxItems": 2
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from",
                "to"
              ],
              "properties": {
                "from": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "to": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "arrow": {
                  "type": "boolean"
                },
                "dashed": {
                  "type": "boolean"
                },
                "label": {
                  "type": "string"
                },
                "labelSide": {
                  "type": "string",
                  "enum": [
                    "above",
                    "below",
                    "left",
                    "right"
                  ]
                },
                "color": {
                  "type": "string",
                  "pattern": "^(?:accent|accent-[2-5]|ink|muted|scaffold|#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\(\\s*[0-9.,%\\s/]+\\)|[a-zA-Z]{3,20})$"
                }
              }
            }
          ]
        }
      },
      "lines": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "oneOf": [
            {
              "required": [
                "x"
              ]
            },
            {
              "required": [
                "y"
              ]
            },
            {
              "required": [
                "m"
              ]
            }
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "m": {
              "type": "number"
            },
            "c": {
              "type": "number"
            },
            "label": {
              "type": "string"
            },
            "showLabel": {
              "type": "boolean"
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            },
            "color": {
              "type": "string",
              "pattern": "^(?:accent|accent-[2-5]|ink|muted|scaffold|#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\(\\s*[0-9.,%\\s/]+\\)|[a-zA-Z]{3,20})$"
            }
          }
        }
      },
      "placeLine": {
        "type": "object",
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "m"
            ]
          },
          {
            "required": [
              "x"
            ]
          },
          {
            "required": [
              "y"
            ]
          }
        ],
        "properties": {
          "m": {
            "type": "number"
          },
          "c": {
            "type": "number"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        }
      },
      "highlight": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "showCoordinates": {
        "type": "boolean"
      },
      "header": {
        "type": "string"
      },
      "draggable": {
        "type": "boolean"
      }
    },
    "required": [
      "axes"
    ]
  },
  "examples": [
    {
