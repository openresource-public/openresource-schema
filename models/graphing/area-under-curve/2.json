{
  "ref": "graphing/area-under-curve@2",
  "family": "graphing",
  "name": "area-under-curve",
  "version": 2,
  "title": "Area under a curve",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "axes": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "x": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "y": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "xStep": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "yStep": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "equalAspect": {
            "type": "boolean"
          },
          "degrees": {
            "type": "boolean"
          },
          "bare": {
            "type": "boolean"
          },
          "showOrigin": {
            "type": "boolean"
          }
        }
      },
      "grid": {
        "type": "boolean"
      },
      "monochrome": {
        "type": "boolean"
      },
      "curves": {
        "type": "array",
        "maxItems": 2,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fn": {
              "type": "string"
            },
            "xt": {
              "type": "string"
            },
            "yt": {
              "type": "string"
            },
            "tRange": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "domain": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "label": {
              "type": "string"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "anyOf": [
            {
              "required": [
                "fn"
              ]
            },
            {
              "required": [
                "xt",
                "yt",
                "tRange"
              ]
            }
          ]
        }
      },
      "region": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "number"
          },
          "to": {
            "type": "number"
          },
          "between": {
            "type": "boolean"
          },
          "shade": {
            "type": "boolean"
          },
          "fill": {
            "type": "string",
            "enum": [
              "tint",
              "solid",
              "hatch"
            ]
          },
          "absolute": {
            "type": "boolean"
          },
          "showValue": {
            "type": "boolean"
          },
          "occlude": {
            "type": "boolean"
          },
          "label": {
            "type": "string"
          },
          "fromLabel": {
            "type": "string"
          },
          "toLabel": {
            "type": "string"
          },
          "highlight": {
            "type": "boolean"
          }
        },
        "required": [
          "from",
          "to"
        ]
      },
      "strips": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rule": {
            "type": "string",
            "enum": [
              "trapezium",
              "left",
              "right",
              "midpoint"
            ]
          },
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "showOrdinates": {
            "type": "boolean"
          },
          "showEstimate": {
            "type": "boolean"
          },
          "occludeEstimate": {
            "type": "boolean"
          },
          "showError": {
            "type": "boolean"
          }
        },
        "required": [
          "rule",
          "n"
        ]
      },
      "tangents": {
        "type": "array",
        "maxItems": 3,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "at": {
              "type": "number"
            },
            "gradient": {
              "type": "number"
            },
            "near": {
              "type": "number"
            },
            "triangle": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "run": {
                  "type": "number"
                },
                "labels": {
                  "oneOf": [
                    {
                      "type": "boolean",
                      "enum": [
                        false
                      ]
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  ]
                }
              },
              "required": [
                "run"
              ]
            }
          },
          "anyOf": [
            {
              "required": [
                "at"
              ]
            },
            {
              "required": [
                "gradient"
              ]
            }
          ]
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      },
      "draggable": {
        "type": "boolean"
      }
    },
    "required": [
      "curves"
    ]
  },
  "examples": [
    {
      "params": {
        "axes": {
          "x": [
            -1,
            4
          ],
          "y": [
            -1,
            10
          ]
        },
        "curves": [
          {
            "fn": "x^2",
            "label": "y = x²"
          }
        ],
        "region": {
          "from": 0,
          "to": 3,
          "highlight": true,
          "label": "A"
        },
        "caption": "The area between y = x² and the x-axis from x = 0 to x = 3"
      }
    },
    {
      "params": {
        "axes": {
          "x": [
            -1,
            5
          ],
          "y": [
            -1,
            6
          ]
        },
        "curves": [
          {
            "fn": "sqrt(x) + 1",
            "label": "y = √x + 1"
          }
        ],
        "region": {
          "from": 0,
          "to": 4,
          "shade": false
        },
        "strips": {
          "rule": "trapezium",
          "n": 4,
          "showOrdinates": true,
          "occludeEstimate": true
        }
      }
    },
    {
      "params": {
        "axes": {
          "x": [
            -1,
            5
          ],
          "y": [
            -1,
            10
          ]
        },
        "curves": [
          {
            "fn": "x^2 - x + 1",
            "label": "y = x² − x + 1"
          }
        ],
        "region": {
          "from": 0,
          "to": 4
        },
        "strips": {
          "rule": "left",
          "n": 4,
          "showEstimate": true,
          "showError": true
        },
        "caption": "Left rectangles under-estimate the area under an increasing curve"
      }
    },
    {
      "params": {
        "axes": {
          "x": [
            -1,
            4
          ],
          "y": [
            -5,
            16
          ]
        },
        "curves": [
          {
            "fn": "x^3 - 4x",
            "label": "y = x³ − 4x"
          }
        ],
        "region": {
          "from": 0,
          "to": 3,
          "highlight": true
        },
        "strips": {
          "rule": "trapezium",
          "n": 4,
          "showOrdinates": true,
          "showError": true
        },
        "caption": "Signed area: the part below the axis counts as negative"
      }
    },
    {
      "params": {
        "axes": {
          "x": [
            -1,
            4
          ],
          "y": [
            -2,
            20
          ]
        },
        "curves": [
          {
            "fn": "x^3 - 3x^2 + 4",
            "label": "y = x³ − 3x² + 4"
          }
        ],
        "region": {
          "from": 0,
          "to": 3,
          "highlight": true
        },
        "caption": "The definite integral of y = x³ − 3x² + 4 from x = 0 to x = 3"
      }
    },
    {
      "params": {
        "axes": {
          "x": [
            0,
            6.5
          ],
          "y": [
            -2,
            4
          ]
        },
        "curves": [
          {
            "fn": "x*sin(x)",
            "label": "y = x·sin x"
          }
        ],
        "region": {
          "from": 0,
          "to": 3.1416,
          "absolute": true,
          "highlight": true
        },
        "caption": "The area between y = x·sin x and the x-axis from x = 0 to x = π"
      }
    },
    {
      "params": {
        "axes": {
          "x": [
            -2,
            3
          ],
          "y": [
            -1,
            6
          ]
        },
        "curves": [
          {
            "fn": "x + 2",
            "label": "y = x + 2"
          },
          {
            "fn": "x^2",
            "label": "y = x²"
          }
        ],
        "region": {
          "from": -1,
          "to": 2,
          "between": true,
          "label": "A"
        },
        "caption": "The area enclosed between y = x + 2 and y = x²"
      }
    },
    {
      "params": {
        "axes": {
          "x": [
            -1,
            5
          ],
          "y": [
            -1,
            9
          ]
        },
        "curves": [
          {
            "fn": "0.5x^2",
            "label": "y = ½x²"
          },
          {
            "fn": "x",
            "label": "y = x"
          }
        ],
        "region": {
          "from": 0,
          "to": 4,
          "between": true,
          "highlight": true
        },
        "caption": "The total area enclosed between y = ½x² and y = x — they swap over at x = 2"
      }
    },
    {
      "params": {
        "axes": {
          "x": [
            -1,
            7
          ],
          "y": [
            -1,
            5
          ]
        },
        "curves": [
          {
            "fn": "4/(1 + x)",
            "label": "y = 4 ÷ (1 + x)"
          }
        ],
        "region": {
          "from": 1,
          "to": 5,
          "shade": false
        }
      }
    },
    {
      "params": {
        "axes": {
          "x": [
            -1.6,
            7.4
          ],
          "y": [
            -6,
            11
          ],
          "bare": true
        },
        "monochrome": true,
        "curves": [
          {
            "fn": "x(6-x)"
          },
          {
            "fn": "5"
          }
        ],
        "region": {
          "from": 1,
          "to": 5,
          "between": true,
          "fill": "solid",
          "label": "R"
        },
        "caption": "The sketch shows the curve y = x(6 − x) and the line y = 5"
      }
    },
    {
      "params": {
        "axes": {
          "x": [
            -1.2,
            5.2
          ],
          "y": [
            -8,
            6
          ],
          "bare": true,
          "showOrigin": true
        },
        "monochrome": true,
        "curves": [
          {
            "fn": "x(x-1)(x-4)"
          }
        ],
        "region": {
          "from": 0,
          "to": 4,
          "absolute": true,
          "fill": "solid",
          "showValue": true
        },
        "caption": "The two parts lie on opposite sides of the axis, so they must not cancel"
      }
    },
    {
      "params": {
        "axes": {
          "x": [
            -0.8,
            7
          ],
          "y": [
            -0.6,
            2.6
          ],
          "bare": true
        },
        "monochrome": true,
        "curves": [
          {
            "xt": "t - sin(t)",
            "yt": "1 - cos(t)",
            "tRange": [
              0,
              6.2832
            ]
          }
        ],
        "region": {
          "from": 0,
          "to": 6.2832,
          "fill": "hatch",
          "label": "R"
        },
        "caption": "One arch of the curve x = t − sin t, y = 1 − cos t for 0 ≤ t ≤ 2π"
      }
    },
    {
      "params": {
        "axes": {
          "x": [
            -0.35,
            2.7
          ],
          "y": [
            -0.2,
            1.15
          ],
          "bare": true
        },
        "monochrome": true,
        "curves": [
          {
            "xt": "ln(t)",
            "yt": "1/t",
            "tRange": [
              1,
              12
            ]
          }
        ],
        "region": {
          "from": 0.6931,
          "to": 1.6094,
          "fill": "solid",
          "fromLabel": "ln 2",
          "toLabel": "ln 5",
          "showValue": true
        },
        "caption": "The region bounded by the curve, the x-axis and x = ln 2, x = ln 5"
      }
    },
    {
      "params": {
        "axes": {
          "x": [
            -0.7,
            5.4
          ],
          "y": [
            -0.22,
            0.52
          ],
          "bare": true
        },
        "monochrome": true,
        "curves": [
          {
            "fn": "x*exp(-x)",
            "domain": [
              0,
              5
            ]
          }
        ],
        "caption": "The diagram shows part of the curve y = x·e⁻ˣ for x ≥ 0"
      }
    },
    {
      "params": {
        "axes": {
          "x": [
            0,
            10
          ],
          "y": [
            0,
            50
          ],
          "xStep": 2,
          "yStep": 10
        },
        "curves": [
          {
            "fn": "-0.0486*x^3 - 0.806*x^2 + 14.92*x"
          }
        ],
        "tangents": [
          {
            "at": 2,
            "triangle": {
              "run": -2
            }
          }
        ]
      }
    },
    {
      "params": {
        "axes": {
          "x": [
            -1,
            4
          ],
          "y": [
            -1,
            7
          ]
        },
        "curves": [
          {
            "fn": "x^2 + 1",
            "label": "y = x² + 1"
          }
        ],
        "region": {
          "from": 0,
          "to": 2,
          "occlude": true,
          "highlight": true
        }
      }
    }
  ]
}
