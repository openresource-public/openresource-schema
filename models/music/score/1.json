          "unit": "3/8",
          "text": "Gently"
        },
        "parts": [
          {
            "name": "Voice",
            "clef": "treble",
            "music": "D | \"G\"!mp!G2A B2c | \"D7\"d2c B2G | \"Em\"!crescendo(!E2G B2d | \"D\"(3cBA !crescendo)!A2- A2 |: \"G\"!f!GAB dBG | \"C\"c2e \"D7\"d2c |1 \"G\"B2G D3 :|2 \"G\"B3 z3 |]",
            "lyrics": [
              "O-ver the hill and far a-way, the sun is set-ting on the day, we sing our song."
            ]
          },
          {
            "name": "Piano",
            "clef": "bass",
            "music": "z | G,,2B,, D,2G, | D,,2A,, C,2^F, | E,,2G,, B,,2E, | D,2A,, D,3 |: G,,2B,, D,2G, | C,2E, D,2^F, |1 G,3 D,3 :|2 G,,3 z3 |]"
          }
        ]
      }
    },
    {
      "params": {
        "header": "Cadence in D major",
        "key": "D",
        "meter": "4/4",
        "unitLength": "1/4",
        "parts": [
          {
            "name": "S / A",
            "clef": "treble",
            "music": "\"D\"^f a a g | \"G\"b a g ^f | \"A7\"e ^c e g | \"D\"^f4 |]",
            "voice2": "d d ^f e | d d d d | ^c e ^c e | d4 |]"
          },
          {
            "name": "T / B",
            "clef": "bass",
            "music": "A, D ^F B, | G, A, B, A, | A, A, A, ^C | A,4 |]",
            "voice2": "D, D, D, G, | G, ^F, G, D, | A,, A,, A,, A,, | D,4 |]"
          }
        ],
        "brace": false,
        "highlightBars": [
