{
  "ref": "music/score@1",
  "family": "music",
  "name": "score",
  "version": 1,
  "title": "Sheet music",
  "responseModes": [
    "select-region"
  ],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "header": {
        "type": "string"
      },
      "composer": {
        "type": "string"
      },
      "key": {
        "type": "string"
      },
      "meter": {
        "type": "string"
      },
      "unitLength": {
        "type": "string"
      },
      "tempo": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "bpm": {
            "type": "number",
            "minimum": 20,
            "maximum": 300
          },
          "unit": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "bpm"
        ]
      },
      "parts": {
        "type": "array",
        "minItems": 1,
        "maxItems": 4,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "clef": {
              "type": "string",
              "enum": [
                "treble",
                "bass",
                "alto",
                "tenor",
                "percussion"
              ]
            },
            "music": {
              "type": "string"
            },
            "voice2": {
              "type": "string"
            },
            "instrument": {
              "type": "string",
              "enum": [
                "piano",
                "organ",
                "flute",
                "pluck",
                "strings",
                "percussion"
              ]
            },
            "lyrics": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "music"
          ]
        }
      },
      "brace": {
        "type": "boolean"
      },
      "window": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "integer",
            "minimum": 0
          },
          "to": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "from",
          "to"
        ]
      },
      "revealTo": {
        "type": "integer",
        "minimum": 0
      },
      "barsPerSystem": {
        "type": "integer",
        "minimum": 1,
        "maximum": 16
      },
      "highlightBars": {
        "type": "array",
        "maxItems": 32,
        "items": {
          "type": "integer",
          "minimum": 0
        }
      },
      "occlude": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "clef": {
            "type": "boolean"
          },
          "key": {
            "type": "boolean"
          },
          "meter": {
            "type": "boolean"
          }
        }
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "barNumbers": {
            "type": "boolean"
          },
          "noteNames": {
            "type": "boolean"
          },
          "partNames": {
            "type": "boolean"
          },
          "clef": {
            "type": "boolean"
          },
          "key": {
            "type": "boolean"
          },
          "meter": {
            "type": "boolean"
          }
        }
      },
      "sound": {
        "type": "boolean"
      },
      "select": {
        "type": "string",
        "enum": [
          "bars",
          "notes"
        ]
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "parts"
    ]
  },
  "examples": [
    {
      "params": {
        "key": "G",
        "meter": "4/4",
        "parts": [
          {
            "clef": "treble",
            "music": "G2 AB c2 d2 | e2 ed c2 B2- | B2 A3 G c2 | G6 z2 |]"
          }
        ],
        "show": {
          "noteNames": true
        }
      }
    },
    {
      "params": {
        "meter": "3/4",
        "parts": [
          {
            "clef": "treble",
            "music": "x6 | x6 | x6 | x6 |]"
          }
        ],
        "barsPerSystem": 4,
        "sound": false
      }
    },
    {
      "params": {
        "meter": "4/4",
        "unitLength": "1/4",
        "parts": [
          {
            "clef": "treble",
            "music": "C D E F | G G ? | E E F F | G4 |]"
          }
        ],
        "sound": false
      }
    },
    {
      "params": {
        "key": "F",
        "meter": "4/4",
        "parts": [
          {
            "name": "Bass",
            "clef": "bass",
            "music": "F,,2 A,,2 C,2 D,2 | _E,2 =E,2 F,2 A,,2 | _B,,2 D,2 F,2 =B,,2 | C,4 C,,4 |]"
          }
        ]
      }
    },
    {
      "params": {
        "header": "Over the hill",
