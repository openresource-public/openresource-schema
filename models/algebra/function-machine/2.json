{
  "ref": "algebra/function-machine@2",
  "family": "algebra",
  "name": "function-machine",
  "version": 2,
  "title": "Function machine",
  "responseModes": [
    "fill-derived"
  ],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "operations": {
        "type": "array",
        "minItems": 1,
        "maxItems": 4,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "type": "string",
              "enum": [
                "add",
                "subtract",
                "multiply",
                "divide",
                "square",
                "root"
              ]
            },
            "by": {
              "type": "number"
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "op"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "op": {
                    "enum": [
                      "add",
                      "subtract",
                      "multiply",
                      "divide"
                    ]
                  }
                },
                "required": [
                  "op"
                ]
              },
              "then": {
                "required": [
                  "by"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "op": {
                    "enum": [
                      "square",
                      "root"
                    ]
                  }
                },
                "required": [
                  "op"
                ]
              },
              "then": {
                "not": {
                  "required": [
                    "by"
                  ]
                }
              }
            },
            {
              "if": {
                "properties": {
                  "op": {
                    "const": "divide"
                  }
                },
                "required": [
                  "op"
                ]
              },
              "then": {
                "properties": {
                  "by": {
                    "not": {
                      "const": 0
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "value": {
            "type": "number"
          },
          "occlude": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          }
        }
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "value": {
            "type": "number"
          },
          "occlude": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          }
        }
      },
      "running": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "after": {
              "type": "integer",
              "minimum": 1
            },
            "show": {
              "type": "boolean"
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "after"
          ]
        }
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "runningValues": {
            "type": "boolean"
          },
          "equation": {
            "type": "boolean"
          }
        }
      },
      "variable": {
        "type": "string",
        "pattern": "^[a-z]$"
      },
      "draggable": {
        "type": "boolean"
      },
      "inputRange": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 2,
        "maxItems": 2
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "operations"
    ],
    "allOf": [
      {
        "not": {
          "allOf": [
            {
              "required": [
                "input"
              ],
              "properties": {
                "input": {
                  "required": [
                    "value"
                  ]
                }
              }
            },
            {
              "required": [
                "output"
              ],
              "properties": {
                "output": {
                  "required": [
                    "value"
                  ]
                }
              }
            },
            {
              "not": {
                "properties": {
                  "operations": {
                    "contains": {
                      "required": [
                        "occlude"
                      ],
                      "properties": {
                        "occlude": {
                          "const": true
                        }
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    ]
  },
  "examples": [
    {
      "params": {
        "header": "Function machine",
        "operations": [
          {
            "op": "multiply",
            "by": 3
          },
          {
            "op": "add",
            "by": 2
          }
        ],
        "input": {
          "value": 5
        },
        "show": {
          "runningValues": true
        },
        "caption": "Apply each operation in turn: 5 → 15 → 17"
      }
    },
    {
      "params": {
        "operations": [
          {
            "op": "multiply",
            "by": 2
          },
          {
            "op": "subtract",
            "by": 3
          }
        ]
      }
    },
    {
      "params": {
        "operations": [
          {
            "op": "divide",
            "by": 2
          },
          {
            "op": "add",
            "by": 5
          }
        ],
        "input": {
          "value": 8
        },
        "output": {
          "occlude": true
        }
      }
    },
    {
      "params": {
        "operations": [
          {
            "op": "multiply",
            "by": 4
          },
          {
            "op": "add",
            "by": 3
          }
        ],
        "output": {
          "value": 31
        },
        "input": {
          "occlude": true,
          "highlight": true
        }
      }
    },
    {
      "params": {
        "operations": [
          {
            "op": "multiply",
            "by": 3
          },
          {
            "op": "add",
            "by": 1
          }
        ],
        "output": {
          "value": 16
        },
        "input": {
          "occlude": true
        },
        "show": {
          "equation": true
        },
        "variable": "x",
        "caption": "Set up and solve the equation"
      }
    },
    {
      "params": {
        "operations": [
          {
            "op": "add",
            "by": 1
          },
          {
            "op": "square"
          }
        ],
        "input": {
          "value": 4
        },
        "show": {
          "runningValues": true
        },
        "caption": "Squaring is the last operation: 4 → 5 → 25"
      }
    },
    {
      "params": {
        "operations": [
          {
            "op": "multiply",
            "by": 4
          },
          {
            "op": "add",
            "by": 10,
            "occlude": true
          }
        ],
        "input": {
          "value": 5
        },
        "output": {
          "value": 30
        },
        "running": [
          {
            "after": 1,
            "show": true
          }
        ]
      }
    },
    {
      "params": {
        "operations": [
          {
            "op": "add",
            "by": 7
          },
          {
            "op": "multiply",
            "by": 3,
            "occlude": true
          }
        ],
        "input": {
          "value": 8
        },
        "output": {
          "value": 45
        }
      }
    },
    {
      "params": {
        "operations": [
          {
            "op": "multiply",
            "by": 4,
            "occlude": true
          },
          {
            "op": "subtract",
            "by": 3
          }
        ],
        "input": {
          "value": 6
        },
        "output": {
          "value": 21
        }
      }
    }
  ]
}
