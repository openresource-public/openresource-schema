{
  "ref": "algebra/graph-table@2",
  "family": "algebra",
  "name": "graph-table",
  "version": 2,
  "title": "Table of values & graph",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "fn": {
        "type": "string"
      },
      "columns": {
        "type": "array",
        "minItems": 2,
        "maxItems": 10,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "number"
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "x"
          ]
        }
      },
      "differences": {
        "type": "integer",
        "enum": [
          0,
          1,
          2
        ]
      },
      "dataFrom": {
        "type": "string",
        "enum": [
          "table",
          "graph"
        ]
      },
      "plot": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "show": {
            "type": "boolean"
          },
          "points": {
            "type": "boolean"
          },
          "connect": {
            "type": "string",
            "enum": [
              "none",
              "segments",
              "curve"
            ]
          },
          "gridLines": {
            "type": "boolean"
          }
        }
      },
      "axes": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "x": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "y": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "xStep": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "yStep": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      },
      "fnLabel": {
        "type": "string"
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "fn",
      "columns"
    ]
  },
  "examples": [
    {
      "params": {
        "fn": "x^2",
        "columns": [
          {
            "x": -2
          },
          {
            "x": -1
          },
          {
            "x": 0
          },
          {
            "x": 1
          },
          {
            "x": 2
          }
        ],
        "fnLabel": "y = x²",
        "plot": {
          "points": false
        }
      }
    },
    {
      "params": {
        "fn": "x^2 - 4",
        "columns": [
          {
            "x": -3
          },
          {
            "x": -2
          },
          {
            "x": -1
          },
          {
            "x": 0
          },
          {
            "x": 1
          },
          {
            "x": 2
          },
          {
            "x": 3
          }
        ],
        "fnLabel": "y = x² − 4",
        "plot": {
          "connect": "curve"
        },
        "caption": "Every value in the table is a point on the curve."
      }
    },
    {
      "params": {
        "fn": "x^2 - 1",
        "columns": [
          {
            "x": -3
          },
          {
            "x": -2,
            "occlude": true
          },
          {
            "x": -1
          },
          {
            "x": 0
          },
          {
            "x": 1
          },
          {
            "x": 2,
            "occlude": true
          },
          {
            "x": 3
          }
        ],
        "fnLabel": "y = x² − 1",
        "plot": {
          "points": false
        }
      }
    },
    {
      "params": {
        "fn": "x^2 + 2x - 1",
        "columns": [
          {
            "x": -4
          },
          {
            "x": -3
          },
          {
            "x": -2
          },
          {
            "x": -1
          },
          {
            "x": 0
          },
          {
            "x": 1,
            "highlight": true
          },
          {
            "x": 2
          }
        ],
        "differences": 2,
        "fnLabel": "y = x² + 2x − 1",
        "plot": {
          "connect": "curve"
        },
        "caption": "The second differences are constant (2), so this is a quadratic."
      }
    },
    {
      "params": {
        "fn": "2x - 1",
        "columns": [
          {
            "x": -1,
            "occlude": true
          },
          {
            "x": 0,
            "occlude": true
          },
          {
            "x": 1,
            "occlude": true
          },
          {
            "x": 2,
            "occlude": true
          },
          {
            "x": 3,
            "occlude": true
          }
        ],
        "dataFrom": "graph",
        "fnLabel": "y = 2x − 1",
        "plot": {
          "connect": "segments"
        }
      }
    },
    {
      "params": {
        "fn": "3x + 2",
        "columns": [
          {
            "x": -2
          },
          {
            "x": -1
          },
          {
            "x": 0
          },
          {
            "x": 1
          },
          {
            "x": 2
          },
          {
            "x": 3
          }
        ],
        "differences": 1,
        "fnLabel": "y = 3x + 2",
        "plot": {
          "connect": "segments"
        },
        "caption": "The first differences are all the same, so the graph is a straight line."
      }
    }
  ]
}
