    {
      "params": {
        "header": "Completing the square: x² + 6x",
        "mode": "rectangle",
        "factors": {
          "top": [
            {
              "coeff": 1,
              "x": true
            },
            {
              "coeff": 3
            }
          ],
          "side": [
            {
              "coeff": 1,
              "x": true
            },
            {
              "coeff": 3
            }
          ]
        },
        "show": {
          "collected": true,
          "factorLabels": true
        },
        "highlight": "result"
      }
    }
  ]
}
