{
  "ref": "algebra/algebra-tiles@1",
  "family": "algebra",
  "name": "algebra-tiles",
  "version": 1,
  "title": "Algebra tiles",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "mode": {
        "type": "string",
        "enum": [
          "collection",
          "rectangle"
        ]
      },
      "tiles": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "x2",
                "x",
                "unit"
              ]
            },
            "sign": {
              "type": "string",
              "enum": [
                "positive",
                "negative"
              ]
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "highlight": {
              "type": "boolean"
            },
            "hidden": {
              "type": "boolean"
            },
            "arrange": {
              "type": "string",
              "enum": [
                "row",
                "stack",
                "grid"
              ]
            },
            "perRow": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "joined": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "count"
          ]
        }
      },
      "factors": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "top": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "coeff": {
                  "type": "integer",
                  "minimum": -12,
                  "maximum": 12
                },
                "x": {
                  "type": "boolean"
                }
              },
              "required": [
                "coeff"
              ],
              "allOf": [
                {
                  "properties": {
                    "coeff": {
                      "not": {
                        "const": 0
                      }
                    }
                  }
                }
              ]
            }
          },
          "side": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "coeff": {
                  "type": "integer",
                  "minimum": -12,
                  "maximum": 12
                },
                "x": {
                  "type": "boolean"
                }
              },
              "required": [
                "coeff"
              ],
              "allOf": [
                {
                  "properties": {
                    "coeff": {
                      "not": {
                        "const": 0
                      }
                    }
                  }
                }
              ]
            }
          }
        },
        "required": [
          "top",
          "side"
        ]
      },
      "tileStyle": {
        "type": "string",
        "enum": [
          "abstract",
          "classroom"
        ]
      },
      "columns": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          }
        }
      },
      "mat": {
        "type": "string",
        "enum": [
          "none",
          "axes"
        ]
      },
      "regions": {
        "type": "array",
        "maxItems": 9,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "top": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            "side": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            "show": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "top",
            "side",
            "show"
          ]
        }
      },
      "occlude": {
        "type": "string",
        "enum": [
          "none",
          "result",
          "factors"
        ]
      },
      "groups": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tile": {
              "type": "integer",
              "minimum": 0
            },
            "label": {
              "type": "string"
            }
          },
          "required": [
            "tile",
            "label"
          ]
        }
      },
      "reveal": {
        "type": "integer",
        "minimum": 0
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "collected": {
            "type": "boolean"
          },
          "zeroPairs": {
            "type": "boolean"
          },
          "factorLabels": {
            "type": "boolean"
          },
          "grid": {
            "type": "boolean"
          },
          "tileLabels": {
            "type": "boolean"
          }
        }
      },
      "highlight": {
        "type": "string",
        "enum": [
          "none",
          "result",
          "zero-pairs"
        ]
      },
      "header": {
        "type": "string"
      }
    }
  },
  "examples": [
    {
      "params": {
        "mode": "collection",
        "tiles": [
          {
            "type": "x2",
            "sign": "positive",
            "count": 2
          },
          {
            "type": "x",
            "sign": "positive",
            "count": 3
          },
          {
            "type": "unit",
            "sign": "negative",
            "count": 1
          }
        ],
        "groups": [
          {
            "tile": 0,
            "label": "x² tiles"
          },
          {
            "tile": 1,
            "label": "x tiles"
          },
          {
            "tile": 2,
            "label": "units"
          }
        ],
        "show": {
          "collected": true
        }
      }
    },
    {
      "params": {
        "header": "Cancel the zero pairs",
        "mode": "collection",
        "tiles": [
          {
            "type": "x",
            "sign": "positive",
            "count": 3
          },
          {
            "type": "x",
            "sign": "negative",
            "count": 1
          },
          {
            "type": "unit",
            "sign": "positive",
            "count": 2
          }
        ],
        "show": {
          "collected": true,
          "zeroPairs": true
        },
        "highlight": "zero-pairs"
      }
    },
    {
      "params": {
        "mode": "collection",
        "tiles": [
          {
            "type": "x2",
            "sign": "positive",
            "count": 1
          },
          {
            "type": "x",
            "sign": "positive",
            "count": 2
          },
          {
            "type": "unit",
            "sign": "negative",
            "count": 3
          }
        ],
        "occlude": "result"
      }
    },
    {
      "params": {
        "mode": "rectangle",
        "factors": {
          "top": [
            {
              "coeff": 1,
              "x": true
            },
            {
              "coeff": 3
            }
          ],
          "side": [
            {
              "coeff": 1,
              "x": true
            },
            {
              "coeff": 2
            }
          ]
        },
        "show": {
          "collected": true,
          "factorLabels": true
        }
      }
    },
    {
      "params": {
        "mode": "rectangle",
        "factors": {
          "top": [
            {
              "coeff": 1,
              "x": true
            },
            {
              "coeff": -3
            }
          ],
          "side": [
            {
              "coeff": 1,
              "x": true
            },
            {
              "coeff": 2
            }
          ]
        },
        "occlude": "factors",
        "show": {
          "collected": true
        }
      }
    },
    {
      "params": {
        "mode": "rectangle",
        "tileStyle": "classroom",
        "mat": "axes",
        "factors": {
          "top": [
            {
              "coeff": -3
            },
            {
              "coeff": 1,
              "x": true
            }
          ],
          "side": [
            {
              "coeff": 1,
