{
  "ref": "algebra/iteration-cobweb@1",
  "family": "algebra",
  "name": "iteration-cobweb",
  "version": 1,
  "title": "Iteration (staircase / cobweb) diagram",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "fn": {
        "type": "string"
      },
      "start": {
        "type": "number"
      },
      "iterations": {
        "type": "integer",
        "minimum": 0,
        "maximum": 12
      },
      "axes": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "x": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "y": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "xStep": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "yStep": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "equalAspect": {
            "type": "boolean"
          }
        }
      },
      "functionLabel": {
        "type": "string"
      },
      "fixedPoint": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "show": {
            "type": "boolean"
          },
          "label": {
            "type": "string"
          },
          "occlude": {
            "type": "boolean"
          }
        }
      },
      "iterateLabels": {
        "type": "boolean"
      },
      "values": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "show": {
            "type": "boolean"
          },
          "decimals": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          },
          "occlude": {
            "type": "boolean"
          }
        }
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "line": {
            "type": "boolean"
          },
          "grid": {
            "type": "boolean"
          },
          "arrows": {
            "type": "boolean"
          }
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      },
      "draggable": {
        "type": "boolean"
      }
    },
    "required": [
      "fn",
      "start"
    ]
  },
  "examples": [
    {
      "params": {
        "header": "Iteration x = √(x + 2)",
        "fn": "(x+2)^0.5",
        "start": 0,
        "iterations": 4,
        "axes": {
          "x": [
            0,
            3
          ],
          "y": [
            0,
            3
          ]
        },
        "functionLabel": "y = √(x + 2)",
        "fixedPoint": {
          "show": true,
          "label": "α"
        },
        "values": {
          "show": true,
          "decimals": 3
        },
        "caption": "The staircase climbs to the fixed point α = 2"
      }
    },
    {
      "params": {
        "fn": "(x+2)^0.5",
        "start": 0,
        "iterations": 0,
        "axes": {
          "x": [
            0,
            3
          ],
          "y": [
            0,
            3
          ]
        },
        "functionLabel": "y = √(x + 2)"
      }
    },
    {
      "params": {
        "fn": "(x+2)^0.5",
        "start": 0,
        "iterations": 4,
        "axes": {
          "x": [
            0,
            3
          ],
          "y": [
            0,
            3
          ]
        },
        "functionLabel": "y = √(x + 2)",
        "values": {
          "show": true,
          "decimals": 3,
          "occlude": true
        }
      }
    },
    {
      "params": {
        "header": "Iteration x = 3 − x/2",
        "fn": "3-x/2",
        "start": 3.6,
        "iterations": 6,
        "axes": {
          "x": [
            0,
            4
          ],
          "y": [
            0,
            4
          ]
        },
        "functionLabel": "y = 3 − x/2",
        "fixedPoint": {
          "show": true,
          "label": "α"
        },
        "caption": "A cobweb that spirals in to α = 2"
      }
    },
    {
      "params": {
        "header": "Iteration x = 1.5x − 1",
        "fn": "1.5x-1",
        "start": 2.4,
        "iterations": 4,
        "axes": {
          "x": [
            0,
            8
          ],
          "y": [
            0,
            8
          ]
        },
        "functionLabel": "y = 1.5x − 1",
        "fixedPoint": {
          "show": true,
          "label": "α"
        },
        "caption": "The staircase marches away from α = 2 — the iteration diverges"
      }
    },
    {
      "params": {
        "fn": "1/(x+1)",
        "start": 1.6,
        "iterations": 6,
        "axes": {
          "x": [
            0,
            2
          ],
          "y": [
            0,
            2
          ]
        },
        "functionLabel": "y = 1/(x + 1)",
        "fixedPoint": {
          "show": true,
          "label": "α"
        },
        "draggable": true
      }
    }
  ]
}
