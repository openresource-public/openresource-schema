{
  "ref": "algebra/number-pyramid@1",
  "family": "algebra",
  "name": "number-pyramid",
  "version": 1,
  "title": "Number pyramid",
  "responseModes": [
    "fill-derived"
  ],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "base": {
        "type": "array",
        "minItems": 2,
        "maxItems": 6,
        "items": {
          "type": [
            "string",
            "number"
          ]
        }
      },
      "operation": {
        "type": "string",
        "enum": [
          "add",
          "subtract"
        ]
      },
      "filledRows": {
        "type": "integer",
        "minimum": 0
      },
      "bricks": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "row": {
              "type": "integer",
              "minimum": 0
            },
            "pos": {
              "type": "integer",
              "minimum": 0
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            },
            "blank": {
              "type": "boolean"
            }
          },
          "required": [
            "row",
            "pos"
          ]
        }
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operators": {
            "type": "boolean"
          }
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "base"
    ]
  },
  "examples": [
    {
      "params": {
        "base": [
          3,
          5,
          2,
          4
        ],
        "show": {
          "operators": true
        },
        "bricks": [
          {
            "row": 3,
            "pos": 0,
            "highlight": true
          }
        ]
      }
    },
    {
      "params": {
        "base": [
          4,
          7,
          2,
          5
        ],
        "filledRows": 1
      }
    },
    {
      "params": {
        "base": [
          7,
          8,
          5,
          3
        ],
        "bricks": [
          {
            "row": 3,
            "pos": 0,
            "occlude": true,
            "highlight": true
          }
        ],
        "caption": "Work up the pyramid to find the top brick"
      }
    },
    {
      "params": {
        "base": [
          5,
          2,
          8
        ],
        "bricks": [
          {
            "row": 1,
            "pos": 0,
            "occlude": true
          },
          {
            "row": 1,
            "pos": 1,
            "occlude": true
          },
          {
            "row": 0,
            "pos": 1,
            "occlude": true,
            "highlight": true
          }
        ],
        "show": {
          "operators": true
        },
        "caption": "The top is 17. Work back down to find the missing brick."
      }
    },
    {
      "params": {
        "base": [
          "3x",
          "x - 2",
          "5",
          "2x"
        ],
        "show": {
          "operators": true
        },
        "bricks": [
          {
            "row": 3,
            "pos": 0,
            "highlight": true
          }
        ]
      }
    },
    {
      "params": {
        "header": "Difference pyramid (left − right)",
        "base": [
          12,
          3,
          8,
          2
        ],
        "operation": "subtract",
        "show": {
          "operators": true
        }
      }
    }
  ]
}
