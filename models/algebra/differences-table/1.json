{
  "ref": "algebra/differences-table@1",
  "family": "algebra",
  "name": "differences-table",
  "version": 1,
  "title": "Sequence differences table",
  "responseModes": [
    "fill-derived"
  ],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "sequence": {
        "type": "array",
        "minItems": 2,
        "maxItems": 8,
        "items": {
          "type": "integer"
        }
      },
      "cells": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "level": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "index": {
              "type": "integer",
              "minimum": 0
            },
            "occlude": {
              "type": "boolean"
            },
            "blank": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "level",
            "index"
          ]
        }
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "position": {
            "type": "boolean"
          },
          "differences": {
            "type": "boolean"
          },
          "differenceValues": {
            "type": "boolean"
          },
          "rowLabels": {
            "type": "boolean"
          },
          "brackets": {
            "type": "boolean"
          },
          "levels": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          }
        }
      },
      "type": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "show": {
            "type": "boolean"
          },
          "occlude": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          }
        }
      },
      "nthTerm": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "show": {
            "type": "boolean"
          },
          "occlude": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          },
          "working": {
            "type": "boolean"
          }
        }
      },
      "predict": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "terms": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9999
            }
          },
          "occlude": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          }
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "sequence"
    ]
  },
  "examples": [
    {
      "params": {
        "sequence": [
          4,
          7,
          12,
          19,
          28
        ],
        "show": {
          "position": true
        },
        "type": {
          "show": true
        },
        "nthTerm": {
          "show": true,
          "working": true
        }
      }
    },
    {
      "params": {
        "sequence": [
          5,
          8,
          11,
          14,
          17
        ],
        "show": {
          "position": true
        },
        "type": {
          "show": true
        },
        "nthTerm": {
          "show": true,
          "working": true
        },
        "caption": "A linear sequence: the 1st differences are constant."
      }
    },
    {
      "params": {
        "sequence": [
          2,
          6,
          12,
          20,
          30
        ],
        "show": {
          "position": true,
          "differenceValues": false
        },
        "nthTerm": {
          "show": true,
          "occlude": true
        }
      }
    },
    {
      "params": {
        "sequence": [
          3,
          9,
          19,
          33,
          51
        ],
        "show": {
          "position": true
        },
        "type": {
          "show": true
        },
        "nthTerm": {
          "show": true,
          "occlude": true
        }
      }
    },
    {
      "params": {
        "header": "A fractional leading coefficient",
        "sequence": [
          1,
          2,
          4,
          7,
          11
        ],
        "show": {
          "position": true
        },
        "type": {
          "show": true
        },
        "nthTerm": {
          "show": true,
          "working": true
        }
      }
    },
    {
      "params": {
        "header": "A cubic sequence",
        "sequence": [
          2,
          9,
          28,
          65,
          126
        ],
        "show": {
          "position": true
        },
        "type": {
          "show": true
        },
        "nthTerm": {
          "show": true,
          "working": true
        },
        "predict": {
          "terms": [
            10
          ]
        }
      }
    }
  ]
}
