{
  "ref": "algebra/area-model@1",
  "family": "algebra",
  "name": "area-model",
  "version": 1,
  "title": "Area model",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "$defs": {
      "term": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "coeff": {
            "type": "number"
          },
          "symbol": {
            "type": "string",
            "pattern": "^[a-z]$"
          },
          "power": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "surd": {
            "type": "integer",
            "minimum": 2
          },
          "occlude": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          }
        },
        "required": [
          "coeff"
        ],
        "allOf": [
          {
            "not": {
              "required": [
                "symbol",
                "surd"
              ]
            }
          },
          {
            "properties": {
              "coeff": {
                "not": {
                  "const": 0
                }
              }
            }
          }
        ]
      }
    },
    "properties": {
      "factors": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "top": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "$ref": "#/$defs/term"
            }
          },
          "side": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "$ref": "#/$defs/term"
            }
          }
        },
        "required": [
          "top",
          "side"
        ]
      },
      "cells": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "row": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "col": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "occlude": {
              "type": "boolean"
            },
            "blank": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "row",
            "col"
          ]
        }
      },
      "total": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expanded": {
            "type": "boolean"
          },
          "occlude": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          }
        }
      },
      "sizing": {
        "type": "string",
        "enum": [
          "proportional",
          "equal"
        ]
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cellValues": {
            "type": "boolean"
          },
          "calculations": {
            "type": "boolean"
          },
          "factorTotals": {
            "type": "boolean"
          }
        }
      },
      "header": {
        "type": "string"
      }
    },
    "required": [
      "factors"
    ]
  },
  "examples": [
    {
      "params": {
        "factors": {
          "top": [
            {
              "coeff": 30
            },
            {
              "coeff": 4
            }
          ],
          "side": [
            {
              "coeff": 20
            },
            {
              "coeff": 7
            }
          ]
        },
        "show": {
          "calculations": true,
          "factorTotals": true
        },
        "total": {
          "expanded": true
        }
      }
    },
    {
      "params": {
        "factors": {
          "top": [
            {
              "coeff": 4
            },
            {
              "coeff": 0.3
            }
          ],
          "side": [
            {
              "coeff": 2
            },
            {
              "coeff": 0.6
            }
          ]
        },
        "show": {
          "cellValues": false
        }
      }
    },
    {
      "params": {
        "factors": {
          "top": [
            {
              "coeff": 1,
              "symbol": "x"
            },
            {
              "coeff": 5
            }
          ],
          "side": [
            {
              "coeff": 1,
              "symbol": "x"
            },
            {
              "coeff": 2
            }
          ]
        },
        "cells": [
          {
            "row": 1,
            "col": 2,
            "occlude": true
          },
          {
            "row": 2,
            "col": 1,
            "occlude": true
          }
        ],
        "total": {
          "expanded": true,
          "occlude": true
        }
      }
    },
    {
      "params": {
        "factors": {
          "top": [
            {
              "coeff": 2,
              "symbol": "x"
            },
            {
              "coeff": -3
            }
          ],
          "side": [
            {
              "coeff": 1,
              "symbol": "x"
            },
            {
              "coeff": 4
            }
          ]
        },
        "cells": [
          {
            "row": 1,
            "col": 2,
            "highlight": true
          },
          {
            "row": 2,
            "col": 1,
            "highlight": true
          }
        ],
        "total": {
          "expanded": true
        }
      }
    },
    {
      "params": {
        "factors": {
          "top": [
            {
              "coeff": 2
            },
            {
              "coeff": -1,
              "surd": 3
            }
          ],
          "side": [
            {
              "coeff": 5
            },
            {
              "coeff": 1,
              "surd": 3
            }
          ]
        },
        "total": {
          "expanded": true
        }
      }
    },
    {
      "params": {
        "factors": {
          "top": [
            {
              "coeff": 1,
              "symbol": "x",
              "occlude": true
            },
            {
              "coeff": 6,
              "occlude": true
            }
          ],
          "side": [
            {
              "coeff": 1,
              "symbol": "x",
              "occlude": true
            },
            {
              "coeff": 2,
              "occlude": true
            }
          ]
        },
        "total": {
          "expanded": false
        }
      }
    }
  ]
}
