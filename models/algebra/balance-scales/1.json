{
  "ref": "algebra/balance-scales@1",
  "family": "algebra",
  "name": "balance-scales",
  "version": 1,
  "title": "Balance scales (equations)",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "equation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "left": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "boxes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8
              },
              "units": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "right": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "boxes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8
              },
              "units": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "required": [
          "left",
          "right"
        ]
      },
      "unknown": {
        "type": "string",
        "pattern": "^[a-z]$"
      },
      "operation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "remove",
              "group"
            ]
          },
          "boxes": {
            "type": "integer",
            "minimum": 0
          },
          "units": {
            "type": "integer",
            "minimum": 0
          },
          "groups": {
            "type": "integer",
            "minimum": 2
          }
        },
        "required": [
          "type"
        ]
      },
      "solution": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "occlude": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          }
        }
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "equation": {
            "type": "boolean"
          }
        }
      },
      "unitMode": {
        "type": "string",
        "enum": [
          "cubes",
          "weight"
        ]
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "equation"
    ]
  },
  "examples": [
    {
      "params": {
        "equation": {
          "left": {
            "boxes": 1,
            "units": 3
          },
          "right": {
            "boxes": 0,
            "units": 8
          }
        },
        "solution": {
          "highlight": true
        },
        "caption": "One box and 3 units balance 8 units"
      }
    },
    {
      "params": {
        "equation": {
          "left": {
            "boxes": 2,
            "units": 3
          },
          "right": {
            "boxes": 0,
            "units": 11
          }
        }
      }
    },
    {
      "params": {
        "equation": {
          "left": {
            "boxes": 3,
            "units": 2
          },
          "right": {
            "boxes": 0,
            "units": 14
          }
        },
        "solution": {
          "occlude": true
        }
      }
    },
    {
      "params": {
        "equation": {
          "left": {
            "boxes": 3,
            "units": 2
          },
          "right": {
            "boxes": 0,
            "units": 14
          }
        },
        "operation": {
          "type": "remove",
          "units": 2
        }
      }
    },
    {
      "params": {
        "equation": {
          "left": {
            "boxes": 3,
            "units": 0
          },
          "right": {
            "boxes": 0,
            "units": 12
          }
        },
        "operation": {
          "type": "group",
          "groups": 3
