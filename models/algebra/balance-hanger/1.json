{
  "ref": "algebra/balance-hanger@1",
  "family": "algebra",
  "name": "balance-hanger",
  "version": 1,
  "title": "Balance hanger",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "$defs": {
      "shape": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "string",
                "pattern": "^[a-z]$"
              }
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "circle",
              "square",
              "triangle",
              "pentagon"
            ]
          },
          "occlude": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          },
          "strike": {
            "type": "boolean"
          }
        },
        "required": [
          "label"
        ]
      }
    },
    "properties": {
      "left": {
        "type": "array",
        "minItems": 1,
        "maxItems": 12,
        "items": {
          "$ref": "#/$defs/shape"
        }
      },
      "right": {
        "type": "array",
        "minItems": 1,
        "maxItems": 12,
        "items": {
          "$ref": "#/$defs/shape"
        }
      },
      "tilt": {
        "type": "string",
        "enum": [
          "balanced",
          "tips-left",
          "tips-right"
        ]
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "equation": {
            "type": "boolean"
          }
        }
      },
      "solution": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "occlude": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          }
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "left",
      "right"
    ]
  },
  "examples": [
    {
      "params": {
        "left": [
          {
            "label": "m"
          },
          {
            "label": "m"
          }
        ],
        "right": [
          {
            "label": 10
          }
        ],
        "show": {
          "equation": true
        },
        "solution": {
          "highlight": true
        },
        "caption": "Two identical circles balance a 10 — so each circle is half of it."
