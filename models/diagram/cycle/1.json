{
  "ref": "diagram/cycle@1",
  "family": "diagram",
  "name": "cycle",
  "version": 1,
  "title": "Cycle",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "nodes": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "label": {
              "type": "string"
            },
            "image": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "url": {
                  "type": "string"
                },
                "alt": {
                  "type": "string"
                },
                "aspect": {
                  "type": "string",
                  "enum": [
                    "square",
                    "landscape",
                    "portrait"
                  ]
                }
              },
              "required": [
                "url"
              ]
            },
            "edgeLabel": {
              "type": "string"
            },
            "edgeColor": {
              "type": "string",
              "pattern": "^(?:accent|accent-[2-5]|ink|muted|scaffold|#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\(\\s*[0-9.,%\\s/]+\\)|[a-zA-Z]{3,20})$"
            },
            "occlude": {
              "type": "boolean"
            },
            "occludeImage": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            },
            "color": {
              "type": "string",
              "pattern": "^(?:accent|accent-[2-5]|ink|muted|scaffold|#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\(\\s*[0-9.,%\\s/]+\\)|[a-zA-Z]{3,20})$"
            }
          },
          "required": [
            "id",
            "label"
          ]
        }
      },
      "direction": {
        "type": "string",
        "enum": [
          "clockwise",
          "anticlockwise"
        ]
      },
      "closed": {
        "type": "boolean"
      },
      "start": {
        "type": [
          "string",
          "integer"
        ]
      },
      "reveal": {
        "type": "integer",
        "minimum": 0
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      },
      "colors": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "arrows": {
            "type": "string",
            "pattern": "^(?:accent|accent-[2-5]|ink|muted|scaffold|#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\(\\s*[0-9.,%\\s/]+\\)|[a-zA-Z]{3,20})$"
          },
          "nodes": {
            "type": "string",
            "pattern": "^(?:accent|accent-[2-5]|ink|muted|scaffold|#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\(\\s*[0-9.,%\\s/]+\\)|[a-zA-Z]{3,20})$"
          }
        }
      }
    },
    "required": [
      "nodes"
    ]
  },
