{
  "ref": "diagram/pyramid@1",
  "family": "diagram",
  "name": "pyramid",
  "version": 1,
  "title": "Pyramid (stacked tiers)",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "tiers": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "label": {
              "type": "string"
            },
            "value": {
              "type": "number"
            },
            "detail": {
              "type": "string"
            },
            "image": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "url": {
                  "type": "string"
                },
                "alt": {
                  "type": "string"
                },
                "aspect": {
                  "type": "string",
                  "enum": [
                    "square",
                    "landscape",
                    "portrait"
                  ]
                }
              },
              "required": [
                "url"
              ]
            },
            "occlude": {
              "type": "boolean"
            },
            "occludeValue": {
              "type": "boolean"
            },
            "occludeImage": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            },
            "color": {
              "type": "string",
              "pattern": "^(?:accent|accent-[2-5]|ink|muted|scaffold|#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\(\\s*[0-9.,%\\s/]+\\)|[a-zA-Z]{3,20})$"
            }
          },
          "required": [
            "id",
            "label"
          ]
        }
      },
      "scale": {
        "type": "string",
        "enum": [
          "equal",
          "proportional"
        ]
      },
      "invert": {
        "type": "boolean"
      },
      "unit": {
        "type": "string"
      },
      "showValues": {
        "type": "boolean"
      },
      "showPercent": {
        "type": "boolean"
      },
      "axis": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string"
          },
          "arrow": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ]
          }
        },
        "required": [
          "label"
        ]
      },
      "reveal": {
        "type": "integer",
        "minimum": 1
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      },
      "colors": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tiers": {
            "type": "string",
            "pattern": "^(?:accent|accent-[2-5]|ink|muted|scaffold|#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\(\\s*[0-9.,%\\s/]+\\)|[a-zA-Z]{3,20})$"
          },
          "outline": {
            "type": "string",
            "pattern": "^(?:accent|accent-[2-5]|ink|muted|scaffold|#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\(\\s*[0-9.,%\\s/]+\\)|[a-zA-Z]{3,20})$"
          }
        }
      }
    },
    "required": [
      "tiers"
    ]
  },
  "examples": [
