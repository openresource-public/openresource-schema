    {
      "params": {
        "header": "Prime number",
        "concept": {
          "label": "Prime number"
        },
        "quadrants": [
          {
            "heading": "Definition",
            "text": "A whole number greater than 1 with exactly two factors: 1 and itself."
          },
          {
            "heading": "Characteristics",
            "items": [
              "Greater than 1",
              "Exactly two factors",
              "Cannot be made by multiplying smaller whole numbers"
            ]
          },
          {
            "heading": "Examples",
            "items": [
              "2",
              "3",
              "5",
              "7",
              "11",
              "13"
            ]
          },
          {
            "heading": "Non-examples",
            "items": [
              "1 (only one factor)",
              "9 = 3 × 3",
              "15 = 3 × 5"
            ]
          }
        ]
      }
    },
