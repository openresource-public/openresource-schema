    {
      "params": {
        "concept": {
          "label": "Metaphor",
          "occlude": true
        },
        "quadrants": [
          {
            "heading": "Definition",
            "text": "A comparison that says one thing IS another, without using \"like\" or \"as\"."
          },
          {
            "heading": "Characteristics",
            "items": [
              "Figurative, not literal",
              "Direct comparison",
              "No \"like\" or \"as\""
            ]
          },
          {
            "heading": "Examples",
            "items": [
              "\"Time is a thief.\"",
              "\"The classroom was a zoo.\""
            ]
          },
          {
            "heading": "Non-examples",
            "items": [
              "\"As brave as a lion.\" (simile)",
              "\"The wind howled.\" (personification)"
            ]
          }
        ]
      }
    },
    {
      "params": {
        "header": "Photosynthesis",
        "concept": {
          "label": "Photosynthesis"
        },
        "quadrants": [
          {
            "heading": "Definition",
            "text": "The process by which green plants use light energy to convert carbon dioxide and water into glucose and oxygen, in the chloroplasts of their cells."
          },
          {
            "heading": "Word equation",
            "text": "carbon dioxide + water → glucose + oxygen (in the presence of light and chlorophyll)"
          },
          {
            "heading": "Needs",
            "items": [
              "Light energy from the sun",
              "Carbon dioxide from the air",
              "Water from the soil through the roots",
              "Chlorophyll in the chloroplasts"
            ]
          },
          {
            "heading": "Common mistakes",
            "items": [
              "Saying plants \"breathe in\" oxygen",
              "Forgetting it only happens in the light",
              "Confusing it with respiration"
            ]
          }
        ]
      }
    },
    {
      "params": {
        "header": "Vocabulary: enormous",
        "concept": {
          "label": "enormous"
        },
        "quadrants": [
          {
            "heading": "Definition",
            "text": "Extremely large in size or amount."
          },
          {
            "heading": "Use it in a sentence",
            "text": "The blue whale is an enormous animal — the largest that has ever lived."
          },
          {
            "heading": "Synonyms",
            "items": [
