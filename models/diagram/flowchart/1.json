{
  "ref": "diagram/flowchart@1",
  "family": "diagram",
  "name": "flowchart",
  "version": 1,
  "title": "Flowchart",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "nodes": {
        "type": "array",
        "minItems": 2,
        "maxItems": 14,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "kind": {
              "type": "string",
              "enum": [
                "start",
                "process",
                "decision",
                "io",
                "end"
              ]
            },
            "label": {
              "type": "string"
            },
            "image": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "url": {
                  "type": "string"
                },
                "alt": {
                  "type": "string"
                },
                "aspect": {
                  "type": "string",
                  "enum": [
                    "square",
                    "landscape",
                    "portrait"
                  ]
                }
              },
              "required": [
                "url"
              ]
            },
            "occlude": {
              "type": "boolean"
            },
            "occludeImage": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            },
            "color": {
              "type": "string",
              "pattern": "^(?:accent|accent-[2-5]|ink|muted|scaffold|#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\(\\s*[0-9.,%\\s/]+\\)|[a-zA-Z]{3,20})$"
            }
          },
          "required": [
            "id",
            "kind",
            "label"
          ]
        }
      },
      "edges": {
        "type": "array",
        "minItems": 1,
        "maxItems": 24,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "string"
            },
            "to": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "highlight": {
              "type": "boolean"
            },
            "color": {
              "type": "string",
              "pattern": "^(?:accent|accent-[2-5]|ink|muted|scaffold|#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\(\\s*[0-9.,%\\s/]+\\)|[a-zA-Z]{3,20})$"
            }
          },
          "required": [
            "from",
            "to"
          ]
        }
      },
      "direction": {
        "type": "string",
        "enum": [
          "down",
          "right"
        ]
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      },
      "colors": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "edges": {
            "type": "string",
            "pattern": "^(?:accent|accent-[2-5]|ink|muted|scaffold|#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\(\\s*[0-9.,%\\s/]+\\)|[a-zA-Z]{3,20})$"
          }
        }
      }
    },
    "required": [
      "nodes",
      "edges"
    ]
  },
  "examples": [
