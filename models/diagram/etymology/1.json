{
  "ref": "diagram/etymology@1",
  "family": "diagram",
  "name": "etymology",
  "version": 1,
  "title": "Etymology breakdown",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "word": {
        "type": "string"
      },
      "morphemes": {
        "type": "array",
        "minItems": 2,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string"
            },
            "meaning": {
              "type": "string"
            },
            "origin": {
              "type": "string"
            },
            "role": {
              "type": "string",
              "enum": [
                "prefix",
                "root",
                "suffix",
                "combining"
              ]
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            },
            "color": {
              "type": "string",
              "pattern": "^(?:accent|accent-[2-5]|ink|muted|scaffold|#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\(\\s*[0-9.,%\\s/]+\\)|[a-zA-Z]{3,20})$"
            }
          },
          "required": [
            "text"
          ]
        }
      },
      "showReconstruction": {
        "type": "boolean"
      },
      "header": {
        "type": "string"
      },
      "colors": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "morphemes": {
            "type": "string",
            "pattern": "^(?:accent|accent-[2-5]|ink|muted|scaffold|#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\(\\s*[0-9.,%\\s/]+\\)|[a-zA-Z]{3,20})$"
          },
          "word": {
            "type": "string",
            "pattern": "^(?:accent|accent-[2-5]|ink|muted|scaffold|#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\(\\s*[0-9.,%\\s/]+\\)|[a-zA-Z]{3,20})$"
          },
          "bracket": {
            "type": "string",
            "pattern": "^(?:accent|accent-[2-5]|ink|muted|scaffold|#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\(\\s*[0-9.,%\\s/]+\\)|[a-zA-Z]{3,20})$"
          }
        }
      }
    },
    "required": [
      "word",
      "morphemes"
    ]
  },
  "examples": [
    {
      "params": {
        "word": "unhelpful",
        "morphemes": [
          {
            "text": "un-",
            "role": "prefix"
          },
          {
            "text": "help",
            "role": "root"
          },
          {
            "text": "-ful",
            "role": "suffix"
          }
        ]
      }
    },
    {
      "params": {
        "word": "photosynthesis",
        "morphemes": [
          {
            "text": "photo-",
            "meaning": "light",
            "origin": "Greek",
            "role": "combining"
          },
          {
            "text": "synthesis",
            "meaning": "putting together",
            "origin": "Greek",
            "role": "root"
          }
        ],
        "showReconstruction": true
      }
    },
    {
      "params": {
        "word": "biology",
        "morphemes": [
          {
            "text": "bio-",
            "meaning": "life",
            "origin": "Greek",
            "role": "combining",
