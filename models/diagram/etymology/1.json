            "highlight": true
          },
          {
            "text": "-logy",
            "meaning": "the study of",
            "origin": "Greek",
            "role": "suffix"
          }
        ]
      }
    },
    {
      "params": {
        "word": "transportation",
        "morphemes": [
          {
            "text": "trans-",
            "meaning": "across",
            "origin": "Latin",
            "role": "prefix"
          },
          {
            "text": "port",
            "meaning": "carry",
            "origin": "Latin porto",
            "role": "root"
          },
          {
            "text": "-ation",
            "meaning": "the process of",
            "origin": "Latin",
            "role": "suffix"
          }
        ],
