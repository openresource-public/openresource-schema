            "origin": "Old English",
            "role": "root"
          },
          {
            "text": "-ish",
            "meaning": "having the quality of",
            "role": "suffix"
          },
          {
            "text": "-ness",
            "meaning": "the state of being",
            "role": "suffix"
          }
        ],
        "header": "Etymology: unselfishness"
      }
    },
    {
      "params": {
        "word": "geography",
        "morphemes": [
          {
            "text": "geo-",
            "meaning": "earth",
            "origin": "Greek",
            "role": "combining"
          },
          {
            "text": "-graphy",
            "meaning": "writing or describing"
          }
        ],
        "showReconstruction": true
      }
    },
    {
      "params": {
        "word": "rewrite",
        "morphemes": [
          {
            "text": "re-",
            "meaning": "again"
          },
          {
            "text": "write",
            "meaning": "put words down"
          }
        ],
        "showReconstruction": true
      }
    },
    {
      "params": {
        "word": "unhelpful",
        "header": "Colour-coded: un · help · ful",
        "colors": {
          "bracket": "muted"
        },
        "morphemes": [
          {
            "text": "un-",
            "meaning": "not",
            "role": "prefix",
            "color": "forestgreen"
          },
          {
            "text": "help",
            "meaning": "to assist",
            "role": "root",
            "color": "accent"
          },
          {
