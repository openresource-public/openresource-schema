            "label": "Rival empires"
          }
        ]
      }
    },
    {
      "params": {
        "header": "Food groups",
        "colors": {
          "spokes": "muted"
        },
        "center": {
          "label": "Healthy plate",
          "color": "darkgreen"
        },
        "branches": [
          {
            "id": "protein",
            "label": "Protein",
            "color": "#d6453c"
          },
          {
            "id": "carbs",
