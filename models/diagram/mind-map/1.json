        },
        "branches": [
          {
            "id": "b1",
            "label": "?",
            "occlude": true
          },
          {
            "id": "b2",
            "label": "?",
            "occlude": true
          },
          {
            "id": "b3",
            "label": "?",
            "occlude": true
          },
          {
            "id": "b4",
            "label": "?",
            "occlude": true
          }
        ]
      }
    },
    {
      "params": {
        "header": "Causes of World War One",
        "center": {
          "label": "Causes of WW1"
        },
        "branches": [
          {
            "id": "alliances",
