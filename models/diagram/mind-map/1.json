{
  "ref": "diagram/mind-map@1",
  "family": "diagram",
  "name": "mind-map",
  "version": 1,
  "title": "Mind map",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "$defs": {
      "image": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string"
          },
          "alt": {
            "type": "string"
          },
          "aspect": {
            "type": "string",
            "enum": [
              "square",
              "landscape",
              "portrait"
            ]
          }
        },
        "required": [
          "url"
        ]
      }
    },
    "properties": {
      "center": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string"
          },
          "image": {
            "$ref": "#/$defs/image"
          },
          "occlude": {
            "type": "boolean"
          },
          "occludeImage": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          },
          "color": {
            "type": "string",
            "pattern": "^(?:accent|accent-[2-5]|ink|muted|scaffold|#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\(\\s*[0-9.,%\\s/]+\\)|[a-zA-Z]{3,20})$"
          }
        },
        "required": [
          "label"
        ]
      },
      "branches": {
        "type": "array",
        "minItems": 1,
        "maxItems": 10,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "label": {
              "type": "string"
            },
            "image": {
              "$ref": "#/$defs/image"
            },
            "occlude": {
              "type": "boolean"
            },
            "occludeImage": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            },
            "color": {
              "type": "string",
              "pattern": "^(?:accent|accent-[2-5]|ink|muted|scaffold|#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\(\\s*[0-9.,%\\s/]+\\)|[a-zA-Z]{3,20})$"
            }
          },
          "required": [
            "id",
            "label"
          ]
        }
      },
      "reveal": {
        "type": "integer",
        "minimum": 0
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      },
      "colors": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "branches": {
            "type": "string",
            "pattern": "^(?:accent|accent-[2-5]|ink|muted|scaffold|#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\(\\s*[0-9.,%\\s/]+\\)|[a-zA-Z]{3,20})$"
          },
          "hub": {
            "type": "string",
            "pattern": "^(?:accent|accent-[2-5]|ink|muted|scaffold|#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\(\\s*[0-9.,%\\s/]+\\)|[a-zA-Z]{3,20})$"
          },
          "spokes": {
            "type": "string",
            "pattern": "^(?:accent|accent-[2-5]|ink|muted|scaffold|#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\(\\s*[0-9.,%\\s/]+\\)|[a-zA-Z]{3,20})$"
          }
        }
      }
    },
    "required": [
      "center",
      "branches"
    ]
  },
  "examples": [
    {
      "params": {
        "header": "Themes in the novel",
        "center": {
          "label": "Themes"
        },
        "branches": [
          {
            "id": "prejudice",
            "label": "Prejudice"
          },
          {
            "id": "innocence",
            "label": "Innocence"
          },
          {
            "id": "courage",
            "label": "Moral courage"
          },
          {
            "id": "family",
            "label": "Family"
          },
          {
            "id": "justice",
            "label": "Justice"
          },
          {
            "id": "growing-up",
            "label": "Growing up"
          }
        ]
      }
    },
    {
      "params": {
        "center": {
          "label": "Healthy diet"
        },
        "branches": [
