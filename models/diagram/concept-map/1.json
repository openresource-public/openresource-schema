{
  "ref": "diagram/concept-map@1",
  "family": "diagram",
  "name": "concept-map",
  "version": 1,
  "title": "Concept map",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "nodes": {
        "type": "array",
        "minItems": 2,
        "maxItems": 16,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "label": {
              "type": "string"
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            },
            "color": {
              "type": "string",
              "pattern": "^(?:accent|accent-[2-5]|ink|muted|scaffold|#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\(\\s*[0-9.,%\\s/]+\\)|[a-zA-Z]{3,20})$"
            }
          },
          "required": [
            "id",
            "label"
          ]
        }
      },
      "links": {
        "type": "array",
        "minItems": 1,
        "maxItems": 28,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "string"
            },
            "to": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            },
            "color": {
              "type": "string",
              "pattern": "^(?:accent|accent-[2-5]|ink|muted|scaffold|#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\(\\s*[0-9.,%\\s/]+\\)|[a-zA-Z]{3,20})$"
            }
          },
          "required": [
            "from",
            "to"
          ]
        }
      },
      "direction": {
        "type": "string",
        "enum": [
          "down",
          "right"
        ]
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      },
      "colors": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "links": {
            "type": "string",
            "pattern": "^(?:accent|accent-[2-5]|ink|muted|scaffold|#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\(\\s*[0-9.,%\\s/]+\\)|[a-zA-Z]{3,20})$"
          }
        }
      }
    },
    "required": [
      "nodes",
      "links"
    ]
  },
