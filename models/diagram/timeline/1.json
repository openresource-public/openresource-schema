{
  "ref": "diagram/timeline@1",
  "family": "diagram",
  "name": "timeline",
  "version": 1,
  "title": "Timeline",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "events": {
        "type": "array",
        "maxItems": 10,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "label": {
              "type": "string"
            },
            "date": {
              "type": "number"
            },
            "dateLabel": {
              "type": "string"
            },
            "detail": {
              "type": "string"
            },
            "image": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "url": {
                  "type": "string"
                },
                "alt": {
                  "type": "string"
                },
                "aspect": {
                  "type": "string",
                  "enum": [
                    "square",
                    "landscape",
                    "portrait"
                  ]
                }
              },
              "required": [
                "url"
              ]
            },
            "side": {
              "type": "string",
              "enum": [
                "above",
                "below"
              ]
            },
            "occlude": {
              "type": "boolean"
            },
            "occludeDate": {
              "type": "boolean"
            },
            "occludeImage": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            },
            "color": {
              "type": "string",
              "pattern": "^(?:accent|accent-[2-5]|ink|muted|scaffold|#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\(\\s*[0-9.,%\\s/]+\\)|[a-zA-Z]{3,20})$"
            }
          },
          "required": [
            "id",
            "label"
          ]
        }
      },
      "scale": {
        "type": "string",
        "enum": [
          "ordinal",
          "scaled"
        ]
      },
      "orientation": {
        "type": "string",
        "enum": [
          "horizontal",
          "vertical"
        ]
      },
      "periods": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "number"
            },
            "to": {
              "type": "number"
            },
            "label": {
              "type": "string"
            },
            "color": {
              "type": "string",
              "pattern": "^(?:accent|accent-[2-5]|ink|muted|scaffold|#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\(\\s*[0-9.,%\\s/]+\\)|[a-zA-Z]{3,20})$"
            }
          },
          "required": [
            "from",
            "to",
            "label"
          ]
        }
      },
      "colors": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "line": {
            "type": "string",
            "pattern": "^(?:accent|accent-[2-5]|ink|muted|scaffold|#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\(\\s*[0-9.,%\\s/]+\\)|[a-zA-Z]{3,20})$"
          },
          "markers": {
            "type": "string",
            "pattern": "^(?:accent|accent-[2-5]|ink|muted|scaffold|#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\(\\s*[0-9.,%\\s/]+\\)|[a-zA-Z]{3,20})$"
          },
          "cards": {
            "type": "string",
            "pattern": "^(?:accent|accent-[2-5]|ink|muted|scaffold|#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\(\\s*[0-9.,%\\s/]+\\)|[a-zA-Z]{3,20})$"
          }
        }
      },
      "reveal": {
        "type": "integer",
        "minimum": 0
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "events"
    ]
  },
  "examples": [
    {
      "params": {
        "header": "Pioneers of modern science",
        "scale": "scaled",
        "periods": [
          {
            "from": 1543,
            "to": 1700,
            "label": "The Scientific Revolution",
            "color": "accent-2"
          }
        ],
        "events": [
          {
            "id": "copernicus",
            "label": "Copernicus",
            "date": 1473,
            "detail": "Sun-centred model",
            "image": {
              "url": "https://upload.wikimedia.org/wikipedia/commons/thumb/f/f2/Nikolaus_Kopernikus.jpg/500px-Nikolaus_Kopernikus.jpg",
              "alt": "Portrait of Nicolaus Copernicus",
              "aspect": "portrait"
            }
          },
          {
            "id": "galileo",
            "label": "Galileo",
            "date": 1564,
            "detail": "Telescope, motion",
            "image": {
              "url": "https://upload.wikimedia.org/wikipedia/commons/thumb/c/c7/Justus_Sustermans_-_Portrait_of_Galileo_Galilei_%28Uffizi%29.jpg/500px-Justus_Sustermans_-_Portrait_of_Galileo_Galilei_%28Uffizi%29.jpg",
              "alt": "Portrait of Galileo Galilei",
              "aspect": "portrait"
            }
          },
          {
            "id": "newton",
            "label": "Newton",
            "date": 1643,
            "detail": "Laws of motion",
            "image": {
              "url": "https://upload.wikimedia.org/wikipedia/commons/thumb/3/3b/Portrait_of_Sir_Isaac_Newton%2C_1689.jpg/500px-Portrait_of_Sir_Isaac_Newton%2C_1689.jpg",
              "alt": "Portrait of Isaac Newton",
              "aspect": "portrait"
            }
          },
          {
            "id": "darwin",
            "label": "Darwin",
            "date": 1809,
            "detail": "Evolution",
            "image": {
              "url": "https://upload.wikimedia.org/wikipedia/commons/thumb/3/3c/Charles_Darwin_01.jpg/500px-Charles_Darwin_01.jpg",
              "alt": "Portrait of Charles Darwin",
              "aspect": "portrait"
            }
          },
          {
            "id": "curie",
            "label": "Curie",
            "date": 1867,
            "detail": "Radioactivity",
            "image": {
              "url": "https://upload.wikimedia.org/wikipedia/commons/thumb/9/93/Marie_Curie_1903.jpg/500px-Marie_Curie_1903.jpg",
              "alt": "Portrait of Marie Curie",
              "aspect": "portrait"
            }
          },
          {
            "id": "einstein",
            "label": "Einstein",
            "date": 1879,
            "detail": "Relativity",
            "image": {
              "url": "https://upload.wikimedia.org/wikipedia/commons/thumb/3/3d/Albert_Einstein_by_Mishkin%2C_1921.png/500px-Albert_Einstein_by_Mishkin%2C_1921.png",
              "alt": "Portrait of Albert Einstein",
              "aspect": "portrait"
            }
          }
        ]
      }
    },
    {
      "params": {
        "header": "Structure of a story",
        "events": [
          {
            "id": "opening",
            "label": "Opening",
            "detail": "Characters and setting introduced"
          },
          {
            "id": "buildup",
            "label": "Build-up",
            "detail": "Events lead towards a problem"
          },
          {
            "id": "climax",
            "label": "Climax",
            "detail": "The turning point"
          },
          {
            "id": "resolution",
            "label": "Resolution",
            "detail": "The problem is resolved"
          },
          {
            "id": "ending",
            "label": "Ending",
            "detail": "How things are left"
          }
        ]
      }
    },
    {
      "params": {
        "scale": "scaled",
        "events": [
          {
            "id": "sputnik",
            "label": "First satellite",
            "date": 1957
          },
          {
            "id": "gagarin",
            "label": "First person in space",
            "date": 1961
          },
          {
            "id": "moon",
            "label": "First Moon landing",
            "date": 1969,
            "occludeDate": true,
            "highlight": true
          },
          {
            "id": "shuttle",
            "label": "First Space Shuttle",
            "date": 1981
          }
        ]
      }
    },
    {
      "params": {
        "header": "Putting a plant's life cycle in order",
        "events": [
          {
            "id": "s1",
            "label": "?",
            "occlude": true
          },
          {
            "id": "s2",
