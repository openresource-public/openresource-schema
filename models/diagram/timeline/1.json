          }
        ]
      }
    },
    {
      "params": {
        "header": "The ancient world",
        "scale": "scaled",
        "periods": [
          {
            "from": -509,
            "to": 476,
            "label": "Ancient Rome",
            "color": "accent-4"
          }
        ],
        "events": [
          {
