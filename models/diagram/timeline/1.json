      }
    },
    {
      "params": {
        "header": "A day at school",
        "orientation": "vertical",
        "events": [
          {
            "id": "register",
            "label": "Registration",
            "detail": "8:50 am"
          },
          {
            "id": "lessons",
            "label": "Morning lessons",
            "detail": "9:00 am"
          },
          {
            "id": "break",
            "label": "Break",
            "detail": "10:30 am"
          },
          {
            "id": "lunch",
            "label": "Lunch",
            "detail": "12:30 pm"
          },
          {
