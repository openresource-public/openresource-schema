{
  "ref": "diagram/tree@1",
  "family": "diagram",
  "name": "tree",
  "version": 1,
  "title": "Tree (hierarchy)",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "nodes": {
        "type": "array",
        "minItems": 2,
        "maxItems": 16,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "parentId": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "image": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "url": {
                  "type": "string"
                },
                "alt": {
                  "type": "string"
                },
                "aspect": {
                  "type": "string",
                  "enum": [
                    "square",
                    "landscape",
                    "portrait"
                  ]
                }
              },
              "required": [
                "url"
              ]
            },
            "edgeLabel": {
              "type": "string"
            },
            "occlude": {
              "type": "boolean"
            },
            "occludeImage": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            },
            "color": {
              "type": "string",
              "pattern": "^(?:accent|accent-[2-5]|ink|muted|scaffold|#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\(\\s*[0-9.,%\\s/]+\\)|[a-zA-Z]{3,20})$"
            }
          },
          "required": [
            "id",
            "label"
          ]
        }
      },
      "reveal": {
        "type": "integer",
        "minimum": 1
      },
      "orientation": {
        "type": "string",
        "enum": [
          "down",
          "right"
        ]
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      },
      "colors": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "nodes": {
            "type": "string",
            "pattern": "^(?:accent|accent-[2-5]|ink|muted|scaffold|#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\(\\s*[0-9.,%\\s/]+\\)|[a-zA-Z]{3,20})$"
          },
          "connectors": {
            "type": "string",
            "pattern": "^(?:accent|accent-[2-5]|ink|muted|scaffold|#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\(\\s*[0-9.,%\\s/]+\\)|[a-zA-Z]{3,20})$"
          }
        }
      }
    },
    "required": [
      "nodes"
    ]
  },
