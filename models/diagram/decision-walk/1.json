{
  "ref": "diagram/decision-walk@1",
  "family": "diagram",
  "name": "decision-walk",
  "version": 1,
  "title": "Decision walk (branching scenario)",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "nodes": {
        "type": "array",
        "minItems": 2,
        "maxItems": 16,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "kind": {
              "type": "string",
              "enum": [
                "decision",
                "outcome"
              ]
            },
            "label": {
              "type": "string"
            },
            "detail": {
              "type": "string"
            },
            "options": {
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "to": {
                    "type": "string"
                  },
                  "occlude": {
                    "type": "boolean"
                  },
                  "highlight": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "label",
                  "to"
                ]
              }
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            },
            "color": {
              "type": "string",
              "pattern": "^(?:accent|accent-[2-5]|ink|muted|scaffold|#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\(\\s*[0-9.,%\\s/]+\\)|[a-zA-Z]{3,20})$"
            }
          },
          "required": [
            "id",
            "kind",
            "label"
          ]
        }
      },
      "start": {
        "type": "string"
      },
      "walk": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "direction": {
        "type": "string",
        "enum": [
          "down",
          "right"
        ]
      },
      "showBreadcrumb": {
        "type": "boolean"
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      },
      "colors": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "decisions": {
            "type": "string",
            "pattern": "^(?:accent|accent-[2-5]|ink|muted|scaffold|#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\(\\s*[0-9.,%\\s/]+\\)|[a-zA-Z]{3,20})$"
          },
          "outcomes": {
            "type": "string",
            "pattern": "^(?:accent|accent-[2-5]|ink|muted|scaffold|#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\(\\s*[0-9.,%\\s/]+\\)|[a-zA-Z]{3,20})$"
          },
          "options": {
            "type": "string",
            "pattern": "^(?:accent|accent-[2-5]|ink|muted|scaffold|#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\(\\s*[0-9.,%\\s/]+\\)|[a-zA-Z]{3,20})$"
          }
        }
      }
    },
    "required": [
      "nodes"
    ]
  },
  "examples": [
    {
      "params": {
        "header": "Which average should I use?",
        "walk": [
          "start",
          "spread",
          "out-median"
        ],
        "nodes": [
          {
            "id": "start",
            "kind": "decision",
            "label": "What kind of data is it?",
            "options": [
              {
                "label": "Numbers",
                "to": "spread"
              },
              {
                "label": "Categories (colours, types)",
                "to": "out-mode"
              }
            ]
          },
          {
            "id": "spread",
            "kind": "decision",
            "label": "Any outliers or a big skew?",
            "options": [
              {
                "label": "Yes, some extreme values",
                "to": "out-median"
              },
              {
                "label": "No, fairly even",
                "to": "out-mean"
              }
            ]
          },
          {
            "id": "out-mean",
            "kind": "outcome",
            "label": "Use the mean",
            "detail": "Uses every value — best when the data is even, with no extremes pulling it."
          },
          {
            "id": "out-median",
            "kind": "outcome",
            "label": "Use the median",
            "detail": "The middle value, resistant to outliers, so it represents a skewed set best."
          },
          {
            "id": "out-mode",
            "kind": "outcome",
            "label": "Use the mode",
            "detail": "The most common value — the only average that works for categories."
          }
        ]
      }
    },
    {
      "params": {
        "header": "Sort the quadrilateral",
        "nodes": [
          {
            "id": "q1",
            "kind": "decision",
            "label": "Are all four sides equal?",
            "options": [
              {
                "label": "Yes",
                "to": "q2"
              },
              {
                "label": "No",
                "to": "q3"
              }
            ]
          },
          {
            "id": "q2",
            "kind": "decision",
            "label": "Are all angles 90°?",
            "options": [
              {
                "label": "Yes",
                "to": "sq"
              },
              {
                "label": "No",
                "to": "rh"
              }
            ]
          },
          {
            "id": "q3",
            "kind": "decision",
            "label": "Is there a pair of parallel sides?",
            "options": [
              {
                "label": "Yes",
                "to": "tr"
              },
              {
                "label": "No",
                "to": "ki"
              }
            ]
          },
          {
            "id": "sq",
            "kind": "outcome",
            "label": "Square"
          },
          {
            "id": "rh",
            "kind": "outcome",
            "label": "Rhombus"
          },
          {
            "id": "tr",
            "kind": "outcome",
            "label": "Trapezium"
          },
          {
            "id": "ki",
            "kind": "outcome",
            "label": "Kite"
          }
        ]
      }
    },
    {
      "params": {
        "walk": [
          "start",
          "out-prime"
        ],
        "nodes": [
          {
            "id": "start",
            "kind": "decision",
            "label": "Does 1 divide it and nothing else below it (besides itself)?",
            "options": [
              {
                "label": "Only 1 and itself",
                "to": "out-prime"
              },
              {
                "label": "Other factors too",
                "to": "out-comp"
              }
            ]
          },
          {
            "id": "out-prime",
            "kind": "outcome",
            "label": "?",
            "detail": "Exactly two factors: one and the number itself.",
            "occlude": true
          },
          {
            "id": "out-comp",
            "kind": "outcome",
            "label": "Composite",
            "detail": "More than two factors."
          }
        ]
      }
    },
    {
      "params": {
        "header": "Choosing an average",
        "nodes": [
          {
            "id": "type",
            "kind": "decision",
            "label": "What type of data?",
            "options": [
              {
                "label": "Numerical, even",
                "to": "out-mean"
              },
              {
                "label": "Numerical, skewed or with outliers",
                "to": "out-median"
              },
              {
                "label": "Ordinal (ranked categories)",
                "to": "out-median"
              },
              {
                "label": "Nominal (named categories)",
                "to": "out-mode"
              }
            ]
          },
          {
            "id": "out-mean",
            "kind": "outcome",
            "label": "Mean",
            "detail": "Add every value and divide by how many there are; best for even numerical data because it uses all of it."
          },
          {
            "id": "out-median",
            "kind": "outcome",
            "label": "Median",
            "detail": "Order the values and take the middle one; it ignores how extreme the ends are, so outliers and skew do not distort it, and it still works for ranked categories."
          },
          {
            "id": "out-mode",
            "kind": "outcome",
            "label": "Mode",
            "detail": "The most frequent value; the only average that makes sense when the data are just names."
          }
        ]
      }
    },
    {
      "params": {
        "direction": "right",
        "header": "Solving a quadratic",
        "nodes": [
          {
            "id": "q",
            "kind": "decision",
            "label": "Does it factorise easily?",
            "options": [
              {
                "label": "Yes",
                "to": "fac"
              },
              {
                "label": "No",
                "to": "sq"
              }
            ]
          },
          {
            "id": "sq",
            "kind": "decision",
            "label": "Is a = 1 and b even?",
            "options": [
              {
                "label": "Yes",
                "to": "comp"
              },
              {
                "label": "No",
                "to": "form"
              }
            ]
          },
          {
            "id": "fac",
            "kind": "outcome",
            "label": "Factorise",
            "detail": "Find two brackets — quickest when it works."
          },
          {
            "id": "comp",
            "kind": "outcome",
            "label": "Complete the square",
            "detail": "Neat when a = 1 and b is even."
          },
          {
            "id": "form",
            "kind": "outcome",
            "label": "Use the formula",
            "detail": "Always works; reach for it when the others do not."
          }
        ]
      }
    },
    {
      "params": {
        "header": "Which average should I use?",
        "colors": {
          "outcomes": "forestgreen",
          "options": "muted"
        },
        "nodes": [
          {
            "id": "start",
            "kind": "decision",
            "label": "What kind of data is it?",
            "color": "#9b5de5",
            "options": [
              {
                "label": "Numbers",
                "to": "spread"
              },
              {
                "label": "Categories",
                "to": "out-mode"
              }
            ]
          },
          {
            "id": "spread",
            "kind": "decision",
            "label": "Any outliers or skew?",
            "options": [
              {
                "label": "Yes",
                "to": "out-median"
              },
              {
                "label": "No",
                "to": "out-mean"
              }
            ]
          },
          {
            "id": "out-mean",
            "kind": "outcome",
            "label": "Use the mean"
          },
          {
            "id": "out-median",
            "kind": "outcome",
            "label": "Use the median"
          },
          {
            "id": "out-mode",
            "kind": "outcome",
            "label": "Use the mode"
          }
        ]
      }
    }
  ]
}
