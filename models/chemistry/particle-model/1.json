{
  "ref": "chemistry/particle-model@1",
  "family": "chemistry",
  "name": "particle-model",
  "version": 1,
  "title": "Particle model (states of matter)",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "state": {
        "type": "string",
        "enum": [
          "solid",
          "liquid",
          "gas"
        ]
      },
      "substance": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "melt": {
            "type": "number"
          },
          "boil": {
            "type": "number"
          }
        },
        "required": [
          "melt",
          "boil"
        ]
      },
      "temperature": {
        "type": "number"
      },
      "count": {
        "type": "integer",
        "minimum": 3,
        "maximum": 60
      },
      "seed": {
        "type": "integer",
        "minimum": 0
      },
      "container": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "shape": {
            "type": "string",
            "enum": [
              "rectangle"
            ]
          },
          "aspect": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      },
      "occlude": {
        "type": "string",
        "enum": [
          "state"
        ]
      },
      "highlight": {
        "type": "boolean"
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "container": {
            "type": "boolean"
          },
          "stateName": {
            "type": "boolean"
          },
          "descriptors": {
            "type": "boolean"
          },
          "temperature": {
            "type": "boolean"
          }
        }
      },
      "header": {
        "type": "string"
      },
      "label": {
        "type": "string"
      }
    }
  },
  "examples": [
    {
      "params": {
        "state": "solid",
        "count": 25,
        "header": "A solid"
      }
    },
    {
      "params": {
        "state": "liquid",
        "count": 25,
        "seed": 4
      }
    },
    {
      "params": {
        "state": "gas",
        "count": 9,
        "seed": 7
      }
    },
    {
      "params": {
        "substance": {
          "name": "Water",
          "melt": 0,
          "boil": 100
        },
        "temperature": 120,
        "count": 9,
        "seed": 3
      }
    },
    {
      "params": {
        "state": "liquid",
        "count": 30,
        "seed": 11,
        "occlude": "state",
        "show": {
          "descriptors": false
        }
      }
    },
    {
      "params": {
        "substance": {
          "name": "Oxygen",
          "melt": -219,
          "boil": -183
        },
        "temperature": -230,
        "count": 16,
        "seed": 2,
        "highlight": true
      }
    }
  ]
}
