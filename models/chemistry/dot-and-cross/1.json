{
  "ref": "chemistry/dot-and-cross@1",
  "family": "chemistry",
  "name": "dot-and-cross",
  "version": 1,
  "title": "Dot-and-cross diagram (bonding)",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "formula"
    ],
    "properties": {
      "formula": {
        "type": "string",
        "pattern": "^(?:[A-Z][a-z]?[0-9]{0,2}){1,4}$"
      },
      "stage": {
        "type": "string",
        "enum": [
          "atoms",
          "transfer",
          "bonded"
        ]
      },
      "occlude": {
        "type": "string",
        "enum": [
          "bonding",
          "lone",
          "electrons",
          "charges",
          "bond-type",
          "formula",
          "symbols"
        ]
      },
      "highlight": {
        "type": "string",
        "enum": [
          "bonding",
          "lone",
          "charges"
        ]
      },
      "label": {
        "type": "string"
      },
      "header": {
        "type": "string"
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "formula": {
            "type": "boolean"
          },
          "bondType": {
            "type": "boolean"
          },
          "key": {
            "type": "boolean"
          },
          "charges": {
            "type": "boolean"
          },
          "brackets": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "examples": [
    {
      "params": {
        "formula": "H2O",
        "show": {
          "key": true
        },
        "header": "Water",
        "label": "Each hydrogen shares one pair with the oxygen"
      }
    },
    {
      "params": {
        "formula": "NaCl",
        "show": {
          "key": true
        },
        "header": "Sodium chloride",
        "label": "Sodium gives its outer electron to chlorine"
      }
    },
    {
      "params": {
        "formula": "MgO",
        "stage": "transfer",
        "header": "Magnesium oxide",
        "label": "Magnesium loses two electrons; oxygen gains two"
      }
    },
    {
      "params": {
        "formula": "NH3",
        "occlude": "bonding"
      }
    },
    {
      "params": {
        "formula": "MgCl2",
        "occlude": "electrons"
      }
    },
    {
      "params": {
        "formula": "CO2",
        "show": {
          "key": true
        },
        "highlight": "bonding",
        "header": "Carbon dioxide",
        "label": "Carbon shares two pairs with each oxygen"
      }
    }
  ]
}
