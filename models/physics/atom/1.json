{
  "ref": "physics/atom@1",
  "family": "physics",
  "name": "atom",
  "version": 1,
  "title": "Atom (shell model)",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "element": {
        "type": "string",
        "enum": [
          "H",
          "He",
          "Li",
          "Be",
          "B",
          "C",
          "N",
          "O",
          "F",
          "Ne",
          "Na",
          "Mg",
          "Al",
          "Si",
          "P",
          "S",
          "Cl",
          "Ar",
          "K",
          "Ca"
        ]
      },
      "z": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20
      },
      "mass": {
        "type": "integer",
        "minimum": 1
      },
      "charge": {
        "type": "integer",
        "minimum": -3,
        "maximum": 3
      },
      "fillShells": {
        "type": "integer",
        "minimum": 0
      },
      "occlude": {
        "type": "string",
        "enum": [
          "neutrons",
          "electrons",
          "protons",
          "config",
          "mass",
          "symbol"
        ]
      },
      "highlight": {
        "type": "boolean"
      },
      "label": {
        "type": "string"
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "nucleusCounts": {
            "type": "boolean"
          },
          "config": {
            "type": "boolean"
          },
          "charge": {
            "type": "boolean"
          },
          "shellCounts": {
            "type": "boolean"
          },
          "particles": {
            "type": "boolean"
          },
          "name": {
            "type": "boolean"
          },
          "notation": {
            "type": "boolean"
          }
        }
      },
      "header": {
        "type": "string"
      }
    },
    "anyOf": [
      {
        "required": [
          "element"
        ]
      },
      {
        "required": [
          "z"
        ]
      }
    ]
  },
  "examples": [
    {
      "params": {
        "element": "Na",
        "header": "Sodium atom",
        "label": "A neutral atom of sodium"
      }
    },
    {
      "params": {
        "element": "Cl",
        "highlight": true,
        "show": {
          "shellCounts": true
        },
        "label": "Chlorine has 7 electrons in its outer shell"
      }
    },
    {
      "params": {
        "element": "C",
        "occlude": "neutrons",
        "show": {
          "particles": true,
          "name": false
        }
      }
    },
    {
      "params": {
        "element": "C",
        "mass": 14,
        "show": {
          "particles": true
        },
        "label": "Carbon-14, an isotope of carbon"
      }
    },
    {
      "params": {
        "element": "Cl",
        "charge": -1,
        "highlight": true,
        "show": {
          "particles": true
        },
        "label": "A chloride ion has gained one electron"
      }
    },
    {
      "params": {
        "z": 12,
        "fillShells": 0,
        "occlude": "config",
        "show": {
          "name": false
        }
      }
    }
  ]
}
