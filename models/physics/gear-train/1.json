{
  "ref": "physics/gear-train@1",
  "family": "physics",
  "name": "gear-train",
  "version": 1,
  "title": "Gear train",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "gears": {
        "type": "array",
        "minItems": 1,
        "maxItems": 6,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "teeth": {
              "type": "integer",
              "minimum": 6,
              "maximum": 80
            },
            "label": {
              "type": "string"
            },
            "mesh": {
              "type": "string",
              "enum": [
                "meshed",
                "shaft"
              ]
            },
            "angle": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "occlude": {
              "type": "string",
              "enum": [
                "teeth",
                "turns",
                "direction"
              ]
            },
            "showDirection": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "teeth"
          ]
        }
      },
      "drive": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "direction": {
            "type": "string",
            "enum": [
              "clockwise",
              "anticlockwise"
            ]
          },
          "turns": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "rpm": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "teeth": {
            "type": "boolean"
          },
          "toothCounts": {
            "type": "boolean"
          },
          "directions": {
            "type": "boolean"
          },
          "turns": {
            "type": "boolean"
          },
          "ratio": {
            "type": "boolean"
          }
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      },
      "draggable": {
        "type": "boolean"
      },
      "animate": {
        "type": "string",
        "enum": [
          "run",
          "play"
        ]
      }
    },
    "required": [
      "gears"
    ]
  },
  "examples": [
    {
      "params": {
        "header": "A simple gear drive",
        "gears": [
          {
            "teeth": 12,
            "label": "A"
          },
          {
            "teeth": 30,
            "label": "B"
          }
        ],
        "drive": {
          "index": 0,
          "direction": "clockwise",
          "turns": 5
        },
        "show": {
          "directions": true,
          "turns": true,
          "ratio": true
        }
      }
    },
    {
      "params": {
        "gears": [
          {
            "teeth": 24,
            "label": "A"
          },
          {
            "teeth": 12,
            "label": "B"
          },
          {
            "teeth": 18,
            "label": "C"
          }
        ],
        "drive": {
          "index": 0,
          "direction": "clockwise"
        },
        "show": {
          "directions": false
        },
        "caption": "Gear A is turned clockwise."
      }
    },
    {
      "params": {
        "gears": [
          {
            "teeth": 15,
            "label": "A"
          },
          {
            "teeth": 24,
            "label": "B",
            "occlude": "turns",
            "highlight": true
          }
        ],
        "drive": {
          "index": 0,
          "direction": "anticlockwise",
          "turns": 8
        },
        "show": {
          "directions": true,
          "turns": true
        },
        "caption": "Gear A makes 8 complete turns."
      }
    },
    {
      "params": {
        "gears": [
          {
            "teeth": 20,
            "label": "A"
          },
          {
            "teeth": 8,
            "label": "B"
          },
          {
            "teeth": 40,
            "label": "C"
          }
        ],
        "drive": {
          "index": 0,
          "direction": "clockwise",
          "turns": 4
        },
        "show": {
          "directions": true,
          "turns": true,
          "ratio": true
        }
      }
    },
    {
      "params": {
        "header": "A compound gear train",
        "gears": [
          {
            "teeth": 12,
            "label": "A"
          },
          {
            "teeth": 36,
            "label": "B"
          },
          {
            "teeth": 20,
            "label": "C",
            "mesh": "shaft"
          },
          {
            "teeth": 40,
            "label": "D",
            "angle": -60
          }
        ],
        "drive": {
          "index": 0,
          "direction": "clockwise",
          "turns": 12
        },
        "show": {
          "directions": true,
          "turns": true,
          "ratio": true
        }
      }
    },
    {
      "params": {
        "header": "Watch the marked teeth",
        "gears": [
          {
            "teeth": 36,
            "label": "A"
          },
          {
            "teeth": 12,
            "label": "B"
          }
        ],
        "drive": {
          "index": 0,
          "direction": "clockwise"
        },
        "show": {
          "directions": true,
          "ratio": true
        },
        "animate": "play"
      }
    },
    {
      "params": {
        "gears": [
          {
            "teeth": 16,
            "label": "A"
          },
          {
            "teeth": 28,
            "label": "B"
          },
          {
            "teeth": 14,
            "label": "C"
          },
          {
            "teeth": 28,
            "label": "D",
            "occlude": "direction",
            "highlight": true
          }
        ],
        "drive": {
          "index": 0,
          "direction": "anticlockwise"
        },
        "show": {
          "directions": true
        }
      }
    }
  ]
}
