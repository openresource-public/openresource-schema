{
  "ref": "physics/circuit@1",
  "family": "physics",
  "name": "circuit",
  "version": 1,
  "title": "Circuit",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "$defs": {
      "component": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "type": {
            "type": "string",
            "enum": [
              "bulb",
              "resistor",
              "switch",
              "ammeter",
              "voltmeter"
            ]
          },
          "resistance": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "closed": {
            "type": "boolean"
          },
          "across": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "occlude": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          }
        },
        "required": [
          "type"
        ]
      }
    },
    "properties": {
      "cell": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "voltage": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "battery": {
            "type": "boolean"
          },
          "label": {
            "type": "string"
          },
          "occlude": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          }
        },
        "required": [
          "voltage"
        ]
      },
      "sections": {
        "type": "array",
        "minItems": 1,
        "maxItems": 6,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "component": {
              "$ref": "#/$defs/component"
            },
            "parallel": {
              "type": "array",
              "minItems": 2,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "components": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 4,
                    "items": {
                      "$ref": "#/$defs/component"
                    }
                  },
                  "label": {
                    "type": "string"
                  }
                },
                "required": [
                  "components"
                ]
              }
            }
          },
          "oneOf": [
            {
              "required": [
                "component"
              ],
              "not": {
                "required": [
                  "parallel"
                ]
              }
            },
            {
              "required": [
                "parallel"
              ],
              "not": {
                "required": [
                  "component"
                ]
              }
            }
          ]
        }
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "readings": {
            "type": "boolean"
          },
          "totals": {
            "type": "boolean"
          },
          "brightness": {
            "type": "boolean"
          },
          "current": {
            "type": "boolean"
          }
        }
      },
      "toggleable": {
        "type": "boolean"
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "cell",
      "sections"
    ]
  },
  "examples": [
    {
      "params": {
        "cell": {
          "voltage": 6,
          "label": "6 V"
        },
        "sections": [
          {
            "component": {
              "id": "l1",
              "type": "bulb",
              "resistance": 4,
              "label": "L₁"
            }
          },
          {
            "component": {
              "id": "l2",
              "type": "bulb",
              "resistance": 2,
              "label": "L₂"
            }
          }
        ],
        "show": {
          "readings": true,
          "totals": true,
          "brightness": true
        }
      }
    },
    {
      "params": {
        "cell": {
          "voltage": 12,
          "label": "12 V"
        },
        "sections": [
          {
            "component": {
              "type": "ammeter",
              "label": "A₁",
              "occlude": true
            }
          },
          {
            "component": {
              "id": "r1",
              "type": "resistor",
              "resistance": 8,
              "label": "R₁"
            }
          },
          {
            "component": {
              "id": "r2",
              "type": "resistor",
              "resistance": 4,
              "label": "R₂"
            }
          }
        ],
        "show": {
          "readings": true,
          "totals": false
        }
      }
    },
    {
      "params": {
        "cell": {
          "voltage": 9,
          "label": "9 V"
        },
        "sections": [
          {
            "component": {
              "id": "r1",
              "type": "resistor",
              "resistance": 2,
              "label": "R₁"
            }
          },
          {
            "component": {
              "id": "r2",
              "type": "resistor",
              "resistance": 1,
              "label": "R₂"
            }
          },
          {
            "component": {
              "type": "voltmeter",
              "across": "r2",
              "label": "V₁"
            }
          }
        ],
        "show": {
          "readings": true,
          "totals": true
        }
      }
    },
    {
      "params": {
        "cell": {
          "voltage": 6,
          "label": "6 V"
        },
        "sections": [
          {
            "parallel": [
              {
                "components": [
                  {
                    "id": "l1",
                    "type": "bulb",
                    "resistance": 3,
                    "label": "L₁"
                  }
                ]
              },
              {
                "components": [
                  {
                    "id": "l2",
                    "type": "bulb",
                    "resistance": 6,
                    "label": "L₂",
                    "occlude": true
                  }
                ]
              }
            ]
          }
        ],
        "show": {
          "readings": true,
          "brightness": true
        },
        "caption": "Remember: each branch of a parallel circuit gets the full supply pd"
      }
    },
    {
      "params": {
        "header": "The current divides",
        "cell": {
          "voltage": 6,
          "label": "6 V"
        },
        "sections": [
          {
            "component": {
              "type": "ammeter",
              "label": "A"
            }
          },
          {
            "parallel": [
              {
                "components": [
                  {
                    "type": "ammeter",
                    "label": "A₁"
                  },
                  {
                    "id": "r1",
                    "type": "resistor",
                    "resistance": 2,
                    "label": "R₁"
                  }
                ]
              },
              {
                "components": [
                  {
                    "type": "ammeter",
                    "label": "A₂"
                  },
                  {
                    "id": "r2",
                    "type": "resistor",
                    "resistance": 3,
                    "label": "R₂"
                  }
                ]
              }
            ]
          }
        ],
        "show": {
          "readings": true,
          "totals": true,
          "current": true
        }
      }
    },
    {
      "params": {
        "cell": {
          "voltage": 4,
          "battery": true,
          "label": "4 V"
        },
        "sections": [
          {
            "parallel": [
              {
                "components": [
                  {
                    "id": "l1",
                    "type": "bulb",
                    "resistance": 8,
                    "label": "L₁"
                  }
                ]
              },
              {
                "components": [
                  {
                    "type": "switch",
                    "closed": false,
                    "label": "S₁"
                  },
                  {
                    "id": "l2",
                    "type": "bulb",
                    "resistance": 8,
                    "label": "L₂"
                  }
                ]
              }
            ]
          }
        ],
        "show": {
          "readings": true,
          "brightness": true
        },
        "toggleable": true,
        "caption": "Click S₁ to close it"
      }
    }
  ]
}
