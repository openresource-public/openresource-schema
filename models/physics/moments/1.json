{
  "ref": "physics/moments@1",
  "family": "physics",
  "name": "moments",
  "version": 1,
  "title": "Moments (levers and see-saws)",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "weights": {
        "type": "array",
        "minItems": 1,
        "maxItems": 6,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "side": {
              "type": "string",
              "enum": [
                "left",
                "right"
              ]
            },
            "force": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "distance": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "label": {
              "type": "string"
            },
            "occlude": {
              "type": "string",
              "enum": [
                "force",
                "distance"
              ]
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "side",
            "force",
            "distance"
          ]
        }
      },
      "unit": {
        "type": "string"
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "distances": {
            "type": "boolean"
          },
          "moments": {
            "type": "boolean"
          },
          "totals": {
            "type": "boolean"
          },
          "verdict": {
            "type": "boolean"
          },
          "stem": {
            "type": "boolean"
          }
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      },
      "draggable": {
        "type": "boolean"
      }
    },
    "required": [
      "weights"
    ]
  },
  "examples": [
    {
      "params": {
        "header": "A balanced see-saw",
        "weights": [
          {
            "side": "left",
            "force": 6,
            "distance": 2,
            "label": "A"
          },
          {
            "side": "right",
            "force": 4,
            "distance": 3,
            "label": "B"
          }
        ],
        "unit": "m",
        "show": {
          "moments": true,
          "totals": true,
          "stem": true
        }
      }
    },
    {
      "params": {
        "weights": [
          {
            "side": "left",
            "force": 5,
            "distance": 3,
            "label": "A"
          },
          {
            "side": "right",
            "force": 5,
            "distance": 1.5,
            "label": "B"
          }
        ],
        "unit": "m",
        "show": {
          "moments": true,
          "totals": true
        }
      }
    },
    {
      "params": {
        "weights": [
          {
            "side": "left",
            "force": 8,
            "distance": 2.5,
            "label": "load"
          },
          {
            "side": "right",
            "force": 20,
            "distance": 1,
            "label": "effort"
          }
        ],
        "unit": "m"
      }
    },
    {
      "params": {
        "weights": [
          {
            "side": "left",
            "force": 30,
            "distance": 2,
            "label": "A"
          },
          {
            "side": "right",
            "force": 30,
            "distance": 2,
            "occlude": "force",
            "label": "B"
          }
        ],
        "unit": "m"
      }
    },
    {
      "params": {
        "weights": [
          {
            "side": "left",
            "force": 2,
            "distance": 3,
            "label": "A"
          },
          {
            "side": "left",
            "force": 4,
            "distance": 1,
            "label": "B"
          },
          {
            "side": "right",
            "force": 5,
            "distance": 2,
            "occlude": "distance",
            "label": "C"
          }
        ],
        "unit": "m",
        "show": {
          "moments": true,
          "totals": true
        }
      }
    },
    {
      "params": {
        "header": "Loosening a nut",
        "weights": [
          {
            "side": "left",
            "force": 200,
            "distance": 4,
            "label": "nut"
          },
          {
            "side": "right",
            "force": 40,
            "distance": 20,
            "label": "hand",
            "highlight": true
          }
        ],
        "unit": "cm",
        "show": {
          "moments": true,
          "totals": true,
          "stem": true
        }
      }
    }
  ]
}
