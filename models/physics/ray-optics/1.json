{
  "ref": "physics/ray-optics@1",
  "family": "physics",
  "name": "ray-optics",
  "version": 1,
  "title": "Ray diagrams (mirror & lens)",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "kind": {
        "type": "string",
        "enum": [
          "mirror",
          "lens"
        ]
      },
      "object": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "distance": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "distance",
          "height"
        ]
      },
      "focalLength": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "incident": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "angle": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 85
          },
          "fromTop": {
            "type": "boolean"
          }
        },
        "required": [
          "angle"
        ]
      },
      "occlude": {
        "type": "string",
        "enum": [
          "image",
          "reflected-ray"
        ]
      },
      "highlight": {
        "type": "boolean"
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "foci": {
            "type": "boolean"
          },
          "normal": {
            "type": "boolean"
          },
          "angles": {
            "type": "boolean"
          },
          "nature": {
            "type": "boolean"
          }
        }
      },
      "reveal": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rays": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "image": {
            "type": "boolean"
          },
          "incident": {
            "type": "boolean"
          },
          "normal": {
            "type": "boolean"
          },
          "reflected": {
            "type": "boolean"
          },
          "angles": {
            "type": "boolean"
          }
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      },
      "draggable": {
        "type": "boolean"
      }
    },
    "required": [
      "kind"
    ]
  },
  "examples": [
    {
      "params": {
        "kind": "mirror",
        "header": "Reflection in a plane mirror",
        "incident": {
          "angle": 50
        },
        "caption": "The angle of reflection equals the angle of incidence."
      }
    },
    {
      "params": {
        "kind": "mirror",
        "incident": {
          "angle": 35
        },
        "occlude": "reflected-ray"
      }
    },
    {
      "params": {
        "kind": "mirror",
        "object": {
          "distance": 3,
          "height": 2,
          "label": "O"
        },
        "caption": "The image is the same distance behind the mirror as the object is in front."
      }
    },
    {
      "params": {
        "kind": "lens",
        "header": "Image formed by a converging lens",
        "focalLength": 4,
        "object": {
          "distance": 12,
          "height": 3,
          "label": "O"
        },
        "caption": "The three principal rays meet where the image forms."
      }
    },
    {
      "params": {
        "kind": "lens",
        "focalLength": 4,
        "object": {
          "distance": 6,
          "height": 3
        },
        "occlude": "image"
      }
    },
    {
      "params": {
        "kind": "lens",
        "header": "Object inside the focal length",
        "focalLength": 6,
        "object": {
          "distance": 3.5,
          "height": 2
        },
        "highlight": true,
        "caption": "The rays diverge, so the image is found by extending them backwards."
      }
    }
  ]
}
