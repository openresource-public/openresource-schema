{
  "ref": "physics/wave-superposition@1",
  "family": "physics",
  "name": "wave-superposition",
  "version": 1,
  "title": "Wave superposition",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "waves": {
        "type": "array",
        "minItems": 1,
        "maxItems": 2,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "amplitude": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "wavelength": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "period": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "phase": {
              "type": "number"
            },
            "travelling": {
              "type": "string",
              "enum": [
                "right",
                "left"
              ]
            },
            "label": {
              "type": "string"
            }
          },
          "required": [
            "amplitude"
          ],
          "anyOf": [
            {
              "required": [
                "wavelength"
              ]
            },
            {
              "required": [
                "period"
              ]
            }
          ]
        }
      },
      "axis": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "variable": {
            "type": "string",
            "enum": [
              "position",
              "time"
            ]
          },
          "span": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "showTicks": {
            "type": "boolean"
          }
        }
      },
      "occlude": {
        "type": "string",
        "enum": [
          "sum"
        ]
      },
      "highlight": {
        "type": "string",
        "enum": [
          "sum",
          "nodes",
          "antinodes"
        ]
      },
      "reveal": {
        "type": "integer",
        "minimum": 0
      },
      "draggable": {
        "type": "boolean"
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "components": {
            "type": "boolean"
          },
          "sum": {
            "type": "boolean"
          },
          "grid": {
            "type": "boolean"
          },
          "phase": {
            "type": "boolean"
          },
          "pathDifference": {
            "type": "boolean"
          },
          "nodes": {
            "type": "boolean"
          },
          "axes": {
            "type": "boolean"
          }
        }
      },
      "caption": {
        "type": "string"
      },
      "header": {
        "type": "string"
      }
    },
    "required": [
      "waves"
    ]
  },
  "examples": [
    {
      "params": {
        "header": "Constructive interference",
        "waves": [
          {
            "amplitude": 1,
            "wavelength": 4,
            "phase": 0,
            "label": "Wave 1"
          },
          {
            "amplitude": 1,
            "wavelength": 4,
            "phase": 0,
            "label": "Wave 2"
          }
        ],
        "show": {
          "pathDifference": true
        }
      }
    },
    {
      "params": {
        "header": "Destructive interference",
        "waves": [
          {
            "amplitude": 1,
            "wavelength": 4,
            "phase": 0,
            "label": "Wave 1"
          },
          {
            "amplitude": 1,
            "wavelength": 4,
            "phase": 1,
            "label": "Wave 2"
          }
        ],
        "highlight": "sum",
        "show": {
          "pathDifference": true
        }
      }
    },
    {
      "params": {
        "waves": [
          {
            "amplitude": 1.2,
            "wavelength": 5,
            "phase": 0,
            "label": "Wave 1"
          },
          {
            "amplitude": 1.2,
            "wavelength": 5,
            "phase": 0.5,
            "label": "Wave 2"
          }
        ],
        "show": {
          "pathDifference": true
        },
        "caption": "Two waves a quarter of a cycle out of step."
      }
    },
    {
      "params": {
        "waves": [
          {
            "amplitude": 1,
            "wavelength": 6,
            "phase": 0
          },
          {
            "amplitude": 0.6,
            "wavelength": 6,
            "phase": 0.5
          }
        ],
        "occlude": "sum"
      }
    },
    {
      "params": {
        "header": "Standing wave",
        "waves": [
          {
            "amplitude": 1,
            "wavelength": 4,
            "phase": 0,
            "travelling": "right",
            "label": "Incident"
          },
          {
            "amplitude": 1,
            "wavelength": 4,
            "phase": 0,
            "travelling": "left",
            "label": "Reflected"
          }
        ],
        "highlight": "nodes",
        "show": {
          "nodes": true,
          "phase": false
        },
        "caption": "Where the two waves always cancel are the nodes; the points of biggest swing are the antinodes."
      }
    },
    {
      "params": {
        "header": "Change the phase difference",
        "waves": [
          {
            "amplitude": 1,
            "wavelength": 5,
            "phase": 0,
            "label": "Wave 1"
          },
          {
            "amplitude": 1,
            "wavelength": 5,
            "phase": 0.3,
            "label": "Wave 2"
          }
        ],
        "draggable": true
      }
    }
  ]
}
