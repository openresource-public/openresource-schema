{
  "ref": "physics/forces@1",
  "family": "physics",
  "name": "forces",
  "version": 1,
  "title": "Force diagram (free body)",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "scene": {
        "type": "string",
        "enum": [
          "box-on-ground",
          "hanging",
          "falling",
          "floating",
          "free"
        ]
      },
      "forces": {
        "type": "array",
        "minItems": 1,
        "maxItems": 6,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string"
            },
            "newtons": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "dir": {
              "type": "string",
              "enum": [
                "up",
                "down",
                "left",
                "right"
              ]
            },
            "bearing": {
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 360
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          },
          "required": [
            "dir"
          ],
          "allOf": [
            {
              "not": {
                "required": [
                  "dir",
                  "bearing"
                ]
              }
            }
          ]
        }
      },
      "resultant": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "occlude": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          }
        }
      },
      "balanceOne": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "resultant": {
            "type": "boolean"
          },
          "verdict": {
            "type": "boolean"
          },
          "values": {
            "type": "boolean"
          },
          "grid": {
            "type": "boolean"
          }
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      },
      "reveal": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "forces"
    ]
  },
  "examples": [
    {
      "params": {
        "scene": "box-on-ground",
        "header": "A box resting on the ground",
        "forces": [
          {
            "label": "Weight",
            "newtons": 500,
            "dir": "down"
          },
          {
            "label": "Normal contact force",
            "newtons": 500,
            "dir": "up"
          }
        ]
      }
    },
    {
      "params": {
        "scene": "free",
        "header": "A car accelerating",
        "forces": [
          {
            "label": "Driving force",
            "newtons": 800,
            "dir": "right"
          },
          {
            "label": "Air resistance",
            "newtons": 300,
            "dir": "left"
          },
          {
            "label": "Weight",
            "newtons": 1000,
            "dir": "down"
          },
          {
            "label": "Normal contact force",
            "newtons": 1000,
            "dir": "up"
          }
        ]
      }
    },
    {
      "params": {
        "scene": "free",
        "forces": [
          {
            "label": "Thrust",
            "newtons": 700,
            "dir": "right"
          },
          {
            "label": "Drag",
            "newtons": 250,
            "dir": "left"
          }
        ],
        "resultant": {
          "occlude": true
        }
      }
    },
    {
      "params": {
        "scene": "box-on-ground",
        "header": "The box moves at a steady speed",
        "forces": [
          {
            "label": "Push",
            "newtons": 40,
            "dir": "right"
          },
          {
            "label": "Friction",
            "dir": "left",
            "id": "friction"
          },
          {
            "label": "Weight",
            "newtons": 120,
            "dir": "down"
          },
          {
            "label": "Normal contact force",
            "newtons": 120,
            "dir": "up"
          }
        ],
        "balanceOne": "friction"
      }
    },
    {
      "params": {
        "scene": "free",
        "header": "Resultant of two perpendicular forces",
        "forces": [
          {
            "label": "Force A",
            "newtons": 3,
            "dir": "right"
          },
          {
            "label": "Force B",
            "newtons": 4,
            "dir": "down"
          }
        ],
        "show": {
          "grid": true
        }
      }
    },
    {
      "params": {
        "scene": "falling",
        "header": "At terminal velocity",
        "forces": [
          {
            "label": "Weight",
            "newtons": 700,
            "dir": "down"
          },
          {
            "label": "Air resistance",
            "newtons": 700,
            "dir": "up"
          }
        ],
        "caption": "The skydiver falls at a steady terminal velocity."
      }
    }
  ]
}
