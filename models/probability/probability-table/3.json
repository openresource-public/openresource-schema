{
  "ref": "probability/probability-table@3",
  "family": "probability",
  "name": "probability-table",
  "version": 3,
  "title": "Probability table",
  "responseModes": [
    "fill-derived"
  ],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "outcomes": {
        "type": "array",
        "minItems": 2,
        "maxItems": 8,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "p": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "string"
                }
              ]
            },
            "weight": {
              "type": "integer",
              "minimum": 1
            },
            "count": {
              "type": "number",
              "minimum": 0
            },
            "occlude": {
              "type": "boolean"
            },
            "occludeFrequency": {
              "type": "boolean"
            },
            "occludeCumulative": {
              "type": "boolean"
            },
            "symbol": {
              "type": "string"
            },
            "cumulativeSymbol": {
              "type": "string"
            },
            "highlight": {
              "type": "boolean"
            }
          }
        }
      },
      "trials": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "fromOutcome": {
            "type": "integer",
            "minimum": 1
          },
          "count": {
            "type": "number",
            "minimum": 0
          },
          "label": {
            "type": "string"
          }
        }
      },
      "display": {
        "type": "string",
        "enum": [
          "auto",
          "fraction",
          "fraction-each",
          "decimal",
          "percent"
        ]
      },
      "total": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "show": {
            "type": "boolean"
          },
          "occludeProbability": {
            "type": "boolean"
          },
          "occludeFrequency": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          }
        }
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "probability": {
            "type": "boolean"
          },
          "cumulative": {
            "type": "boolean"
          },
          "frequency": {
            "type": "boolean"
          }
        }
      },
      "probabilityLabel": {
        "type": "string"
      },
      "cumulativeLabel": {
        "type": "string"
      },
      "frequencyLabel": {
        "type": "string"
      },
      "totalLabel": {
        "type": "string"
      },
      "cornerLabel": {
        "type": "string"
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "outcomes"
    ]
  },
  "examples": [
    {
      "params": {
        "header": "A four-colour spinner",
        "cornerLabel": "Colour",
        "outcomes": [
          {
            "name": "Red",
            "p": 0.15
          },
          {
            "name": "Blue",
            "p": 0.25
          },
          {
            "name": "Yellow",
            "p": 0.4
          },
          {
            "name": "Green"
          }
        ],
        "caption": "The four probabilities add up to 1, so green is 1 − 0.8 = 0.2."
      }
    },
    {
      "params": {
        "header": "A biased spinner",
        "outcomes": [
          {
            "name": "A",
            "p": 0.5
          },
          {
            "name": "B",
            "p": 0.2
          },
          {
            "name": "C",
            "occlude": true,
            "highlight": true
          }
        ]
      }
    },
    {
      "params": {
        "header": "Counters in the ratio 5 : 4 : 3",
        "cornerLabel": "Colour",
        "display": "fraction",
        "outcomes": [
          {
            "name": "Red",
            "weight": 5
          },
          {
            "name": "Blue",
            "weight": 4
          },
          {
            "name": "Green",
            "weight": 3
          }
        ],
        "caption": "Each probability is that colour's share of the 12 equal parts."
      }
    },
    {
      "params": {
        "header": "Spinner spun 40 times",
        "cornerLabel": "Colour",
        "outcomes": [
          {
            "name": "Red",
            "count": 14,
            "occlude": true
          },
          {
            "name": "Blue",
            "count": 10,
            "occlude": true
          },
          {
            "name": "Green",
            "count": 16,
            "occlude": true
          }
        ]
      }
    },
    {
      "params": {
        "outcomes": [
          {
            "name": "Red",
            "p": 0.4
          },
          {
            "name": "Blue",
            "p": 0.25
          },
          {
            "name": "Green",
            "p": 0.35
          }
        ],
        "trials": {
          "fromOutcome": 1,
          "count": 40
        }
      }
    },
    {
      "params": {
        "header": "A biased four-sided spinner",
        "outcomes": [
          {
            "name": "1",
            "p": 0.4
          },
          {
            "name": "2",
            "weight": 1,
            "occlude": true,
            "occludeFrequency": true
          },
          {
            "name": "3",
            "weight": 1,
            "occlude": true,
            "occludeFrequency": true
          },
          {
            "name": "4",
            "weight": 2,
            "occlude": true,
            "occludeFrequency": true
          }
        ],
        "trials": {
          "n": 200
        },
        "caption": "P(2) = P(3) and P(4) = 2 × P(2). Complete the table for 200 spins."
      }
    },
    {
      "params": {
        "header": "A bag of counters",
        "cornerLabel": "Colour",
        "display": "fraction-each",
        "outcomes": [
          {
            "name": "Red",
            "p": "1/2"
          },
          {
            "name": "Blue",
            "p": "1/3"
          },
          {
            "name": "Green"
          }
        ],
        "caption": "Each probability keeps its own denominator: 1 − 1/2 − 1/3 = 1/6 for green."
      }
    },
    {
      "params": {
        "header": "A four-colour spinner",
        "cornerLabel": "Colour",
        "display": "fraction-each",
        "outcomes": [
          {
            "name": "Red",
            "p": "2/5"
          },
          {
            "name": "Yellow",
            "p": "1/4"
          },
          {
            "name": "Blue",
            "occlude": true,
            "highlight": true
          }
        ],
        "caption": "P(red) = 2/5 and P(yellow) = 1/4 — shown exactly. Work out P(blue)."
      }
    },
    {
      "params": {
        "header": "A discrete random variable",
        "cornerLabel": "x",
        "probabilityLabel": "P(X = x)",
        "display": "decimal",
        "total": {
          "show": false
        },
        "show": {
          "cumulative": true
        },
        "outcomes": [
          {
            "name": "1",
            "p": 0.1
          },
          {
            "name": "2",
            "p": 0.3
          },
          {
            "name": "3",
            "p": 0.4
          },
          {
            "name": "4",
            "p": 0.2
          }
        ],
        "caption": "Each F(x) is the running total: F(2) = 0.1 + 0.3 = 0.4, and F(4) = 1."
      }
    },
    {
      "params": {
        "header": "The probability function of X",
        "cornerLabel": "x",
        "probabilityLabel": "P(X = x)",
        "display": "decimal",
        "total": {
          "show": false
        },
        "outcomes": [
          {
            "name": "1",
            "p": 0.35
          },
          {
            "name": "2",
            "occlude": true,
            "symbol": "a",
            "highlight": true
          },
          {
            "name": "3",
            "p": 0.15
          },
          {
            "name": "4",
            "p": 0.3
          }
        ],
        "caption": "The probabilities sum to 1. Find the value of a."
      }
    },
    {
      "params": {
        "header": "The cumulative distribution of X",
        "cornerLabel": "x",
        "display": "decimal",
        "total": {
          "show": false
        },
        "show": {
          "probability": false,
          "cumulative": true
        },
        "outcomes": [
          {
            "name": "0",
            "p": 0.3,
            "occludeCumulative": true,
            "cumulativeSymbol": "c"
          },
          {
            "name": "1",
            "p": 0.25
          },
          {
            "name": "2",
            "p": 0.15,
            "occludeCumulative": true,
            "cumulativeSymbol": "d"
          },
          {
            "name": "3",
            "p": 0.3,
            "occludeCumulative": true,
            "cumulativeSymbol": "e"
          }
        ],
        "caption": "The cumulative table as the paper prints it — naming c, d and e lets each part ask for one."
      }
    },
    {
      "params": {
        "header": "The distribution and its cumulative table",
        "cornerLabel": "x",
        "probabilityLabel": "P(X = x)",
        "display": "decimal",
        "total": {
          "show": false
        },
        "show": {
          "cumulative": true
        },
        "outcomes": [
          {
            "name": "0",
            "p": 0.05
          },
          {
            "name": "1",
            "weight": 1,
            "occlude": true,
            "symbol": "a",
            "occludeCumulative": true,
            "cumulativeSymbol": "d"
          },
          {
            "name": "2",
            "p": 0.45
          },
          {
            "name": "3",
            "weight": 1,
            "occlude": true,
            "symbol": "b",
            "occludeCumulative": true,
            "cumulativeSymbol": "e"
          }
        ],
        "caption": "P(1) = P(3). Find a and b, then complete F(x)."
      }
    }
  ]
}
