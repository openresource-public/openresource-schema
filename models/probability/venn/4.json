{
  "ref": "probability/venn@4",
  "family": "probability",
  "name": "venn",
  "version": 4,
  "title": "Venn diagram",
  "responseModes": [
    "select-region",
    "fill-derived"
  ],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "sets": {
        "type": "array",
        "minItems": 2,
        "maxItems": 3,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string"
            },
            "members": {
              "type": "array",
              "items": {
                "type": [
                  "number",
                  "string"
                ]
              }
            }
          }
        }
      },
      "layout": {
        "oneOf": [
          {
            "type": "string",
            "enum": [
              "standard",
              "chain",
              "disjoint",
              "apart"
            ]
          },
          {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "string",
              "enum": [
                "AB",
                "AC",
                "BC"
              ]
            }
          }
        ]
      },
      "regions": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "enum": [
                "A",
                "B",
                "C",
                "AB",
                "AC",
                "BC",
                "ABC",
                "none"
              ]
            },
            "value": {
              "type": "number"
            },
            "label": {
              "type": "string"
            },
            "members": {
              "type": "array",
              "items": {
                "type": [
                  "number",
                  "string"
                ]
              }
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "id"
          ]
        }
      },
      "universal": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string"
          },
          "total": {
            "type": "number"
          },
          "showTotal": {
            "type": "boolean"
          },
          "members": {
            "type": "array",
            "items": {
              "type": [
                "number",
                "string"
              ]
            }
          }
        }
      },
      "showUniverse": {
        "type": "boolean"
      },
      "compute": {
        "type": "string",
        "enum": [
          "none",
          "hcf-lcm",
          "union",
          "probability"
        ]
      },
      "caption": {
        "type": "string"
      },
      "header": {
        "type": "string"
      }
    },
    "required": [
      "sets"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "layout": {
              "const": "chain"
            }
          },
          "required": [
            "layout"
          ]
        },
        "then": {
          "properties": {
            "regions": {
              "items": {
                "properties": {
                  "id": {
                    "enum": [
                      "A",
                      "B",
                      "C",
                      "AB",
                      "BC",
                      "none"
                    ]
                  }
                }
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "layout": {
              "const": "disjoint"
            },
            "sets": {
              "minItems": 3
            }
          },
          "required": [
            "layout",
            "sets"
          ]
        },
        "then": {
          "properties": {
            "regions": {
              "items": {
                "properties": {
                  "id": {
                    "enum": [
                      "A",
                      "B",
                      "C",
                      "AB",
                      "none"
                    ]
                  }
                }
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "layout": {
              "const": "disjoint"
            },
            "sets": {
              "maxItems": 2
            }
          },
          "required": [
            "layout",
            "sets"
          ]
        },
        "then": {
          "properties": {
            "regions": {
              "items": {
                "properties": {
                  "id": {
                    "enum": [
                      "A",
                      "B",
                      "none"
                    ]
                  }
                }
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "layout": {
              "const": "apart"
            }
          },
          "required": [
            "layout"
          ]
        },
        "then": {
          "properties": {
            "regions": {
              "items": {
                "properties": {
                  "id": {
                    "enum": [
                      "A",
                      "B",
                      "C",
                      "none"
                    ]
                  }
                }
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "layout": {
              "enum": [
                "chain",
                "disjoint",
                "apart"
              ]
            }
          },
          "required": [
            "layout"
          ]
        },
        "then": {
          "properties": {
            "sets": {
              "items": {
                "not": {
                  "required": [
                    "members"
                  ]
                }
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "sets": {
              "maxItems": 2
            },
            "layout": {
              "type": "array"
            }
          },
          "required": [
            "layout",
            "sets"
          ]
        },
        "then": {
          "properties": {
            "layout": {
              "items": {
                "const": "AB"
              }
            }
          }
        }
      }
    ]
  },
