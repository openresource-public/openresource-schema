{
  "ref": "probability/tree@3",
  "family": "probability",
  "name": "tree",
  "version": 3,
  "title": "Tree diagram",
  "responseModes": [
    "fill-derived"
  ],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "$defs": {
      "result": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string"
          },
          "occlude": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          }
        }
      }
    },
    "properties": {
      "mode": {
        "type": "string",
        "enum": [
          "probability",
          "frequency"
        ]
      },
      "root": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string"
          }
        }
      },
      "branches": {
        "type": "array",
        "maxItems": 4,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string"
            },
            "p": {
              "type": [
                "string",
                "number"
              ]
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            },
            "result": {
              "$ref": "#/$defs/result"
            },
            "children": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "p": {
                    "type": [
                      "string",
                      "number"
                    ]
                  },
                  "occlude": {
                    "type": "boolean"
                  },
                  "highlight": {
                    "type": "boolean"
                  },
                  "result": {
                    "$ref": "#/$defs/result"
                  },
                  "children": {
                    "type": "array",
                    "maxItems": 4,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "label": {
                          "type": "string"
                        },
                        "p": {
                          "type": [
                            "string",
                            "number"
                          ]
                        },
                        "occlude": {
                          "type": "boolean"
                        },
                        "highlight": {
                          "type": "boolean"
                        },
                        "result": {
                          "$ref": "#/$defs/result"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "outcomes": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "showLabels": {
            "type": "boolean"
          },
          "showValues": {
            "type": "boolean"
          },
          "header": {
            "type": "string"
          }
        }
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "values": {
            "type": "boolean"
          }
        }
      },
      "header": {
        "type": "string"
      },
      "key": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "abbr": {
              "type": "string"
            },
            "meaning": {
              "type": "string"
            }
          },
          "required": [
            "abbr",
            "meaning"
          ]
        }
      }
    },
    "required": [
      "branches"
    ]
