{
  "ref": "probability/spinner@1",
  "family": "probability",
  "name": "spinner",
  "version": 1,
  "title": "Spinner",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "sectors": {
        "type": "array",
        "minItems": 2,
        "maxItems": 12,
        "items": {
          "type": "string"
        }
      },
      "shape": {
        "type": "string",
        "enum": [
          "circle",
          "square",
          "pentagon",
          "hexagon",
          "octagon"
        ]
      },
      "ask": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string"
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "label"
          ]
        }
      },
      "pointer": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "show": {
            "type": "boolean"
          },
          "at": {
            "type": "integer",
            "minimum": 1
          },
          "angle": {
            "type": "number"
          },
          "highlight": {
            "type": "boolean"
          }
        }
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "labels": {
            "type": "boolean"
          },
          "fill": {
            "type": "boolean"
          },
          "simplified": {
            "type": "boolean"
          },
          "fairness": {
            "type": "boolean"
          }
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "sectors"
    ]
  },
  "examples": [
    {
      "params": {
        "header": "Letter spinner",
        "sectors": [
          "A",
          "B",
          "C",
          "C",
          "A",
          "C",
          "B",
          "A"
        ],
        "ask": [
          {
            "label": "A"
          },
          {
            "label": "B"
          },
          {
            "label": "C"
          }
        ],
        "caption": "The spinner is spun once. Each section is equally likely."
      }
    },
    {
      "params": {
        "header": "Spin the spinner",
        "sectors": [
          "1",
          "2",
          "3",
          "4",
          "5",
          "6"
        ],
        "caption": "The spinner is spun once. Write down the probability of landing on 4."
      }
    },
    {
      "params": {
        "sectors": [
          "Green",
          "Green",
          "Blue",
          "Green",
          "Blue",
          "Blue",
          "Green",
          "Blue"
        ],
        "ask": [
          {
            "label": "Green",
            "occlude": true,
            "highlight": true
          }
        ]
      }
    },
    {
      "params": {
        "header": "Octagonal spinner",
        "shape": "octagon",
        "sectors": [
          "Red",
          "Blue",
          "Red",
          "Green",
          "Red",
          "Blue",
          "Red",
          "Yellow"
        ],
        "ask": [
          {
            "label": "Red"
          },
          {
            "label": "Blue"
          },
          {
            "label": "Green"
          },
          {
            "label": "Yellow"
          }
        ],
        "pointer": {
          "at": 1
        },
        "show": {
          "fairness": true
        }
      }
    },
    {
      "params": {
        "header": "Square spinner",
        "shape": "square",
        "sectors": [
          "Win",
          "Lose",
          "Lose",
          "Lose"
        ],
        "ask": [
          {
            "label": "Win",
            "highlight": true
          },
          {
            "label": "Lose"
          }
        ],
        "caption": "One section wins. Find P(win) and P(lose)."
      }
    },
    {
      "params": {
        "sectors": [
          "Cat",
          "Dog",
          "Fish",
          "Bird"
        ],
        "ask": [
          {
            "label": "Cat"
          },
          {
            "label": "Dog"
          },
          {
            "label": "Fish"
          },
          {
            "label": "Bird"
          }
        ],
        "show": {
          "fairness": true
        }
      }
    }
  ]
}
