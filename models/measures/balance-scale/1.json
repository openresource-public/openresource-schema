{
  "ref": "measures/balance-scale@1",
  "family": "measures",
  "name": "balance-scale",
  "version": 1,
  "title": "Balance scale",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "objects": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "mass": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "color": {
              "type": "string",
              "enum": [
                "blue",
                "teal",
                "purple",
                "coral",
                "green"
              ]
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "name",
            "mass"
          ]
        }
      },
      "comparisons": {
        "type": "array",
        "maxItems": 5,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "left": {
              "type": "array",
              "maxItems": 6,
              "items": {
                "type": "string"
              }
            },
            "right": {
              "type": "array",
              "maxItems": 6,
              "items": {
                "type": "string"
              }
            },
            "occlude": {
              "type": "boolean"
            },
            "label": {
              "type": "string"
            }
          },
          "required": [
            "left",
            "right"
          ]
        }
      },
      "order": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "show": {
            "type": "boolean"
          },
          "of": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "direction": {
            "type": "string",
            "enum": [
              "lightest-first",
              "heaviest-first"
            ]
          },
          "occlude": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          }
        }
      },
      "unit": {
        "type": "string"
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "masses": {
            "type": "boolean"
          },
          "verdict": {
            "type": "boolean"
          },
          "stem": {
            "type": "boolean"
          }
        }
      },
      "caption": {
        "type": "string"
      },
      "header": {
        "type": "string"
      }
    },
    "required": [
      "objects",
      "comparisons"
    ]
  },
  "examples": [
    {
      "params": {
        "objects": [
          {
            "name": "apple",
            "mass": 150,
            "color": "green"
          },
          {
            "name": "melon",
            "mass": 900,
            "color": "coral",
            "highlight": true
          }
        ],
        "comparisons": [
          {
            "left": [
              "apple"
            ],
            "right": [
              "melon"
            ]
          }
        ],
        "show": {
          "stem": true
        }
      }
    },
    {
      "params": {
        "objects": [
          {
            "name": "book",
            "mass": 600,
            "color": "blue"
          },
          {
            "name": "ball",
            "mass": 250,
            "color": "purple"
          }
        ],
        "comparisons": [
          {
            "left": [
              "book"
            ],
            "right": [
              "ball"
            ],
            "occlude": true
          }
        ]
      }
    },
    {
      "params": {
        "objects": [
          {
            "name": "apple",
            "mass": 300,
            "color": "green"
          },
          {
            "name": "melon",
            "mass": 900,
            "color": "coral"
          }
        ],
        "comparisons": [
          {
            "left": [
              "apple",
              "apple",
              "apple"
            ],
            "right": [
              "melon"
            ]
          }
        ],
        "show": {
          "masses": true,
          "stem": true
        },
        "unit": "g"
      }
    },
    {
      "params": {
        "header": "Put them in order, lightest first",
        "objects": [
          {
            "name": "A",
            "mass": 200,
            "color": "blue"
          },
          {
            "name": "B",
            "mass": 500,
            "color": "teal"
          },
          {
            "name": "C",
            "mass": 800,
            "color": "purple"
          }
        ],
        "comparisons": [
          {
            "left": [
              "A"
            ],
            "right": [
              "B"
            ],
            "label": "A and B"
          },
          {
            "left": [
              "B"
            ],
            "right": [
              "C"
            ],
            "label": "B and C"
          }
        ],
        "order": {
          "show": true,
          "occlude": true,
          "direction": "lightest-first"
        }
      }
    },
    {
      "params": {
        "objects": [
          {
            "name": "pear",
            "mass": 200,
            "color": "green"
          },
          {
            "name": "weights",
            "mass": 200,
            "color": "blue"
          }
        ],
        "comparisons": [
          {
            "left": [
              "pear"
            ],
            "right": [
              "weights"
            ]
          }
        ],
        "show": {
          "masses": true
        },
        "unit": "g"
      }
    },
    {
      "params": {
        "objects": [
          {
            "name": "red",
            "mass": 400,
            "color": "coral"
          },
          {
            "name": "blue",
            "mass": 250,
            "color": "blue"
          },
          {
            "name": "green",
            "mass": 650,
            "color": "green"
          },
          {
            "name": "purple",
            "mass": 500,
            "color": "purple"
          }
        ],
        "comparisons": [
          {
            "left": [
              "blue"
            ],
            "right": [
              "red"
            ]
          },
          {
            "left": [
              "red"
            ],
            "right": [
              "purple"
            ]
          },
          {
            "left": [
              "purple"
            ],
            "right": [
              "green"
            ]
          }
        ],
        "order": {
          "show": true,
          "occlude": true
        }
      }
    }
  ]
}
