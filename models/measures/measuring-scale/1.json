{
  "ref": "measures/measuring-scale@1",
  "family": "measures",
  "name": "measuring-scale",
  "version": 1,
  "title": "Measuring scale",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "kind": {
        "type": "string",
        "enum": [
          "ruler",
          "jug",
          "dial"
        ]
      },
      "scale": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "major": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20
          },
          "unit": {
            "type": "string"
          }
        },
        "required": [
          "max",
          "major",
          "unit"
        ]
      },
      "object": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "number"
          },
          "to": {
            "type": "number"
          },
          "label": {
            "type": "string"
          },
          "fill": {
            "type": "string",
            "enum": [
              "teal",
              "blue",
              "purple",
              "coral",
              "green"
            ]
          }
        },
        "required": [
          "to"
        ]
      },
      "value": {
        "type": "number"
      },
      "reading": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "show": {
            "type": "boolean"
          },
          "occlude": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          },
          "interval": {
            "type": "boolean"
          },
          "places": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          }
        }
      },
      "stem": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "noun": {
            "type": "string"
          },
          "measure": {
            "type": "string"
          }
        }
      },
      "caption": {
        "type": "string"
      },
      "header": {
        "type": "string"
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "endValues": {
            "type": "boolean"
          },
          "minorTicks": {
            "type": "boolean"
          },
          "tickLabels": {
            "type": "boolean"
          }
        }
      }
    },
    "required": [
      "kind",
      "scale"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "kind": {
              "const": "ruler"
            }
          }
        },
        "then": {
          "required": [
            "object"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "kind": {
              "enum": [
                "jug",
                "dial"
              ]
            }
          }
        },
        "then": {
          "required": [
            "value"
          ]
        }
      }
    ]
  },
  "examples": [
    {
      "params": {
        "kind": "ruler",
        "scale": {
          "min": 0,
          "max": 12,
          "major": 1,
          "minor": 10,
          "unit": "cm"
        },
        "object": {
          "from": 0,
          "to": 8,
          "label": "crayon",
          "fill": "teal"
        },
        "stem": {
          "noun": "crayon",
          "measure": "long"
        }
      }
    },
    {
      "params": {
        "kind": "ruler",
        "scale": {
          "min": 0,
          "max": 14,
          "major": 1,
          "minor": 10,
          "unit": "cm"
        },
        "object": {
          "from": 3,
          "to": 11,
          "label": "ribbon",
          "fill": "coral"
        },
        "show": {
          "endValues": true
        },
        "reading": {
          "occlude": true
        }
      }
    },
    {
      "params": {
        "kind": "jug",
        "scale": {
          "min": 0,
          "max": 500,
          "major": 100,
          "minor": 5,
          "unit": "ml"
        },
        "value": 350,
        "reading": {
          "interval": true
        },
        "stem": {
          "noun": "water",
          "measure": "full"
        }
      }
    },
    {
      "params": {
        "kind": "dial",
        "scale": {
          "min": 0,
          "max": 1000,
          "major": 100,
          "minor": 5,
          "unit": "g"
        },
        "value": 650,
        "reading": {
          "occlude": true
        }
      }
    },
    {
      "params": {
        "kind": "dial",
        "scale": {
          "min": 0,
          "max": 500,
          "major": 100,
          "minor": 4,
          "unit": "g"
        },
        "value": 250,
        "reading": {
          "highlight": true,
          "interval": true
        },
        "stem": {
          "noun": "flour"
        }
      }
    },
    {
      "params": {
        "kind": "ruler",
        "scale": {
          "min": 0,
          "max": 12,
          "major": 1,
          "minor": 10,
          "unit": "cm"
        },
        "object": {
          "from": 0,
          "to": 9,
          "label": "pencil",
          "fill": "green"
        },
        "reading": {
          "occlude": true
        }
      }
    }
  ]
}
