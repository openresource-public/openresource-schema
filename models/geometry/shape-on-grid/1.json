{
  "ref": "geometry/shape-on-grid@1",
  "family": "geometry",
  "name": "shape-on-grid",
  "version": 1,
  "title": "Shape on a centimetre grid",
  "responseModes": [
    "construct"
  ],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "grid": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cols": {
            "type": "integer",
            "minimum": 2,
            "maximum": 24
          },
          "rows": {
            "type": "integer",
            "minimum": 2,
            "maximum": 24
          }
        },
        "required": [
          "cols",
          "rows"
        ]
      },
      "shape": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "rectangle",
              "triangle",
              "parallelogram"
            ]
          },
          "at": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "base": {
            "type": "integer",
            "minimum": 1
          },
          "slant": {
            "type": "integer"
          },
          "apexShift": {
            "type": "integer"
          },
          "label": {
            "type": "string"
          },
          "occludeDims": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          },
          "area": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "show": {
                "type": "boolean"
              },
              "occlude": {
                "type": "boolean"
              },
              "highlight": {
                "type": "boolean"
              }
            }
          },
          "perimeter": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "show": {
                "type": "boolean"
              },
              "occlude": {
                "type": "boolean"
              },
              "highlight": {
                "type": "boolean"
              }
            }
          }
        },
        "required": [
          "type"
        ]
      },
      "constraints": {
        "type": "array",
        "maxItems": 4,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            },
            "measure": {
              "type": "string",
              "enum": [
                "width",
                "length",
                "base",
                "height",
                "area",
                "perimeter"
              ]
            },
            "equals": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "times": {
                      "type": "number"
                    },
                    "of": {
                      "type": "string",
                      "enum": [
                        "width",
                        "length",
                        "base",
                        "height",
                        "area",
                        "perimeter"
                      ]
                    }
                  },
                  "required": [
                    "times",
                    "of"
                  ]
                }
              ]
            }
          },
          "required": [
            "measure",
            "equals"
          ]
        }
      },
      "construct": {
        "type": "boolean"
      },
      "start": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "at": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "base": {
            "type": "integer",
            "minimum": 1
          },
          "slant": {
            "type": "integer"
          },
          "apexShift": {
            "type": "integer"
          }
        }
      },
      "tolerance": {
        "type": "number",
        "minimum": 0,
        "maximum": 5
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "dims": {
            "type": "boolean"
          },
          "grid": {
            "type": "boolean"
          },
          "unitHint": {
            "type": "boolean"
          }
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "grid"
    ]
  },
  "examples": [
    {
      "params": {
        "grid": {
          "cols": 9,
          "rows": 6
        },
        "shape": {
          "type": "rectangle",
          "at": [
            2,
            2
          ],
          "width": 6,
          "height": 3,
          "label": "R",
          "area": {
            "show": true
          },
          "perimeter": {
            "show": true
          }
        },
        "header": "Rectangle R"
      }
    },
    {
      "params": {
        "grid": {
          "cols": 8,
          "rows": 6
        },
        "header": "Your turn"
      }
    },
    {
      "params": {
        "grid": {
          "cols": 10,
          "rows": 6
        },
        "shape": {
          "type": "rectangle",
          "at": [
            2,
            1
          ],
          "width": 7,
          "height": 4,
          "label": "A",
          "occludeDims": true,
          "area": {
            "show": true,
            "occlude": true
          }
        }
      }
    },
    {
      "params": {
        "grid": {
          "cols": 11,
          "rows": 6
        },
        "shape": {
          "type": "parallelogram",
          "at": [
            1,
            1
          ],
          "base": 6,
          "height": 3,
          "slant": 2,
          "label": "P",
          "area": {
            "show": true
          }
        },
        "header": "Area of a parallelogram",
        "caption": "The height is the perpendicular distance between the base and the top — not the sloping side."
      }
    },
    {
      "params": {
        "grid": {
          "cols": 10,
          "rows": 8
        },
        "shape": {
          "type": "rectangle"
        },
        "construct": true,
        "constraints": [
          {
            "id": "ratio",
            "measure": "length",
            "equals": {
              "times": 2,
              "of": "width"
            }
          },
          {
            "id": "perimeter",
            "measure": "perimeter",
            "equals": 18
          }
        ],
        "caption": "Drag the corners to draw a rectangle whose length is twice its width, with a perimeter of 18 cm."
      }
    },
    {
      "params": {
        "grid": {
          "cols": 9,
          "rows": 7
        },
        "shape": {
          "type": "triangle"
        },
        "construct": true,
        "constraints": [
          {
            "id": "ratio",
            "measure": "base",
            "equals": {
              "times": 2,
              "of": "height"
            }
          },
          {
            "id": "area",
            "measure": "area",
            "equals": 9
          }
        ],
        "caption": "Drag the vertices to draw a triangle whose base is twice its height, with an area of 9 cm²."
      }
    }
  ]
}
