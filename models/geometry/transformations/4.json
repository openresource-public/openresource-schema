  "interface": {
    "type": "object",
    "additionalProperties": false,
    "$defs": {
      "transformStep": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "rotation",
              "reflection",
              "enlargement",
              "translation"
            ]
          },
          "centre": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "angle": {
            "type": "number"
          },
          "mirror": {
            "type": "string"
          },
          "scaleFactor": {
            "type": "number"
          },
          "vector": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "required": [
          "type"
        ]
      }
    },
    "properties": {
      "axes": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "x": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "y": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "step": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "labelStep": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "show": {
            "type": "boolean"
          }
        }
      },
      "grid": {
        "type": "boolean"
      },
      "shape": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "vertices": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "vertices"
        ]
      },
      "transform": {
        "$ref": "#/$defs/transformStep"
      },
      "transforms": {
        "type": "array",
        "minItems": 1,
        "maxItems": 4,
        "items": {
          "$ref": "#/$defs/transformStep"
        }
      },
      "imageLabel": {
        "type": "string"
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "image": {
            "type": "boolean"
          },
          "intermediate": {
            "type": "boolean"
          },
          "construction": {
            "type": "boolean"
          },
          "vertexLabels": {
            "type": "boolean"
          }
        }
      },
      "construct": {
        "type": "boolean"
      },
      "constructAnywhere": {
        "type": "boolean"
      },
      "constructSnap": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "header": {
        "type": "string"
      },
      "draggable": {
        "type": "boolean"
      }
    },
    "required": [
      "shape"
    ],
    "anyOf": [
      {
        "required": [
          "transform"
        ]
      },
      {
        "required": [
          "transforms"
        ]
      }
    ]
  },
