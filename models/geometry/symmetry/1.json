{
  "ref": "geometry/symmetry@1",
  "family": "geometry",
  "name": "symmetry",
  "version": 1,
  "title": "Symmetry",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "regular": {
        "type": "integer",
        "minimum": 3,
        "maximum": 12
      },
      "vertices": {
        "type": "array",
        "minItems": 3,
        "maxItems": 12,
        "items": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "reflective": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "lines": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "angle": {
                  "type": "number"
                },
                "label": {
                  "type": "string"
                },
                "highlight": {
                  "type": "boolean"
                }
              },
              "required": [
                "angle"
              ]
            }
          },
          "showLines": {
            "type": "boolean"
          },
          "showCount": {
            "type": "boolean"
          },
          "occludeCount": {
            "type": "boolean"
          },
          "highlightCount": {
            "type": "boolean"
          }
        }
      },
      "rotational": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "showCentre": {
            "type": "boolean"
          },
          "showArrow": {
            "type": "boolean"
          },
          "showCount": {
            "type": "boolean"
          },
          "occlude": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          }
        }
      },
      "completion": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "angle": {
            "type": "number"
          },
          "reveal": {
            "type": "boolean"
          }
        },
        "required": [
          "angle"
        ]
      },
      "vertexLabels": {
        "type": "boolean"
      },
      "notToScale": {
        "type": "boolean"
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      },
      "draggable": {
        "type": "boolean"
      }
    },
    "anyOf": [
      {
        "required": [
          "regular"
        ]
      },
      {
        "required": [
          "vertices"
        ]
      }
    ]
  },
  "examples": [
    {
      "params": {
        "regular": 5,
        "header": "Symmetry of a regular pentagon"
      }
    },
    {
      "params": {
        "regular": 4,
        "reflective": {
          "showLines": false,
          "occludeCount": true
        },
        "rotational": {
          "occlude": true
        }
      }
    },
    {
      "params": {
        "regular": 6,
        "reflective": {
          "occludeCount": true
        },
        "rotational": {
          "occlude": true
        }
      }
    },
    {
      "params": {
        "vertices": [
          [
            0,
            0
          ],
          [
            4,
            0
          ],
          [
            5,
            2
          ],
          [
            1,
            2
          ]
        ],
        "reflective": {
          "lines": []
        },
        "rotational": {
          "order": 2
        },
        "notToScale": true,
        "caption": "A parallelogram has no lines of symmetry but rotational symmetry of order 2"
      }
    },
    {
      "params": {
        "vertices": [
          [
            0,
            3
          ],
          [
            1.5,
            0.4
          ],
          [
            0,
            -2.4
          ],
          [
            -1.5,
            0.4
          ]
        ],
        "reflective": {
          "lines": [
            {
              "angle": 90
            }
          ]
        },
        "rotational": {
          "order": 1
        },
        "vertexLabels": true,
        "notToScale": true
      }
    },
    {
      "params": {
        "vertices": [
          [
            -2,
            -2
          ],
          [
            2,
            -2
          ],
          [
            2,
            1
          ],
          [
            0,
            3
          ],
          [
            -2,
            1
          ]
        ],
        "completion": {
          "angle": 90
        }
      }
    }
  ]
}
