{
  "ref": "geometry/prism@5",
  "family": "geometry",
  "name": "prism",
  "version": 5,
  "title": "Prism (isometric)",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "crossSection",
      "length"
    ],
    "properties": {
      "header": {
        "type": "string"
      },
      "crossSection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind"
