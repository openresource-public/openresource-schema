          "type": "object",
          "additionalProperties": false,
          "required": [
            "target",
            "text"
          ],
          "properties": {
            "target": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "string",
                  "enum": [
                    "length",
                    "h",
                    "r"
                  ]
                }
              ]
            },
            "text": {
              "type": "string"
            }
          }
        }
      },
      "shadeCrossSection": {
        "type": "boolean"
      },
      "rotatable": {
        "type": "boolean"
      },
      "view": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "turn",
          "tilt"
        ],
        "properties": {
          "turn": {
            "type": "number",
            "minimum": -80,
            "maximum": 80
          },
          "tilt": {
            "type": "number",
            "minimum": 5,
            "maximum": 60
          }
        }
      },
      "arrows": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "front": {
            "type": "boolean"
          },
          "side": {
            "type": "boolean"
          }
        }
      },
