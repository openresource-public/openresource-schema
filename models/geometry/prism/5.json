        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "regular",
              "rectangle",
              "triangle",
              "parallelogram",
              "trapezium",
              "polygon",
              "circle",
              "semicircle",
              "sector",
              "arch"
            ]
          },
          "n": {
            "type": "integer",
            "minimum": 3
          },
          "side": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "circumradius": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "wallHeight": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "heightMode": {
            "type": "string",
            "enum": [
              "wall",
              "total"
            ]
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "base": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "apexOffset": {
            "type": "number",
            "minimum": 0
          },
          "slant": {
            "type": "number"
          },
          "a": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "b": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "offset": {
            "type": "number"
          },
          "vertices": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          },
          "radius": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "angle": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 359
          }
        }
      },
      "length": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "unit": {
        "type": "string"
      },
      "edgeLabels": {
        "oneOf": [
          {
            "type": "string",
            "enum": [
              "all",
              "none"
            ]
          },
          {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        ]
      },
      "showLength": {
        "type": "boolean"
      },
      "occlude": {
        "type": "array",
        "items": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string",
              "enum": [
                "length",
                "h",
                "r"
              ]
            }
          ]
        }
      },
      "highlight": {
        "type": "array",
