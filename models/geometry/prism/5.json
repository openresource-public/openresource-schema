          },
          "occlude": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          },
          "onFace": {
            "type": "boolean"
          }
        }
      },
      "surfaceArea": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "working": {
            "type": "boolean"
          },
          "occlude": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          }
        }
      },
      "volume": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "working": {
            "type": "boolean"
          },
          "occlude": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          }
        }
      },
