{
  "ref": "geometry/polygons-at-a-point@1",
  "family": "geometry",
  "name": "polygons-at-a-point",
  "version": 1,
  "title": "Polygons at a point",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "polygons": {
        "type": "array",
        "minItems": 2,
        "maxItems": 8,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sides": {
              "type": "integer",
              "minimum": 3,
              "maximum": 24
            },
            "unknown": {
              "type": "boolean"
            },
            "label": {
              "type": "string"
            },
            "occludeAngle": {
              "type": "boolean"
            },
            "highlightAngle": {
              "type": "boolean"
            },
            "angleLabel": {
              "type": "string"
            },
            "vertexLabels": {
              "type": "array",
              "maxItems": 24,
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "showAngles": {
        "type": "boolean"
      },
      "sizing": {
        "type": "string",
        "enum": [
          "point",
          "edge"
        ]
      },
      "crop": {
        "type": "string",
        "enum": [
          "unknown",
          "all",
          "none"
        ]
      },
      "startAngle": {
        "type": "number"
      },
      "clockwise": {
        "type": "boolean"
      },
      "gap": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "show": {
            "type": "boolean"
          },
          "label": {
            "type": "string"
          },
          "occlude": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          }
        }
      },
      "pointLabel": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      },
      "header": {
        "type": "string"
      },
      "notToScale": {
        "type": "boolean"
      },
      "reveal": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "polygons"
    ]
  },
  "examples": [
    {
      "params": {
        "polygons": [
          {
            "sides": 4,
            "label": "A"
          },
          {
            "sides": 6,
            "label": "B"
          },
          {
            "sides": 12,
            "label": "C",
            "occludeAngle": true,
            "highlightAngle": true
          }
        ],
        "showAngles": true,
        "notToScale": true
      }
    },
    {
      "params": {
        "polygons": [
          {
            "sides": 8,
            "label": "A"
          },
          {
            "sides": 4,
            "label": "B"
          },
          {
            "sides": 8,
            "label": "C"
          }
        ],
        "crop": "none",
        "showAngles": true,
        "caption": "The angles at a point add to 360°"
      }
    },
    {
      "params": {
        "polygons": [
          {
            "sides": 4,
            "label": "A"
          },
          {
            "sides": 6,
            "label": "B"
          },
          {
            "unknown": true,
            "label": "P",
            "occludeAngle": true,
            "highlightAngle": true
          }
        ],
        "showAngles": true,
        "notToScale": true
      }
    },
    {
      "params": {
        "polygons": [
          {
            "sides": 6,
            "label": "A"
          },
          {
            "sides": 4,
            "label": "B"
          },
          {
            "sides": 4,
            "label": "C"
          }
        ],
        "showAngles": true,
        "gap": {
          "show": true,
          "label": "x",
          "highlight": true
        },
        "notToScale": true
      }
    },
    {
      "params": {
        "polygons": [
          {
            "sides": 6,
            "vertexLabels": [
              "D",
              "C",
              "B",
              "A",
              "F",
              "E"
            ]
          },
          {
            "sides": 4,
            "vertexLabels": [
              "D",
              "E",
              "H",
              "G"
            ]
          },
          {
            "unknown": true,
            "label": "P",
            "occludeAngle": true,
            "highlightAngle": true
          }
        ],
        "crop": "unknown",
        "showAngles": true,
        "notToScale": true
      }
    },
    {
      "params": {
        "polygons": [
          {
            "sides": 3
          },
          {
            "sides": 3
          },
          {
            "sides": 3
          },
          {
            "sides": 3
          },
          {
            "sides": 3
          },
          {
            "sides": 3
          }
        ],
        "crop": "none",
        "showAngles": true,
        "caption": "Six equilateral triangles: 6 × 60° = 360°"
      }
    }
  ]
}
