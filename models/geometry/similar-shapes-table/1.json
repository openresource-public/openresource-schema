{
  "ref": "geometry/similar-shapes-table@1",
  "family": "geometry",
  "name": "similar-shapes-table",
  "version": 1,
  "title": "Similar shapes measurements table",
  "responseModes": [
    "fill-derived"
  ],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "shapes": {
        "type": "array",
        "minItems": 2,
        "maxItems": 3,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "length": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "area": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "volume": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "scale": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "known": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "of": {
                  "type": "string",
                  "enum": [
                    "length",
                    "area",
                    "volume"
                  ]
                },
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "of",
                "value"
              ]
            }
          }
        }
      },
      "unit": {
        "type": "string"
      },
      "cells": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "shape": {
              "type": "integer",
              "minimum": 1
            },
            "measure": {
              "type": "string",
              "enum": [
                "length",
                "area",
                "volume"
              ]
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "shape",
            "measure"
          ]
        }
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "factors": {
            "type": "boolean"
          },
          "working": {
            "type": "boolean"
          }
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "shapes"
    ]
  },
  "examples": [
    {
      "params": {
        "header": "Two similar shapes, scale factor 3",
        "unit": "cm",
        "shapes": [
          {
            "name": "Shape A",
            "length": 5,
            "area": 20,
            "volume": 8
          },
          {
            "name": "Shape B",
            "scale": 3
          }
        ],
        "show": {
          "working": true
        },
        "caption": "Lengths scale by 3, so areas scale by 3² = 9 and volumes by 3³ = 27."
      }
    },
    {
      "params": {
        "unit": "cm",
        "shapes": [
          {
            "name": "Shape A",
            "length": 4,
            "area": 24
          },
          {
            "name": "Shape B",
            "known": {
              "of": "length",
              "value": 10
            }
          }
        ],
        "cells": [
          {
            "shape": 2,
            "measure": "area",
            "occlude": true,
            "highlight": true
          }
        ],
        "caption": "Two similar shapes. Shape A: length 4 cm, area 24 cm². Shape B: length 10 cm. Find the area of Shape B."
      }
    },
    {
      "params": {
        "unit": "mm",
        "shapes": [
          {
            "name": "Shape A",
            "length": 6,
            "area": 15,
            "volume": 10
          },
          {
            "name": "Shape B",
            "scale": 2
          }
        ],
        "cells": [
          {
            "shape": 2,
            "measure": "length",
            "occlude": true
          },
          {
            "shape": 2,
            "measure": "area",
            "occlude": true
          },
          {
            "shape": 2,
            "measure": "volume",
            "occlude": true
          }
        ],
        "caption": "Shape B is similar to Shape A with a scale factor of 2. Complete the table."
      }
    },
    {
      "params": {
        "unit": "cm",
        "shapes": [
          {
            "name": "Shape A",
            "length": 2,
            "area": 4
          },
          {
            "name": "Shape B",
            "known": {
              "of": "area",
              "value": 36
            }
          }
        ],
        "cells": [
          {
            "shape": 2,
            "measure": "length",
            "occlude": true,
            "highlight": true
          }
        ],
        "show": {
          "working": true
        },
        "caption": "The areas of two similar shapes are 4 cm² and 36 cm². Find the length of Shape B."
      }
    },
    {
      "params": {
        "header": "Three similar shapes",
        "unit": "cm",
        "shapes": [
          {
            "name": "Shape A",
            "length": 4,
            "area": 6
          },
          {
            "name": "Shape B",
            "scale": 2
          },
          {
            "name": "Shape C",
            "scale": 3
          }
        ]
      }
    },
    {
      "params": {
        "header": "From the volume ratio",
        "unit": "cm",
        "shapes": [
          {
            "name": "Shape A",
            "length": 3,
            "area": 7,
            "volume": 8
          },
          {
            "name": "Shape B",
            "known": {
              "of": "volume",
              "value": 64
            }
          }
        ],
        "cells": [
          {
            "shape": 2,
            "measure": "area",
            "occlude": true,
            "highlight": true
          }
        ],
        "show": {
          "working": true
        },
        "caption": "Two similar solids have volumes 8 cm³ and 64 cm³. Find the area of Shape B."
      }
    }
  ]
}
