{
  "ref": "geometry/turn@1",
  "family": "geometry",
  "name": "turn",
  "version": 1,
  "title": "Turn (amount of turn)",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "$defs": {
      "direction": {
        "oneOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ]
      }
    },
    "properties": {
      "scene": {
        "type": "string",
        "enum": [
          "arrow",
          "dial",
          "rosette"
        ]
      },
      "start": {
        "$ref": "#/$defs/direction"
      },
      "direction": {
        "type": "string",
        "enum": [
          "clockwise",
          "anticlockwise"
        ]
      },
      "turn": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fraction": {
            "type": "string"
          },
          "degrees": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      },
      "to": {
        "$ref": "#/$defs/direction"
      },
      "landmarks": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "at": {
              "$ref": "#/$defs/direction"
            },
            "label": {
              "type": "string"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "at",
            "label"
          ]
        }
      },
      "occlude": {
        "type": "string",
        "enum": [
          "none",
          "turn",
          "end"
        ]
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "degrees": {
            "type": "boolean"
          },
          "fraction": {
            "type": "boolean"
          },
          "startPointer": {
            "type": "boolean"
          },
          "endPointer": {
            "type": "boolean"
          },
          "arc": {
            "type": "boolean"
          },
          "marks": {
            "type": "boolean"
          },
          "numerals": {
            "type": "boolean"
          },
          "compass": {
            "type": "boolean"
          },
          "person": {
            "type": "boolean"
          }
        }
      },
      "stem": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "show": {
            "type": "boolean"
          }
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      },
      "draggable": {
        "type": "boolean"
      }
    }
  },
  "examples": [
    {
      "params": {
        "scene": "arrow",
        "start": "up",
        "turn": {
          "fraction": "quarter"
        },
        "direction": "clockwise",
        "stem": {
          "show": true
        },
        "header": "A quarter turn"
      }
    },
    {
      "params": {
        "scene": "dial",
        "start": "N",
        "to": "S",
        "direction": "clockwise",
        "show": {
          "numerals": true
        },
        "stem": {
          "show": true
        },
        "caption": "The hand turns half a turn, from 12 round to 6."
      }
    },
    {
      "params": {
        "scene": "rosette",
        "start": "school",
        "to": "park",
        "direction": "clockwise",
        "landmarks": [
          {
            "id": "school",
            "at": "N",
            "label": "school"
          },
          {
            "id": "park",
            "at": "E",
            "label": "park",
            "highlight": true
          },
          {
            "id": "shop",
            "at": "S",
            "label": "shop"
          },
          {
            "id": "home",
            "at": "W",
            "label": "home"
          }
        ],
        "stem": {
          "show": true
        }
      }
    },
    {
      "params": {
        "scene": "arrow",
        "start": "up",
        "turn": {
          "fraction": "three-quarter"
        },
        "direction": "clockwise",
        "occlude": "turn",
        "stem": {
          "show": false
        }
      }
    },
    {
      "params": {
        "scene": "arrow",
        "start": "up",
        "turn": {
          "fraction": "three-quarter"
        },
        "direction": "anticlockwise",
        "show": {
          "compass": true
        },
        "stem": {
          "show": true
        },
        "caption": "Three-quarters of a turn anticlockwise — the long way round."
      }
    },
    {
      "params": {
        "scene": "arrow",
        "start": "up",
        "turn": {
          "fraction": "quarter"
        },
        "direction": "clockwise",
        "occlude": "end",
        "show": {
          "arc": false,
          "compass": true
        },
        "stem": {
          "show": false
        }
      }
    }
  ]
}
