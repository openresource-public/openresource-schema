{
  "ref": "geometry/polygon-angles@1",
  "family": "geometry",
  "name": "polygon-angles",
  "version": 1,
  "title": "Polygon angles",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "regular": {
        "type": "integer",
        "minimum": 3,
        "maximum": 12
      },
      "vertices": {
        "type": "array",
        "minItems": 3,
        "maxItems": 12,
        "items": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "angles": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "at": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "label": {
              "type": "string"
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            },
            "exterior": {
              "type": "boolean"
            }
          },
          "required": [
            "at"
          ]
        }
      },
      "showInteriorAngles": {
        "type": "boolean"
      },
      "showExteriorAngles": {
        "type": "boolean"
      },
      "angleSum": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "interior",
              "exterior"
            ]
          },
          "showWorking": {
            "type": "boolean"
          },
          "perAngle": {
            "type": "boolean"
          },
          "occlude": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          }
        }
      },
      "diagonalsFrom": {
        "type": "integer",
        "minimum": 1,
        "maximum": 12
      },
      "showEqualMarks": {
        "type": "boolean"
      },
      "vertexLabels": {
        "type": "boolean"
      },
      "notToScale": {
        "type": "boolean"
      },
      "caption": {
        "type": "string"
      },
      "header": {
        "type": "string"
      },
      "draggablePoints": {
        "type": "boolean"
      }
    },
    "oneOf": [
      {
        "required": [
          "regular"
        ]
      },
      {
        "required": [
          "vertices"
        ]
      }
    ]
  },
  "examples": [
    {
      "params": {
        "regular": 5,
        "angleSum": {
          "mode": "interior",
          "occlude": true
        }
      }
    },
    {
      "params": {
        "regular": 6,
        "showInteriorAngles": true,
        "showEqualMarks": true,
        "angleSum": {
          "mode": "interior",
          "showWorking": true,
          "perAngle": true
        },
        "caption": "Each interior angle of a regular hexagon"
      }
    },
    {
      "params": {
        "vertices": [
          [
            0,
            0
          ],
          [
            4.2,
            0
          ],
          [
            5.4,
            3.1
          ],
          [
            2.1,
            5.2
          ],
          [
            -1.2,
            2.8
          ]
        ],
        "showInteriorAngles": true,
        "angles": [
          {
            "at": 1,
            "label": "130°"
          },
          {
            "at": 2,
            "label": "95°"
          },
          {
            "at": 3,
            "label": "110°"
          },
          {
            "at": 4,
            "label": "100°"
          },
          {
            "at": 5,
            "occlude": true,
            "highlight": true
          }
        ],
        "angleSum": {
          "mode": "interior",
          "showWorking": true
        },
        "notToScale": true
      }
    },
    {
      "params": {
        "vertices": [
          [
            0,
            0
          ],
          [
            5,
            -1
          ],
          [
            7.2,
            3
          ],
          [
            4,
            6.2
          ],
          [
            0,
            6
          ],
          [
            -2.1,
            3
          ]
        ],
        "showInteriorAngles": true,
        "angles": [
          {
            "at": 1,
            "label": "100°"
          },
          {
            "at": 2,
            "label": "150°"
          },
          {
            "at": 3,
            "label": "120°"
          },
          {
            "at": 4,
            "label": "90°"
          },
          {
            "at": 5,
            "label": "140°"
          },
          {
            "at": 6,
            "occlude": true,
            "highlight": true
          }
        ],
        "angleSum": {
          "mode": "interior",
          "showWorking": true
        },
        "notToScale": true,
        "caption": "Five angles are given. Work out the sixth."
      }
    },
    {
      "params": {
        "regular": 8,
        "showExteriorAngles": true,
        "angles": [
          {
            "at": 1,
            "highlight": true,
            "exterior": true
          }
        ],
        "angleSum": {
          "mode": "exterior",
          "perAngle": true
        },
        "caption": "The exterior angles of a polygon add to 360°"
      }
    },
    {
      "params": {
        "regular": 7,
        "diagonalsFrom": 1,
        "angleSum": {
          "mode": "interior",
          "showWorking": true
        },
        "caption": "Splitting the polygon into triangles"
      }
    }
  ]
}
