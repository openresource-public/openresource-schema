{
  "ref": "geometry/net@1",
  "family": "geometry",
  "name": "net",
  "version": 1,
  "title": "Net of a solid",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "solid"
    ],
    "properties": {
      "solid": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "dimensions"
            ],
            "properties": {
              "type": {
                "const": "cuboid"
              },
              "dimensions": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "length",
                  "width",
                  "height"
                ],
                "properties": {
                  "length": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "dimensions"
            ],
            "properties": {
              "type": {
                "const": "triangular-prism"
              },
              "dimensions": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sides",
                  "length"
                ],
                "properties": {
                  "sides": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "length": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "dimensions"
            ],
            "properties": {
              "type": {
                "const": "square-pyramid"
              },
              "dimensions": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "base",
                  "height"
                ],
                "properties": {
                  "base": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "dimensions"
            ],
            "properties": {
              "type": {
                "const": "cylinder"
              },
              "dimensions": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "radius",
                  "height"
                ],
                "properties": {
                  "radius": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              }
            }
          }
        ]
      },
      "mode": {
        "type": "string",
        "enum": [
          "net",
          "solid"
        ]
      },
      "layout": {
        "type": "string",
        "enum": [
          "cross",
          "zigzag"
        ]
      },
      "faces": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "enum": [
                "top",
                "bottom",
                "front",
                "back",
                "left",
                "right",
                "end-1",
                "end-2",
                "rect-1",
                "rect-2",
                "rect-3",
                "base",
                "side-1",
                "side-2",
                "side-3",
                "side-4",
                "curved"
              ]
            },
            "label": {
              "type": "string"
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            }
          }
        }
      },
      "surfaceArea": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "workedSteps": {
            "type": "boolean"
          },
          "occlude": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          }
        }
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "dimensions": {
            "type": "boolean"
          },
          "foldMarks": {
            "type": "boolean"
          },
          "faceLabels": {
            "type": "boolean"
          },
          "faceAreas": {
            "type": "boolean"
          }
        }
      },
      "unit": {
        "type": "string"
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    }
  },
  "examples": [
    {
      "params": {
        "solid": {
          "type": "cuboid",
          "dimensions": {
            "length": 8,
            "width": 5,
            "height": 3
          }
        },
        "show": {
          "dimensions": true,
          "faceAreas": true
        },
        "surfaceArea": {
          "workedSteps": true
        },
        "unit": "cm"
      }
    },
    {
      "params": {
        "solid": {
          "type": "cuboid",
          "dimensions": {
            "length": 6,
            "width": 4,
            "height": 2
          }
        },
        "show": {
          "dimensions": true
        },
        "unit": "cm"
      }
    },
    {
      "params": {
        "solid": {
          "type": "triangular-prism",
          "dimensions": {
            "sides": [
              6,
              8,
              10
            ],
            "length": 12
          }
        },
        "show": {
          "dimensions": true,
          "faceAreas": true
        },
        "surfaceArea": {
          "workedSteps": true,
          "occlude": true
        },
        "unit": "cm"
      }
    },
    {
      "params": {
        "solid": {
          "type": "triangular-prism",
          "dimensions": {
            "sides": [
              3,
              4,
              5
            ],
            "length": 10
          }
        },
        "show": {
          "dimensions": true,
          "faceAreas": true
        },
        "surfaceArea": {
          "workedSteps": true
        },
        "unit": "cm"
      }
    },
    {
      "params": {
        "solid": {
          "type": "square-pyramid",
          "dimensions": {
            "base": 6,
            "height": 4
          }
        },
        "show": {
          "dimensions": true,
          "faceAreas": true
        },
        "surfaceArea": {
          "workedSteps": true
        },
        "unit": "cm"
      }
    },
    {
      "params": {
        "solid": {
          "type": "cylinder",
          "dimensions": {
            "radius": 3.5,
            "height": 10
          }
        },
        "faces": [
          {
            "id": "curved",
            "highlight": true
          }
        ],
        "show": {
          "dimensions": true
        },
        "surfaceArea": {
          "workedSteps": true
        },
        "unit": "cm"
      }
    },
    {
      "params": {
        "mode": "net",
        "header": "Fold the net",
        "solid": {
          "type": "cuboid",
          "dimensions": {
            "length": 6,
            "width": 4,
            "height": 3
          }
        },
        "show": {
          "dimensions": true
        },
        "unit": "cm"
      }
    },
    {
      "params": {
        "mode": "solid",
        "header": "Fold the net",
        "solid": {
          "type": "cuboid",
          "dimensions": {
            "length": 6,
            "width": 4,
            "height": 3
          }
        },
        "show": {
          "dimensions": true
        },
        "unit": "cm"
      }
    },
    {
      "params": {
        "mode": "solid",
        "solid": {
          "type": "triangular-prism",
          "dimensions": {
            "sides": [
              3,
              4,
              5
            ],
            "length": 10
          }
        },
        "show": {
          "dimensions": true
        },
        "unit": "cm",
        "caption": "A triangular prism"
      }
    }
  ]
}
