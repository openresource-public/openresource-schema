{
  "ref": "geometry/angles-at-a-point@1",
  "family": "geometry",
  "name": "angles-at-a-point",
  "version": 1,
  "title": "Angles at a point",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "arms": {
        "type": "array",
        "minItems": 2,
        "maxItems": 8,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "direction": {
              "type": "number"
            },
            "label": {
              "type": "string"
            }
          },
          "required": [
            "direction"
          ]
        }
      },
      "angles": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "between": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "label": {
              "type": "string"
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            },
            "rightAngle": {
              "type": "boolean"
            }
          },
          "required": [
            "between"
          ]
        }
      },
      "vertexLabel": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      },
      "header": {
        "type": "string"
      },
      "draggable": {
        "type": "boolean"
      }
    },
    "required": [
      "arms"
    ]
  },
  "examples": [
    {
      "params": {
        "arms": [
          {
            "direction": 0
          },
          {
            "direction": 110
          },
          {
            "direction": 180
          }
        ],
        "angles": [
          {
            "between": [
              0,
              110
            ],
            "occlude": true
          },
          {
            "between": [
              110,
              180
            ],
            "occlude": true
          }
        ],
        "caption": "Angles on a straight line add to 180°"
      }
    },
    {
      "params": {
        "arms": [
          {
            "direction": 0
          },
          {
            "direction": 90
          },
          {
            "direction": 200
          }
        ],
        "angles": [
          {
            "between": [
              0,
              90
            ],
            "rightAngle": true
          },
          {
            "between": [
              90,
              200
            ]
          },
          {
            "between": [
              200,
              0
            ]
          }
        ],
        "vertexLabel": "O",
        "caption": "Angles around a point add to 360°"
      }
    },
    {
      "params": {
        "arms": [
          {
            "direction": 0
          },
          {
            "direction": 35
          },
          {
            "direction": 180
          }
        ],
        "angles": [
          {
            "between": [
              0,
              35
            ]
          },
          {
            "between": [
              35,
              180
            ],
            "occlude": true,
            "highlight": true
          }
        ]
      }
    },
    {
      "params": {
        "arms": [
          {
            "direction": 0
          },
          {
            "direction": 60
          },
          {
            "direction": 180
          }
        ],
        "angles": [
          {
            "between": [
              0,
              60
            ],
            "label": "x"
          },
          {
            "between": [
              60,
              180
            ],
            "label": "2x"
          }
        ],
        "caption": "x + 2x = 180"
      }
    },
    {
      "params": {
        "arms": [
          {
            "direction": 0
          },
          {
            "direction": 125
          },
          {
            "direction": 180
          },
          {
            "direction": 305
          }
        ],
        "angles": [
          {
            "between": [
              0,
              125
            ],
            "highlight": true
          },
          {
            "between": [
              125,
              180
            ]
          },
          {
            "between": [
              180,
              305
            ],
            "highlight": true
          },
          {
            "between": [
              305,
              0
            ]
          }
        ],
        "caption": "Vertically opposite angles are equal"
      }
    },
    {
      "params": {
        "arms": [
          {
            "direction": 0
          },
          {
            "direction": 25
          },
          {
            "direction": 95
          }
        ],
        "angles": [
          {
            "between": [
              0,
              25
            ]
          },
          {
            "between": [
              25,
              95
            ]
          },
          {
            "between": [
              95,
              0
            ],
            "occlude": true,
            "highlight": true
          }
        ],
        "vertexLabel": "O",
        "caption": "Angles around a point add to 360°"
      }
    }
  ]
}
