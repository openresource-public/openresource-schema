{
  "ref": "geometry/orthographic-views@2",
  "family": "geometry",
  "name": "orthographic-views",
  "version": 2,
  "title": "Orthographic views (plan and elevations)",
  "responseModes": [
    "construct"
  ],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "$defs": {
      "panel": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "shape": {
            "type": "string",
            "enum": [
              "rectangle",
              "square",
              "triangle",
              "trapezium",
              "circle",
              "house",
              "polygon"
            ]
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "side": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "base": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "top": {
            "type": "number",
            "minimum": 0
          },
          "diameter": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "wallHeight": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "apex": {
            "type": "string",
            "enum": [
              "centre",
              "left",
              "right"
            ]
          },
          "align": {
            "type": "string",
            "enum": [
              "centre",
              "left",
              "right"
            ]
          },
          "diagonals": {
            "type": "boolean"
          },
          "lines": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              }
            }
          },
          "optionalLines": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              }
            }
          },
          "points": {
            "type": "array",
            "minItems": 3,
            "maxItems": 12,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          },
          "showDims": {
            "type": "boolean"
          },
          "occlude": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          },
          "draw": {
            "type": "boolean"
          },
          "drawLines": {
            "type": "boolean"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "shape"
        ]
      }
    },
    "properties": {
      "panels": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "plan": {
            "$ref": "#/$defs/panel"
          },
          "front": {
            "$ref": "#/$defs/panel"
          },
          "side": {
            "$ref": "#/$defs/panel"
          }
        }
      },
      "construct": {
        "type": "boolean"
      },
      "tolerance": {
        "type": "number",
        "minimum": 0,
        "maximum": 5
      },
      "unit": {
        "type": "string"
      },
      "grid": {
        "type": "boolean"
      },
      "showLabels": {
        "type": "boolean"
      },
      "scale": {
        "type": "string"
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "panels"
    ]
  },
  "examples": [
    {
      "params": {
        "header": "The plan and elevations of a cuboid",
        "panels": {
          "plan": {
            "shape": "rectangle",
            "width": 5,
            "height": 3
          },
          "front": {
            "shape": "rectangle",
            "width": 5,
            "height": 2
          },
          "side": {
            "shape": "rectangle",
            "width": 3,
            "height": 2
          }
        },
        "caption": "A cuboid 5 cm by 3 cm by 2 cm"
      }
    },
    {
      "params": {
        "panels": {
          "plan": {
            "shape": "circle",
            "diameter": 6
          },
          "front": {
            "shape": "rectangle",
            "width": 6,
            "height": 4
          },
          "side": {
            "shape": "rectangle",
            "width": 6,
            "height": 4
          }
        },
        "caption": "The plan and elevations of a cylinder, diameter 6 cm and height 4 cm"
      }
    },
    {
      "params": {
        "panels": {
          "plan": {
            "shape": "rectangle",
            "width": 4,
            "height": 3
          },
          "front": {
            "shape": "trapezium",
            "base": 4,
            "top": 2,
            "height": 3,
            "occlude": true
          },
          "side": {
            "shape": "triangle",
            "base": 3,
            "height": 3,
            "apex": "left"
          }
        }
      }
    },
    {
      "params": {
        "header": "A square-based pyramid",
        "panels": {
          "plan": {
            "shape": "square",
            "side": 4,
            "diagonals": true
          },
          "front": {
            "shape": "triangle",
            "base": 4,
            "height": 5,
            "highlight": true
          }
        },
        "scale": "2 cm represents 1 m",
        "caption": "The plan and front elevation"
      }
    },
    {
      "params": {
        "panels": {
          "plan": {
            "shape": "rectangle",
            "width": 5,
            "height": 3
          },
          "front": {
            "shape": "triangle",
            "base": 5,
            "height": 4
          },
          "side": {
            "shape": "rectangle",
            "width": 3,
            "height": 4
          }
        }
      }
    },
    {
      "params": {
        "panels": {
          "plan": {
            "shape": "circle",
            "diameter": 5,
            "showDims": false
          },
          "front": {
            "shape": "rectangle",
            "width": 5,
            "height": 4,
            "showDims": false
          },
          "side": {
            "shape": "rectangle",
            "width": 5,
            "height": 4,
            "showDims": false
          }
        },
        "scale": "1 cm represents 2 cm"
      }
    },
    {
      "params": {
        "panels": {
          "side": {
            "shape": "rectangle",
            "width": 6,
            "height": 4,
            "draw": true
          }
        },
        "construct": true,
        "caption": "Drag the corners to draw the side elevation: a 6 cm by 4 cm rectangle."
      }
    },
    {
      "params": {
        "panels": {
          "plan": {
            "shape": "circle",
            "diameter": 6,
            "draw": true
          }
        },
        "construct": true,
        "caption": "Drag the radius handle to draw the plan: a circle of diameter 6 cm."
      }
    },
    {
      "params": {
        "panels": {
          "front": {
            "shape": "triangle",
            "base": 6,
            "height": 7,
            "draw": true
          }
        },
        "construct": true,
        "caption": "Drag the vertices to draw the front elevation: an isosceles triangle, base 6 cm and height 7 cm."
      }
    },
    {
      "params": {
        "panels": {
          "plan": {
            "shape": "polygon",
            "points": [
              [
                0,
                0
              ],
              [
                4,
                0
              ],
              [
                4,
                2
              ],
              [
                2,
                2
              ],
              [
                2,
                5
              ],
              [
                0,
                5
              ]
            ],
            "draw": true
          }
        },
        "construct": true,
        "caption": "Drag the vertices to draw the plan: the L-shaped outline shown, on the grid."
      }
    }
  ]
}
