{
  "ref": "geometry/exact-trig-table@1",
  "family": "geometry",
  "name": "exact-trig-table",
  "version": 1,
  "title": "Exact trig values table",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "functions": {
        "type": "array",
        "minItems": 1,
        "maxItems": 3,
        "items": {
          "type": "string",
          "enum": [
            "sin",
            "cos",
            "tan"
          ]
        }
      },
      "angles": {
        "type": "array",
        "minItems": 1,
        "maxItems": 5,
        "items": {
          "type": "integer",
          "enum": [
            0,
            30,
            45,
            60,
            90
          ]
        }
      },
      "angleUnit": {
        "type": "string",
        "enum": [
          "degrees",
          "radians"
        ]
      },
      "form": {
        "type": "string",
        "enum": [
          "rationalised",
          "surd-denominator"
        ]
      },
      "cells": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "function": {
              "type": "string",
              "enum": [
                "sin",
                "cos",
                "tan"
              ]
            },
            "angle": {
              "type": "integer",
              "enum": [
                0,
                30,
                45,
                60,
                90
              ]
            },
            "occlude": {
              "type": "boolean"
            },
            "blank": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "function",
            "angle"
          ]
        }
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "values": {
            "type": "boolean"
          },
          "approx": {
            "type": "boolean"
          }
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    }
  },
  "examples": [
    {
      "params": {
        "header": "Exact values to memorise",
        "functions": [
          "sin",
          "cos",
          "tan"
        ],
        "angles": [
          0,
          30,
          45,
          60,
          90
        ]
      }
    },
    {
      "params": {
        "functions": [
          "sin",
          "cos",
          "tan"
        ],
        "angles": [
          0,
          30,
          45,
          60,
          90
        ],
        "show": {
          "values": false
        }
      }
    },
    {
      "params": {
        "functions": [
          "sin",
          "cos",
          "tan"
        ],
        "angles": [
          0,
          30,
          45,
          60,
          90
        ],
        "show": {
          "approx": true
        },
        "cells": [
          {
            "function": "sin",
            "angle": 60,
            "highlight": true
          }
        ]
      }
    },
    {
      "params": {
        "header": "Exact values (radians)",
        "functions": [
          "sin",
          "cos",
          "tan"
        ],
        "angles": [
          0,
          30,
          45,
          60,
          90
        ],
        "angleUnit": "radians",
        "show": {
          "approx": true
        }
      }
    },
    {
      "params": {
        "functions": [
          "sin",
          "cos"
        ],
        "angles": [
          0,
          30,
          45,
          60,
          90
        ],
        "cells": [
          {
            "function": "cos",
            "angle": 30,
            "occlude": true
          },
          {
            "function": "cos",
            "angle": 45,
            "occlude": true
          },
          {
            "function": "cos",
            "angle": 60,
            "occlude": true
          }
        ]
      }
    },
    {
      "params": {
        "functions": [
          "sin",
          "cos",
          "tan"
        ],
        "angles": [
          30,
          45,
          60
        ],
        "form": "surd-denominator",
        "caption": "Before rationalising: sin 45° = 1⁄√2 and tan 30° = 1⁄√3."
      }
    }
  ]
}
