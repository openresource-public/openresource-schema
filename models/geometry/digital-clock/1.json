{
  "ref": "geometry/digital-clock@1",
  "family": "geometry",
  "name": "digital-clock",
  "version": 1,
  "title": "Digital clock",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "display": {
        "type": "string",
        "enum": [
          "readout",
          "table"
        ]
      },
      "times": {
        "type": "array",
        "minItems": 1,
        "maxItems": 6,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hour": {
              "type": "integer",
              "minimum": 0,
              "maximum": 23
            },
            "minute": {
              "type": "integer",
              "minimum": 0,
              "maximum": 59
            },
            "label": {
              "type": "string"
            },
            "occlude": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "hour",
                  "minute",
                  "ampm",
                  "twelveHour",
                  "twentyFourHour",
                  "analogue"
                ]
              }
            },
            "highlight": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "hour",
                  "minute",
                  "ampm",
                  "twelveHour",
                  "twentyFourHour",
                  "analogue"
                ]
              }
            }
          },
          "required": [
            "hour",
            "minute"
          ]
        }
      },
      "format": {
        "type": "string",
        "enum": [
          "12",
          "24"
        ]
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "analogue": {
            "type": "boolean"
          },
          "arrow": {
            "type": "boolean"
          },
          "stem": {
            "type": "boolean"
          }
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "times"
    ]
  },
  "examples": [
    {
      "params": {
        "display": "readout",
        "format": "24",
        "times": [
          {
            "hour": 13,
            "minute": 7
          }
        ],
        "header": "In the afternoon"
      }
    },
    {
      "params": {
        "display": "table",
        "times": [
          {
            "hour": 7,
            "minute": 30,
            "label": "Morning"
          },
          {
            "hour": 19,
            "minute": 30,
            "label": "Evening"
          }
        ],
        "caption": "The same clock numbers — but the evening time adds 12 hours"
      }
    },
    {
      "params": {
        "display": "table",
        "times": [
          {
            "hour": 8,
            "minute": 15,
            "occlude": [
              "twentyFourHour"
            ]
          },
          {
            "hour": 14,
            "minute": 40,
            "occlude": [
              "twentyFourHour"
            ]
          },
          {
            "hour": 21,
            "minute": 5,
            "occlude": [
              "twentyFourHour"
            ]
          }
        ]
      }
    },
    {
      "params": {
        "display": "readout",
        "format": "12",
        "times": [
          {
            "hour": 15,
            "minute": 45,
            "label": "Home time",
            "occlude": [
              "ampm"
            ]
          }
        ]
      }
    },
    {
      "params": {
        "display": "table",
        "times": [
          {
            "hour": 6,
            "minute": 5,
            "label": "Wake up"
          },
          {
            "hour": 0,
            "minute": 30,
            "label": "Midnight"
          },
          {
            "hour": 12,
            "minute": 30,
            "label": "Noon"
          },
          {
            "hour": 21,
            "minute": 15,
            "label": "Bedtime"
          }
        ],
        "caption": "Watch the two 12s: midnight becomes 00 and noon stays 12"
      }
    },
    {
      "params": {
        "display": "readout",
        "format": "12",
        "times": [
          {
            "hour": 8,
            "minute": 5,
            "label": "School starts"
          }
        ]
      }
    }
  ]
}
