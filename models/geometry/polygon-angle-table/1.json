{
  "ref": "geometry/polygon-angle-table@1",
  "family": "geometry",
  "name": "polygon-angle-table",
  "version": 1,
  "title": "Polygon angle table",
  "responseModes": [
    "fill-derived"
  ],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "polygons": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "n": {
              "type": "integer",
              "minimum": 3,
              "maximum": 100
            },
            "sum": {
              "type": "number"
            },
            "interior": {
              "type": "number"
            },
            "exterior": {
              "type": "number"
            },
            "name": {
              "type": "string"
            },
            "occlude": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "n",
                  "sum",
                  "interior",
                  "exterior"
                ]
              }
            },
            "highlight": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "n",
                  "sum",
                  "interior",
                  "exterior"
                ]
              }
            }
          },
          "anyOf": [
            {
              "required": [
                "n"
              ]
            },
            {
              "required": [
                "sum"
              ]
            },
            {
              "required": [
                "interior"
              ]
            },
            {
              "required": [
                "exterior"
              ]
            }
          ]
        }
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "names": {
            "type": "boolean"
          },
          "sum": {
            "type": "boolean"
          },
          "interior": {
            "type": "boolean"
          },
          "exterior": {
            "type": "boolean"
          },
          "formulae": {
            "type": "boolean"
          },
          "decimals": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          }
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "polygons"
    ]
  },
  "examples": [
    {
      "params": {
        "header": "Angles of a regular hexagon",
        "polygons": [
          {
            "n": 6
          }
        ],
        "show": {
          "names": true,
          "formulae": true
        },
        "caption": "Interior angles add to (6 − 2) × 180 = 720°; each interior is 120° and each exterior 60°."
      }
    },
    {
      "params": {
        "polygons": [
          {
            "n": 5,
            "occlude": [
              "sum",
              "interior",
              "exterior"
            ]
          }
        ],
        "show": {
          "formulae": true
        },
        "caption": "A regular pentagon has 5 sides. Work out the three angle facts."
      }
    },
    {
      "params": {
        "polygons": [
          {
            "n": 8,
            "occlude": [
              "interior"
            ],
            "highlight": [
              "interior"
            ]
          }
        ]
      }
    },
    {
      "params": {
        "polygons": [
          {
            "interior": 156,
            "occlude": [
              "n",
              "sum"
            ],
            "highlight": [
              "n"
            ]
          }
        ]
      }
    },
    {
      "params": {
        "header": "Regular polygons",
        "polygons": [
          {
            "n": 5
          },
          {
            "n": 6
          },
          {
            "n": 8
          },
          {
            "n": 10
          },
          {
            "n": 12
          }
        ],
        "show": {
          "names": true
        },
        "caption": "As the number of sides grows, each exterior angle shrinks (the sum of exterior angles stays 360°)."
      }
    },
    {
      "params": {
        "polygons": [
          {
            "n": 7,
            "name": "Heptagon"
          }
        ],
        "show": {
          "names": true,
          "decimals": 1
        },
        "caption": "A regular heptagon: each interior angle is 128.6° and each exterior angle 51.4° (1 d.p.)."
      }
    }
  ]
}
