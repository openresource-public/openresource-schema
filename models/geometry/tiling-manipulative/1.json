{
  "ref": "geometry/tiling-manipulative@1",
  "family": "geometry",
  "name": "tiling-manipulative",
  "version": 1,
  "title": "Tangram & pattern blocks",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "set": {
        "type": "string",
        "enum": [
          "tangram",
          "pattern-blocks"
        ]
      },
      "pieces": {
        "type": "array",
        "maxItems": 14,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "small-triangle",
                "medium-triangle",
                "large-triangle",
                "square",
                "parallelogram",
                "triangle",
                "rhombus",
                "trapezoid",
                "hexagon"
              ]
            },
            "at": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "rotation": {
              "type": "number"
            },
            "flip": {
              "type": "boolean"
            },
            "label": {
              "type": "string"
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            },
            "blank": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "at"
          ]
        }
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "pieceAreas": {
            "type": "boolean"
          },
          "fractions": {
            "type": "boolean"
          },
          "total": {
            "type": "boolean"
          },
          "equivalence": {
            "type": "boolean"
          },
          "names": {
            "type": "boolean"
          }
        }
      },
      "occludeTotal": {
        "type": "boolean"
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "set"
    ]
  },
  "examples": [
    {
      "params": {
        "set": "pattern-blocks",
        "pieces": [
          {
            "kind": "triangle",
            "at": [
              -1,
              1
            ],
            "rotation": 0
          },
          {
            "kind": "triangle",
            "at": [
              0,
              0
            ],
            "rotation": 0
          },
          {
            "kind": "triangle",
            "at": [
              0,
              1
            ],
            "rotation": 0
          },
          {
            "kind": "triangle",
            "at": [
              0,
              0
            ],
            "rotation": 60
          },
          {
            "kind": "triangle",
            "at": [
              0,
              1
            ],
            "rotation": 60
          },
          {
            "kind": "triangle",
            "at": [
              1,
              0
            ],
            "rotation": 60
          }
        ],
        "show": {
          "pieceAreas": true,
          "total": true,
          "equivalence": true
        },
        "header": "Six triangles make a hexagon"
      }
    },
    {
      "params": {
        "set": "pattern-blocks",
        "pieces": [
          {
            "kind": "hexagon",
            "at": [
              0,
              0
            ],
            "blank": true
          }
        ]
      }
    },
    {
      "params": {
        "set": "pattern-blocks",
        "pieces": [
          {
            "kind": "rhombus",
            "at": [
              -1,
              1
            ],
            "rotation": 0,
            "highlight": true,
            "occlude": true
          },
          {
            "kind": "rhombus",
            "at": [
              1,
              0
            ],
            "rotation": 60
          },
          {
            "kind": "rhombus",
            "at": [
              1,
              0
            ],
            "rotation": 120
          }
        ],
        "show": {
          "pieceAreas": true,
          "fractions": true
        }
      }
    },
    {
      "params": {
        "set": "tangram",
        "pieces": [
          {
            "kind": "large-triangle",
            "at": [
              0,
              0
            ],
            "rotation": 0
          },
          {
            "kind": "large-triangle",
            "at": [
              4,
              0
            ],
            "rotation": 90
          },
          {
            "kind": "medium-triangle",
            "at": [
              0,
              4
            ],
            "rotation": 270
          },
          {
            "kind": "square",
            "at": [
              0,
              2
            ],
            "rotation": 0
          },
          {
            "kind": "parallelogram",
            "at": [
              1,
              3
            ],
            "rotation": 0
          },
          {
            "kind": "small-triangle",
            "at": [
              3,
              3
            ],
            "rotation": 180
          },
          {
            "kind": "small-triangle",
            "at": [
              0,
              2
            ],
            "rotation": 270
          }
        ],
        "show": {
          "pieceAreas": true,
          "total": true,
          "equivalence": true
        },
        "header": "The tangram square"
      }
    },
    {
      "params": {
        "set": "tangram",
        "pieces": [
          {
            "kind": "large-triangle",
            "at": [
              0,
              0
            ],
            "rotation": 0
          },
          {
            "kind": "large-triangle",
            "at": [
              4,
              0
            ],
            "rotation": 0
          },
          {
            "kind": "medium-triangle",
            "at": [
              4,
              2
            ],
            "rotation": 0
          },
          {
            "kind": "square",
            "at": [
              2,
              2
            ],
            "rotation": 0
          },
          {
            "kind": "parallelogram",
            "at": [
              3,
              1
            ],
            "rotation": 0
          },
          {
            "kind": "small-triangle",
            "at": [
              4,
              2
            ],
            "rotation": 90
          },
          {
            "kind": "small-triangle",
            "at": [
              5,
              1
            ],
            "rotation": 180
          }
        ],
        "show": {
          "total": true
        },
        "caption": "The same seven pieces, rearranged. The total area is still 16 small triangles."
      }
    },
    {
      "params": {
        "set": "pattern-blocks",
        "pieces": [
          {
            "kind": "trapezoid",
            "at": [
              -1,
              1
            ],
            "rotation": 0
          },
          {
            "kind": "trapezoid",
            "at": [
              1,
              1
            ],
            "rotation": 180
          }
        ],
        "show": {
          "names": true,
          "equivalence": true
        },
        "header": "Two trapezoids make a hexagon"
      }
    }
  ]
}
