{
  "ref": "geometry/plan-elevation@1",
  "family": "geometry",
  "name": "plan-elevation",
  "version": 1,
  "title": "Plans and elevations",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "solid": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "heights": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8
              }
            }
          },
          "extent": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8
              },
              "depth": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8
              }
            }
          }
        },
        "required": [
          "heights"
        ]
      },
      "views": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "isometric": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "occlude": {
                "type": "boolean"
              },
              "highlight": {
                "type": "boolean"
              },
              "label": {
                "type": "string"
              }
            }
          },
          "plan": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "occlude": {
                "type": "boolean"
              },
              "highlight": {
                "type": "boolean"
              },
              "label": {
                "type": "string"
              },
              "showHeights": {
                "type": "boolean"
              }
            }
          },
          "front": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "occlude": {
                "type": "boolean"
              },
              "highlight": {
                "type": "boolean"
              },
              "label": {
                "type": "string"
              }
            }
          },
          "side": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "occlude": {
                "type": "boolean"
              },
              "highlight": {
                "type": "boolean"
              },
              "label": {
                "type": "string"
              },
              "from": {
                "type": "string",
                "enum": [
                  "left",
                  "right"
                ]
              }
            }
          }
        }
      },
      "arrows": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "front": {
                "type": "boolean"
              },
              "side": {
                "type": "boolean"
              },
              "frontLabel": {
                "type": "string"
              },
              "sideLabel": {
                "type": "string"
              }
            }
          }
        ]
      },
      "showLabels": {
        "type": "boolean"
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "solid"
    ]
  },
  "examples": [
    {
      "params": {
        "header": "A solid made of cubes",
        "solid": {
          "heights": [
            [
              2,
              2,
              1
            ],
            [
              1,
              1,
              1
            ]
          ]
        },
        "views": {
          "isometric": {},
          "plan": {
            "showHeights": true
          },
          "front": {},
          "side": {}
        },
        "caption": "The solid and its plan, front and side elevations"
      }
    },
    {
      "params": {
        "solid": {
          "heights": [
            [
              1,
              1,
              2
            ],
            [
              1,
              0,
              2
            ]
          ]
        },
        "views": {
          "isometric": {}
        }
      }
    },
    {
      "params": {
        "solid": {
          "heights": [
            [
              3,
              2,
              1
            ],
            [
              1,
              1,
              1
            ]
          ]
        },
        "views": {
          "isometric": {},
          "plan": {},
          "front": {
            "occlude": true
          },
          "side": {}
        }
      }
    },
    {
      "params": {
        "solid": {
          "heights": [
            [
              3,
              2,
              2
            ],
            [
              2,
              1,
              0
            ],
            [
              1,
              0,
              0
            ]
          ]
        },
        "views": {
          "isometric": {},
          "plan": {
            "showHeights": true
          },
          "front": {
            "highlight": true
          },
          "side": {}
        },
        "caption": "Plan, front elevation and side elevation all differ"
      }
    },
    {
      "params": {
        "solid": {
          "heights": [
            [
              2,
              1
            ],
            [
              2,
              1
            ],
            [
              1,
              1
            ]
          ]
        },
        "views": {
          "plan": {},
          "front": {},
          "side": {}
        }
      }
    },
    {
      "params": {
        "solid": {
          "heights": [
            [
              2,
              2,
              2
            ],
            [
              2,
              0,
              0
            ],
            [
              2,
              0,
              0
            ]
          ]
        },
        "views": {
          "isometric": {},
          "plan": {},
          "front": {},
          "side": {
            "from": "right"
          }
        },
        "caption": "An L-shaped prism: only the plan shows the L"
      }
    },
    {
      "params": {
        "solid": {
          "heights": [
            [
              3,
              2,
              2
            ],
            [
              2,
              1,
              0
            ],
            [
              1,
              0,
              0
            ]
          ]
        },
        "views": {
          "isometric": {},
          "plan": {},
          "front": {},
          "side": {}
        },
        "arrows": {
          "side": true
        },
        "caption": "The front and side viewing directions"
      }
    },
    {
      "params": {
        "solid": {
          "heights": [
            [
              1
            ]
          ],
          "extent": {
            "width": 3,
            "depth": 2,
            "height": 3
          }
        },
        "views": {
          "isometric": {},
          "plan": {},
          "front": {},
          "side": {}
        },
        "caption": "Start with a single cube"
      }
    },
    {
      "params": {
        "solid": {
          "heights": [
            [
              3,
              2,
              1
            ],
            [
              2,
              1,
              1
            ]
          ],
          "extent": {
            "width": 3,
            "depth": 2,
            "height": 3
          }
        },
        "views": {
          "isometric": {},
          "plan": {
            "showHeights": true
          },
          "front": {},
          "side": {}
        },
        "caption": "The finished solid and its three views"
      }
    }
  ]
}
