{
  "ref": "geometry/symmetric-pattern@1",
  "family": "geometry",
  "name": "symmetric-pattern",
  "version": 1,
  "title": "Symmetric pattern",
  "responseModes": [
    "select-region"
  ],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "grid": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cols": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          },
          "rows": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          }
        },
        "required": [
          "cols",
          "rows"
        ]
      },
      "axis": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "vertical",
              "horizontal",
              "diagonal"
            ]
          },
          "direction": {
            "type": "string",
            "enum": [
              "main",
              "anti"
            ]
          },
          "show": {
            "type": "boolean"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "type"
        ]
      },
      "cells": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "col": {
              "type": "integer",
              "minimum": 0
            },
            "row": {
              "type": "integer",
              "minimum": 0
            },
            "colour": {
              "type": "string",
              "enum": [
                "blue",
                "teal",
                "purple",
                "coral",
                "green"
              ]
            }
          },
          "required": [
            "col",
            "row"
          ]
        }
      },
      "glyph": {
        "type": "string",
        "enum": [
          "square",
          "disc",
          "diamond"
        ]
      },
      "reveal": {
        "type": "string",
        "enum": [
          "pattern",
          "given"
        ]
      },
      "mirrorReveal": {
        "type": "integer",
        "minimum": 0
      },
      "highlightMirror": {
        "type": "boolean"
      },
      "showGrid": {
        "type": "boolean"
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "grid",
      "axis"
    ]
  },
  "examples": [
    {
      "params": {
        "header": "A symmetrical pattern",
        "grid": {
          "cols": 8,
          "rows": 6
        },
        "axis": {
          "type": "vertical",
          "label": "line of symmetry"
        },
        "cells": [
          {
            "col": 0,
            "row": 1
          },
          {
            "col": 1,
            "row": 1
          },
          {
            "col": 1,
            "row": 2
          },
          {
            "col": 2,
            "row": 2
          },
          {
            "col": 2,
            "row": 3
          },
          {
            "col": 3,
            "row": 3
          },
          {
            "col": 0,
            "row": 4,
            "colour": "coral"
          },
          {
            "col": 1,
            "row": 4,
            "colour": "coral"
          }
        ],
        "caption": "The dashed line is a line of symmetry"
      }
    },
    {
      "params": {
        "grid": {
          "cols": 8,
          "rows": 6
        },
        "axis": {
          "type": "vertical"
        },
        "cells": [
          {
            "col": 0,
            "row": 0
          },
          {
            "col": 1,
            "row": 1
          },
          {
            "col": 2,
            "row": 1
          },
          {
            "col": 0,
            "row": 2
          },
          {
            "col": 3,
            "row": 2
          },
          {
            "col": 0,
            "row": 4,
            "colour": "green"
          },
          {
            "col": 1,
            "row": 4,
            "colour": "green"
          },
          {
            "col": 2,
            "row": 5,
            "colour": "green"
          }
        ],
        "reveal": "given",
        "caption": "Colour the squares so the dashed line is a line of symmetry"
      }
    },
    {
      "params": {
        "header": "Make your own symmetrical pattern",
        "grid": {
          "cols": 6,
          "rows": 6
        },
        "axis": {
          "type": "horizontal",
          "label": "mirror line"
        },
        "reveal": "given",
        "caption": "Colour some squares, then reflect them in the mirror line"
      }
    },
    {
      "params": {
        "header": "Symmetry in a diagonal mirror",
        "grid": {
          "cols": 7,
          "rows": 7
        },
        "axis": {
          "type": "diagonal",
          "direction": "main",
          "label": "line of symmetry"
        },
        "cells": [
          {
            "col": 1,
            "row": 0
          },
          {
            "col": 2,
            "row": 0
          },
          {
            "col": 3,
            "row": 1
          },
          {
            "col": 0,
            "row": 3,
            "colour": "purple"
          },
          {
            "col": 1,
            "row": 4,
            "colour": "purple"
          },
          {
            "col": 2,
            "row": 2,
            "colour": "coral"
          },
          {
            "col": 5,
            "row": 0,
            "colour": "teal"
          }
        ],
        "caption": "Each square reflects across the diagonal to its partner"
      }
    },
    {
      "params": {
        "grid": {
          "cols": 6,
          "rows": 6
        },
        "axis": {
          "type": "vertical",
          "label": "line of symmetry"
        },
        "glyph": "disc",
        "cells": [
          {
            "col": 0,
            "row": 0
          },
          {
            "col": 1,
            "row": 0
          },
          {
            "col": 0,
            "row": 1
          },
          {
            "col": 2,
            "row": 2
          },
          {
            "col": 1,
            "row": 3
          },
          {
            "col": 0,
            "row": 4
          },
          {
            "col": 2,
            "row": 5
          }
        ],
        "highlightMirror": true,
        "caption": "The amber discs are the reflections of the blue ones"
      }
    },
    {
      "params": {
        "header": "A horizontal line of symmetry",
        "grid": {
          "cols": 7,
          "rows": 8
        },
        "axis": {
          "type": "horizontal",
          "label": "line of symmetry"
        },
        "glyph": "diamond",
        "cells": [
          {
            "col": 1,
            "row": 0,
            "colour": "teal"
          },
          {
            "col": 2,
            "row": 1,
            "colour": "teal"
          },
          {
            "col": 3,
            "row": 1
          },
          {
            "col": 4,
            "row": 2
          },
          {
            "col": 5,
            "row": 0,
            "colour": "coral"
          },
          {
            "col": 3,
            "row": 3
          }
        ]
      }
    }
  ]
}
