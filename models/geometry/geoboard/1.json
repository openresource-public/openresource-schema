{
  "ref": "geometry/geoboard@1",
  "family": "geometry",
  "name": "geoboard",
  "version": 1,
  "title": "Geoboard",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "board": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "square-dots",
              "square-lines",
              "iso-dots",
              "iso-lines",
              "circular"
            ]
          },
          "cols": {
            "type": "integer",
            "minimum": 2,
            "maximum": 12
          },
          "rows": {
            "type": "integer",
            "minimum": 2,
            "maximum": 12
          },
          "pins": {
            "type": "integer",
            "minimum": 3,
            "maximum": 24
          }
        }
      },
      "shapes": {
        "type": "array",
        "maxItems": 4,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "points": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "minItems": 1,
                "maxItems": 2
              },
              "minItems": 2,
              "maxItems": 16
            },
            "closed": {
              "type": "boolean"
            },
            "fill": {
              "type": "boolean"
            },
            "label": {
              "type": "string"
            },
            "occludeLabel": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            },
            "marks": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "rightAngles": {
                  "type": "boolean"
                },
                "parallel": {
                  "type": "boolean"
                },
                "equalSides": {
                  "type": "boolean"
                }
              }
            },
            "properties": {
              "type": "boolean"
            }
          },
          "required": [
            "points"
          ]
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    }
  },
  "examples": [
    {
      "params": {
        "board": {
          "type": "square-lines",
          "cols": 6,
          "rows": 5
        },
        "shapes": [
          {
            "points": [
              [
                1,
                1
              ],
              [
                4,
                1
              ],
              [
                4,
                3
              ],
              [
                1,
                3
              ]
            ],
            "fill": true,
            "label": "A",
            "marks": {
              "rightAngles": true,
              "parallel": true
            },
            "properties": true
          }
        ],
        "header": "Rectangle A"
      }
    },
    {
      "params": {
        "board": {
          "type": "square-dots",
          "cols": 5,
          "rows": 5
        },
        "caption": "Stretch a band to make a triangle with exactly one right angle."
      }
    },
    {
      "params": {
        "board": {
          "type": "square-dots",
          "cols": 6,
          "rows": 5
        },
        "shapes": [
          {
            "points": [
              [
                1,
                1
              ],
              [
                5,
                1
              ],
              [
                4,
                3
              ],
              [
                2,
                3
              ]
            ],
            "label": "trapezium",
            "occludeLabel": true,
            "marks": {
              "parallel": true
            }
          }
        ],
        "header": "Name this shape"
      }
    },
    {
      "params": {
        "board": {
          "type": "square-dots",
          "cols": 5,
          "rows": 5
        },
        "shapes": [
          {
            "points": [
              [
                1,
                0
              ],
              [
                3,
                1
              ],
              [
                2,
                3
              ],
              [
                0,
                2
              ]
            ],
            "fill": true,
            "label": "S",
            "marks": {
              "rightAngles": true,
              "equalSides": true
            },
            "properties": true
          }
        ]
      }
    },
    {
      "params": {
        "board": {
          "type": "iso-lines",
          "cols": 5,
          "rows": 3
        },
        "shapes": [
          {
            "points": [
              [
                0,
                0
              ],
              [
                2,
                0
              ],
              [
                3,
                1
              ],
              [
                1,
                1
              ]
            ],
            "fill": true,
            "label": "parallelogram",
            "marks": {
              "parallel": true,
              "equalSides": true
            }
          }
        ],
        "caption": "Both pairs of opposite sides are parallel and equal."
      }
    },
    {
      "params": {
        "board": {
          "type": "circular",
          "pins": 12
        },
        "shapes": [
          {
            "points": [
              [
                0
              ],
              [
                3
              ],
              [
                6
              ],
              [
                9
              ]
            ],
            "fill": true,
            "label": "B",
            "marks": {
              "rightAngles": true,
              "equalSides": true
            },
            "properties": true
          }
        ],
        "header": "Joining every third pin"
      }
    }
  ]
}
