{
  "ref": "geometry/clock@1",
  "family": "geometry",
  "name": "clock",
  "version": 1,
  "title": "Clock face",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "time": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "hour": {
            "type": "integer",
            "minimum": 0,
            "maximum": 23
          },
          "minute": {
            "type": "integer",
            "minimum": 0,
            "maximum": 59
          }
        },
        "required": [
          "hour",
          "minute"
        ]
      },
      "angle": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string",
            "enum": [
              "hour",
              "minute",
              "twelve"
            ]
          },
          "to": {
            "type": "string",
            "enum": [
              "hour",
              "minute",
              "twelve"
            ]
          },
          "reflex": {
            "type": "boolean"
          },
          "show": {
            "type": "string",
            "enum": [
              "degrees",
              "fraction",
              "both",
              "none"
            ]
          },
          "occlude": {
            "type": "boolean"
          }
        }
      },
      "digital": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "show": {
            "type": "boolean"
          },
          "occlude": {
            "type": "boolean"
          }
        }
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "numerals": {
            "type": "boolean"
          },
          "minuteTicks": {
            "type": "boolean"
          },
          "hourHand": {
            "type": "boolean"
          },
          "minuteHand": {
            "type": "boolean"
          }
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "time"
    ]
  },
  "examples": [
    {
      "params": {
        "time": {
          "hour": 3,
          "minute": 30
        },
        "angle": {
          "from": "hour",
          "to": "minute",
          "show": "both"
        },
        "digital": {
          "show": true
        },
        "caption": "The hour hand is half-way to 4, so the angle is 75°"
      }
    },
    {
      "params": {
        "time": {
          "hour": 3,
          "minute": 0
        },
        "angle": {
          "from": "hour",
          "to": "minute",
          "show": "degrees"
        },
        "digital": {
          "show": true
        },
        "caption": "A right angle — on the hour the hour hand is on the 3"
      }
    },
    {
      "params": {
        "time": {
          "hour": 1,
          "minute": 50
        }
      }
    },
    {
      "params": {
        "time": {
          "hour": 9,
          "minute": 0
        },
        "angle": {
          "from": "hour",
          "to": "minute",
          "occlude": true
        }
      }
    },
    {
      "params": {
        "time": {
          "hour": 12,
          "minute": 15
        },
        "angle": {
          "from": "twelve",
          "to": "minute",
          "show": "both"
        },
        "show": {
          "hourHand": false
        },
        "header": "A quarter turn"
      }
    },
    {
      "params": {
        "time": {
          "hour": 8,
          "minute": 0
        },
        "angle": {
          "from": "hour",
          "to": "minute",
          "reflex": true,
          "show": "both"
        },
        "digital": {
          "show": true
        },
        "caption": "Measured the long way round (reflex)"
      }
    }
  ]
}
