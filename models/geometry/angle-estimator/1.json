{
  "ref": "geometry/angle-estimator@1",
  "family": "geometry",
  "name": "angle-estimator",
  "version": 1,
  "title": "Angle estimator",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "size": {
        "type": "number",
        "exclusiveMinimum": 0,
        "exclusiveMaximum": 360
      },
      "rotate": {
        "type": "number"
      },
      "label": {
        "type": "string"
      },
      "occlude": {
        "type": "boolean"
      },
      "highlight": {
        "type": "boolean"
      },
      "armLabels": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 3,
        "maxItems": 3
      },
      "guides": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "right-angle",
            "straight"
          ]
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reading": {
            "type": "boolean"
          },
          "type": {
            "type": "boolean"
          },
          "arc": {
            "type": "boolean"
          }
        }
      }
    },
    "required": [
      "size"
    ]
  },
  "examples": [
    {
      "params": {
        "header": "Types of angle",
        "size": 55,
        "rotate": 12,
        "caption": "This angle is acute — it is less than a right angle."
      }
    },
    {
      "params": {
        "size": 118,
        "rotate": 200,
        "show": {
          "reading": false,
          "type": false
        }
      }
    },
    {
      "params": {
        "size": 68,
        "rotate": 25,
        "occlude": true,
        "guides": [
          "right-angle"
        ]
      }
    },
    {
      "params": {
        "size": 255,
        "rotate": 200,
        "caption": "A reflex angle is bigger than a straight angle (180°)."
      }
    },
    {
      "params": {
        "size": 130,
        "rotate": 8,
        "label": "∠ABC",
        "armLabels": [
          "A",
          "B",
          "C"
        ],
        "caption": "The vertex, B, is the middle letter of the angle name."
      }
    },
    {
      "params": {
        "size": 96,
        "rotate": 30,
        "highlight": true,
        "guides": [
          "right-angle"
        ],
        "caption": "Just bigger than a right angle — this angle is obtuse."
      }
    }
  ]
}
