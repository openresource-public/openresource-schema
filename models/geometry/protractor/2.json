{
  "ref": "geometry/protractor@2",
  "family": "geometry",
  "name": "protractor",
  "version": 2,
  "title": "Protractor",
  "responseModes": [
    "construct"
  ],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "angles": {
        "type": "array",
        "maxItems": 12,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 360
            },
            "label": {
              "type": "string"
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            },
            "fill": {
              "type": "boolean"
            },
            "reflex": {
              "type": "boolean"
            }
          },
          "required": [
            "size"
          ]
        }
      },
      "baseline": {
        "type": "number"
      },
      "measure": {
        "type": "string",
        "enum": [
          "acw",
          "cw"
        ]
      },
      "kind": {
        "type": "string",
        "enum": [
          "semicircle",
          "circle"
        ]
      },
      "construct": {
        "type": "boolean"
      },
      "toleranceDegrees": {
        "type": "number",
        "minimum": 0,
        "maximum": 10
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "protractor": {
            "type": "boolean"
          },
          "scale": {
            "type": "boolean"
          },
          "secondaryScale": {
            "type": "boolean"
          },
          "readings": {
            "type": "boolean"
          },
          "arcs": {
            "type": "boolean"
          }
        }
      },
      "draggable": {
        "type": "boolean"
      }
    },
    "required": [
      "angles"
    ]
  },
  "examples": [
    {
      "params": {
        "header": "Measuring an angle",
        "angles": [
          {
            "size": 55
          }
        ],
        "caption": "The protractor is lined up: the angle measures 55°."
      }
    },
    {
      "params": {
        "angles": []
      }
    },
    {
      "params": {
        "angles": [
          {
            "size": 124,
            "occlude": true
          }
        ]
      }
    },
    {
      "params": {
        "baseline": 23,
        "angles": [
          {
            "size": 138,
            "highlight": true
          }
        ]
      }
    },
    {
      "params": {
        "kind": "circle",
        "header": "How we travel to school",
        "angles": [
          {
            "size": 144,
            "label": "Walk",
            "fill": true
          },
          {
            "size": 90,
            "label": "Car",
            "fill": true
          },
          {
            "size": 84,
            "label": "Bus",
            "fill": true
          },
          {
            "size": 42,
            "label": "Cycle",
            "fill": true
          }
        ]
      }
    },
    {
      "params": {
        "angles": [
          {
            "size": 110,
            "reflex": true,
            "highlight": true
          }
        ],
        "caption": "The reflex angle is 360° − 110° = 250°."
      }
    },
    {
      "params": {
        "construct": true,
        "angles": [
          {
            "size": 72,
            "label": "P"
          }
        ]
      }
    },
    {
      "params": {
        "construct": true,
        "toleranceDegrees": 3,
        "angles": [
          {
            "size": 145,
            "label": "R"
          }
        ]
      }
    }
  ]
}
