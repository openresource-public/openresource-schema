{
  "ref": "geometry/similarity-ratio-table@1",
  "family": "geometry",
  "name": "similarity-ratio-table",
  "version": 1,
  "title": "Similar shapes scale-factor table",
  "responseModes": [
    "fill-derived"
  ],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "given": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "of": {
            "type": "string",
            "enum": [
              "length",
              "area",
              "volume"
            ]
          },
          "value": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "of",
          "value"
        ]
      },
      "occlude": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "length": {
            "type": "boolean"
          },
          "area": {
            "type": "boolean"
          },
          "volume": {
            "type": "boolean"
          }
        }
      },
      "highlight": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "length": {
            "type": "boolean"
          },
          "area": {
            "type": "boolean"
          },
          "volume": {
            "type": "boolean"
          }
        }
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "powers": {
            "type": "boolean"
          },
          "working": {
            "type": "boolean"
          },
          "volume": {
            "type": "boolean"
          }
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "given"
    ]
  },
  "examples": [
    {
      "params": {
        "header": "Length, area and volume scale factors",
        "given": {
          "of": "length",
          "value": 3
        },
        "show": {
          "working": true
        },
        "caption": "The lengths scale by 3, so areas scale by 3² and volumes by 3³."
      }
    },
    {
      "params": {
        "given": {
          "of": "length",
          "value": 4
        },
        "occlude": {
          "area": true,
          "volume": true
        },
        "caption": "Two similar shapes have length scale factor 4. Find the area and volume scale factors."
      }
    },
    {
      "params": {
        "given": {
          "of": "area",
          "value": 9
        },
        "occlude": {
          "length": true,
          "volume": true
        },
        "highlight": {
          "volume": true
        },
        "caption": "The area scale factor of two similar shapes is 9. Work out the length and volume scale factors."
      }
    },
    {
      "params": {
        "header": "Surd scale factor",
        "given": {
          "of": "area",
          "value": 2
        },
        "show": {
          "working": true
        },
        "caption": "The area scale factor is 2, so the length scale factor is √2 and the volume scale factor is 2√2."
      }
    },
    {
      "params": {
        "header": "From the volume ratio",
        "given": {
          "of": "volume",
          "value": 64
        },
        "occlude": {
          "length": true,
          "area": true
        },
        "show": {
          "working": true
        },
        "caption": "Two similar solids have volume scale factor 64. Find the length and area scale factors."
      }
    },
    {
      "params": {
        "given": {
          "of": "length",
          "value": 1.5
        },
        "show": {
          "working": true
        },
        "caption": "A length scale factor of 1.5 gives an area scale factor of 2.25 and a volume scale factor of 3.375."
      }
    }
  ]
}
