{
  "ref": "geometry/scale-drawing@1",
  "family": "geometry",
  "name": "scale-drawing",
  "version": 1,
  "title": "Scale drawing",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "scale": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ratio": {
            "type": "number",
            "exclusiveMinimum": 1
          },
          "drawn": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "drawnUnit": {
            "type": "string",
            "enum": [
              "mm",
              "cm"
            ]
          },
          "real": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "realUnit": {
            "type": "string",
            "enum": [
              "mm",
              "cm",
              "m",
              "km"
            ]
          },
          "displayUnit": {
            "type": "string",
            "enum": [
              "mm",
              "cm",
              "m",
              "km"
            ]
          }
        }
      },
      "points": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "at": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "polar": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "from": {
                  "type": "string"
                },
                "bearing": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 360
                },
                "distance": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "value": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "unit": {
                      "type": "string",
                      "enum": [
                        "mm",
                        "cm",
                        "m",
                        "km"
                      ]
                    },
                    "of": {
                      "type": "string",
                      "enum": [
                        "real",
                        "drawn"
                      ]
                    }
                  },
                  "required": [
                    "value"
                  ]
                }
              },
              "required": [
                "from",
                "bearing",
                "distance"
              ]
            },
            "label": {
              "type": "string"
            },
            "north": {
              "type": "boolean"
            }
          },
          "required": [
            "id"
          ]
        }
      },
      "paths": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "string"
            },
            "to": {
              "type": "string"
            },
            "show": {
              "type": "string",
              "enum": [
                "real",
                "drawn",
                "both",
                "none"
              ]
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            },
            "arrow": {
              "type": "boolean"
            },
            "style": {
              "type": "string",
              "enum": [
                "solid",
                "dashed"
              ]
            },
            "label": {
              "type": "string"
            }
          },
          "required": [
            "from",
            "to"
          ]
        }
      },
      "bearings": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "at": {
              "type": "string"
            },
            "to": {
              "type": "string"
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            },
            "label": {
              "type": "string"
            }
          },
          "required": [
            "at",
            "to"
          ]
        }
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "statement": {
            "type": "boolean"
          },
          "ratio": {
            "type": "boolean"
          },
          "grid": {
            "type": "boolean"
          },
          "northLabels": {
            "type": "boolean"
          }
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      },
      "draggable": {
        "type": "boolean"
      }
    },
    "required": [
      "scale",
      "points"
    ]
  },
  "examples": [
    {
      "params": {
        "header": "Drawing to scale",
        "scale": {
          "ratio": 50000,
          "displayUnit": "km"
        },
        "points": [
          {
            "id": "A",
            "at": [
              0,
              0
            ]
          },
          {
            "id": "B",
            "polar": {
              "from": "A",
              "bearing": 70,
              "distance": {
                "value": 6,
                "unit": "km",
                "of": "real"
              }
            }
          }
        ],
        "paths": [
          {
            "from": "A",
            "to": "B",
            "arrow": true,
            "show": "both"
          }
        ],
        "bearings": [
          {
            "at": "A",
            "to": "B"
          }
        ],
        "caption": "At 1:50 000, 6 km of real distance is drawn 12 cm long."
      }
    },
    {
      "params": {
        "scale": {
          "ratio": 50000,
          "displayUnit": "km"
        },
        "points": [
          {
            "id": "A",
            "at": [
              0,
              0
            ]
          },
          {
            "id": "B",
            "polar": {
              "from": "A",
              "bearing": 70,
              "distance": {
                "value": 6,
                "unit": "km",
                "of": "real"
              }
            }
          }
        ],
        "paths": [
          {
            "from": "A",
            "to": "B",
            "arrow": true,
            "show": "drawn",
            "occlude": true,
            "highlight": true
          }
        ],
        "bearings": [
          {
            "at": "A",
            "to": "B"
          }
        ]
      }
    },
    {
      "params": {
        "scale": {
          "ratio": 25000,
          "displayUnit": "km"
        },
        "points": [
          {
            "id": "A",
            "at": [
              0,
              0
            ]
          },
          {
            "id": "B",
            "polar": {
              "from": "A",
              "bearing": 90,
              "distance": {
                "value": 8,
                "unit": "cm",
                "of": "drawn"
              }
            }
          }
        ],
        "paths": [
          {
            "from": "A",
            "to": "B",
            "show": "both",
            "occlude": true,
            "highlight": true
          }
        ],
        "caption": "On a 1:25 000 map, A to B measures 8 cm. Work out the real distance."
      }
    },
    {
      "params": {
        "scale": {
          "drawnUnit": "cm",
          "real": 5,
          "realUnit": "km"
        },
        "points": [
          {
            "id": "P",
            "at": [
              0,
              0
            ],
            "label": "Pelton"
          },
          {
            "id": "Q",
            "polar": {
              "from": "P",
              "bearing": 118,
              "distance": {
                "value": 7,
                "unit": "cm",
                "of": "drawn"
              }
            },
            "label": "Quarry"
          }
        ],
        "paths": [
          {
            "from": "P",
            "to": "Q",
            "show": "both"
          }
        ],
        "caption": "The map distance is 7 cm, so the real distance is 35 km."
      }
    },
    {
      "params": {
        "header": "Plan of a field",
        "scale": {
          "ratio": 500,
          "displayUnit": "m"
        },
        "points": [
          {
            "id": "A",
            "at": [
              0,
              0
            ]
          },
          {
            "id": "B",
            "at": [
              40,
              0
            ]
          },
          {
            "id": "C",
            "at": [
              40,
              30
            ]
          },
          {
            "id": "D",
            "at": [
              0,
              30
            ]
          }
        ],
        "paths": [
          {
            "from": "A",
            "to": "B",
            "show": "both"
          },
          {
            "from": "B",
            "to": "C",
            "show": "both"
          },
          {
            "from": "C",
            "to": "D",
            "show": "none"
          },
          {
            "from": "D",
            "to": "A",
            "show": "none"
          }
        ],
        "caption": "A rectangular field 40 m by 30 m drawn at a scale of 1:500."
      }
    },
    {
      "params": {
        "scale": {
          "ratio": 100000,
          "displayUnit": "km"
        },
        "points": [
          {
            "id": "A",
            "at": [
              0,
              0
            ],
            "north": true
          },
          {
            "id": "B",
            "polar": {
              "from": "A",
              "bearing": 55,
              "distance": {
                "value": 9,
                "unit": "cm",
                "of": "drawn"
              }
            }
          },
          {
            "id": "C",
            "polar": {
              "from": "B",
              "bearing": 140,
              "distance": {
                "value": 7,
                "unit": "cm",
                "of": "drawn"
              }
            }
          }
        ],
        "paths": [
          {
            "from": "A",
            "to": "B",
            "arrow": true,
            "show": "drawn"
          },
          {
            "from": "B",
            "to": "C",
            "arrow": true,
            "show": "real",
            "occlude": true
          }
        ],
        "caption": "AB is 9 cm on the map. Use the scale to work out the real distance for each leg."
      }
    }
  ]
}
