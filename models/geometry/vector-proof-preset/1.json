{
  "ref": "geometry/vector-proof-preset@1",
  "family": "geometry",
  "name": "vector-proof-preset",
  "version": 1,
  "title": "Vector proof (preset shapes)",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "$defs": {
      "pair": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[A-Z]$"
        },
        "minItems": 2,
        "maxItems": 2
      },
      "ratio": {
        "type": "array",
        "items": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "minItems": 2,
        "maxItems": 2
      }
    },
    "properties": {
      "figure": {
        "type": "string",
        "enum": [
          "triangle",
          "parallelogram",
          "hexagon"
        ]
      },
      "base": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "a": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "coeff": {
                "type": "integer",
                "minimum": 1
              },
              "label": {
                "type": "string"
              }
            }
          },
          "b": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "coeff": {
                "type": "integer",
                "minimum": 1
              },
              "label": {
                "type": "string"
              }
            }
          }
        }
      },
      "points": {
        "type": "array",
        "maxItems": 6,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[A-Z]$"
            },
            "midpoint": {
              "$ref": "#/$defs/pair"
            },
            "divide": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "of": {
                  "$ref": "#/$defs/pair"
                },
                "ratio": {
                  "$ref": "#/$defs/ratio"
                }
              },
              "required": [
                "of",
                "ratio"
              ]
            },
            "extend": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "of": {
                  "$ref": "#/$defs/pair"
                },
                "ratio": {
                  "$ref": "#/$defs/ratio"
                }
              },
              "required": [
                "of",
                "ratio"
              ]
            },
            "ray": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "of": {
                  "$ref": "#/$defs/pair"
                },
                "ratio": {
                  "$ref": "#/$defs/ratio"
                }
              },
              "required": [
                "of",
                "ratio"
              ]
            },
            "unknown": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "on": {
                  "$ref": "#/$defs/pair"
                }
              },
              "required": [
                "on"
              ]
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "name"
          ],
          "oneOf": [
            {
              "required": [
                "midpoint"
              ]
            },
            {
              "required": [
                "divide"
              ]
            },
            {
              "required": [
                "extend"
              ]
            },
            {
              "required": [
                "ray"
              ]
            },
            {
              "required": [
                "unknown"
              ]
            }
          ]
        }
      },
      "task": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "find": {
            "type": "string",
            "pattern": "^[A-Z][A-Z]$"
          },
          "express": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z]$"
            },
            "maxItems": 8
          },
          "as": {
            "type": "string",
            "enum": [
              "vector",
              "scalar"
            ]
          },
          "scalarName": {
            "type": "string"
          },
          "prove": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]$"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "occlude": {
            "type": "boolean"
          }
        }
      },
      "solution": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "show": {
            "type": "boolean"
          },
          "reveal": {
            "type": "integer",
            "minimum": 0
          },
          "highlightAnswer": {
            "type": "boolean"
          }
        }
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "vertexLabels": {
            "type": "boolean"
          },
          "pointLabels": {
            "type": "boolean"
          },
          "arrows": {
            "type": "boolean"
          },
          "inner": {
            "type": "boolean"
          }
        }
      },
      "highlight": {
        "type": "array",
        "items": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]$"
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "figure"
    ]
  },
  "examples": [
    {
      "params": {
        "figure": "triangle",
        "points": [
          {
            "name": "P",
            "divide": {
              "of": [
                "A",
                "B"
              ],
              "ratio": [
                1,
                2
              ]
            }
          }
        ],
        "task": {
          "find": "OP",
          "occlude": true
        },
        "caption": "P lies on AB with AP:PB = 1:2. Express OP in terms of a and b."
      }
    },
    {
      "params": {
        "figure": "triangle",
        "base": {
          "a": {
            "coeff": 2
          }
        },
        "points": [
          {
            "name": "P",
            "divide": {
              "of": [
                "A",
                "B"
              ],
              "ratio": [
                1,
                2
              ]
            }
          }
        ],
        "task": {
          "find": "OP"
        },
        "solution": {
          "show": true,
          "highlightAnswer": true
        },
        "caption": "P lies on AB with AP:PB = 1:2. Express OP in terms of a and b."
      }
    },
    {
      "params": {
        "figure": "triangle",
        "base": {
          "b": {
            "coeff": 3
          }
        },
        "points": [
          {
            "name": "P",
            "divide": {
              "of": [
                "A",
                "B"
              ],
              "ratio": [
                3,
                1
              ]
            }
          }
        ],
        "task": {
          "find": "OP",
          "as": "scalar",
          "occlude": true
        },
        "caption": "P lies on AB with AP:PB = 3:1, and OP = k(a + 9b). Find the value of k."
      }
    },
    {
      "params": {
        "figure": "hexagon",
        "points": [
          {
            "name": "M",
            "midpoint": [
              "E",
              "F"
            ]
          },
          {
            "name": "X",
            "extend": {
              "of": [
                "C",
                "D"
              ],
              "ratio": [
                2,
                3
              ]
            }
          }
        ],
        "task": {
          "find": "MX"
        },
        "solution": {
          "show": true
        },
        "caption": "M is the midpoint of EF and X is on CD extended with CD:DX = 2:3. Express MX in terms of a and b."
      }
    },
    {
      "params": {
        "figure": "triangle",
        "base": {
          "a": {
            "coeff": 4
          },
          "b": {
            "coeff": 2
          }
        },
        "points": [
          {
            "name": "C",
            "divide": {
              "of": [
                "O",
                "A"
              ],
              "ratio": [
                3,
                1
              ]
            }
          },
          {
            "name": "M",
            "midpoint": [
              "A",
              "B"
            ]
          },
          {
            "name": "D",
            "ray": {
              "of": [
                "O",
                "B"
              ],
              "ratio": [
                2,
                3
              ]
            }
          }
        ],
        "task": {
          "prove": [
            "C",
            "M",
            "D"
          ]
        },
        "solution": {
          "show": true
        }
      }
    },
    {
      "params": {
        "figure": "triangle",
        "base": {
          "a": {
            "coeff": 3
          }
        },
        "points": [
          {
            "name": "C",
            "divide": {
              "of": [
                "O",
                "A"
              ],
              "ratio": [
                2,
                1
              ]
            }
          },
          {
            "name": "D",
            "midpoint": [
              "A",
              "B"
            ]
          },
          {
            "name": "E",
            "unknown": {
              "on": [
                "O",
                "B"
              ]
            }
          }
        ],
        "task": {
          "prove": [
            "C",
            "D",
            "E"
          ],
          "find": "BE"
        },
        "solution": {
          "show": true,
          "highlightAnswer": true
        },
        "caption": "C, D and E lie on a straight line, and OB is extended to E. Find BE."
      }
    },
    {
      "params": {
        "figure": "hexagon",
        "base": {
          "a": {
            "coeff": 2,
            "label": "p"
          },
          "b": {
            "coeff": 2,
            "label": "q"
          }
        },
        "show": {
          "inner": true
        },
        "task": {
          "express": [
            "OA",
            "OB",
            "OC",
            "OD",
            "OE",
            "OF"
          ]
        },
        "solution": {
          "show": true
        },
        "caption": "Two regular hexagons with centre O. OA = 2p and OB = 2q. Write each outer vertex’s position vector in terms of p and q."
      }
    }
  ]
}
