            "type": "boolean"
          },
          "joinSeam": {
            "type": "boolean"
          },
          "hiddenEdges": {
            "type": "boolean"
          },
          "diameter": {
            "type": "boolean"
          }
        }
      },
      "reveal": {
        "type": "integer",
        "minimum": 1
      },
      "header": {
        "type": "string"
      }
    }
  },
