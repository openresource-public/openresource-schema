{
  "ref": "geometry/composite-solid@2",
  "family": "geometry",
  "name": "composite-solid",
  "version": 2,
  "title": "Composite solid (isometric)",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "parts"
    ],
    "properties": {
      "parts": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shape",
            "dims"
          ],
          "properties": {
            "shape": {
              "type": "string",
              "enum": [
                "cuboid",
                "cylinder",
                "cone",
                "pyramid",
                "hemisphere",
                "frustum"
              ]
            },
            "dims": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "depth": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "height": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "radius": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "baseRadius": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "topRadius": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            },
            "label": {
              "type": "string"
            },
            "letter": {
              "type": "string"
            },
            "occlude": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "width",
                  "depth",
                  "height",
                  "radius",
                  "baseRadius",
                  "topRadius"
                ]
              }
            },
            "highlight": {
              "type": "boolean"
            },
            "shade": {
              "type": "boolean"
            },
            "diameter": {
              "type": "boolean"
            },
            "orient": {
              "type": "string",
              "enum": [
                "up",
                "down"
              ]
            },
            "op": {
              "type": "string",
              "enum": [
                "add",
                "subtract"
              ]
            }
          }
        }
      },
      "unit": {
        "type": "string"
      },
      "view": {
        "type": "string",
        "enum": [
          "assembled",
          "exploded",
          "both"
        ]
      },
      "volume": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "occlude": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          }
        }
      },
      "surfaceArea": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "occlude": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          }
        }
      },
