              "type": "string"
            },
            "from": {
              "type": "string"
            },
            "to": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            },
            "bare": {
              "type": "boolean"
            },
            "rightAngle": {
              "type": "boolean"
            },
            "reflex": {
              "type": "boolean"
            },
            "mark": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            }
          },
          "required": [
            "at",
            "from",
            "to"
          ]
        }
      },
      "shades": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "loop": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "loop"
          ]
        }
      },
      "hideLabels": {
        "type": "array",
