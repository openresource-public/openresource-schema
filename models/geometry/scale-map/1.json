{
  "ref": "geometry/scale-map@1",
  "family": "geometry",
  "name": "scale-map",
  "version": 1,
  "title": "Scale map",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "grid": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cols": {
            "type": "integer",
            "minimum": 2,
            "maximum": 12
          },
          "rows": {
            "type": "integer",
            "minimum": 2,
            "maximum": 12
          },
          "showLines": {
            "type": "boolean"
          }
        },
        "required": [
          "cols",
          "rows"
        ]
      },
      "scale": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "real": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "realUnit": {
            "type": "string",
            "enum": [
              "mm",
              "cm",
              "m",
              "km"
            ]
          },
          "square": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "statement": {
            "type": "boolean"
          }
        },
        "required": [
          "real",
          "realUnit"
        ]
      },
      "landmarks": {
        "type": "array",
        "maxItems": 12,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "at": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "minItems": 2,
              "maxItems": 2
            },
            "label": {
              "type": "string"
            },
            "icon": {
              "type": "string",
              "enum": [
                "pin",
                "home",
                "school",
                "tree",
                "church",
                "shop",
                "pond",
                "mountain",
                "flag",
                "star"
              ]
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "at"
          ]
        }
      },
      "arrows": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "string"
            },
            "to": {
              "type": "string"
            },
            "via": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 2,
                "maxItems": 2
              }
            },
            "show": {
              "type": "string",
              "enum": [
                "distance",
                "direction",
                "both",
                "none"
              ]
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            },
            "style": {
              "type": "string",
              "enum": [
                "solid",
                "dashed"
              ]
            }
          },
          "required": [
            "from",
            "to"
          ]
        }
      },
      "compass": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "show": {
            "type": "boolean"
          },
          "points": {
            "type": "integer",
            "enum": [
              4,
              8
            ]
          },
          "position": {
            "type": "string",
            "enum": [
              "top-right",
              "top-left",
              "bottom-right",
              "bottom-left"
            ]
          },
          "occlude": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          }
        }
      },
      "scaleBar": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "show": {
            "type": "boolean"
          },
          "squares": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "numberLine": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "show": {
            "type": "boolean"
          },
          "upTo": {
            "type": "integer",
            "minimum": 1
          },
          "mark": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "squares": {
                "type": "number",
                "minimum": 0
              },
              "occlude": {
                "type": "boolean"
              },
              "highlight": {
                "type": "boolean"
              }
            },
            "required": [
              "squares"
            ]
          }
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "grid",
      "scale"
    ]
  },
  "examples": [
    {
      "params": {
        "header": "Hillside village",
        "grid": {
          "cols": 6,
          "rows": 6
        },
        "scale": {
          "real": 2,
          "realUnit": "km"
        },
        "landmarks": [
          {
            "id": "school",
            "at": [
              1,
              4
            ],
            "label": "School",
            "icon": "school"
          },
          {
            "id": "park",
            "at": [
              4,
              4
            ],
            "label": "Park",
            "icon": "tree"
          },
          {
            "id": "shop",
            "at": [
              4,
              1
            ],
            "label": "Shop",
            "icon": "shop"
          },
          {
            "id": "pond",
            "at": [
              1,
              1
            ],
            "label": "Pond",
            "icon": "pond"
          }
        ],
        "arrows": [
          {
            "from": "school",
            "to": "park",
            "show": "both"
          },
          {
            "from": "park",
            "to": "shop",
            "show": "distance"
          }
        ],
        "caption": "Each square is 2 km. The park is 6 km East of the school."
      }
    },
    {
      "params": {
        "grid": {
          "cols": 7,
          "rows": 5
        },
        "scale": {
          "real": 1,
          "realUnit": "km"
        },
        "landmarks": [
          {
            "id": "home",
            "at": [
              1,
              1
            ],
            "label": "Home",
            "icon": "home"
          },
          {
            "id": "school",
            "at": [
              1,
              4
            ],
            "label": "School",
            "icon": "school"
          },
          {
            "id": "shop",
            "at": [
              5,
              4
            ],
            "label": "Shop",
            "icon": "shop"
          }
        ],
        "arrows": [
          {
            "from": "home",
            "to": "school",
            "show": "distance",
            "occlude": true
          },
          {
            "from": "school",
            "to": "shop",
            "show": "distance",
            "occlude": true
          }
        ],
        "numberLine": {
          "upTo": 5
        }
      }
    },
    {
      "params": {
        "grid": {
          "cols": 6,
          "rows": 5
        },
        "scale": {
          "real": 5,
          "realUnit": "km"
        },
        "landmarks": [
          {
            "id": "church",
            "at": [
              1,
              3
            ],
            "label": "Church",
            "icon": "church"
          },
          {
            "id": "farm",
            "at": [
              5,
              3
            ],
            "label": "Farm",
            "icon": "home"
          }
        ],
        "arrows": [
          {
            "from": "church",
            "to": "farm",
            "show": "distance",
            "occlude": true,
            "highlight": true
          }
        ]
      }
    },
    {
      "params": {
        "grid": {
          "cols": 6,
          "rows": 6
        },
        "scale": {
          "real": 2,
          "realUnit": "km"
        },
        "landmarks": [
          {
            "id": "harbour",
            "at": [
              1,
              1
            ],
            "label": "Harbour",
            "icon": "pin"
          },
          {
            "id": "light",
            "at": [
              4,
              5
            ],
            "label": "Lighthouse",
            "icon": "flag"
          }
        ],
        "arrows": [
          {
            "from": "harbour",
            "to": "light",
            "show": "distance",
            "highlight": true
          },
          {
            "from": "harbour",
            "to": "light",
            "via": [
              [
                4,
                1
              ]
            ],
            "show": "distance",
            "style": "dashed"
          }
        ],
        "caption": "Straight across it is 10 km; along the roads (dashed) it is 14 km."
      }
    },
    {
      "params": {
        "header": "The scale as a number line",
        "grid": {
          "cols": 5,
          "rows": 4
        },
        "scale": {
          "real": 10,
          "realUnit": "m"
        },
        "landmarks": [
          {
            "id": "gate",
            "at": [
              0,
              0
            ],
            "label": "Gate",
            "icon": "pin"
          },
          {
            "id": "oak",
            "at": [
              4,
              0
            ],
            "label": "Oak",
            "icon": "tree"
          }
        ],
        "arrows": [
          {
            "from": "gate",
            "to": "oak",
            "show": "distance",
            "occlude": true
          }
        ],
        "numberLine": {
          "upTo": 5,
          "mark": {
            "squares": 4,
            "occlude": true,
            "highlight": true
          }
        }
      }
    },
    {
      "params": {
        "grid": {
          "cols": 6,
          "rows": 6
        },
        "scale": {
          "real": 1,
          "realUnit": "km"
        },
        "landmarks": [
          {
            "id": "well",
            "at": [
              3,
              3
            ],
            "label": "Well",
            "icon": "pin"
          },
          {
            "id": "mill",
            "at": [
              3,
              5
            ],
            "label": "Windmill",
            "icon": "flag"
          },
          {
            "id": "pond",
            "at": [
              5,
              3
            ],
            "label": "Pond",
            "icon": "pond"
          },
          {
            "id": "wood",
            "at": [
              3,
              1
            ],
            "label": "Wood",
            "icon": "tree"
          }
        ],
        "arrows": [
          {
            "from": "well",
            "to": "mill",
            "show": "direction"
          },
          {
            "from": "well",
            "to": "pond",
            "show": "direction"
          }
        ],
        "compass": {
          "points": 8,
          "occlude": true
        },
        "caption": "North is shown. Label the other points, then say which way each place is from the well."
      }
    }
  ]
}
