{
  "ref": "geometry/area-grid@1",
  "family": "geometry",
  "name": "area-grid",
  "version": 1,
  "title": "Area on squared paper",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "grid": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cols": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "rows": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        }
      },
      "shapes": {
        "type": "array",
        "maxItems": 4,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rects": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "minItems": 4,
                "maxItems": 4
              }
            },
            "cells": {
              "type": "array",
              "maxItems": 80,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "at": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "half": {
                    "type": "string",
                    "enum": [
                      "BL",
                      "BR",
                      "TL",
                      "TR"
                    ]
                  }
                },
                "required": [
                  "at"
                ]
              }
            },
            "label": {
              "type": "string"
            },
            "occludeLabel": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            },
            "area": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "occlude": {
                  "type": "boolean"
                },
                "highlight": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      },
      "subdivisions": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cell": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "into": {
              "type": "integer",
              "minimum": 2,
              "maximum": 10
            },
            "dir": {
              "type": "string",
              "enum": [
                "rows",
                "cols"
              ]
            },
            "shaded": {
              "type": "integer",
              "minimum": 0
            },
            "shape": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "cell",
            "into"
          ]
        }
      },
      "compare": {
        "type": "boolean"
      },
      "unit": {
        "type": "string"
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tally": {
            "type": "boolean"
          },
          "area": {
            "type": "boolean"
          },
          "grid": {
            "type": "boolean"
          }
        }
      },
      "stem": {
        "type": "boolean"
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    }
  },
  "examples": [
    {
      "params": {
        "grid": {
          "cols": 7,
          "rows": 6
        },
        "header": "Your turn"
      }
    },
    {
      "params": {
        "grid": {
          "cols": 7,
          "rows": 6
        },
        "shapes": [
          {
            "rects": [
              [
                1,
                1,
                4,
                1
              ],
              [
                1,
                2,
                1,
                3
              ]
            ]
          }
        ],
        "show": {
          "tally": true
        },
        "stem": true
      }
    },
    {
      "params": {
        "grid": {
          "cols": 7,
          "rows": 5
        },
        "shapes": [
          {
            "rects": [
              [
                1,
                1,
                3,
                2
              ]
            ],
            "label": "R",
            "area": {
              "occlude": true
            }
          }
        ]
      }
    },
    {
      "params": {
        "grid": {
          "cols": 6,
          "rows": 5
        },
        "shapes": [
          {
            "cells": [
              {
                "at": [
                  1,
                  1
                ]
              },
              {
                "at": [
                  2,
                  1
                ]
              },
              {
                "at": [
                  1,
                  2
                ]
              },
              {
                "at": [
                  3,
                  1
                ],
                "half": "BL"
              },
              {
                "at": [
                  2,
                  2
                ],
                "half": "BL"
              },
              {
                "at": [
                  1,
                  3
                ],
                "half": "BL"
              }
            ],
            "area": {
              "occlude": true
            }
          }
        ],
        "show": {
          "tally": true
        },
        "caption": "Two half-squares make one whole square."
      }
    },
    {
      "params": {
        "grid": {
          "cols": 9,
          "rows": 5
        },
        "shapes": [
          {
            "rects": [
              [
                0,
                1,
                2,
                3
              ]
            ],
            "label": "A"
          },
          {
            "rects": [
              [
                4,
                1,
                3,
                1
              ],
              [
                4,
                2,
                1,
                3
              ]
            ],
            "label": "B"
          }
        ],
        "compare": true
      }
    },
    {
      "params": {
        "grid": {
          "cols": 7,
          "rows": 2
        },
        "subdivisions": [
          {
            "cell": [
              0,
              0
            ],
            "into": 2,
            "shaded": 1
          },
          {
            "cell": [
              3,
              0
            ],
            "into": 4,
            "shaded": 1,
            "dir": "cols"
          },
          {
            "cell": [
              5,
              0
            ],
            "into": 4,
            "shaded": 3
          }
        ],
        "show": {
          "grid": true
        },
        "header": "Fractions of a square"
      }
    }
  ]
}
