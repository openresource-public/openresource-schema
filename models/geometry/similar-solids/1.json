{
  "ref": "geometry/similar-solids@1",
  "family": "geometry",
  "name": "similar-solids",
  "version": 1,
  "title": "Similar solids (pair)",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "shape": {
        "type": "string",
        "enum": [
          "cylinder",
          "cone",
          "frustum",
          "sphere"
        ]
      },
      "k": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "orientation": {
        "type": "string",
        "enum": [
          "upright",
          "lying"
        ]
      },
      "a": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "dims": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "radius": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "diameter": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "length": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "baseRadius": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "topRadius": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "letter": {
            "type": "string"
          },
          "label": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "radius",
                "diameter",
                "length",
                "height",
                "baseRadius",
                "topRadius"
              ]
            }
          },
          "occlude": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "radius",
                "diameter",
                "length",
                "height",
                "baseRadius",
                "topRadius"
              ]
            }
          },
          "highlight": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "radius",
                "diameter",
                "length",
                "height",
                "baseRadius",
                "topRadius"
              ]
            }
          },
          "symbol": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "radius": {
                "type": "string"
              },
              "diameter": {
                "type": "string"
              },
              "length": {
                "type": "string"
              },
              "height": {
                "type": "string"
              },
              "baseRadius": {
                "type": "string"
              },
              "topRadius": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "dims"
        ]
      },
      "b": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "letter": {
            "$ref": "#/properties/a/properties/letter"
          },
          "label": {
            "$ref": "#/properties/a/properties/label"
          },
          "occlude": {
            "$ref": "#/properties/a/properties/occlude"
          },
          "highlight": {
            "$ref": "#/properties/a/properties/highlight"
          },
          "symbol": {
            "$ref": "#/properties/a/properties/symbol"
          }
        }
      },
      "unit": {
        "type": "string"
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scaleArrow": {
            "type": "boolean"
          },
          "second": {
            "type": "boolean"
          },
          "hiddenEdges": {
            "type": "boolean"
          }
        }
      },
      "header": {
        "type": "string"
      }
    },
    "required": [
      "shape",
      "k",
      "a"
    ]
  },
  "examples": [
    {
      "params": {
        "header": "Cone B is similar to cone A",
        "shape": "cone",
        "k": 2,
        "unit": "cm",
        "a": {
          "dims": {
            "radius": 3,
            "height": 5
          },
          "letter": "A",
          "label": [
            "height"
          ]
        },
        "b": {
          "letter": "B",
          "label": [
            "height"
          ]
        }
      }
    },
    {
      "params": {
        "shape": "cylinder",
        "orientation": "upright",
        "k": 1.5,
        "unit": "cm",
        "a": {
          "dims": {
            "radius": 4,
            "length": 6
          },
          "letter": "A",
          "label": [
            "radius"
          ]
        },
        "b": {
          "letter": "B",
          "label": [
            "radius"
          ],
          "highlight": [
            "radius"
          ]
        },
        "show": {
          "scaleArrow": true
        }
      }
    },
    {
      "params": {
        "shape": "cone",
        "k": 3,
        "unit": "cm",
        "a": {
          "dims": {
            "radius": 2,
            "height": 4
          },
          "letter": "A",
          "label": [
            "height"
          ]
        },
        "b": {
          "letter": "B",
          "label": [
            "height"
          ],
          "occlude": [
            "height"
          ],
          "highlight": [
            "height"
          ]
        }
      }
    },
    {
      "params": {
        "header": "Two similar buckets",
        "shape": "frustum",
        "k": 2,
        "unit": "cm",
        "a": {
          "dims": {
            "baseRadius": 5,
            "topRadius": 3,
            "height": 6
          },
          "letter": "A",
          "label": [
            "baseRadius"
          ]
        },
        "b": {
          "letter": "B",
          "label": [
            "baseRadius"
          ]
        }
      }
    },
    {
      "params": {
        "header": "Two similar pipes",
        "shape": "cylinder",
        "orientation": "lying",
        "k": 1.5,
        "unit": "cm",
        "a": {
          "dims": {
            "radius": 2,
            "length": 6
          },
          "letter": "A",
          "label": [
            "length"
          ]
        },
        "b": {
          "letter": "B",
          "label": [
            "length"
          ]
        }
      }
    },
    {
      "params": {
        "shape": "sphere",
        "k": 3,
        "unit": "cm",
        "a": {
          "dims": {
            "radius": 2
          },
          "letter": "A",
          "label": [
            "radius"
          ]
        },
        "b": {
          "letter": "B",
          "label": [
            "radius"
          ],
          "highlight": [
            "radius"
          ]
        },
        "show": {
          "scaleArrow": true
        }
      }
    }
  ]
}
