{
  "ref": "number/number-track@1",
  "family": "number",
  "name": "number-track",
  "version": 1,
  "title": "Number track",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "start": {
        "type": "number"
      },
      "step": {
        "type": "number"
      },
      "length": {
        "type": "integer",
        "minimum": 2,
        "maximum": 20
      },
      "cells": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "index": {
              "type": "integer",
              "minimum": 0
            },
            "occlude": {
              "type": "boolean"
            },
            "blank": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            },
            "loose": {
              "type": "boolean"
            }
          },
          "required": [
            "index"
          ],
          "not": {
            "required": [
              "blank",
              "loose"
            ]
          }
        }
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "values": {
            "type": "boolean"
          },
          "greaterArrow": {
            "type": "boolean"
          }
        }
      },
      "stem": {
        "type": "string",
        "enum": [
          "none",
          "rule"
        ]
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "start",
      "length"
    ]
  },
  "examples": [
    {
      "params": {
        "header": "Number track to 10",
        "start": 1,
        "step": 1,
        "length": 10,
        "stem": "rule"
      }
    },
    {
      "params": {
        "start": 0,
        "step": 5,
        "length": 9,
        "show": {
          "values": false
        }
      }
    },
    {
      "params": {
        "start": 3,
        "step": 3,
        "length": 8,
        "cells": [
          {
            "index": 3,
            "occlude": true
          },
          {
            "index": 5,
            "occlude": true
          }
        ]
      }
    },
    {
      "params": {
        "start": 40,
        "step": 10,
        "length": 7,
        "cells": [
          {
            "index": 1,
            "blank": true
          },
          {
            "index": 2,
            "blank": true
          },
          {
            "index": 3,
            "blank": true
          },
          {
            "index": 5,
            "blank": true
          },
          {
            "index": 6,
            "blank": true
          }
        ],
        "caption": "Two numbers are filled in. Work out the step, then fill in the rest."
      }
    },
    {
      "params": {
        "header": "Place the number",
        "start": 1,
        "step": 1,
        "length": 6,
        "cells": [
          {
            "index": 3,
            "loose": true
          }
        ],
        "caption": "Where does the card 4 go? Place it in the right box."
      }
    },
    {
      "params": {
        "header": "Counting back past zero",
        "start": 10,
        "step": -4,
        "length": 7,
        "cells": [
          {
            "index": 4,
            "occlude": true
          }
        ],
        "show": {
          "greaterArrow": true
        },
        "stem": "rule"
      }
    }
  ]
}
