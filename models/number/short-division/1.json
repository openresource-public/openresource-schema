{
  "ref": "number/short-division@1",
  "family": "number",
  "name": "short-division",
  "version": 1,
  "title": "Short division (bus-stop method)",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "dividend": {
        "type": "number",
        "minimum": 0
      },
      "divisor": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "form": {
        "type": "string",
        "enum": [
          "remainder",
          "decimal"
        ]
      },
      "decimalPlaces": {
        "type": "integer",
        "minimum": 1,
        "maximum": 8
      },
      "method": {
        "type": "string",
        "enum": [
          "short"
        ]
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "quotient": {
            "type": "boolean"
          },
          "carries": {
            "type": "boolean"
          },
          "remainder": {
            "type": "boolean"
          },
          "rescale": {
            "type": "boolean"
          },
          "decimalCarry": {
            "type": "boolean"
          }
        }
      },
      "occlude": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "quotient": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            ]
          },
          "remainder": {
            "type": "boolean"
          },
          "carries": {
            "type": "boolean"
          }
        }
      },
      "reveal": {
        "type": "integer",
        "minimum": 0
      },
      "highlight": {
        "type": "boolean"
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "dividend",
      "divisor"
    ]
  },
  "examples": [
    {
      "params": {
        "dividend": 196,
        "divisor": 7,
        "show": {
          "carries": true
        },
        "caption": "196 ÷ 7"
      }
    },
    {
      "params": {
        "header": "Short division",
        "dividend": 162,
        "divisor": 3,
        "show": {
          "quotient": false
        }
      }
    },
    {
      "params": {
        "dividend": 437,
        "divisor": 8,
        "form": "remainder",
        "show": {
          "carries": false
        },
        "occlude": {
          "quotient": true,
          "remainder": true
        }
      }
    },
    {
      "params": {
        "dividend": 5.1,
        "divisor": 0.4,
        "form": "decimal",
        "show": {
          "carries": true,
          "rescale": true
        },
        "caption": "Divide by a decimal: scale both by 10"
      }
    },
    {
      "params": {
        "dividend": 7,
        "divisor": 8,
        "form": "decimal",
        "decimalPlaces": 4,
        "show": {
          "carries": true
        },
        "caption": "7 ÷ 8"
      }
    },
    {
      "params": {
        "dividend": 74,
        "divisor": 5,
        "form": "remainder",
        "highlight": true,
        "show": {
          "carries": true
        },
        "caption": "74 ÷ 5"
      }
    }
  ]
}
