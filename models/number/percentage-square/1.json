{
  "ref": "number/percentage-square@1",
  "family": "number",
  "name": "percentage-square",
  "version": 1,
  "title": "Percentage square",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "percent": {
        "type": "number",
        "minimum": 0,
        "maximum": 200
      },
      "change": {
        "type": "string",
        "enum": [
          "increase",
          "decrease"
        ]
      },
      "known": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "value": {
            "type": "number"
          },
          "represents": {
            "type": "string",
            "enum": [
              "original",
              "result"
            ]
          },
          "prefix": {
            "type": "string"
          },
          "suffix": {
            "type": "string"
          }
        },
        "required": [
          "value"
        ]
      },
      "occlude": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "percent": {
            "type": "boolean"
          },
          "decimal": {
            "type": "boolean"
          },
          "fraction": {
            "type": "boolean"
          },
          "multiplier": {
            "type": "boolean"
          },
          "answer": {
            "type": "boolean"
          }
        }
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "equivalence": {
            "type": "boolean"
          },
          "multiplier": {
            "type": "boolean"
          },
          "guides": {
            "type": "boolean"
          }
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "percent"
    ]
  },
  "examples": [
    {
      "params": {
        "percent": 35,
        "known": {
          "value": 80,
          "represents": "original",
          "prefix": "£"
        }
      }
    },
    {
      "params": {
        "percent": 0,
        "show": {
          "equivalence": false,
          "multiplier": false
        }
      }
    },
    {
      "params": {
        "percent": 20,
        "change": "increase",
        "known": {
          "value": 40,
          "represents": "original",
          "prefix": "£"
        },
        "caption": "Increase £40 by 20%"
      }
    },
    {
      "params": {
        "percent": 15,
        "change": "decrease",
        "known": {
          "value": 80,
          "represents": "original",
          "prefix": "£"
        },
        "occlude": {
          "multiplier": true,
          "answer": true
        }
      }
    },
    {
      "params": {
        "header": "Reverse percentage",
        "percent": 20,
        "change": "increase",
        "known": {
          "value": 30000,
          "represents": "result",
          "prefix": "£"
        },
        "occlude": {
          "answer": true
        }
      }
    },
    {
      "params": {
        "percent": 12.5
      }
    }
  ]
}
