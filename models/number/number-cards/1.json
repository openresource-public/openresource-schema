{
  "ref": "number/number-cards@1",
  "family": "number",
  "name": "number-cards",
  "version": 1,
  "title": "Number cards",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "sets": {
        "type": "array",
        "minItems": 1,
        "maxItems": 3,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string",
              "maxLength": 24
            },
            "cards": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "face": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8
                  },
                  "occlude": {
                    "type": "boolean"
                  },
                  "blank": {
                    "type": "boolean"
                  },
                  "highlight": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "face"
                ]
              }
            }
          },
          "required": [
            "cards"
          ]
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "sets"
    ]
  },
  "examples": [
    {
      "params": {
        "sets": [
          {
            "cards": [
              {
                "face": "4"
              },
              {
                "face": "7"
              },
              {
                "face": "2"
              }
            ]
          }
        ]
      }
    },
    {
      "params": {
        "sets": [
          {
            "label": "Your cards",
            "cards": [
              {
                "face": "4"
              },
              {
                "face": "7"
              },
              {
                "face": "2"
              }
            ]
          },
          {
            "label": "Largest number",
            "cards": [
              {
                "face": "7",
                "highlight": true
              },
              {
                "face": "4",
                "highlight": true
              },
              {
                "face": "2",
                "highlight": true
              }
            ]
          }
        ]
      }
    },
    {
      "params": {
        "sets": [
          {
            "cards": [
              {
                "face": "4"
              },
              {
                "face": "8"
              },
              {
                "face": "3"
              },
              {
                "face": "7"
              },
              {
                "face": "8",
                "occlude": true
              }
            ]
          }
        ]
      }
    },
    {
      "params": {
        "header": "Make a 3-digit number",
        "sets": [
          {
            "cards": [
              {
                "face": "8",
                "blank": true
              },
              {
                "face": "4",
                "blank": true
              },
              {
                "face": "3",
                "blank": true
              }
            ]
          }
        ]
      }
    },
    {
      "params": {
        "sets": [
          {
            "label": "Box A",
            "cards": [
              {
                "face": "2"
              },
              {
                "face": "6"
              },
              {
                "face": "7"
              }
            ]
          },
          {
            "label": "Box B",
            "cards": [
              {
                "face": "4"
              },
              {
                "face": "9"
              }
            ]
          }
        ],
        "caption": "One card is taken from each box and the numbers are multiplied."
      }
    },
    {
      "params": {
        "sets": [
          {
            "cards": [
              {
                "face": "-7"
              },
              {
                "face": "2"
              },
              {
                "face": "-3"
              },
              {
                "face": "5"
              }
            ]
          }
        ]
      }
    }
  ]
}
