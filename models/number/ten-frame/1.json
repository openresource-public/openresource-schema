{
  "ref": "number/ten-frame@1",
  "family": "number",
  "name": "ten-frame",
  "version": 1,
  "title": "Ten-frame",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "counters": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "colour": {
              "type": "string",
              "enum": [
                "red",
                "yellow",
                "blue",
                "green"
              ]
            },
            "strike": {
              "type": "boolean"
            }
          },
          "required": [
            "count"
          ]
        }
      },
      "frames": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2
      },
      "fill": {
        "type": "string",
        "enum": [
          "row",
          "column"
        ]
      },
      "stem": {
        "type": "string",
        "enum": [
          "auto",
          "count",
          "bond",
          "complement",
          "subtract",
          "none"
        ]
      },
      "occlude": {
        "type": "string",
        "enum": [
          "none",
          "total",
          "complement"
        ]
      },
      "highlight": {
        "type": "string",
        "enum": [
          "none",
          "empties",
          "result"
        ]
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "counters"
    ]
  },
  "examples": [
    {
      "params": {
        "counters": [],
        "stem": "none",
        "caption": "Place 6 counters, filling the top row first."
      }
    },
    {
      "params": {
        "counters": [
          {
            "count": 7,
            "colour": "red"
          },
          {
            "count": 3,
            "colour": "yellow"
          }
        ],
        "stem": "bond"
      }
    },
    {
      "params": {
        "counters": [
          {
            "count": 6,
            "colour": "red"
          }
        ],
        "stem": "complement",
        "occlude": "complement",
        "highlight": "empties"
      }
    },
    {
      "params": {
        "counters": [
          {
            "count": 8,
            "colour": "red"
          },
          {
            "count": 5,
            "colour": "yellow"
          }
        ],
        "stem": "bond"
      }
    },
    {
      "params": {
        "counters": [
          {
            "count": 5,
            "colour": "red"
          },
          {
            "count": 4,
            "colour": "red",
            "strike": true
          }
        ],
        "stem": "subtract"
      }
    },
    {
      "params": {
        "counters": [
          {
            "count": 6,
            "colour": "blue"
          }
        ],
        "stem": "count",
        "occlude": "total"
      }
    }
  ]
}
