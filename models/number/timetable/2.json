{
  "ref": "number/timetable@2",
  "family": "number",
  "name": "timetable",
  "version": 2,
  "title": "Timetable",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "stops": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 2,
        "maxItems": 14
      },
      "services": {
        "type": "array",
        "minItems": 1,
        "maxItems": 6,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "times": {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$"
              }
            }
          },
          "required": [
            "times"
          ]
        }
      },
      "format": {
        "type": "string",
        "enum": [
          "24h",
          "12h"
        ]
      },
      "cells": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "stop": {
              "type": "integer",
              "minimum": 1
            },
            "service": {
              "type": "integer",
              "minimum": 1
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "stop",
            "service"
          ]
        }
      },
      "query": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "duration"
              },
              "service": {
                "type": "integer",
                "minimum": 1
              },
              "from": {
                "type": "integer",
                "minimum": 1
              },
              "to": {
                "type": "integer",
                "minimum": 1
              },
              "occlude": {
                "type": "boolean"
              },
              "highlight": {
                "type": "boolean"
              }
            },
            "required": [
              "kind",
              "service",
              "from",
              "to"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "difference"
              },
              "stop": {
                "type": "integer",
                "minimum": 1
              },
              "services": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                },
                "minItems": 2,
                "maxItems": 2
              },
              "occlude": {
                "type": "boolean"
              },
              "highlight": {
                "type": "boolean"
              }
            },
            "required": [
              "kind",
              "stop",
              "services"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "arriveBy"
              },
              "stop": {
                "type": "integer",
                "minimum": 1
              },
              "by": {
                "type": "string",
                "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$"
              },
              "from": {
                "type": "integer",
                "minimum": 1
              },
              "occlude": {
                "type": "boolean"
              },
              "highlight": {
                "type": "boolean"
              }
            },
            "required": [
              "kind",
              "stop",
              "by"
            ]
          }
        ]
      },
      "cornerLabel": {
        "type": "string"
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "stops",
      "services"
    ]
  },
