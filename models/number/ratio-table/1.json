{
  "ref": "number/ratio-table@1",
  "family": "number",
  "name": "ratio-table",
  "version": 1,
  "title": "Ratio table",
  "responseModes": [
    "fill-derived"
  ],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "$defs": {
      "part": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "units": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string"
          },
          "highlight": {
            "type": "boolean"
          }
        },
        "required": [
          "units"
        ]
      }
    },
    "properties": {
      "parts": {
        "type": "array",
        "minItems": 2,
        "maxItems": 6,
        "items": {
          "$ref": "#/$defs/part"
        }
      },
      "rows": {
        "type": "array",
        "maxItems": 6,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "factor": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "unitary": {
              "type": "integer",
              "minimum": 1
            },
            "value": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "valueCol": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "string",
                  "enum": [
                    "total",
                    "difference"
                  ]
                }
              ]
            },
            "label": {
              "type": "string"
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            }
          }
        }
      },
      "total": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string"
          },
          "highlight": {
            "type": "boolean"
          }
        }
      },
      "difference": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "between": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "label": {
            "type": "string"
          },
          "highlight": {
            "type": "boolean"
          }
        }
      },
      "cells": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "row": {
              "type": "integer",
              "minimum": 0
            },
            "col": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "string",
                  "enum": [
                    "total",
                    "difference"
                  ]
                }
              ]
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "row",
            "col"
          ]
        }
      },
      "combineWith": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "parts": {
            "type": "array",
            "minItems": 2,
            "maxItems": 5,
            "items": {
              "$ref": "#/$defs/part"
            }
          },
          "occludeResult": {
            "type": "boolean"
          }
        },
        "required": [
          "parts"
        ]
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "headers": {
            "type": "boolean"
          },
          "arrows": {
            "type": "boolean"
          },
          "arrowStyle": {
            "type": "string",
            "enum": [
              "split",
              "both"
            ]
          },
          "factors": {
            "type": "boolean"
          },
          "values": {
            "type": "boolean"
          }
        }
      },
      "cornerLabel": {
        "type": "string"
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "parts"
    ]
  },
  "examples": [
    {
      "params": {
        "header": "Share £56 in the ratio 5 : 3",
        "parts": [
          {
            "units": 5,
            "name": "A"
          },
          {
            "units": 3,
            "name": "B"
          }
        ],
        "rows": [
          {
            "value": 56,
            "valueCol": "total"
          }
        ],
        "total": {},
        "caption": "One part is worth £7, so the shares are £35 and £21."
      }
    },
    {
      "params": {
        "parts": [
          {
            "units": 4,
            "name": "Red"
          },
          {
            "units": 3,
            "name": "Blue"
          }
        ],
        "rows": [
          {
            "value": 28,
            "valueCol": 1
          }
        ],
        "show": {
          "values": false,
          "factors": false
        }
      }
    },
    {
      "params": {
        "parts": [
          {
            "units": 2,
            "name": "A"
          },
          {
            "units": 5,
            "name": "B"
          }
        ],
        "rows": [
          {
            "factor": 3
          }
        ],
        "cells": [
          {
            "row": 1,
            "col": 2,
            "occlude": true,
            "highlight": true
          }
        ],
        "caption": "A : B = 2 : 5. If A becomes 6, find B."
      }
    },
    {
      "params": {
        "parts": [
          {
            "units": 3,
            "name": "Cakes"
          },
          {
            "units": 450,
            "name": "Flour (g)"
          }
        ],
        "rows": [
          {
            "unitary": 1,
            "label": "one cake"
          },
          {
            "value": 5,
            "valueCol": 1,
            "label": "five cakes",
            "highlight": true
          }
        ],
        "cells": [
          {
            "row": 2,
            "col": 2,
            "occlude": true
          }
        ]
      }
    },
    {
      "params": {
        "parts": [
          {
            "units": 7,
            "name": "A"
          },
          {
            "units": 4,
            "name": "B"
          }
        ],
        "rows": [
          {
            "value": 24,
            "valueCol": "difference"
          }
        ],
        "difference": {
          "between": [
            1,
            2
          ]
        },
        "total": {},
        "caption": "A : B = 7 : 4 and A is 24 more than B. Find A, B and the total."
      }
    },
    {
      "params": {
        "header": "Combine the ratios",
        "parts": [
          {
            "units": 2,
            "name": "A"
          },
          {
            "units": 3,
            "name": "B"
          }
        ],
        "combineWith": {
          "parts": [
            {
              "units": 4,
              "name": "B"
            },
            {
              "units": 5,
              "name": "C"
            }
          ]
        },
        "caption": "A : B = 2 : 3 and B : C = 4 : 5. Find A : B : C."
      }
    }
  ]
}
