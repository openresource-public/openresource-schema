{
  "ref": "number/bead-string@1",
  "family": "number",
  "name": "bead-string",
  "version": 1,
  "title": "Bead string",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "beads": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "colour": {
              "type": "string",
              "enum": [
                "red",
                "white",
                "yellow",
                "blue",
                "green"
              ]
            },
            "strike": {
              "type": "boolean"
            }
          },
          "required": [
            "count"
          ]
        }
      },
      "length": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "groupSize": {
        "type": "integer",
        "enum": [
          5,
          10
        ]
      },
      "orientation": {
        "type": "string",
        "enum": [
          "horizontal",
          "vertical"
        ]
      },
      "ticks": {
        "type": "string",
        "enum": [
          "none",
          "fives",
          "tens"
        ]
      },
      "stem": {
        "type": "string",
        "enum": [
          "auto",
          "count",
          "bond",
          "complement",
          "subtract",
          "one-more",
          "one-less",
          "none"
        ]
      },
      "unit": {
        "type": "string",
        "enum": [
          "beads",
          "minutes"
        ]
      },
      "occlude": {
        "type": "string",
        "enum": [
          "none",
          "total",
          "complement"
        ]
      },
      "highlight": {
        "type": "string",
        "enum": [
          "none",
          "remainder",
          "last",
          "result"
        ]
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "beads"
    ]
  },
  "examples": [
    {
      "params": {
        "beads": [],
        "length": 20,
        "ticks": "tens",
        "stem": "none",
        "caption": "Slide 13 beads across, counting in fives."
      }
    },
    {
      "params": {
        "beads": [
          {
            "count": 7
          }
        ],
        "ticks": "fives",
        "stem": "count"
      }
    },
    {
      "params": {
        "beads": [
          {
            "count": 6,
            "colour": "red"
          },
          {
            "count": 4,
            "colour": "yellow"
          }
        ],
        "length": 10,
        "stem": "bond"
      }
    },
    {
      "params": {
        "beads": [
          {
            "count": 13
          }
        ],
        "length": 20,
        "stem": "complement",
        "occlude": "complement",
        "highlight": "remainder"
      }
    },
    {
      "params": {
        "header": "Complements to an hour",
        "beads": [
          {
            "count": 45
          }
        ],
        "length": 60,
        "unit": "minutes",
        "ticks": "fives",
        "stem": "complement",
        "occlude": "complement",
        "highlight": "remainder"
      }
    },
    {
      "params": {
        "beads": [
          {
            "count": 5,
            "colour": "red"
          },
          {
            "count": 4,
            "colour": "red",
            "strike": true
          }
        ],
        "orientation": "vertical",
        "stem": "subtract"
      }
    }
  ]
}
