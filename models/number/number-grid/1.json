{
  "ref": "number/number-grid@1",
  "family": "number",
  "name": "number-grid",
  "version": 1,
  "title": "Number grid",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "start": {
        "type": "integer"
      },
      "end": {
        "type": "integer"
      },
      "width": {
        "type": "integer",
        "minimum": 1,
        "maximum": 30
      },
      "rules": {
        "type": "array",
        "maxItems": 3,
        "items": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "multiples"
                },
                "of": {
                  "type": "integer",
                  "minimum": 1
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "of"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "primes"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "type"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "sequence"
                },
                "first": {
                  "type": "integer"
                },
                "step": {
                  "type": "integer"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "first",
                "step"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "modular"
                },
                "mod": {
                  "type": "integer",
                  "minimum": 1
                },
                "residue": {
                  "type": "integer",
                  "minimum": 0
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "mod",
                "residue"
              ]
            }
          ]
        }
      },
      "cells": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "n": {
              "type": "integer"
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "n"
          ]
        }
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "numbers": {
            "type": "boolean"
          },
          "legend": {
            "type": "boolean"
          }
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "start",
      "end"
    ]
  },
  "examples": [
    {
      "params": {
        "header": "Number grid",
        "start": 1,
        "end": 100,
        "width": 10
      }
    },
    {
      "params": {
        "start": 1,
        "end": 100,
        "width": 10,
        "rules": [
          {
            "type": "multiples",
            "of": 5
          }
        ]
      }
    },
    {
      "params": {
        "header": "The prime numbers to 100",
        "start": 1,
        "end": 100,
        "width": 10,
        "rules": [
          {
            "type": "primes"
          }
        ]
      }
    },
    {
      "params": {
        "header": "Common multiples of 4 and 6",
        "start": 1,
        "end": 60,
        "width": 7,
        "rules": [
          {
            "type": "multiples",
            "of": 4
          },
          {
            "type": "multiples",
            "of": 6
          }
        ],
        "caption": "The amber numbers are multiples of both — the smallest is the LCM."
      }
    },
    {
      "params": {
        "start": 1,
        "end": 100,
        "width": 10,
        "rules": [
          {
            "type": "multiples",
            "of": 9
          }
        ],
        "cells": [
          {
            "n": 36,
            "occlude": true
          },
          {
            "n": 72,
            "occlude": true
          }
        ]
      }
    },
    {
      "params": {
        "start": 1,
        "end": 100,
        "width": 10,
        "cells": [
          {
            "n": 23,
            "highlight": true
          },
          {
            "n": 24,
            "highlight": true
          },
          {
            "n": 25,
            "highlight": true
          },
          {
            "n": 34,
            "highlight": true
          },
          {
            "n": 44,
            "highlight": true
          }
        ]
      }
    }
  ]
}
