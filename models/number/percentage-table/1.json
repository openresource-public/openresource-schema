{
  "ref": "number/percentage-table@1",
  "family": "number",
  "name": "percentage-table",
  "version": 1,
  "title": "Percentage table (benchmark ladder)",
  "responseModes": [
    "fill-derived"
  ],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "amount": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "benchmarks": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "percent": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "occlude": {
              "type": "boolean"
            },
            "occludePercent": {
              "type": "boolean"
            },
            "blank": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "percent"
          ]
        }
      },
      "build": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "parts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "percent": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "times": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "percent"
              ]
            }
          },
          "occlude": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          }
        },
        "required": [
          "parts"
        ]
      },
      "prefix": {
        "type": "string"
      },
      "suffix": {
        "type": "string"
      },
      "money": {
        "type": "boolean"
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "arrows": {
            "type": "boolean"
          },
          "arrowStyle": {
            "type": "string",
            "enum": [
              "split",
              "both"
            ]
          },
          "factors": {
            "type": "boolean"
          },
          "values": {
            "type": "boolean"
          },
          "headers": {
            "type": "boolean"
          }
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "amount"
    ]
  },
  "examples": [
    {
      "params": {
        "header": "Percentages of 600",
        "amount": 600,
        "benchmarks": [
          {
            "percent": 100
          },
          {
            "percent": 50
          },
          {
            "percent": 10
          },
          {
            "percent": 5
          },
          {
            "percent": 1
          }
        ],
        "caption": "Halve 100% for 50%; take a tenth for 10%; halve that for 5%; a tenth of 10% is 1%."
      }
    },
    {
      "params": {
        "amount": 80,
        "benchmarks": [
          {
            "percent": 100
          },
          {
            "percent": 10
          },
          {
            "percent": 5
          },
          {
            "percent": 1
          }
        ],
        "show": {
          "values": false
        }
      }
    },
    {
      "params": {
        "amount": 350,
        "benchmarks": [
          {
            "percent": 100
          },
          {
            "percent": 10,
            "occlude": true,
            "highlight": true
          }
        ]
      }
    },
    {
      "params": {
        "amount": 600,
        "benchmarks": [
          {
            "percent": 100
          },
          {
            "percent": 10,
            "highlight": true
          },
          {
            "percent": 5,
            "highlight": true
          }
        ],
        "build": {
          "parts": [
            {
              "percent": 10,
              "times": 3
            },
            {
              "percent": 5
            }
          ],
          "highlight": true
        },
        "caption": "35% is three 10%s and a 5%: 180 + 30 = 210."
      }
    },
    {
      "params": {
        "amount": 240,
        "prefix": "£",
        "benchmarks": [
          {
            "percent": 100
          },
          {
            "percent": 10
          },
          {
            "percent": 5
          },
          {
            "percent": 2.5
          }
        ],
        "build": {
          "parts": [
            {
              "percent": 10
            },
            {
              "percent": 5
            },
            {
              "percent": 2.5
            }
          ],
          "occlude": true
        },
        "caption": "Build 17.5% from 10%, 5% and 2.5%, then add the values."
      }
    },
    {
      "params": {
        "amount": 240,
        "prefix": "£",
        "benchmarks": [
          {
            "percent": 100
          },
          {
            "percent": 17.5,
            "occludePercent": true,
            "highlight": true
          }
        ],
        "show": {
          "arrows": false
        }
      }
    }
  ]
}
