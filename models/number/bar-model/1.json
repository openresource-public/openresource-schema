{
  "ref": "number/bar-model@1",
  "family": "number",
  "name": "bar-model",
  "version": 1,
  "title": "Bar model",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "bars": {
        "type": "array",
        "maxItems": 6,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string"
            },
            "segments": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "value": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "units": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "label": {
                    "type": "string"
                  },
                  "occlude": {
                    "type": "boolean"
                  },
                  "blank": {
                    "type": "boolean"
                  },
                  "highlight": {
                    "type": "boolean"
                  }
                },
                "allOf": [
                  {
                    "not": {
                      "required": [
                        "value",
                        "units"
                      ]
                    }
                  }
                ]
              }
            },
            "braces": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "from": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "to": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "total": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "label": {
                    "type": "string"
                  },
                  "occlude": {
                    "type": "boolean"
                  },
                  "highlight": {
                    "type": "boolean"
                  },
                  "side": {
                    "type": "string",
                    "enum": [
                      "top",
                      "bottom"
                    ]
                  }
                },
                "required": [
                  "from",
                  "to"
                ]
              }
            }
          },
          "required": [
            "segments"
          ]
        }
      },
      "align": {
        "type": "string",
        "enum": [
          "unit",
          "whole"
        ]
      },
      "unit": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "value": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "values": {
            "type": "boolean"
          }
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "bars"
    ]
  },
  "examples": [
    {
      "params": {
        "caption": "Share £40 in the ratio 3 : 2",
        "bars": [
          {
            "segments": [
              {
                "units": 1
              },
              {
                "units": 1
              },
              {
                "units": 1
              },
              {
                "units": 1
              },
              {
                "units": 1
              }
            ],
            "braces": [
              {
                "from": 1,
                "to": 5,
                "total": 40,
                "side": "top"
              },
              {
                "from": 1,
                "to": 3,
                "label": "3 parts",
                "side": "bottom"
              },
              {
                "from": 4,
                "to": 5,
                "label": "2 parts",
                "side": "bottom"
              }
            ]
          }
        ],
        "show": {
          "values": false
        }
      }
    },
    {
      "params": {
        "header": "Three fifths of 30",
        "bars": [
          {
            "segments": [
              {
                "units": 1,
