{
  "ref": "number/number-shape@1",
  "family": "number",
  "name": "number-shape",
  "version": 1,
  "title": "Number shape",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "shapes": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            },
            "blank": {
              "type": "boolean"
            }
          },
          "required": [
            "value"
          ]
        }
      },
      "piece": {
        "type": "string",
        "enum": [
          "plate",
          "cubes",
          "counters"
        ]
      },
      "operation": {
        "type": "string",
        "enum": [
          "none",
          "add"
        ]
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "show": {
            "type": "boolean"
          },
          "shape": {
            "type": "boolean"
          },
          "occlude": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          }
        }
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "values": {
            "type": "boolean"
          },
          "parity": {
            "type": "boolean"
          }
        }
      },
      "stem": {
        "type": "string",
        "enum": [
          "auto",
          "count",
          "parity",
          "bond",
          "none"
        ]
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "shapes"
    ]
  },
  "examples": [
    {
      "params": {
        "header": "The number shape for 7",
        "shapes": [
          {
            "value": 7
          }
        ],
        "show": {
          "values": true,
          "parity": true
        },
        "stem": "parity",
        "caption": "Seven is odd — one peg is left without a partner."
      }
    },
    {
      "params": {
        "shapes": [
          {
            "value": 6,
            "occlude": true
          }
        ],
        "show": {
          "values": true
        },
        "stem": "none"
      }
    },
    {
      "params": {
        "shapes": [
          {
            "value": 6
          },
          {
            "value": 4
          }
        ],
        "operation": "add",
        "result": {
          "show": true,
          "shape": true
        },
        "stem": "bond",
        "caption": "The 6-shape and the 4-shape fit together to make the 10-shape."
      }
    },
    {
      "params": {
        "shapes": [
          {
            "value": 6
          },
          {
            "value": 4,
            "occlude": true
          }
        ],
        "operation": "add",
        "result": {
          "show": true
        },
        "stem": "bond"
      }
    },
    {
      "params": {
        "header": "Odd and even",
        "shapes": [
          {
            "value": 1
          },
          {
            "value": 2
          },
          {
            "value": 3
          },
          {
            "value": 4
          },
          {
            "value": 5
          }
        ],
        "piece": "cubes",
        "show": {
          "values": true,
          "parity": true
        },
        "stem": "none",
        "caption": "Even numbers are flat on top; odd numbers have one cube sticking out."
      }
    },
    {
      "params": {
        "shapes": [
          {
            "value": 5
          },
          {
            "value": 3
          }
        ],
        "operation": "add",
        "result": {
          "show": true,
          "shape": true,
          "highlight": true
        },
        "stem": "bond",
        "caption": "Eight is \"five and a bit\": the 5-shape and 3 more."
      }
    }
  ]
}
