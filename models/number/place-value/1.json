{
  "ref": "number/place-value@1",
  "family": "number",
  "name": "place-value",
  "version": 1,
  "title": "Place value chart",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "value": {
        "type": "number"
      },
      "operation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "multiply",
              "divide"
            ]
          },
          "power": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9
          }
        },
        "required": [
          "type",
          "power"
        ]
      },
      "standardForm": {
        "type": "boolean"
      },
      "columns": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "integer"
          },
          "to": {
            "type": "integer"
          }
        }
      },
      "headers": {
        "type": "string",
        "enum": [
          "name",
          "power",
          "both",
          "none"
        ]
      },
      "highlight": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "power": {
            "type": "integer"
          },
          "row": {
            "type": "string",
            "enum": [
              "source",
              "result"
            ]
          },
          "value": {
            "type": "string",
            "enum": [
              "show",
              "hide",
              "none"
            ]
          }
        },
        "required": [
          "power"
        ]
      },
      "occlude": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "boolean"
          },
          "result": {
            "type": "boolean"
          },
          "operation": {
            "type": "boolean"
          },
          "digits": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "row": {
                  "type": "string",
                  "enum": [
                    "source",
                    "result"
                  ]
                },
                "power": {
                  "type": "integer"
                }
              },
              "required": [
                "power"
              ]
            }
          }
        }
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "digits": {
            "type": "boolean"
          },
          "arrows": {
            "type": "boolean"
          },
          "point": {
            "type": "boolean"
          }
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "value"
    ]
  },
  "examples": [
    {
      "params": {
        "value": 3.42,
        "headers": "both",
        "highlight": {
          "power": -1,
          "value": "show"
        }
      }
    },
    {
      "params": {
        "value": 3407,
        "headers": "name",
        "show": {
          "digits": false
        }
      }
    },
    {
      "params": {
        "value": 3.6,
        "operation": {
          "type": "multiply",
          "power": 2
        },
        "headers": "name"
      }
    },
    {
      "params": {
        "value": 24.5,
        "operation": {
          "type": "divide",
          "power": 1
        },
        "headers": "name",
        "occlude": {
          "result": true
        },
        "caption": "24.5 ÷ 10 = ?"
      }
    },
    {
      "params": {
        "value": 4.732,
        "operation": {
          "type": "multiply",
          "power": 3
        },
        "standardForm": true,
        "headers": "power"
      }
    },
    {
      "params": {
        "value": 5.6,
        "operation": {
          "type": "divide",
          "power": 4
        },
        "standardForm": true,
        "headers": "power",
        "header": "Standard form to an ordinary number"
      }
    }
  ]
}
