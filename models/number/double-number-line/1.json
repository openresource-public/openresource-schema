{
  "ref": "number/double-number-line@1",
  "family": "number",
  "name": "double-number-line",
  "version": 1,
  "title": "Double number line",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "top": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "max": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      },
      "bottom": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          }
        }
      },
      "ratio": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "top": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "bottom": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "top",
          "bottom"
        ]
      },
      "ticks": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "step": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "labelStep": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "show": {
            "type": "boolean"
          }
        },
        "required": [
          "step"
        ]
      },
      "points": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "top": {
              "type": "number",
              "minimum": 0
            },
            "bottom": {
              "type": "number",
              "minimum": 0
            },
            "label": {
              "type": "string"
            },
            "occludeTop": {
              "type": "boolean"
            },
            "occludeBottom": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "anyOf": [
            {
              "required": [
                "top"
              ]
            },
            {
              "required": [
                "bottom"
              ]
            }
          ]
        }
      },
      "showScaling": {
        "type": "boolean"
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      },
      "draggable": {
        "type": "boolean"
      }
    },
    "required": [
      "top",
      "bottom",
      "ratio"
    ]
  },
  "examples": [
    {
      "params": {
        "top": {
          "label": "lemons"
        },
        "bottom": {
          "label": "juice (ml)"
        },
        "ratio": {
          "top": 3,
          "bottom": 75
        },
        "points": [
          {
            "top": 3
          },
          {
            "top": 5,
            "highlight": true
          }
        ],
        "showScaling": true
      }
    },
    {
      "params": {
        "top": {
          "label": "lemons",
          "max": 6
        },
        "bottom": {
          "label": "juice (ml)"
        },
        "ratio": {
          "top": 3,
          "bottom": 75
        },
        "points": [
          {
            "top": 3
          }
        ]
      }
    },
    {
      "params": {
        "top": {
          "label": "time (hours)"
        },
        "bottom": {
          "label": "distance (km)"
        },
        "ratio": {
          "top": 2,
          "bottom": 150
        },
        "points": [
          {
            "top": 2
          },
          {
            "top": 5,
            "occludeBottom": true,
            "highlight": true
          }
        ]
      }
    },
    {
      "params": {
        "top": {
          "label": "percent",
          "unit": "%",
          "max": 100
        },
        "bottom": {
          "label": "amount"
        },
        "ratio": {
          "top": 70,
          "bottom": 35
        },
        "ticks": {
          "step": 10,
          "labelStep": 50
        },
        "points": [
          {
            "top": 70
          },
          {
            "top": 100,
            "occludeBottom": true,
            "highlight": true
          }
        ],
        "caption": "35 is 70% of an amount. Find 100%."
      }
    },
    {
      "params": {
        "top": {
          "label": "miles",
          "max": 10
        },
        "bottom": {
          "label": "kilometres"
        },
        "ratio": {
          "top": 5,
          "bottom": 8
        },
        "ticks": {
          "step": 1,
          "labelStep": 5
        },
        "points": [
          {
            "top": 5,
            "highlight": true
          }
        ],
        "caption": "5 miles is about 8 km."
      }
    },
    {
      "params": {
        "top": {
          "label": "pancakes",
          "max": 10
        },
        "bottom": {
          "label": "flour (g)"
        },
        "ratio": {
          "top": 4,
          "bottom": 250
        },
        "points": [
          {
            "top": 4
          },
          {
            "top": 1,
            "highlight": true
          },
          {
            "top": 9,
            "occludeBottom": true
          }
        ]
      }
    }
  ]
}
