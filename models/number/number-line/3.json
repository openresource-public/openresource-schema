{
  "ref": "number/number-line@3",
  "family": "number",
  "name": "number-line",
  "version": 3,
  "title": "Number line",
  "responseModes": [
    "show-inequality",
    "mark-cross"
  ],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "range": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 2,
        "maxItems": 2
      },
      "ticks": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "step": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "labelStep": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "at": {
                  "type": "number"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "at",
                "text"
              ]
            }
          },
          "showNumbers": {
            "type": "boolean"
          }
        }
      },
      "marks": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "at": {
              "type": "number"
            },
            "label": {
              "type": "string"
            },
            "glyph": {
              "type": "string",
              "enum": [
                "dot",
                "cross"
              ]
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "at"
          ]
        }
      },
      "jumps": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "number"
            },
            "to": {
              "type": "number"
            },
            "label": {
              "type": "string"
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "from",
            "to"
          ]
        }
      },
      "intervals": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "to": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "fromClosed": {
              "type": "boolean"
            },
            "toClosed": {
              "type": "boolean"
            },
            "label": {
              "type": "string"
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            }
          }
        }
      },
      "header": {
        "type": "string"
      },
      "axisLabel": {
        "type": "string"
      },
      "draggable": {
        "type": "boolean"
      },
      "constructInequality": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "from": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "to": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "fromClosed": {
            "type": "boolean"
          },
          "toClosed": {
            "type": "boolean"
          }
        }
      },
      "markCrosses": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "at": {
              "type": "number"
            },
            "label": {
              "type": "string"
            },
            "id": {
              "type": "string"
            }
          },
          "required": [
            "at"
          ]
        }
      },
      "crossSnap": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "required": [
      "range"
    ]
  },
  "examples": [
