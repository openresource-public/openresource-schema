{
  "ref": "number/fraction-shape@1",
  "family": "number",
  "name": "fraction-shape",
  "version": 1,
  "title": "Fraction of a shape",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "shape": {
        "type": "string",
        "enum": [
          "bar",
          "circle",
          "grid"
        ]
      },
      "parts": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "fractions": {
        "type": "array",
        "maxItems": 4,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "n": {
              "type": "integer",
              "minimum": 0
            },
            "d": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "subtract": {
              "type": "boolean"
            },
            "label": {
              "type": "string"
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "n",
            "d"
          ]
        }
      },
      "whole": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "unit": {
        "type": "string"
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "show": {
            "type": "boolean"
          },
          "occlude": {
            "type": "boolean"
          },
          "mixed": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          }
        }
      },
      "grid": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cols": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "rows": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        }
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fractionLabels": {
            "type": "boolean"
          },
          "partLabels": {
            "type": "boolean"
          },
          "partValues": {
            "type": "boolean"
          }
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    }
  },
  "examples": [
    {
      "params": {
        "shape": "bar",
        "fractions": [
          {
            "n": 3,
            "d": 4
          }
        ]
      }
    },
    {
      "params": {
        "shape": "circle",
        "parts": 4
      }
    },
    {
      "params": {
        "header": "Adding with a common denominator",
        "shape": "bar",
        "fractions": [
          {
            "n": 1,
            "d": 3
          },
          {
            "n": 1,
            "d": 4
          }
        ]
      }
    },
    {
      "params": {
        "shape": "grid",
        "parts": 10,
        "fractions": [
          {
            "n": 7,
            "d": 10,
            "occlude": true
          }
        ]
      }
    },
    {
      "params": {
        "shape": "bar",
        "fractions": [
          {
            "n": 3,
            "d": 4,
            "highlight": true
          }
        ],
        "whole": 20,
        "show": {
          "partValues": true
        },
        "result": {
          "highlight": true
        }
      }
    },
    {
      "params": {
        "header": "Seven thirds",
        "shape": "circle",
        "fractions": [
          {
            "n": 7,
            "d": 3
          }
        ],
        "result": {
          "mixed": true
        }
      }
    }
  ]
}
