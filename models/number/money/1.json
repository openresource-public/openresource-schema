{
  "ref": "number/money@1",
  "family": "number",
  "name": "money",
  "version": 1,
  "title": "Money (coins & notes)",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "pieces": {
        "type": "array",
        "maxItems": 16,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "integer",
              "enum": [
                1,
                2,
                5,
                10,
                20,
                50,
                100,
                200,
                500,
                1000,
                2000,
                5000
              ]
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "label": {
              "type": "string"
            },
            "occlude": {
              "type": "boolean"
            },
            "blank": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "value"
          ]
        }
      },
      "arrange": {
        "type": "string",
        "enum": [
          "as-listed",
          "by-value"
        ]
      },
      "group": {
        "type": "boolean"
      },
      "total": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "show": {
            "type": "boolean"
          },
          "label": {
            "type": "string"
          },
          "occlude": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          }
        }
      },
      "track": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "show": {
            "type": "boolean"
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "occlude": {
            "type": "boolean"
          }
        }
      },
      "unit": {
        "type": "string",
        "enum": [
          "auto",
          "pence",
          "pounds"
        ]
      },
      "frame": {
        "type": "boolean"
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "pieces"
    ]
  },
  "examples": [
    {
      "params": {
        "header": "Counting coins",
        "pieces": [
          {
            "value": 20
          },
          {
            "value": 20
          },
          {
            "value": 5
          },
          {
            "value": 2
          }
        ],
        "total": {
          "show": true,
          "label": "Total"
        }
      }
    },
    {
      "params": {
        "pieces": [],
        "frame": true,
        "caption": "Make 50p using coins. Draw them in the tray."
      }
    },
    {
      "params": {
        "pieces": [
          {
            "value": 50,
            "occlude": true
          }
        ]
      }
    },
    {
      "params": {
        "pieces": [
          {
            "value": 100
          },
          {
            "value": 50
          },
          {
            "value": 20
          },
          {
            "value": 10
          },
          {
            "value": 2
          }
        ],
        "total": {
          "show": true,
          "label": "Total",
          "occlude": true
        }
      }
    },
    {
      "params": {
        "header": "Sort the coins",
        "pieces": [
          {
            "value": 2,
            "count": 3
          },
          {
            "value": 50
          },
          {
            "value": 10,
            "count": 2
          },
          {
            "value": 100
          },
          {
            "value": 5
          }
        ],
        "arrange": "by-value",
        "group": true,
        "total": {
          "show": true,
          "label": "Altogether"
        }
      }
    },
    {
      "params": {
        "header": "Change from £10",
        "pieces": [
          {
            "value": 5
          },
          {
            "value": 10
          },
          {
            "value": 50
          },
          {
            "value": 100
          },
          {
            "value": 200
          }
        ],
        "track": {
          "show": true,
          "start": 635
        },
        "total": {
          "show": true,
          "label": "Change"
        },
        "caption": "A toy costs £6.35. You pay with £10. Count on to find the change."
      }
    }
  ]
}
