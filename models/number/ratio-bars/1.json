{
  "ref": "number/ratio-bars@1",
  "family": "number",
  "name": "ratio-bars",
  "version": 1,
  "title": "Ratio bars",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "$defs": {
      "part": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "units": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string"
          },
          "occlude": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          }
        },
        "required": [
          "units"
        ]
      }
    },
    "properties": {
      "parts": {
        "type": "array",
        "minItems": 2,
        "maxItems": 5,
        "items": {
          "$ref": "#/$defs/part"
        }
      },
      "known": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "total",
              "part",
              "difference"
            ]
          },
          "value": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "part": {
            "type": "integer",
            "minimum": 1
          },
          "between": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "required": [
          "type",
          "value"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "part"
                }
              }
            },
            "then": {
              "required": [
                "part"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "difference"
                }
              }
            },
            "then": {
              "required": [
                "between"
              ]
            }
          }
        ]
      },
      "unit": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "symbol": {
            "type": "string"
          },
          "after": {
            "type": "boolean"
          }
        },
        "required": [
          "symbol"
        ]
      },
      "combineWith": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "parts": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "$ref": "#/$defs/part"
            }
          }
        },
        "required": [
          "parts"
        ]
      },
      "occludeSimplified": {
        "type": "boolean"
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "values": {
            "type": "boolean"
          },
          "unitValue": {
            "type": "boolean"
          },
          "arrows": {
            "type": "boolean"
          },
          "unitSquares": {
            "type": "boolean"
          },
          "fractions": {
            "type": "boolean"
          },
          "total": {
            "type": "boolean"
          }
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "parts"
    ]
  },
  "examples": [
    {
      "params": {
        "header": "Share £56 in the ratio 5 : 3",
        "parts": [
          {
            "units": 5,
            "name": "Amara"
          },
          {
            "units": 3,
            "name": "Beth"
          }
        ],
        "known": {
          "type": "total",
          "value": 56
        },
        "unit": {
          "symbol": "£"
        }
      }
    },
    {
      "params": {
        "caption": "Share £84 in the ratio 4 : 3",
        "parts": [
          {
            "units": 4
          },
          {
            "units": 3
          }
        ],
        "known": {
          "type": "total",
          "value": 84
        },
        "unit": {
          "symbol": "£"
        },
        "show": {
          "values": false,
          "unitValue": false
        }
      }
    },
    {
      "params": {
        "parts": [
          {
            "units": 18
          },
          {
            "units": 12
          }
        ],
        "occludeSimplified": true
      }
    },
    {
      "params": {
        "caption": "A : B = 2 : 5. A is 14. Find B.",
        "parts": [
          {
            "units": 2,
            "name": "A"
          },
          {
            "units": 5,
            "name": "B",
            "occlude": true,
            "highlight": true
          }
        ],
        "known": {
          "type": "part",
          "part": 1,
          "value": 14
        }
      }
    },
    {
      "params": {
        "header": "Combine the ratios",
        "caption": "A : B = 2 : 3 and B : C = 4 : 5. Find A : B : C.",
        "parts": [
          {
            "units": 2,
            "name": "A"
          },
          {
            "units": 3,
            "name": "B"
          }
        ],
        "combineWith": {
          "parts": [
            {
              "units": 4,
              "name": "B"
            },
            {
              "units": 5,
              "name": "C"
            }
          ]
        }
      }
    },
    {
      "params": {
        "caption": "A : B = 7 : 4 and A is 24 more than B. Find A and B.",
        "parts": [
          {
            "units": 7,
            "name": "A"
          },
          {
            "units": 4,
            "name": "B"
          }
        ],
        "known": {
          "type": "difference",
          "between": [
            1,
            2
          ],
          "value": 24
        },
        "show": {
          "fractions": true
        }
      }
    }
  ]
}
