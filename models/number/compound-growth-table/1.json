{
  "ref": "number/compound-growth-table@1",
  "family": "number",
  "name": "compound-growth-table",
  "version": 1,
  "title": "Compound growth & decay table",
  "responseModes": [
    "fill-derived"
  ],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "principal": {
        "type": "number"
      },
      "rate": {
        "type": "number"
      },
      "years": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50
      },
      "rates": {
        "type": "array",
        "minItems": 1,
        "maxItems": 30,
        "items": {
          "type": "number"
        }
      },
      "mode": {
        "type": "string",
        "enum": [
          "interest",
          "depreciation",
          "change"
        ]
      },
      "prefix": {
        "type": "string"
      },
      "decimals": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4
      },
      "roundPeriod": {
        "type": "boolean"
      },
      "target": {
        "type": "number"
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "opening": {
            "type": "boolean"
          },
          "multiplier": {
            "type": "boolean"
          },
          "change": {
            "type": "boolean"
          },
          "closing": {
            "type": "boolean"
          },
          "simple": {
            "type": "boolean"
          },
          "workings": {
            "type": "boolean"
          }
        }
      },
      "multiplierLine": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "show": {
            "type": "boolean"
          },
          "occlude": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          }
        }
      },
      "finalLine": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "show": {
            "type": "boolean"
          },
          "occlude": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          }
        }
      },
      "overallChange": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "show": {
            "type": "boolean"
          },
          "occlude": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          }
        }
      },
      "compareLine": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "show": {
            "type": "boolean"
          },
          "occlude": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          }
        }
      },
      "solveLine": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "show": {
            "type": "boolean"
          },
          "occlude": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          }
        }
      },
      "cells": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "row": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "col": {
              "type": "string",
              "enum": [
                "opening",
                "multiplier",
                "change",
                "closing",
                "simple"
              ]
            },
            "occlude": {
              "type": "boolean"
            },
            "blank": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "row",
            "col"
          ]
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "principal"
    ]
  },
  "examples": [
    {
      "params": {
        "header": "£2400 invested at 3% per year",
        "principal": 2400,
        "rate": 3,
        "years": 4,
        "mode": "interest",
        "multiplierLine": {
          "show": true
        },
        "finalLine": {
          "show": true,
          "highlight": true
        }
      }
    },
    {
      "params": {
        "header": "£1800 at 5% per year",
        "principal": 1800,
        "rate": 5,
        "years": 3,
        "mode": "interest",
        "show": {
          "workings": false
        },
        "multiplierLine": {
          "show": false
        },
        "finalLine": {
          "show": false
        }
      }
    },
    {
      "params": {
        "principal": 2500,
        "rate": 4,
        "years": 2,
        "mode": "interest",
        "show": {
          "workings": false
        },
        "cells": [
          {
            "row": 1,
            "col": "opening",
            "occlude": true
          }
        ],
        "finalLine": {
          "show": true
        },
        "caption": "After 2 years at 4%, find the original deposit."
      }
    },
    {
      "params": {
        "header": "£1000 at 6% per year",
        "principal": 1000,
        "rate": 6,
        "target": 1500,
        "mode": "interest",
        "show": {
          "simple": true
        },
        "compareLine": {
          "show": true
        },
        "solveLine": {
          "show": true,
          "highlight": true
        }
      }
    },
    {
      "params": {
        "header": "Car value, depreciating 20% per year",
        "principal": 18000,
        "rate": 20,
        "years": 4,
        "mode": "depreciation",
        "multiplierLine": {
          "show": true
        },
        "finalLine": {
          "show": true
        },
        "overallChange": {
          "show": true
        }
      }
    },
    {
      "params": {
        "header": "House value, year by year",
        "principal": 250000,
        "rates": [
          8,
          -12,
          5
        ],
        "mode": "change",
        "decimals": 0,
        "multiplierLine": {
          "show": true
        },
        "finalLine": {
          "show": true
        },
        "overallChange": {
          "show": true,
          "highlight": true
        }
      }
    }
  ]
}
