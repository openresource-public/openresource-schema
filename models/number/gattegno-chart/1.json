{
  "ref": "number/gattegno-chart@1",
  "family": "number",
  "name": "gattegno-chart",
  "version": 1,
  "title": "Gattegno place-value chart",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "number": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 9999999
      },
      "operation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "multiply",
              "divide"
            ]
          },
          "power": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          }
        },
        "required": [
          "type",
          "power"
        ]
      },
      "rows": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "integer",
            "minimum": -3,
            "maximum": 6
          },
          "to": {
            "type": "integer",
            "minimum": -3,
            "maximum": 6
          }
        }
      },
      "rowLabels": {
        "type": "string",
        "enum": [
          "value",
          "power",
          "none"
        ]
      },
      "highlight": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "power": {
            "type": "integer",
            "minimum": -3,
            "maximum": 6
          }
        },
        "required": [
          "power"
        ]
      },
      "occlude": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "number": {
            "type": "boolean"
          },
          "result": {
            "type": "boolean"
          }
        }
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "selection": {
            "type": "boolean"
          },
          "sum": {
            "type": "boolean"
          },
          "jumps": {
            "type": "boolean"
          }
        }
      },
      "stem": {
        "type": "boolean"
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "number"
    ]
  },
  "examples": [
    {
      "params": {
        "number": 342,
        "stem": true,
        "header": "Building 342"
      }
    },
    {
      "params": {
        "number": 506,
        "show": {
          "selection": false
        },
        "rows": {
          "from": 2,
          "to": 0
        },
        "header": "Build 506 on the chart"
      }
    },
    {
      "params": {
        "number": 42,
        "operation": {
          "type": "multiply",
          "power": 1
        },
        "stem": true
      }
    },
    {
      "params": {
        "number": 28,
        "operation": {
          "type": "multiply",
          "power": 2
        },
        "occlude": {
          "result": true
        }
      }
    },
    {
      "params": {
        "number": 34,
        "operation": {
          "type": "divide",
          "power": 2
        },
        "rowLabels": "value",
        "stem": true
      }
    },
    {
      "params": {
        "number": 4.7,
        "highlight": {
          "power": -1
        },
        "caption": "The 7 is in the tenths place, so it is worth 0.7."
      }
    }
  ]
}
