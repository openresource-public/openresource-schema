{
  "ref": "number/part-whole@1",
  "family": "number",
  "name": "part-whole",
  "version": 1,
  "title": "Part-whole model",
  "responseModes": [
    "fill-derived"
  ],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "$defs": {
      "node": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "value": {
            "type": [
              "number",
              "string"
            ]
          },
          "label": {
            "type": "string"
          },
          "occlude": {
            "type": "boolean"
          },
          "blank": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          }
        }
      }
    },
    "properties": {
      "whole": {
        "$ref": "#/$defs/node"
      },
      "parts": {
        "type": "array",
        "maxItems": 3,
        "items": {
          "$ref": "#/$defs/node"
        }
      },
      "unit": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "prefix": {
            "type": "string"
          },
          "suffix": {
            "type": "string"
          }
        }
      },
      "stem": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "show": {
            "type": "boolean"
          },
          "style": {
            "type": "string",
            "enum": [
              "parts-make-whole",
              "whole-is-parts"
            ]
          }
        }
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "factFamily": {
            "type": "boolean"
          }
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "whole",
      "parts"
    ]
  },
  "examples": [
    {
      "params": {
        "header": "Number bond to 7",
        "whole": {
          "value": 7
        },
        "parts": [
          {
            "value": 3
          },
          {
            "value": 4
          }
        ],
        "stem": {
          "show": true
        }
      }
    },
    {
      "params": {
        "whole": {
          "value": 10
        },
        "parts": [
          {
            "blank": true
          },
          {
            "blank": true
          }
        ],
        "stem": {
          "show": false
        }
      }
    },
    {
      "params": {
        "whole": {
          "value": 12
        },
        "parts": [
          {
            "value": 10
          },
          {
            "occlude": true,
            "value": 2
          }
        ],
        "unit": {
          "suffix": "p"
        },
        "stem": {
          "show": false
        }
      }
    },
    {
      "params": {
        "header": "Fact family for 11",
        "whole": {
          "value": 11
        },
        "parts": [
          {
            "value": 5
          },
          {
            "value": 6
          }
        ],
        "stem": {
          "show": true
        },
        "show": {
          "factFamily": true
        }
      }
    },
    {
      "params": {
        "header": "Three parts of 10",
        "whole": {
          "value": 10
        },
        "parts": [
          {
            "value": 2
          },
          {
            "value": 3
          },
          {
            "value": 5
          }
        ],
        "stem": {
          "show": true
        }
      }
    },
    {
      "params": {
        "header": "Compose 2¾",
        "whole": {
          "value": "2 3/4"
        },
        "parts": [
          {
            "value": 2
          },
          {
            "value": "3/4"
          }
        ],
        "stem": {
          "show": true
        },
        "caption": "A whole number and a fraction make a mixed number."
      }
    }
  ]
}
