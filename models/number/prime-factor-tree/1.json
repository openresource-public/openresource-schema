{
  "ref": "number/prime-factor-tree@1",
  "family": "number",
  "name": "prime-factor-tree",
  "version": 1,
  "title": "Prime factor tree",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "trees": {
        "type": "array",
        "minItems": 1,
        "maxItems": 2,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "n": {
              "type": "integer",
              "minimum": 2,
              "maximum": 100000
            },
            "strategy": {
              "type": "string",
              "enum": [
                "balanced",
                "smallest-prime"
              ]
            },
            "splits": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "value": {
                    "type": "integer",
                    "minimum": 4
                  },
                  "by": {
                    "type": "integer",
                    "minimum": 2
                  }
                },
                "required": [
                  "value",
                  "by"
                ]
              }
            },
            "label": {
              "type": "string"
            },
            "ringPrimes": {
              "type": "boolean"
            },
            "product": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "show": {
                  "type": "boolean"
                },
                "form": {
                  "type": "string",
                  "enum": [
                    "index",
                    "expanded"
                  ]
                },
                "occlude": {
                  "type": "boolean"
                },
                "highlight": {
                  "type": "boolean"
                }
              }
            }
          },
          "required": [
            "n"
          ]
        }
      },
      "hcfLcm": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "showWorking": {
            "type": "boolean"
          },
          "occlude": {
            "type": "boolean"
          }
        }
      },
      "reveal": {
        "type": "integer",
        "minimum": 1
      },
      "header": {
        "type": "string"
      }
    },
    "required": [
      "trees"
    ]
  },
  "examples": [
    {
      "params": {
        "trees": [
          {
            "n": 360,
            "product": {
              "show": true,
              "form": "index",
              "highlight": true
            }
          }
        ]
      }
    },
    {
      "params": {
        "trees": [
          {
            "n": 84,
            "product": {
              "show": false
            }
          }
        ],
        "reveal": 1
      }
    },
    {
      "params": {
        "trees": [
          {
            "n": 120,
            "product": {
              "occlude": true
            }
          }
        ]
      }
    },
    {
      "params": {
        "trees": [
          {
            "n": 72,
            "splits": [
              {
                "value": 72,
                "by": 8
              },
              {
                "value": 8,
                "by": 2
              },
              {
                "value": 9,
                "by": 3
              }
            ],
            "product": {
              "show": true,
              "form": "expanded"
            }
          }
        ]
      }
    },
    {
      "params": {
        "trees": [
          {
            "n": 360
          },
          {
            "n": 84
          }
        ],
        "hcfLcm": {
          "showWorking": true
        }
      }
    },
    {
      "params": {
        "header": "Keep dividing by the smallest prime",
        "trees": [
          {
            "n": 540,
            "strategy": "smallest-prime",
            "product": {
              "show": true,
              "form": "index"
            }
          }
        ]
      }
    }
  ]
}
