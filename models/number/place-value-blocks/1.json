{
  "ref": "number/place-value-blocks@1",
  "family": "number",
  "name": "place-value-blocks",
  "version": 1,
  "title": "Place-value blocks",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "piece": {
        "type": "string",
        "enum": [
          "dienes",
          "counters",
          "bundles"
        ]
      },
      "value": {
        "type": "number",
        "minimum": 0
      },
      "columns": {
        "type": "array",
        "minItems": 1,
        "maxItems": 12,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "place": {
              "type": "integer",
              "minimum": -4,
              "maximum": 6
            },
            "count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "strike": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "blank": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "place",
            "count"
          ]
        }
      },
      "places": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "integer",
            "minimum": -4,
            "maximum": 6
          },
          "to": {
            "type": "integer",
            "minimum": -4,
            "maximum": 6
          }
        }
      },
      "headers": {
        "type": "string",
        "enum": [
          "name",
          "power",
          "none"
        ]
      },
      "regroup": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "integer",
            "minimum": -4,
            "maximum": 6
          },
          "to": {
            "type": "integer",
            "minimum": -4,
            "maximum": 6
          },
          "label": {
            "type": "boolean"
          }
        },
        "required": [
          "from",
          "to"
        ]
      },
      "occlude": {
        "type": "boolean"
      },
      "stem": {
        "type": "string"
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "pieces": {
            "type": "boolean"
          },
          "numeral": {
            "type": "boolean"
          },
          "stem": {
            "type": "boolean"
          },
          "mat": {
            "type": "boolean"
          }
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "anyOf": [
      {
        "required": [
          "value"
        ]
      },
      {
        "required": [
          "columns"
        ]
      }
    ]
  },
  "examples": [
    {
      "params": {
        "piece": "dienes",
        "value": 234,
        "header": "Two hundred and thirty-four"
      }
    },
    {
      "params": {
        "piece": "dienes",
        "value": 162,
        "show": {
          "pieces": false,
          "stem": false
        },
        "caption": "Make 162 with base-ten blocks."
      }
    },
    {
      "params": {
        "piece": "counters",
        "value": 3406,
        "headers": "name",
        "occlude": true
      }
    },
    {
      "params": {
        "piece": "dienes",
        "value": 1.25,
        "places": {
          "from": 0,
          "to": -2
        },
        "header": "One and twenty-five hundredths"
      }
    },
    {
      "params": {
        "piece": "bundles",
        "columns": [
          {
            "place": 1,
            "count": 1
          },
          {
            "place": 0,
            "count": 12
          }
        ],
        "regroup": {
          "from": 0,
          "to": 1
        },
        "caption": "Bundle ten ones to make a ten: 12 ones = 1 ten and 2 ones."
      }
    },
    {
      "params": {
        "piece": "dienes",
        "columns": [
          {
            "place": 1,
            "count": 4,
            "strike": 2
          },
          {
            "place": 0,
            "count": 12,
            "strike": 7
          }
        ],
        "regroup": {
          "from": 1,
          "to": 0
        },
        "header": "52 − 27",
        "caption": "You cannot take 7 from 2, so exchange a ten for ten ones, then take 27 away."
      }
    }
  ]
}
