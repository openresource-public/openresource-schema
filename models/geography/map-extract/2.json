{
  "ref": "geography/map-extract@2",
  "family": "geography",
  "name": "map-extract",
  "version": 2,
  "title": "Map extract",
  "responseModes": [
    "fill-derived",
    "select-point"
  ],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "plate": {
        "type": "string"
      },
      "plateData": {
        "type": "object",
        "additionalProperties": true
      },
      "contours": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "show": {
            "type": "boolean"
          },
          "interval": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "index": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "labels": {
            "type": "boolean"
          }
        }
      },
      "grid": {
        "type": "boolean"
      },
      "squares": {
        "type": "array",
        "maxItems": 6,
        "items": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "at": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {
                        "type": "number"
                      }
                    }
                  ]
                },
                "tag": {
                  "type": "string"
                },
                "ref": {
                  "type": "boolean"
                },
                "occlude": {
                  "type": "boolean"
                },
                "highlight": {
                  "type": "boolean"
                }
              },
              "required": [
                "at"
              ]
            }
          ]
        }
      },
      "hide": {
        "type": "array",
        "maxItems": 12,
        "items": {
          "type": "string"
        }
      },
      "marks": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "at": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number"
                  }
                }
              ]
            },
            "ref": {
              "type": "integer",
              "enum": [
                4,
                6
              ]
            },
            "label": {
              "type": "string"
            },
            "occlude": {
              "type": "boolean"
            },
            "occludeSymbol": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "at"
          ]
        }
      },
      "select": {
        "oneOf": [
          {
            "type": "string",
            "enum": [
              "square",
              "point",
              "feature"
            ]
          },
          {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "string"
            }
          }
        ]
      },
      "key": {
        "oneOf": [
          {
            "type": "string",
            "enum": [
              "auto",
              "all",
              "quiz",
              "none"
            ]
          },
          {
            "type": "array",
            "maxItems": 24,
            "items": {
              "type": "string"
            }
          }
        ]
      },
      "keyQuiz": {
        "type": "boolean"
      },
      "keyOnly": {
        "type": "boolean"
      },
      "scheme": {
        "type": "string",
        "enum": [
          "colour",
          "tonal"
        ]
      },
      "reveal": {
        "type": "integer",
        "minimum": 0
      },
      "header": {
        "type": "string"
      }
    },
    "required": [
      "plate"
    ]
  },
  "examples": [
    {
      "params": {
        "plate": "hebden-town",
        "header": "Hebden Bridge — 1 km grid squares"
      }
    },
    {
      "params": {
        "plate": "hebden-town",
        "marks": [
          {
            "id": "A",
            "at": "pla-st-james-s-church-sd98432744",
            "ref": 4,
            "label": "church"
          },
          {
            "id": "B",
            "at": "vp-crags",
            "ref": 6,
            "occlude": true
          }
        ]
      }
    },
    {
      "params": {
        "plate": "hebden-town",
        "squares": [
          {
            "at": "9926"
          },
          {
            "at": "vp-crags",
            "tag": "A",
            "occlude": true
          }
        ]
      }
    },
    {
      "params": {
        "plate": "keswick",
        "hide": [
          "parking"
        ],
        "squares": [
          {
            "at": "pl-keswick-ny26542352",
            "tag": "A"
          }
        ]
      }
    },
    {
      "params": {
        "plate": "hebden-town",
        "marks": [
          {
            "id": "A",
            "at": "st-hebden-bridge-sd99512680",
            "occludeSymbol": true
          }
        ],
        "key": [
          "station",
          "bus-station",
          "parking",
          "post-office"
        ]
      }
    },
    {
      "params": {
        "plate": "sheffield-centre",
        "select": "square"
      }
    },
    {
      "params": {
        "plate": "hebden-town",
        "select": "point",
        "marks": [
          {
            "id": "A",
            "at": "st-hebden-bridge-sd99512680"
          }
        ]
      }
    },
    {
      "params": {
        "plate": "malham",
        "key": "quiz",
        "contours": {
          "show": false
        },
        "grid": false
      }
    },
    {
      "params": {
        "plate": "spurn-head",
        "key": [
          "foreshore",
          "sea",
          "campsite",
          "lighthouse"
        ],
        "marks": [
          {
            "id": "A",
            "at": "pl-kilnsea-ta41591585",
            "ref": 6,
            "occlude": true
          }
        ]
      }
    },
    {
      "params": {
        "plate": "hebden-town",
        "keyOnly": true,
        "key": "all",
        "header": "Map symbols"
      }
    },
    {
      "params": {
        "plate": "hebden-town",
        "keyOnly": true,
        "key": "quiz"
      }
    }
  ]
}
