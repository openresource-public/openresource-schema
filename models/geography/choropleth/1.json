  "family": "geography",
  "name": "choropleth",
  "version": 1,
  "title": "Choropleth map",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "plate": {
        "type": "string"
      },
      "plateData": {
        "type": "object",
        "additionalProperties": true
      },
      "panels": {
        "type": "array",
        "maxItems": 2,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string"
            },
            "data": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[A-Za-z]{2}(-[A-Za-z0-9]{1,3})?$"
              },
              "additionalProperties": {
                "type": "number"
              }
            }
          },
          "required": [
            "data"
          ]
        }
      },
      "valueLabel": {
        "type": "string"
      },
      "classes": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "equal-interval",
              "quantile"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 3,
            "maximum": 7
          }
        }
      },
      "regions": {
        "type": "array",
        "maxItems": 12,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "display": {
              "type": "string",
              "enum": [
                "name",
                "tag"
              ]
            },
            "tag": {
              "type": "string"
            },
            "occlude": {
              "type": "boolean"
            },
            "blank": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "id"
          ]
        }
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "boolean"
          }
        }
      },
      "scheme": {
        "type": "string",
        "enum": [
          "colour",
          "tonal"
        ]
      },
      "interactive": {
        "type": "boolean"
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "plate",
      "panels"
    ]
  },
