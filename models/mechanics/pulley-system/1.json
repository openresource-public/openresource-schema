{
  "ref": "mechanics/pulley-system@1",
  "family": "mechanics",
  "name": "pulley-system",
  "version": 1,
  "title": "Connected particles over a pulley",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "$defs": {
      "face": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "angle": {
            "type": "number",
            "minimum": 15,
            "maximum": 70
          },
          "label": {
            "type": "string"
          },
          "occlude": {
            "type": "boolean"
          },
          "showArc": {
            "type": "boolean"
          },
          "rough": {
            "type": "boolean"
          }
        },
        "required": [
          "angle"
        ]
      }
    },
    "properties": {
      "scene": {
        "type": "string",
        "enum": [
          "atwood",
          "table-edge",
          "incline"
        ]
      },
      "incline": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "left": {
            "$ref": "#/$defs/face"
          },
          "right": {
            "$ref": "#/$defs/face"
          }
        },
        "required": [
          "left"
        ]
      },
      "particles": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string"
            },
            "mass": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "string",
                  "minLength": 1
                }
              ]
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            },
            "height": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    {
                      "type": "string",
                      "minLength": 1
                    }
                  ]
                },
                "occlude": {
                  "type": "boolean"
                }
              },
              "required": [
                "value"
              ]
            }
          }
        }
      },
      "showGround": {
        "type": "boolean"
      },
      "reveal": {
        "type": "integer",
        "minimum": 1
      },
      "header": {
        "type": "string"
      }
    },
    "required": [
      "scene",
      "particles"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "scene": {
              "const": "incline"
            }
          },
          "required": [
            "scene"
          ]
        },
        "then": {
          "required": [
            "incline"
          ]
        }
      }
    ]
  },
  "examples": [
    {
      "params": {
        "scene": "atwood",
        "particles": [
          {
            "label": "A",
            "mass": 7,
            "height": {
              "value": 2.5
            }
          },
          {
            "label": "B",
            "mass": 4,
            "height": {
              "value": 0.9
            }
          }
        ]
      }
    },
    {
      "params": {
        "scene": "atwood",
        "particles": [
          {
            "label": "A",
            "mass": 7
          },
          {
            "label": "B",
            "mass": 4,
            "occlude": true,
            "highlight": true
          }
        ]
      }
    },
    {
      "params": {
        "scene": "table-edge",
        "particles": [
          {
            "label": "A"
          },
          {
            "label": "B"
          }
        ]
      }
    },
    {
      "params": {
        "scene": "table-edge",
        "particles": [
          {
            "label": "A",
            "mass": 3
          },
          {
            "label": "B",
            "mass": 8,
            "height": {
              "value": 1.2
            }
          }
        ]
      }
    },
    {
      "params": {
        "scene": "incline",
        "incline": {
          "left": {
            "angle": 35,
            "label": "α°",
            "rough": true
          }
        },
        "particles": [
          {
            "label": "P",
            "mass": 9
          },
          {
            "label": "Q",
            "mass": 6,
            "height": {
              "value": 1.8
            }
          }
        ]
      }
    },
    {
      "params": {
        "header": "One particle on each face",
        "scene": "incline",
        "incline": {
          "left": {
            "angle": 25
          },
          "right": {
            "angle": 55,
            "rough": true
          }
        },
        "particles": [
          {
            "label": "R",
            "mass": 11
          },
          {
            "label": "S",
            "mass": 3
          }
        ]
      }
    }
  ]
}
