{
  "ref": "mechanics/force-diagram@1",
  "family": "mechanics",
  "name": "force-diagram",
  "version": 1,
  "title": "Force diagram (statics and dynamics)",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "$defs": {
      "angleMark": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "to": {
            "type": "string",
            "enum": [
              "horizontal",
              "vertical",
              "plane"
            ]
          },
          "at": {
            "type": "string",
            "enum": [
              "body",
              "anchor"
            ]
          },
          "label": {
            "type": "string"
          },
          "occlude": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          }
        },
        "required": [
          "to"
        ]
      }
    },
    "properties": {
      "scene": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "plain",
              "ground",
              "incline",
              "wall",
              "ceiling"
            ]
          },
          "angle": {
            "type": "number",
            "minimum": 1,
            "maximum": 80
          },
          "angleLabel": {
            "type": "string"
          },
          "occludeAngle": {
            "type": "boolean"
          },
          "showAngle": {
            "type": "boolean"
          },
          "rough": {
            "type": "boolean"
          },
          "friction": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "kind"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "incline"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "angle"
              ]
            }
          }
        ]
      },
      "body": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "shape": {
            "type": "string",
            "enum": [
              "particle",
              "block"
            ]
          },
          "label": {
            "type": "string"
          },
          "occlude": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          }
        }
      },
      "forces": {
        "type": "array",
        "maxItems": 6,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "angle": {
              "type": "number"
            },
            "frame": {
              "type": "string",
              "enum": [
                "horizontal",
                "plane"
              ]
            },
            "arrow": {
              "type": "string",
              "enum": [
                "out",
                "in"
              ]
            },
            "label": {
              "type": "string"
            },
            "magnitude": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "angleMark": {
              "$ref": "#/$defs/angleMark"
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "angle"
          ]
        }
      },
      "strings": {
        "type": "array",
        "maxItems": 3,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "angle": {
              "type": "number"
            },
            "label": {
              "type": "string"
            },
            "anchorLabel": {
              "type": "string"
            },
            "angleMark": {
              "$ref": "#/$defs/angleMark"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "angle"
          ]
        }
      },
      "header": {
        "type": "string"
      },
      "reveal": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "scene"
    ]
  },
  "examples": [
    {
      "params": {
        "header": "A block at rest on a rough plane",
        "scene": {
          "kind": "incline",
          "angle": 22,
          "rough": true,
          "friction": 0.35
        },
        "body": {
          "shape": "block",
          "label": "6 kg"
        },
        "forces": [
          {
            "angle": 270,
            "label": "W",
            "magnitude": 58.8
          },
          {
            "angle": 90,
            "frame": "plane",
            "label": "R"
          },
          {
            "angle": 0,
            "frame": "plane",
            "label": "F"
          }
        ]
      }
    },
    {
      "params": {
        "scene": {
          "kind": "incline",
          "angle": 18
        },
        "body": {
          "shape": "particle",
          "label": "P"
        }
      }
    },
    {
      "params": {
        "scene": {
          "kind": "ground",
          "rough": true,
          "friction": 0.3
        },
        "body": {
          "shape": "block",
          "label": "8 kg"
        },
        "forces": [
          {
            "angle": 35,
            "label": "F",
            "occlude": true,
            "highlight": true,
            "angleMark": {
              "to": "horizontal"
            }
          },
          {
            "angle": 270,
            "label": "W"
          },
          {
            "angle": 90,
            "label": "R"
          }
        ]
      }
    },
    {
      "params": {
        "scene": {
          "kind": "wall"
        },
        "body": {
          "shape": "particle",
          "label": "P"
        },
        "strings": [
          {
            "angle": 130,
            "label": "T",
            "angleMark": {
              "to": "vertical",
              "at": "anchor"
            }
          }
        ],
        "forces": [
          {
            "angle": 0,
            "magnitude": 15
          },
          {
            "angle": 270,
            "label": "W"
          }
        ]
      }
    },
    {
      "params": {
        "header": "A particle held by two strings",
        "scene": {
          "kind": "ceiling"
        },
        "body": {
          "shape": "particle",
          "label": "P"
        },
        "strings": [
          {
            "angle": 125,
            "anchorLabel": "A",
            "angleMark": {
              "to": "horizontal"
            }
          },
          {
            "angle": 25,
            "anchorLabel": "B",
            "angleMark": {
              "to": "horizontal"
            }
          }
        ],
        "forces": [
          {
            "angle": 270,
            "label": "W",
            "magnitude": 40
          }
        ]
      }
    },
    {
      "params": {
        "scene": {
          "kind": "incline",
          "angle": 37,
          "angleLabel": "θ°",
          "rough": true
        },
        "body": {
          "shape": "block",
          "label": "2 kg"
        },
        "forces": [
          {
            "angle": 0,
            "frame": "plane",
            "magnitude": 9,
            "arrow": "in",
            "highlight": true
          }
        ]
      }
    }
  ]
}
