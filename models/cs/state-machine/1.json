{
  "ref": "cs/state-machine@1",
  "family": "cs",
  "name": "state-machine",
  "version": 1,
  "title": "State machine",
  "responseModes": [
    "fill-derived"
  ],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "machine": {
        "type": "string",
        "enum": [
          "acceptor",
          "mealy",
          "turing"
        ]
      },
      "states": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
            },
            "label": {
              "type": "string"
            },
            "accept": {
              "type": "boolean"
            },
            "halt": {
              "type": "boolean"
            }
          },
          "required": [
            "id"
          ]
        }
      },
      "start": {
        "type": "string"
      },
      "rules": {
        "type": "array",
        "maxItems": 28,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "string"
            },
            "read": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 8
                }
              ]
            },
            "to": {
              "type": "string"
            },
            "output": {
              "type": "string"
            },
            "write": {
              "type": "string"
            },
            "move": {
              "type": "string",
              "enum": [
                "left",
                "right",
                "stay"
              ]
            },
            "occlude": {
              "type": "string",
              "enum": [
                "to",
                "read",
                "output",
                "write",
                "move",
                "all"
              ]
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "from",
            "read",
            "to"
          ]
        }
      },
      "blank": {
        "type": "string"
      },
      "tape": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cells": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 16
              }
            ]
          },
          "head": {
            "type": "integer"
          }
        }
      },
      "input": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 16
          }
        ]
      },
      "inputs": {
        "type": "array",
        "maxItems": 6,
        "items": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 16
            }
          ]
        }
      },
      "view": {
        "type": "string",
        "enum": [
          "diagram",
          "table",
          "diagram+table",
          "delta",
          "trace",
          "tape",
          "verdicts"
        ]
      },
      "table": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "layout": {
            "type": "string",
            "enum": [
              "wide",
              "long",
              "long-input-first",
              "transposed"
            ]
          }
        }
      },
      "layout": {
        "type": "string",
        "enum": [
          "auto",
          "row",
          "ring"
        ]
      },
      "at": {
        "type": "integer",
        "minimum": 0
      },
      "frames": {
        "type": "string",
        "enum": [
          "one",
          "all"
        ]
      },
      "regex": {
        "type": "string"
      },
      "occlude": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "verdict": {
            "type": "boolean"
          },
          "trace": {
            "type": "boolean"
          },
          "outputs": {
            "type": "boolean"
          },
          "finalTape": {
            "type": "boolean"
          },
          "frames": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "regex": {
            "type": "boolean"
          },
          "alphabet": {
            "type": "boolean"
          }
        }
      },
      "highlight": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "states": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string"
            }
          },
          "rules": {
            "type": "array",
            "maxItems": 28,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "alphabet": {
            "type": "boolean"
          },
          "path": {
            "type": "boolean"
          },
          "states": {
            "type": "boolean"
          },
          "outputs": {
            "type": "boolean"
          },
          "verdict": {
            "type": "boolean"
          },
          "indices": {
            "type": "boolean"
          },
          "key": {
            "type": "boolean"
          },
          "moveWords": {
            "type": "boolean"
          }
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "states",
      "rules"
    ]
  },
  "examples": [
    {
      "params": {
        "machine": "acceptor",
        "header": "An even number of 1s",
        "states": [
          {
            "id": "S0",
            "accept": true
          },
          {
            "id": "S1"
          }
        ],
        "rules": [
          {
            "from": "S0",
            "read": "0",
            "to": "S0"
          },
          {
            "from": "S0",
            "read": "1",
            "to": "S1"
          },
          {
            "from": "S1",
            "read": "0",
            "to": "S1"
          },
          {
            "from": "S1",
            "read": "1",
            "to": "S0"
          }
        ],
        "view": "diagram+table",
        "table": {
          "layout": "wide"
        },
        "show": {
          "alphabet": true
        },
        "caption": "S0 counts an even number of 1s so far"
      }
    },
    {
      "params": {
        "machine": "acceptor",
        "states": [
          {
            "id": "S0"
          },
          {
            "id": "S1"
          },
          {
            "id": "S2",
            "accept": true
          }
        ],
        "rules": [
          {
            "from": "S0",
            "read": "a",
            "to": "S1"
          },
          {
            "from": "S0",
            "read": "b",
            "to": "S0"
          },
          {
            "from": "S1",
            "read": "a",
            "to": "S1"
          },
          {
            "from": "S1",
            "read": "b",
            "to": "S2"
          },
          {
            "from": "S2",
            "read": "a",
            "to": "S1"
          },
          {
            "from": "S2",
            "read": "b",
            "to": "S0"
          }
        ],
        "view": "table",
        "table": {
          "layout": "long"
        },
        "at": 1
      }
    },
    {
      "params": {
        "machine": "acceptor",
        "states": [
          {
            "id": "S0",
            "accept": true
          },
          {
            "id": "S1"
          },
          {
            "id": "S2"
          }
        ],
        "rules": [
          {
            "from": "S0",
            "read": "0",
            "to": "S1"
          },
          {
            "from": "S0",
            "read": "1",
            "to": "S0"
          },
          {
            "from": "S1",
            "read": "0",
            "to": "S2"
          },
          {
            "from": "S1",
            "read": "1",
            "to": "S0"
          },
          {
            "from": "S2",
            "read": [
              "0",
              "1"
            ],
            "to": "S2"
          }
        ],
        "view": "table",
        "table": {
          "layout": "wide"
        },
        "at": 0
      }
    },
    {
      "params": {
        "machine": "turing",
        "header": "Binary increment",
        "blank": "#",
        "states": [
          {
            "id": "S0"
          },
          {
            "id": "S1"
          },
          {
            "id": "S2",
            "halt": true
          }
        ],
        "tape": {
          "cells": "101",
          "head": 0
        },
        "rules": [
          {
            "from": "S0",
            "read": [
              "0",
              "1"
            ],
            "to": "S0",
            "move": "right"
          },
          {
            "from": "S0",
            "read": "#",
            "to": "S1",
            "write": "#",
            "move": "left"
          },
          {
            "from": "S1",
            "read": "1",
            "to": "S1",
            "write": "0",
            "move": "left"
          },
          {
            "from": "S1",
            "read": "0",
            "to": "S2",
            "write": "1",
            "move": "right"
          },
          {
            "from": "S1",
            "read": "#",
            "to": "S2",
            "write": "1",
            "move": "right"
          }
        ],
        "view": "tape",
        "frames": "all",
        "occlude": {
          "finalTape": true
        }
      }
    },
    {
      "params": {
        "machine": "mealy",
        "header": "Output 1 on the second 1 in a row",
        "states": [
          {
            "id": "A"
          },
          {
            "id": "B"
          }
        ],
        "rules": [
          {
            "from": "A",
            "read": "0",
            "to": "A",
            "output": "0"
          },
          {
            "from": "A",
            "read": "1",
            "to": "B",
            "output": "0"
          },
          {
            "from": "B",
            "read": "0",
            "to": "A",
            "output": "0"
          },
          {
            "from": "B",
            "read": "1",
            "to": "B",
            "output": "1"
          }
        ],
        "input": "11011",
        "view": "trace"
      }
    },
    {
      "params": {
        "machine": "acceptor",
        "header": "Strings ending in ab",
        "states": [
          {
            "id": "S0"
          },
          {
            "id": "S1"
          },
          {
            "id": "S2",
            "accept": true
          }
        ],
        "rules": [
          {
            "from": "S0",
            "read": "a",
            "to": "S1"
          },
          {
            "from": "S0",
            "read": "b",
            "to": "S0"
          },
          {
            "from": "S1",
            "read": "a",
            "to": "S1"
          },
          {
            "from": "S1",
            "read": "b",
            "to": "S2"
          },
          {
            "from": "S2",
            "read": "a",
            "to": "S1"
          },
          {
            "from": "S2",
            "read": "b",
            "to": "S0"
          }
        ],
        "inputs": [
          "ab",
          "aab",
          "aba",
          "babab"
        ],
        "view": "verdicts",
        "regex": "(a|b)*ab",
        "occlude": {
          "regex": true
        }
      }
    }
  ]
}
