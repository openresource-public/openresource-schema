{
  "ref": "cs/spreadsheet@2",
  "family": "cs",
  "name": "spreadsheet",
  "version": 2,
  "title": "Spreadsheet",
  "responseModes": [
    "run-value",
    "run-sheet"
  ],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "$defs": {
      "fillCheck": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "range": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "pattern": {
            "type": "string"
          }
        },
        "required": [
          "range"
        ]
      },
      "formatCheck": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "range": {
            "type": "string"
          },
          "is": {
            "type": "string",
            "enum": [
              "general",
              "currency",
              "percent",
              "1dp",
              "2dp"
            ]
          },
          "bold": {
            "type": "boolean"
          }
        },
        "required": [
          "range"
        ]
      }
    },
    "properties": {
      "cells": {
        "type": "object",
        "additionalProperties": false,
        "patternProperties": {
          "^[A-Z][1-9][0-9]?$": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "value": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      }
                    ]
                  },
                  "occlude": {
                    "type": "boolean"
                  },
                  "highlight": {
                    "type": "boolean"
                  },
                  "bold": {
                    "type": "boolean"
                  },
                  "format": {
                    "type": "string",
                    "enum": [
                      "general",
                      "currency",
                      "percent",
                      "1dp",
                      "2dp"
                    ]
                  }
                },
                "required": [
                  "value"
                ]
              }
            ]
          }
        }
      },
      "selected": {
        "type": "string",
        "pattern": "^[A-Z][1-9][0-9]?$"
      },
      "responseCell": {
        "type": "string",
        "pattern": "^[A-Z][1-9][0-9]?$"
      },
      "markSheet": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fill": {
            "oneOf": [
              {
                "$ref": "#/$defs/fillCheck"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/fillCheck"
                }
              }
            ]
          },
          "format": {
            "oneOf": [
              {
                "$ref": "#/$defs/formatCheck"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/formatCheck"
                }
              }
            ]
          }
        }
      },
      "editable": {
        "type": "boolean"
      },
      "header": {
        "type": "string"
      },
      "theme": {
        "type": "string",
        "enum": [
          "platinum",
          "paper",
          "contrast",
          "chalkboard",
          "terminal",
          "aubergine",
          "amber"
        ]
      },
      "cols": {
        "type": "integer",
        "minimum": 2,
        "maximum": 12
      },
      "rows": {
        "type": "integer",
        "minimum": 2,
        "maximum": 40
      },
      "colWidths": {
        "type": "object",
        "additionalProperties": false,
        "patternProperties": {
          "^[A-Z]$": {
            "type": "number",
            "minimum": 40,
            "maximum": 240
          }
        }
      },
      "currency": {
        "type": "string",
        "maxLength": 3
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "formulaBar": {
            "type": "boolean"
          },
          "formulas": {
            "type": "boolean"
          }
        }
      }
    },
    "required": [
      "cells"
    ]
  },
  "examples": [
