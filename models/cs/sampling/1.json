{
  "ref": "cs/sampling@1",
  "family": "cs",
  "name": "sampling",
  "version": 1,
  "title": "Sampling and quantisation",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "signal": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "harmonics": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "frequency": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "amplitude": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "phase": {
                  "type": "number"
                }
              },
              "required": [
                "frequency",
                "amplitude"
              ]
            }
          },
          "window": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "peak": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "harmonics"
        ]
      },
      "sampling": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rate": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "bitDepth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          }
        },
        "required": [
          "rate",
          "bitDepth"
        ]
      },
      "fileSize": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "channels": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          },
          "binaryPrefixes": {
            "type": "boolean"
          }
        }
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "curve": {
            "type": "boolean"
          },
          "samples": {
            "type": "boolean"
          },
          "staircase": {
            "type": "boolean"
          },
          "levels": {
            "type": "boolean"
          },
          "levelNumbers": {
            "type": "boolean"
          },
          "sampleCodes": {
            "type": "boolean"
          },
          "quantisationError": {
            "type": "boolean"
          },
          "rate": {
            "type": "boolean"
          },
          "bitDepth": {
            "type": "boolean"
          },
          "levelCount": {
            "type": "boolean"
          },
          "seriesLabels": {
            "type": "boolean"
          }
        }
      },
      "occlude": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "staircase": {
            "type": "boolean"
          },
          "fileSize": {
            "type": "boolean"
          },
          "levelCount": {
            "type": "boolean"
          }
        }
      },
      "highlight": {
        "type": "string",
        "enum": [
          "staircase",
          "levels",
          "error",
          "fileSize"
        ]
      },
      "reveal": {
        "type": "integer",
        "minimum": 1,
        "maximum": 3
      },
      "codeBase": {
        "type": "string",
        "enum": [
          "denary",
          "binary"
        ]
      },
      "draggable": {
        "type": "boolean"
      },
      "caption": {
        "type": "string"
      },
      "header": {
        "type": "string"
      }
    },
    "required": [
      "signal",
      "sampling"
    ]
  },
  "examples": [
    {
      "params": {
        "header": "Sampling at 8 Hz with 3 bits per sample",
        "signal": {
          "harmonics": [
            {
              "frequency": 1,
              "amplitude": 1
            },
            {
              "frequency": 2,
              "amplitude": 0.42,
              "phase": 0.35
            }
          ],
          "window": 1
        },
        "sampling": {
          "rate": 8,
          "bitDepth": 3
        },
        "fileSize": {},
        "show": {
          "sampleCodes": true
        },
        "caption": "Each sample is rounded to the nearest of the 8 levels and stored as that number."
      }
    },
    {
      "params": {
        "signal": {
          "harmonics": [
            {
              "frequency": 1,
              "amplitude": 1
            },
            {
              "frequency": 3,
              "amplitude": 0.28,
              "phase": 0.5
            }
          ],
          "window": 1
        },
        "sampling": {
          "rate": 10,
          "bitDepth": 3
        },
        "show": {
          "staircase": false,
          "seriesLabels": false
        }
      }
    },
    {
      "params": {
        "signal": {
          "harmonics": [
            {
              "frequency": 2,
              "amplitude": 1
            },
            {
              "frequency": 5,
              "amplitude": 0.3,
              "phase": 0.6
            }
          ],
          "window": 1
        },
        "sampling": {
          "rate": 16,
          "bitDepth": 4
        },
        "fileSize": {
          "duration": 30,
          "channels": 2
        },
        "occlude": {
          "fileSize": true
        }
      }
    },
    {
      "params": {
        "header": "Sampling at 4 Hz",
        "signal": {
          "harmonics": [
            {
              "frequency": 1,
              "amplitude": 1
            },
            {
              "frequency": 2,
              "amplitude": 0.42,
              "phase": 0.35
            }
          ],
          "window": 1
        },
        "sampling": {
          "rate": 4,
          "bitDepth": 4
        },
        "fileSize": {},
        "show": {
          "quantisationError": true
        },
        "caption": "Between the samples the stored waveform knows nothing about the signal."
      }
    },
    {
      "params": {
        "header": "CD audio",
        "signal": {
          "harmonics": [
            {
              "frequency": 440,
              "amplitude": 1
            },
            {
              "frequency": 880,
              "amplitude": 0.35,
              "phase": 0.4
            }
          ],
          "window": 0.002
        },
        "sampling": {
          "rate": 44100,
          "bitDepth": 16
        },
        "fileSize": {
          "duration": 180,
          "channels": 2
        },
        "caption": "At this rate and depth the stored waveform sits on the signal — and the file is enormous."
      }
    },
    {
      "params": {
        "header": "1 bit per sample",
        "signal": {
          "harmonics": [
            {
              "frequency": 1,
              "amplitude": 1
            },
            {
              "frequency": 2,
              "amplitude": 0.42,
              "phase": 0.35
            }
          ],
          "window": 1
        },
        "sampling": {
          "rate": 16,
          "bitDepth": 1
        },
        "show": {
          "quantisationError": true,
          "sampleCodes": true
        },
        "highlight": "error",
        "caption": "With only two levels every sample is stored as loud or quiet, nothing between."
      }
    }
  ]
}
