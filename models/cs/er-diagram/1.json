{
  "ref": "cs/er-diagram@1",
  "family": "cs",
  "name": "er-diagram",
  "version": 1,
  "title": "Entity-relationship diagram",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "$defs": {
      "attribute": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "key": {
            "type": "string",
            "enum": [
              "primary"
            ]
          },
          "occlude": {
            "type": "boolean"
          },
          "blank": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "properties": {
      "entities": {
        "type": "array",
        "minItems": 1,
        "maxItems": 6,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "name": {
              "type": "string"
            },
            "attributes": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "$ref": "#/$defs/attribute"
              }
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "name"
          ]
        }
      },
      "relationships": {
        "type": "array",
        "maxItems": 6,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "string"
            },
            "to": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "one-to-one",
                "one-to-many",
                "many-to-many"
              ]
            },
            "label": {
              "type": "string"
            },
            "link": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "attributes": {
                  "type": "array",
                  "maxItems": 4,
                  "items": {
                    "$ref": "#/$defs/attribute"
                  }
                }
              }
            },
            "occlude": {
              "type": "boolean"
            },
            "blank": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "from",
            "to",
            "type"
          ]
        }
      },
      "normalise": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "relation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "attributes": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10,
                "items": {
                  "$ref": "#/$defs/attribute"
                }
              },
              "repeating": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "attributes": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 8,
                    "items": {
                      "$ref": "#/$defs/attribute"
                    }
                  }
                },
                "required": [
                  "name",
                  "attributes"
                ]
              }
            },
            "required": [
              "name",
              "attributes"
            ]
          },
          "dependencies": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "determinant": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "dependents": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "relation": {
                  "type": "string"
                }
              },
              "required": [
                "determinant",
                "dependents"
              ]
            }
          },
          "stage": {
            "type": "string",
            "enum": [
              "unf",
              "1nf",
              "2nf",
              "3nf"
            ]
          },
          "occlude": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blank": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "highlight": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "relation"
        ]
      },
      "view": {
        "type": "string",
        "enum": [
          "diagram",
          "tables"
        ]
      },
      "notation": {
        "type": "string",
        "enum": [
          "crows-foot",
          "one-many"
        ]
      },
      "layout": {
        "type": "string",
        "enum": [
          "columns",
          "rows"
        ]
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "relationships": {
            "type": "boolean"
          },
          "keys": {
            "type": "boolean"
          }
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "oneOf": [
      {
        "required": [
          "entities"
        ]
      },
      {
        "required": [
          "normalise"
        ]
      }
    ]
  },
  "examples": [
    {
      "params": {
        "entities": [
          {
            "id": "tutor",
            "name": "Tutor",
            "attributes": [
              {
                "name": "TutorID",
                "key": "primary"
              },
              {
                "name": "Surname"
              },
              {
                "name": "Instrument"
              }
            ]
          },
          {
            "id": "pupil",
            "name": "Pupil",
            "attributes": [
              {
                "name": "PupilID",
                "key": "primary"
              },
              {
                "name": "Surname"
              },
              {
                "name": "YearGroup"
              }
            ]
          }
        ],
        "relationships": [
          {
            "from": "tutor",
            "to": "pupil",
            "type": "one-to-many",
            "label": "teaches"
          }
        ],
        "caption": "One tutor teaches many pupils"
      }
    },
    {
      "params": {
        "entities": [
          {
            "id": "member",
            "name": "Member",
            "attributes": [
              {
                "name": "MemberID",
                "key": "primary"
              },
              {
                "name": "Surname"
              }
            ]
          },
          {
            "id": "hire",
            "name": "Hire",
            "attributes": [
              {
                "name": "HireID",
                "key": "primary"
              },
              {
                "name": "StartTime"
              }
            ]
          },
          {
            "id": "bike",
            "name": "Bike",
            "attributes": [
              {
                "name": "BikeID",
                "key": "primary"
              },
              {
                "name": "Model"
              }
            ]
          }
        ],
        "relationships": [
          {
            "from": "member",
            "to": "hire",
            "type": "one-to-many"
          },
          {
            "from": "bike",
            "to": "hire",
            "type": "one-to-many"
          }
        ],
        "show": {
          "relationships": false
        },
        "caption": "A member may hire many bikes; each hire is of one bike"
      }
    },
    {
      "params": {
        "entities": [
          {
            "id": "ward",
            "name": "Ward",
            "attributes": [
              {
                "name": "WardID",
                "key": "primary"
              },
              {
                "name": "WardName"
              }
            ]
          },
          {
            "id": "bed",
            "name": "Bed",
            "attributes": [
              {
                "name": "BedID",
                "key": "primary"
              },
              {
                "name": "BedNumber"
              }
            ]
          }
        ],
        "relationships": [
          {
            "from": "ward",
            "to": "bed",
            "type": "one-to-many",
            "label": "contains",
            "occlude": true
          }
        ]
      }
    },
    {
      "params": {
        "entities": [
          {
            "id": "pupil",
            "name": "Pupil",
            "attributes": [
              {
                "name": "PupilID",
                "key": "primary"
              },
              {
                "name": "Surname"
              }
            ]
          },
          {
            "id": "ensemble",
            "name": "Ensemble",
            "attributes": [
              {
                "name": "EnsembleID",
                "key": "primary"
              },
              {
                "name": "Ensemble"
              }
            ]
          }
        ],
        "relationships": [
          {
            "from": "pupil",
            "to": "ensemble",
            "type": "many-to-many",
            "link": {
              "name": "Seat",
              "attributes": [
                {
                  "name": "Part"
                }
              ]
            }
          }
        ],
        "caption": "The link entity takes both primary keys as its composite key"
      }
    },
    {
      "params": {
        "view": "tables",
        "entities": [
          {
            "id": "venue",
            "name": "Venue",
            "attributes": [
              {
                "name": "VenueID",
                "key": "primary"
              },
              {
                "name": "VenueName"
              },
              {
                "name": "Capacity"
              }
            ]
          },
          {
            "id": "concert",
            "name": "Concert",
            "attributes": [
              {
                "name": "ConcertID",
                "key": "primary"
              },
              {
                "name": "ConcertDate"
              }
            ]
          },
          {
            "id": "ticket",
            "name": "Ticket",
            "attributes": [
              {
                "name": "TicketID",
                "key": "primary"
              },
              {
                "name": "Price"
              }
            ]
          }
        ],
        "relationships": [
          {
            "from": "venue",
            "to": "concert",
            "type": "one-to-many"
          },
          {
            "from": "concert",
            "to": "ticket",
            "type": "one-to-many"
          }
        ],
        "caption": "Each foreign key sits on the many side of its relationship"
      }
    },
    {
      "params": {
        "normalise": {
          "relation": {
            "name": "Booking",
            "attributes": [
              {
                "name": "BookingID",
                "key": "primary"
              },
              {
                "name": "BookingDate"
              },
              {
                "name": "HirerID"
              },
              {
                "name": "HirerName"
              },
              {
                "name": "HirerPhone"
              }
            ],
            "repeating": {
              "name": "BookingSlot",
              "attributes": [
                {
                  "name": "RoomID",
                  "key": "primary"
                },
                {
                  "name": "Hours"
                },
                {
                  "name": "RoomName"
                },
                {
                  "name": "HourlyRate"
                }
              ]
            }
          },
          "dependencies": [
            {
              "determinant": [
                "BookingID"
              ],
              "dependents": [
                "BookingDate",
                "HirerID"
              ]
            },
            {
              "determinant": [
                "RoomID"
              ],
              "dependents": [
                "RoomName",
                "HourlyRate"
              ],
              "relation": "Room"
            },
            {
              "determinant": [
                "HirerID"
              ],
              "dependents": [
                "HirerName",
                "HirerPhone"
              ],
              "relation": "Hirer"
            }
          ],
          "stage": "3nf",
          "highlight": [
            "Hirer"
          ]
        },
        "header": "Third normal form",
        "caption": "Four relations, each fully dependent on its own key — Hirer is the 3NF split"
      }
    }
  ]
}
