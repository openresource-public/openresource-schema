{
  "ref": "cs/pseudocode-editor@1",
  "family": "cs",
  "name": "pseudocode-editor",
  "version": 1,
  "title": "Pseudo-code editor",
  "responseModes": [
    "run-program"
  ],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "program": {
        "type": "string",
        "minLength": 1
      },
      "inputs": {
        "type": "array",
        "maxItems": 20,
        "items": {
          "type": [
            "string",
            "number"
          ]
        }
      },
      "startVars": {
        "type": "object",
        "propertyNames": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "additionalProperties": {}
      },
      "seed": {
        "type": "integer",
        "minimum": 0
      },
      "editable": {
        "enum": [
          true,
          false,
          "data"
        ]
      },
      "occlude": {
        "type": "boolean"
      },
      "header": {
        "type": "string"
      },
      "theme": {
        "type": "string",
        "enum": [
          "platinum",
          "paper",
          "contrast",
          "chalkboard",
          "terminal",
          "aubergine",
          "amber"
        ]
      },
      "skin": {
        "type": "string"
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "variables": {
            "type": "boolean"
          },
          "inputs": {
            "type": "boolean"
          },
          "output": {
            "type": "boolean"
          }
        }
      },
      "markProgram": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reference": {
            "type": "string"
          },
          "subroutine": {
            "type": "string"
          },
          "tests": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "inputs": {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "number"
                    ]
                  }
                },
                "args": {
                  "type": "array"
                },
                "out": {}
              }
            }
          },
          "generate": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "count": {
                "type": "integer"
              },
              "ints": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                }
              }
            }
          },
          "require": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "required": [
      "program"
    ]
  },
  "examples": [
    {
      "params": {
        "header": "total of 1 to 10",
        "program": "total ← 0\nFOR n ← 1 TO 10\n   total ← total + n\nENDFOR\nOUTPUT 'The total is ' + INT_TO_STRING(total)"
      }
    },
    {
      "params": {
        "occlude": true,
        "editable": false,
        "program": "count ← 0\nFOR i ← 1 TO 12\n   IF i MOD 4 = 0 THEN\n      count ← count + 1\n   ENDIF\nENDFOR\nOUTPUT count"
      }
    },
    {
      "params": {
        "header": "binary search",
        "editable": false,
        "startVars": {
          "items": [
            3,
            8,
            11,
            19,
            24,
            30,
            37
          ]
        },
        "program": "SUBROUTINE find(list, target)\n   low ← 0\n   high ← LEN(list) - 1\n   WHILE low ≤ high\n      mid ← (low + high) DIV 2\n      IF list[mid] = target THEN\n         RETURN mid\n      ENDIF\n      IF list[mid] < target THEN\n         low ← mid + 1\n      ELSE\n         high ← mid - 1\n      ENDIF\n   ENDWHILE\n   RETURN -1\nENDSUBROUTINE\n\nposition ← find(items, 24)\nOUTPUT position"
      }
    },
    {
      "params": {
        "header": "pass or fail",
        "editable": false,
        "inputs": [
          67
        ],
        "program": "mark ← USERINPUT\nIF mark ≥ 45 THEN\n   OUTPUT 'pass'\nELSE\n   OUTPUT 'fail'\nENDIF"
      }
    },
    {
      "params": {
        "header": "your answer",
        "program": "# Write pseudo-code that displays the 4 times table\n# from 4 up to 40, one line per multiple.\n"
      }
    },
    {
      "params": {
        "header": "your answer",
        "inputs": [
          14
        ],
        "program": "# Write pseudo-code that reads an age and displays\n# 'child' if it is under 16, otherwise 'adult'.\n",
        "markProgram": {
          "reference": "age ← USERINPUT\nIF age < 16 THEN\n   OUTPUT 'child'\nELSE\n   OUTPUT 'adult'\nENDIF",
          "tests": [
            {
              "inputs": [
                14
              ]
            },
            {
              "inputs": [
                41
              ]
            }
          ],
          "generate": {
            "count": 3,
            "ints": [
              [
                0,
                100
              ]
            ]
          }
        }
      }
    }
  ]
}
