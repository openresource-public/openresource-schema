{
  "ref": "cs/caesar-cipher@1",
  "family": "cs",
  "name": "caesar-cipher",
  "version": 1,
  "title": "Caesar cipher",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "message": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      },
      "shift": {
        "type": "integer",
        "minimum": 0,
        "maximum": 25
      },
      "mode": {
        "type": "string",
        "enum": [
          "encode",
          "decode"
        ]
      },
      "occlude": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "shift": {
            "type": "boolean"
          },
          "output": {
            "type": "boolean"
          },
          "mapping": {
            "type": "boolean"
          }
        }
      },
      "highlightLetter": {
        "type": "string",
        "pattern": "^[A-Za-z]$"
      },
      "reveal": {
        "type": "integer",
        "minimum": 0
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mapping": {
            "type": "boolean"
          },
          "shift": {
            "type": "boolean"
          },
          "output": {
            "type": "boolean"
          },
          "frequency": {
            "type": "boolean"
          },
          "expected": {
            "type": "boolean"
          }
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      },
      "draggable": {
        "type": "boolean"
      }
    },
    "required": [
      "message",
      "shift"
    ]
  },
  "examples": [
    {
      "params": {
        "header": "Encrypt with a shift of 3",
        "message": "Meet me by the old oak.",
        "shift": 3,
        "mode": "encode",
        "show": {
          "mapping": true
        },
        "caption": "Each letter moves 3 places: A→D, B→E, …"
      }
    },
    {
      "params": {
        "message": "ZLUK TVYL ZBWWSPLZ",
        "shift": 7,
        "mode": "decode",
        "show": {
          "mapping": true
        },
        "caption": "The key is 7 — shift each letter back to read the message."
      }
    },
    {
      "params": {
        "message": "THE DROP IS AT NOON",
        "shift": 3,
        "mode": "encode",
        "occlude": {
          "shift": true,
          "mapping": true
        }
      }
    },
    {
      "params": {
        "header": "Encrypt with a shift of 5",
        "message": "GUARD THE BRIDGE AT 6PM",
        "shift": 5,
        "mode": "encode",
        "occlude": {
          "output": true
        },
        "caption": "Shift each letter 5 places and write the ciphertext."
      }
    },
    {
      "params": {
        "header": "Crack the cipher",
        "message": "JXU IUSHUJ WQHTUD WQJU EFUDI QJ CYTDYWXJ. BUQLU JXU BUJJUH RUDUQJX JXU JXYHT IJEDU QDT JUBB DE EDU. JXU AUUFUH IUUI ULUHOJXYDW JXQJ CELUI RUJMUUD JXU XUTWUI.",
        "shift": 16,
        "mode": "decode",
        "occlude": {
          "shift": true,
          "output": true,
          "mapping": true
        },
        "show": {
          "frequency": true
        }
      }
    },
    {
      "params": {
        "header": "A shift of 0 changes nothing",
        "message": "ADD ONE MORE DAY",
        "shift": 0,
        "mode": "encode",
        "highlightLetter": "D",
        "show": {
          "mapping": true
        },
        "caption": "With shift 0 every letter maps to itself — trace D."
      }
    }
  ]
}
