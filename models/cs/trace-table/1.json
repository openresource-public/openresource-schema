{
  "ref": "cs/trace-table@1",
  "family": "cs",
  "name": "trace-table",
  "version": 1,
  "title": "Trace table",
  "responseModes": [
    "fill-derived"
  ],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "language": {
        "type": "string",
        "enum": [
          "aqa",
          "python"
        ]
      },
      "program": {
        "type": "string",
        "minLength": 1
      },
      "inputs": {
        "type": "array",
        "maxItems": 20,
        "items": {
          "type": [
            "string",
            "number"
          ]
        }
      },
      "startVars": {
        "type": "object",
        "propertyNames": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "additionalProperties": {}
      },
      "seed": {
        "type": "integer",
        "minimum": 0
      },
      "columns": {
        "type": "array",
        "maxItems": 10,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "var": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "var"
          ]
        }
      },
      "rows": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "at": {
            "type": "string",
            "enum": [
              "change",
              "statement",
              "line",
              "output"
            ]
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "groupLine": {
            "type": "integer",
            "minimum": 1
          },
          "conditions": {
            "type": "boolean"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 40
          }
        }
      },
      "cells": {
        "type": "array",
        "maxItems": 24,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "row": {
              "type": "integer",
              "minimum": 0
            },
            "fromRow": {
              "type": "integer",
              "minimum": 0
            },
            "column": {
              "type": "string"
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            }
          }
        }
      },
      "at": {
        "type": "integer",
        "minimum": 0
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "step": {
            "type": "boolean"
          },
          "line": {
            "type": "boolean"
          },
          "depth": {
            "type": "boolean"
          },
          "output": {
            "type": "boolean"
          },
          "startRow": {
            "type": "boolean"
          },
          "changeMarks": {
            "type": "boolean"
          },
          "repeatUnchanged": {
            "type": "boolean"
          }
        }
      },
      "header": {
        "type": "string"
      }
    },
    "required": [
      "program"
    ]
  },
  "examples": [
    {
      "params": {
        "header": "Trace the running total",
        "program": "total ← 0\ncount ← 1\nWHILE count <= 4 DO\n  total ← total + count\n  count ← count + 1\nENDWHILE\nOUTPUT total",
        "show": {
          "line": true,
          "step": true
        },
        "rows": {
          "at": "change",
          "groupLine": 4
        }
      }
    },
    {
      "params": {
        "program": "total ← 0\ncount ← 1\nWHILE count <= 4 DO\n  total ← total + count\n  count ← count + 1\nENDWHILE\nOUTPUT total",
        "at": 0,
        "show": {
          "line": true,
          "step": true
        }
      }
    },
    {
      "params": {
        "program": "number ← 4193\ndigitSum ← 0\nWHILE number > 0 DO\n  digitSum ← digitSum + number MOD 10\n  number ← number DIV 10\nENDWHILE\nOUTPUT digitSum",
        "show": {
          "step": true
        },
        "cells": [
          {
            "fromRow": 3,
            "occlude": true
          }
        ]
      }
    },
    {
      "params": {
        "header": "Binary search for 26",
        "program": "list ← [3, 8, 12, 19, 26, 31, 44]\ntarget ← 26\nlow ← 0\nhigh ← 6\nfound ← -1\nWHILE low <= high AND found = -1 DO\n  mid ← (low + high) DIV 2\n  IF list[mid] = target THEN\n    found ← mid\n  ELSE IF list[mid] < target THEN\n    low ← mid + 1\n  ELSE\n    high ← mid - 1\n  ENDIF\nENDWHILE\nOUTPUT found",
        "columns": [
          {
            "var": "low"
          },
          {
            "var": "high"
          },
          {
            "var": "mid"
          },
          {
            "var": "found",
            "highlight": true
          }
        ],
        "show": {
          "line": true,
          "step": true
        },
        "rows": {
          "at": "change",
          "groupLine": 7
        }
      }
    },
    {
      "params": {
        "header": "Register trace",
        "program": "R0 ← M[0]\nR1 ← M[1]\nR2 ← R0 - R1\nM[2] ← R2\nR1 ← 3\nR2 ← R2 * R1\nM[2] ← R2",
        "startVars": {
          "M": [
            17,
            6,
            0
          ]
        },
        "columns": [
          {
            "var": "M[0]",
            "label": "FIRST"
          },
          {
            "var": "M[1]",
            "label": "SECOND"
          },
          {
            "var": "M[2]",
            "label": "THIRD"
          },
          {
            "var": "R0"
          },
          {
            "var": "R1"
          },
          {
            "var": "R2"
          }
        ],
        "show": {
          "line": true
        },
        "rows": {
          "at": "statement"
        }
      }
    },
    {
      "params": {
        "header": "Fibonacci numbers",
        "program": "a ← 1\nb ← 1\nFOR n ← 3 TO 8\n  next ← a + b\n  a ← b\n  b ← next\nENDFOR",
        "rows": {
          "at": "line",
          "line": 6
        },
        "show": {
          "step": true
        },
        "cells": [
          {
            "fromRow": 2,
            "occlude": true
          }
        ]
      }
    }
  ]
}
