{
  "ref": "cs/code-editor@4",
  "family": "cs",
  "name": "code-editor",
  "version": 4,
  "title": "Code editor",
  "responseModes": [
    "run-program"
  ],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "language": {
        "type": "string",
        "enum": [
          "javascript",
          "python"
        ]
      },
      "stdin": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "seed": {
        "type": "integer"
      },
      "files": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "code": {
        "type": "string"
      },
      "markProgram": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reference": {
            "type": "string"
          },
          "referenceLanguage": {
            "type": "string",
            "enum": [
              "javascript",
              "python"
            ]
          },
          "function": {
            "type": "string"
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "stdin": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "args": {
                  "type": "array"
                },
                "out": {},
                "files": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "expectFiles": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "generate": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "count": {
                "type": "integer"
              },
              "ints": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                }
              }
            }
          },
          "require": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "editable": {
        "type": "boolean"
      },
      "header": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "theme": {
        "type": "string",
        "enum": [
          "platinum",
          "paper",
          "contrast",
          "chalkboard",
          "terminal",
          "aubergine",
          "amber"
        ]
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "console": {
            "type": "boolean"
          }
        }
      }
    },
    "required": [
      "code"
    ]
  },
  "examples": [
    {
      "params": {
        "language": "python",
        "header": "answer.py",
        "code": "# Write a program that reads a mark and prints\n# \"pass\" if it is 50 or more, otherwise \"fail\".\n",
        "stdin": [
          "62"
        ],
        "markProgram": {
          "reference": "mark = int(input())\nif mark >= 50:\n    print(\"pass\")\nelse:\n    print(\"fail\")",
          "tests": [
            {
              "stdin": [
                "62"
              ]
            },
            {
              "stdin": [
                "3"
              ]
            }
          ],
          "generate": {
            "count": 3,
            "ints": [
              [
                0,
                100
              ]
            ]
          }
        }
      }
    },
    {
      "params": {
        "language": "python",
        "header": "answer.py",
        "code": "def total(nums):\n    # Return the total of the list.\n    pass\n",
        "markProgram": {
          "function": "total",
          "reference": "def total(nums):\n    t = 0\n    for n in nums:\n        t += n\n    return t",
          "tests": [
            {
              "args": [
                [
                  1,
                  2,
                  3
                ]
              ]
            },
            {
              "args": [
                []
              ]
            },
            {
              "args": [
                [
                  -2,
                  2
                ]
              ]
            }
          ]
        }
      }
    },
    {
      "params": {
        "language": "python",
        "title": "Add up one to ten",
        "theme": "terminal",
        "header": "sum.py",
        "code": "total = 0\nfor n in range(1, 11):\n    total += n\nprint(\"The sum of 1 to 10 is\", total)"
      }
    },
    {
      "params": {
        "language": "python",
        "title": "Ask for a name and an age",
        "theme": "chalkboard",
        "header": "greet.py",
        "code": "name = input(\"What is your name? \")\nage = int(input(\"How old are you? \"))\nprint(f\"Hello {name} — next year you will be {age + 1}.\")",
        "stdin": [
          "Ada",
          "11"
        ]
      }
    },
    {
      "params": {
        "language": "python",
        "title": "Read and trace",
        "theme": "paper",
        "header": "grades.py",
        "editable": false,
        "code": "def grade(mark):\n    if mark >= 70:\n        return \"A\"\n    elif mark >= 50:\n        return \"B\"\n    return \"C\"\n\nfor m in [72, 55, 31]:\n    print(m, grade(m))"
      }
    },
    {
      "params": {
        "header": "sum.js",
        "code": "let total = 0;\nfor (let n = 1; n <= 10; n++) {\n  total += n;\n}\nconsole.log(\"The sum of 1 to 10 is\", total);"
      }
    },
    {
      "params": {
        "header": "answer.js",
        "code": "// Write a program that prints the 3 times table\n// from 3 up to 30, one line per multiple.\n"
      }
    },
    {
      "params": {
        "header": "double.js",
        "editable": false,
        "code": "function doubleIt(x) {\n  return x * 2;\n}\n\nconsole.log(doubleIt(6));\nconsole.log(doubleIt(doubleIt(5)));"
      }
    },
    {
      "params": {
        "header": "output.js",
        "code": "const pupil = { name: \"Ada\", marks: [7, 9, 8] };\nconsole.log(pupil);\nconsole.log(\"marks:\", pupil.marks);\nconsole.warn(\"one mark is missing\");"
      }
    },
    {
      "params": {
        "header": "oops.js",
        "code": "const price = 5;\nconsole.log(\"price is\", price);\nconsole.log(\"total is\", price * quantity);"
      }
    },
    {
      "params": {
        "header": "loop.js",
        "code": "// This never stops on its own — the sandbox\n// stops it on a step limit.\nwhile (true) {}"
      }
    }
  ]
}
