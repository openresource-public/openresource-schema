{
  "ref": "cs/sql-playground@6",
  "family": "cs",
  "name": "sql-playground",
  "version": 6,
  "title": "SQL playground",
  "responseModes": [
    "run-query",
    "run-statement"
  ],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "anyOf": [
      {
        "required": [
          "tables"
        ]
      },
      {
        "required": [
          "sql"
        ]
      }
    ],
    "properties": {
      "tables": {
        "type": "array",
        "maxItems": 3,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "columns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string"
                      },
                      "primaryKey": {
                        "type": "boolean"
                      },
                      "notNull": {
                        "type": "boolean"
                      },
                      "unique": {
                        "type": "boolean"
                      },
                      "default": {
                        "type": [
                          "number",
                          "string",
                          "boolean",
                          "null"
                        ]
                      },
                      "references": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "table": {
                            "type": "string"
                          },
                          "column": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "table",
                          "column"
                        ]
                      }
                    },
                    "required": [
                      "name"
                    ]
                  }
                ]
              }
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": [
                    "number",
                    "string",
                    "boolean",
                    "null"
                  ]
                }
              }
            }
          },
          "required": [
            "name",
            "columns"
          ]
        }
      },
      "sql": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sql": {
                  "type": "string"
                },
                "occlude": {
                  "type": "boolean"
                },
                "highlight": {
                  "type": "boolean"
                }
              },
              "required": [
                "sql"
              ]
            }
          }
        ]
      },
      "occludeAfter": {
        "type": "string",
        "enum": [
          "changes",
          "table"
        ]
      },
      "mark": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reference": {
            "type": "string"
          },
          "variants": {
            "type": "integer"
          }
        }
      },
      "editable": {
        "type": "boolean"
      },
      "header": {
        "type": "string"
      },
      "theme": {
        "type": "string",
        "enum": [
          "platinum",
          "paper",
          "contrast",
          "chalkboard",
          "terminal",
          "aubergine",
          "amber"
        ]
      },
      "skin": {
        "type": "string"
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "result": {
            "type": "boolean"
          },
          "rowNumbers": {
            "type": "boolean"
          },
          "before": {
            "type": "boolean"
          },
          "types": {
            "type": "boolean"
          },
          "diff": {
            "type": "boolean"
          },
          "rowCount": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "examples": [
    {
      "params": {
        "header": "pupils.sql",
        "tables": [
          {
            "name": "pupils",
            "columns": [
              "id",
              "name",
              "house",
              "score"
            ],
            "rows": [
              [
                1,
                "Ada",
                "Oak",
                72
              ],
              [
                2,
                "Bo",
                "Elm",
                55
              ],
              [
                3,
                "Cai",
                "Oak",
                64
              ],
              [
                4,
                "Dev",
                "Elm",
                81
              ],
              [
                5,
                "Ela",
                "Oak",
                90
              ]
            ]
          }
        ],
        "sql": "SELECT name, score\nFROM pupils\nWHERE house = 'Oak'\nORDER BY score DESC;"
      }
    },
    {
      "params": {
        "header": "answer.sql",
        "tables": [
          {
            "name": "books",
            "columns": [
              "title",
              "genre",
              "price"
            ],
            "rows": [
              [
                "Lumen",
                "sci-fi",
                6
              ],
              [
                "Tidewheel",
                "fantasy",
                9
              ],
              [
                "Grasp",
                "poetry",
                4
              ],
              [
                "Halyard",
                "sci-fi",
                12
              ]
            ]
          }
        ],
        "sql": "-- Write a query that lists the title and price of\n-- every book priced under 8, cheapest first.\n",
        "mark": {
          "reference": "SELECT title, price\nFROM books\nWHERE price < 8\nORDER BY price;"
        }
      }
    },
    {
      "params": {
        "header": "members.sql",
        "tables": [
          {
            "name": "Member",
            "columns": [
              {
                "name": "MemberID",
                "type": "INTEGER",
                "primaryKey": true
              },
              {
                "name": "Surname",
                "type": "VARCHAR(20)",
                "notNull": true
              },
              {
                "name": "Joined",
                "type": "DATE"
              },
              {
                "name": "Credits",
                "type": "INTEGER",
                "default": 0
              }
            ],
            "rows": [
              [
                4101,
                "Okafor",
                "2024-09-03",
                12
              ],
              [
                4102,
                "Lindqvist",
                "2024-09-11",
                4
              ],
              [
                4103,
                "Bhatt",
                "2025-01-20",
                0
              ]
            ]
          }
        ],
        "sql": "INSERT INTO Member (MemberID, Surname, Joined)\nVALUES (4104, 'Ferreira', '2025-02-14');"
      }
    },
    {
      "params": {
        "header": "Halving the unsealed barley",
        "tables": [
          {
            "name": "Bin",
            "columns": [
              {
                "name": "BinRef",
                "type": "CHAR(4)",
                "primaryKey": true
              },
              {
                "name": "Grain",
                "type": "VARCHAR(12)"
              },
              {
                "name": "Tonnes",
                "type": "REAL"
              },
              {
                "name": "Sealed",
                "type": "BOOLEAN"
              }
            ],
            "rows": [
              [
                "B-11",
                "barley",
                18.4,
                true
              ],
              [
                "B-12",
                "oats",
                6.2,
                false
              ],
              [
                "B-13",
                "barley",
                21.9,
                false
              ],
              [
                "B-14",
                "wheat",
                9.5,
                true
              ]
            ]
          }
        ],
        "sql": [
          {
            "sql": "UPDATE Bin\nSET Tonnes = Tonnes * 0.5\nWHERE Grain = 'barley' AND Sealed = FALSE;"
          }
        ]
      }
    },
    {
      "params": {
        "tables": [
          {
            "name": "Sensor",
            "columns": [
              {
                "name": "SensorID",
                "type": "INTEGER",
                "primaryKey": true
              },
              {
                "name": "Room",
                "type": "VARCHAR(12)"
              },
              {
                "name": "LastReading",
                "type": "REAL"
              }
            ],
            "rows": [
              [
                1,
                "Lab A",
                19.4
              ],
              [
                2,
                "Lab B",
                21.1
              ],
              [
                3,
                "Lab A",
                18.9
              ],
              [
                4,
                "Lab B",
                22.6
              ]
            ]
          }
        ],
        "sql": [
          {
            "sql": "UPDATE Sensor\nSET Room = 'Lab 2'\nWHERE Room = 'Lab B';",
            "occlude": true
          }
        ]
      }
    },
    {
      "params": {
        "header": "loans.sql",
        "tables": [
          {
            "name": "Loan",
            "columns": [
              "LoanID",
              "Genre",
              "DaysOut"
            ],
            "rows": [
              [
                1,
                "fantasy",
                12
              ],
              [
                2,
                "sci-fi",
                3
              ],
              [
                3,
                "fantasy",
                8
              ],
              [
                4,
                "poetry",
                21
              ],
              [
                5,
                "fantasy",
                2
              ],
              [
                6,
                "sci-fi",
                15
              ]
            ]
          }
        ],
        "sql": "SELECT Genre, COUNT(*) AS Total\nFROM Loan\nGROUP BY Genre\nHAVING COUNT(*) > 1\nORDER BY Total DESC;"
      }
    },
    {
      "params": {
        "header": "school.sql",
        "tables": [
          {
            "name": "Student",
            "columns": [
              {
                "name": "StudentID",
                "type": "INTEGER",
                "primaryKey": true
              },
              {
                "name": "Name",
                "type": "VARCHAR(14)",
                "notNull": true
              }
            ],
            "rows": [
              [
                1,
                "Amara"
              ],
              [
                2,
                "Blake"
              ],
              [
                3,
                "Chidi"
              ]
            ]
          },
          {
            "name": "Course",
            "columns": [
              {
                "name": "CourseID",
                "type": "INTEGER",
                "primaryKey": true
              },
              {
                "name": "Title",
                "type": "VARCHAR(14)",
                "notNull": true
              }
            ],
            "rows": [
              [
                10,
                "Databases"
              ],
              [
                20,
                "Networks"
              ]
            ]
          },
          {
            "name": "Enrolment",
            "columns": [
              {
                "name": "StudentID",
                "type": "INTEGER",
                "references": {
                  "table": "Student",
                  "column": "StudentID"
                }
              },
              {
                "name": "CourseID",
                "type": "INTEGER",
                "references": {
                  "table": "Course",
                  "column": "CourseID"
                }
              },
              {
                "name": "Grade",
                "type": "CHAR(1)"
              }
            ],
            "rows": [
              [
                1,
                10,
                "A"
              ],
              [
                1,
                20,
                "B"
              ],
              [
                2,
                10,
                "C"
              ],
              [
                3,
                20,
                "A"
              ]
            ]
          }
        ],
        "sql": "SELECT Name, Title, Grade\nFROM Student\nJOIN Enrolment ON Student.StudentID = Enrolment.StudentID\nJOIN Course ON Enrolment.CourseID = Course.CourseID\nWHERE Grade = 'A'\nORDER BY Name;"
      }
    },
    {
      "params": {
        "header": "answer.sql",
        "tables": [
          {
            "name": "books",
            "columns": [
              "title",
              "genre",
              "price"
            ],
            "rows": [
              [
                "Lumen",
                "sci-fi",
                6
              ],
              [
                "Tidewheel",
                "fantasy",
                9
              ],
              [
                "Grasp",
                "poetry",
                4
              ],
              [
                "Halyard",
                "sci-fi",
                12
              ],
              [
                "Marrowlight",
                "fantasy",
                7
              ]
            ]
          }
        ],
        "sql": "-- Write a query that shows each genre with the\n-- number of books in it, largest count first.\n",
        "mark": {
          "reference": "SELECT genre, COUNT(*) AS Total\nFROM books\nGROUP BY genre\nORDER BY Total DESC;"
        }
      }
    },
    {
      "params": {
        "tables": [],
        "sql": [
          {
            "sql": "CREATE TABLE Seedling (\n  Tray INTEGER PRIMARY KEY,\n  Species VARCHAR(18) NOT NULL,\n  Height REAL\n);"
          },
          {
            "sql": "INSERT INTO Seedling VALUES (1, 'birch', 4.2), (2, 'alder', 3.5);"
          },
          {
            "sql": "INSERT INTO Seedling VALUES (3, 'birch', 2.8), (4, 'rowan', 5.1);"
          },
          {
            "sql": "ALTER TABLE Seedling ADD COLUMN Potted BOOLEAN DEFAULT FALSE;"
          },
          {
            "sql": "UPDATE Seedling\nSET Height = Height * 1.1, Potted = TRUE\nWHERE Species = 'birch';"
          },
          {
            "sql": "DELETE FROM Seedling WHERE Height < 3.6;"
          }
        ]
      }
    }
  ]
}
