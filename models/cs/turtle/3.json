{
  "ref": "cs/turtle@3",
  "family": "cs",
  "name": "turtle",
  "version": 3,
  "title": "Turtle graphics",
  "responseModes": [
    "run-figure"
  ],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "language": {
        "type": "string",
        "enum": [
          "logo",
          "python"
        ]
      },
      "code": {
        "type": "string"
      },
      "header": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "theme": {
        "type": "string",
        "enum": [
          "platinum",
          "paper",
          "contrast",
          "chalkboard",
          "terminal",
          "aubergine",
          "amber"
        ]
      },
      "skin": {
        "type": "string"
      },
      "markFigure": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "shape": {
            "type": "string",
            "enum": [
              "regular-polygon",
              "rectangle",
              "star",
              "path"
            ]
          },
          "sides": {
            "type": "integer"
          },
          "length": {
            "type": "number"
          },
          "width": {
            "type": "number"
          },
          "height": {
            "type": "number"
          },
          "points": {
            "type": "integer"
          },
          "step": {
            "type": "integer"
          },
          "segments": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          },
          "anchored": {
            "type": "boolean"
          },
          "require": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "shape"
        ]
      },
      "editable": {
        "type": "boolean"
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "grid": {
            "type": "boolean"
          },
          "turtle": {
            "type": "boolean"
          },
          "state": {
            "type": "boolean"
          }
        }
      }
    },
    "required": [
      "code"
    ]
  },
  "examples": [
    {
      "params": {
        "language": "python",
        "header": "hexagon.py",
        "code": "import turtle\n\nt = turtle.Turtle()\n\n# exterior angle = 360 / 6 = 60\nfor side in range(6):\n    t.forward(70)\n    t.right(360 / 6)\n"
      }
    },
    {
      "params": {
        "language": "python",
        "header": "polygon.py",
        "code": "from turtle import *\n\ndef polygon(sides, size):\n    for i in range(sides):\n        forward(size)\n        right(360 / sides)\n\npolygon(5, 90)\n"
      }
    },
    {
      "params": {
        "language": "python",
        "header": "flag.py",
        "code": "color(\"teal\", \"yellow\")\npensize(3)\n\nbegin_fill()\nfor i in range(3):\n    forward(90)\n    right(120)\nend_fill()\n"
      }
    },
    {
      "params": {
        "language": "python",
        "header": "square.py",
        "code": "# Write a program that draws a square\n# with sides of 80 steps, using a loop.\n",
        "markFigure": {
          "shape": "regular-polygon",
          "sides": 4,
          "length": 80,
          "require": [
            "uses-repeat"
          ]
        }
      }
    },
    {
      "params": {
        "header": "hexagon.logo",
        "code": "; a regular hexagon\n; exterior angle = 360 / 6 = 60\nREPEAT 6 [\n  FORWARD 70\n  RIGHT 60\n]"
      }
    },
    {
      "params": {
        "header": "square.logo",
        "code": "; Write a program that draws\n; a square with sides 80 steps.\n"
      }
    },
    {
      "params": {
        "header": "predict.logo",
        "editable": false,
        "code": "FORWARD 50\nRIGHT 90\nFORWARD 50\nLEFT 90\nFORWARD 50\nRIGHT 90\nFORWARD 50"
      }
    },
    {
      "params": {
        "header": "star.logo",
        "code": "; 5 turns of 144 = 720 degrees\n; = two full turns\nREPEAT 5 [\n  FORWARD 100\n  RIGHT 144\n]"
      }
    },
    {
      "params": {
        "header": "rosette.logo",
        "code": "REPEAT 8 [\n  REPEAT 4 [\n    FORWARD 45\n    RIGHT 90\n  ]\n  RIGHT 45\n]"
      }
    },
    {
      "params": {
        "header": "pens.logo",
        "code": "SETCOLOUR red\nREPEAT 4 [ FORWARD 60 RIGHT 90 ]\nPENUP\nRIGHT 90\nFORWARD 90\nLEFT 90\nPENDOWN\nSETCOLOUR teal\nREPEAT 4 [ FORWARD 60 RIGHT 90 ]"
      }
    },
    {
      "params": {
        "header": "polygon.logo",
        "code": "TO POLYGON :n :size\n  REPEAT :n [\n    FORWARD :size\n    RIGHT 360 / :n\n  ]\nEND\n\nPOLYGON 5 90"
      }
    },
    {
      "params": {
        "header": "spiral.logo",
        "code": "MAKE \"side 4\nREPEAT 40 [\n  FORWARD :side\n  RIGHT 90\n  MAKE \"side :side + 4\n]"
      }
    },
    {
      "params": {
        "header": "square.logo",
        "code": "; Write a program that draws a square\n; with sides of 80 steps. Use REPEAT.\n",
        "markFigure": {
          "shape": "regular-polygon",
          "sides": 4,
          "length": 80,
          "require": [
            "uses-repeat"
          ]
        }
      }
    },
    {
      "params": {
        "header": "scene.logo",
        "code": "; a filled star and a moon\nSETCOLOUR yellow\nBEGINFILL\nREPEAT 5 [ FORWARD 80 RIGHT 144 ]\nENDFILL\nPENUP\nSETXY 110 70\nPENDOWN\nSETPENSIZE 4\nSETCOLOUR cyan\nCIRCLE 22"
      }
    }
  ]
}
