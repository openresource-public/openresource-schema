{
  "ref": "cs/logic-gates@2",
  "family": "cs",
  "name": "logic-gates",
  "version": 2,
  "title": "Logic gates",
  "responseModes": [
    "fill-derived"
  ],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "inputs": {
        "type": "array",
        "minItems": 1,
        "maxItems": 3,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9]{0,3}$"
            },
            "value": {
              "type": "integer",
              "enum": [
                0,
                1
              ]
            }
          },
          "required": [
            "name"
          ]
        }
      },
      "gates": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "type": {
              "type": "string",
              "enum": [
                "AND",
                "OR",
                "NOT",
                "XOR",
                "NAND",
                "NOR"
              ]
            },
            "in": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "items": {
                "type": "string"
              }
            },
            "label": {
              "type": "string"
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "type",
            "in"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "NOT"
                  }
                }
              },
              "then": {
                "properties": {
                  "in": {
                    "minItems": 1,
                    "maxItems": 1
                  }
                }
              },
              "else": {
                "properties": {
                  "in": {
                    "minItems": 2,
                    "maxItems": 2
                  }
                }
              }
            }
          ]
        }
      },
      "outputs": {
        "type": "array",
        "minItems": 1,
        "maxItems": 2,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9]{0,3}$"
            },
            "from": {
              "type": "string"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "name",
            "from"
          ]
        }
      },
      "table": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "markCurrentRow": {
            "type": "boolean"
          },
          "occlude": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "col": {
                  "type": "string"
                },
                "row": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 8
                }
              },
              "required": [
                "col"
              ]
            }
          },
          "blank": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "col": {
                  "type": "string"
                },
                "row": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 8
                }
              },
              "required": [
                "col"
              ]
            }
          },
          "highlight": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "col": {
                  "type": "string"
                },
                "row": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 8
                }
              },
              "required": [
                "col"
              ]
            }
          }
        }
      },
      "blankCanvas": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "legend": {
            "type": "array",
            "maxItems": 6,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "AND",
                "OR",
                "NOT",
                "XOR",
                "NAND",
                "NOR"
              ]
            }
          }
        }
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "wireValues": {
            "type": "boolean"
          },
          "gateNames": {
            "type": "boolean"
          },
          "expression": {
            "type": "boolean"
          }
        }
      },
      "toggleable": {
        "type": "boolean"
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      }
    },
    "required": [
      "inputs",
      "gates",
      "outputs"
    ]
  },
