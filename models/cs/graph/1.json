        "type": "string",
        "enum": [
          "free",
          "circle",
          "tree",
          "binary"
        ]
      },
      "root": {
        "type": "string"
      },
      "insert": {
        "type": "array",
        "maxItems": 14,
        "items": {
          "type": [
            "string",
            "number"
          ]
        }
      },
      "expression": {
        "type": "string"
      },
      "run": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "algorithm": {
            "type": "string",
            "enum": [
              "dfs",
              "bfs",
              "dijkstra",
              "bst-search",
              "preorder",
              "inorder",
              "postorder"
            ]
          },
          "from": {
            "type": "string"
          },
          "target": {
            "type": [
              "string",
              "number"
            ]
          },
          "neighbourOrder": {
            "type": "string",
            "enum": [
              "label",
              "edges"
            ]
          },
          "granularity": {
            "type": "string",
            "enum": [
              "event",
              "node"
            ]
          }
        },
        "required": [
          "algorithm"
        ]
      },
      "at": {
        "type": "integer",
        "minimum": 0
      },
      "atVisited": {
        "type": "array",
        "maxItems": 14,
        "items": {
          "type": "string"
        }
      },
      "frames": {
        "type": "string",
        "enum": [
          "one",
          "all"
        ]
      },
      "panel": {
        "type": "string",
