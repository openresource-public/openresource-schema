          "auto",
          "none",
          "aux",
          "visited",
          "distance-table"
        ]
      },
      "view": {
        "type": "string",
        "enum": [
          "diagram",
          "matrix",
          "list",
          "array",
          "diagram+matrix",
          "diagram+list",
          "diagram+array"
        ]
      },
      "matrixStyle": {
