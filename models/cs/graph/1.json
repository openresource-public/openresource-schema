        "maxItems": 14,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9]+([ -][A-Za-z0-9]+)*$"
            },
            "label": {
              "type": "string"
            },
            "place": {
              "type": "array",
