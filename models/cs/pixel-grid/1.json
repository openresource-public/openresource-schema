{
  "ref": "cs/pixel-grid@1",
  "family": "cs",
  "name": "pixel-grid",
  "version": 1,
  "title": "Pixel grid",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "pixels": {
        "type": "array",
        "maxItems": 24,
        "items": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{1,24}$"
        }
      },
      "palette": {
        "type": "array",
        "maxItems": 16,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "colour": {
              "type": "string",
              "pattern": "^(?:accent|accent-[2-5]|ink|muted|scaffold|#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\(\\s*[0-9.,%\\s/]+\\)|[a-zA-Z]{3,20})$"
            },
            "label": {
              "type": "string"
            }
          }
        }
      },
      "codeBase": {
        "type": "string",
        "enum": [
          "binary",
          "denary"
        ]
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "codes": {
            "type": "boolean"
          },
          "image": {
            "type": "boolean"
          },
          "key": {
            "type": "boolean"
          },
          "coordinates": {
            "type": "boolean"
          },
          "panelLabels": {
            "type": "boolean"
          }
        }
      },
      "blank": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "codes": {
            "type": "boolean"
          },
          "image": {
            "type": "boolean"
          }
        }
      },
      "reveal": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "codes": {
            "type": "integer",
            "minimum": 0
          },
          "image": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "cells": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "row": {
              "type": "integer",
              "minimum": 1
            },
            "col": {
              "type": "integer",
              "minimum": 1
            },
            "occlude": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            }
          },
          "required": [
            "row",
            "col"
          ]
        }
      },
      "readouts": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "resolution": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "occlude": {
                "type": "boolean"
              },
              "highlight": {
                "type": "boolean"
              }
            }
          },
          "depth": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "occlude": {
                "type": "boolean"
              },
              "highlight": {
                "type": "boolean"
              }
            }
          },
          "fileSize": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "metadataBits": {
                "type": "integer",
                "minimum": 0
              },
              "unit": {
                "type": "string",
                "enum": [
                  "bits",
                  "bytes",
                  "both"
                ]
              },
              "occlude": {
                "type": "boolean"
              },
              "highlight": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "header": {
        "type": "string"
      }
    },
    "required": [
      "pixels",
      "palette"
    ]
  },
  "examples": [
    {
      "params": {
        "header": "One bit per pixel",
        "pixels": [
          "0110110",
          "1111111",
          "1111111",
          "1111111",
          "0111110",
          "0011100",
          "0001000"
        ],
