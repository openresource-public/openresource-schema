{
  "ref": "cs/binary-converter@1",
  "family": "cs",
  "name": "binary-converter",
  "version": 1,
  "title": "Binary converter",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "width": {
        "type": "integer",
        "enum": [
          4,
          8,
          16
        ]
      },
      "value": {
        "type": "integer",
        "minimum": 0
      },
      "bits": {
        "type": "string",
        "pattern": "^[01?]+$"
      },
      "occludeBits": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0
        }
      },
      "highlightBits": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0
        }
      },
      "total": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "occlude": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          }
        }
      },
      "hex": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "occlude": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          }
        }
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "placeValues": {
            "type": "boolean"
          },
          "binaryString": {
            "type": "boolean"
          },
          "hex": {
            "type": "boolean"
          },
          "nibbleSplit": {
            "type": "boolean"
          },
          "msbLsb": {
            "type": "boolean"
          }
        }
      },
      "interactive": {
        "type": "boolean"
      },
      "header": {
        "type": "string"
      }
    }
  },
  "examples": [
    {
      "params": {
        "header": "172 in binary and hex",
        "width": 8,
        "value": 172,
        "show": {
          "hex": true,
          "nibbleSplit": true,
          "msbLsb": true
        }
      }
    },
    {
      "params": {
        "header": "Set the bits to make 42",
        "width": 8,
        "value": 0,
        "total": {
          "occlude": true
        }
      }
    },
    {
      "params": {
        "width": 8,
        "bits": "01101001",
        "total": {
          "occlude": true
        }
      }
    },
    {
      "params": {
        "width": 8,
        "value": 255,
        "show": {
          "hex": true,
          "nibbleSplit": true,
          "msbLsb": true
        },
        "hex": {
          "highlight": true
        }
      }
    },
    {
      "params": {
        "header": "Place values",
        "width": 8,
        "value": 0,
        "highlightBits": [
          5
        ],
        "total": {
          "occlude": true
        }
      }
    },
    {
      "params": {
        "header": "Convert to hexadecimal",
        "width": 16,
        "value": 2748,
        "show": {
          "hex": true,
          "nibbleSplit": true
        },
        "hex": {
          "occlude": true
        }
      }
    }
  ]
}
