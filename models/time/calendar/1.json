{
  "ref": "time/calendar@1",
  "family": "time",
  "name": "calendar",
  "version": 1,
  "title": "Calendar",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "month": {
        "type": [
          "string",
          "integer"
        ]
      },
      "year": {
        "type": "integer"
      },
      "days": {
        "type": "integer",
        "minimum": 28,
        "maximum": 31
      },
      "startDay": {
        "type": [
          "string",
          "integer"
        ]
      },
      "weekStart": {
        "type": "string",
        "enum": [
          "monday",
          "sunday"
        ]
      },
      "marks": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "day": {
              "type": "integer",
              "minimum": 1,
              "maximum": 31
            },
            "label": {
              "type": "string"
            },
            "highlight": {
              "type": "boolean"
            },
            "occlude": {
              "type": "boolean"
            }
          },
          "required": [
            "day"
          ]
        }
      },
      "relation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31
          },
          "op": {
            "type": "string",
            "enum": [
              "nextDay",
              "prevDay",
              "nextWeek",
              "prevWeek"
            ]
          },
          "by": {
            "type": "integer"
          },
          "occlude": {
            "type": "boolean"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "from"
        ]
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "weekdayHeader": {
            "type": "boolean"
          }
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      },
      "stem": {
        "type": "string"
      }
    }
  },
  "examples": [
    {
      "params": {
        "month": "June",
        "year": 2024,
        "marks": [
          {
            "day": 14,
            "label": "Sports",
            "highlight": true
          }
        ],
        "header": "June 2024",
        "stem": "Sports day is on Friday 14th June."
      }
    },
    {
      "params": {
        "month": "September",
        "year": 2025
      }
    },
    {
      "params": {
        "month": "October",
        "year": 2024,
        "marks": [
          {
            "day": 31,
            "label": "Party",
            "occlude": true,
            "highlight": true
          }
        ]
      }
    },
    {
      "params": {
        "month": "June",
        "year": 2024,
        "relation": {
          "from": 10,
          "op": "nextWeek"
        },
        "stem": "A week after Monday the 10th is Monday the 17th."
      }
    },
    {
      "params": {
        "month": "February",
        "year": 2024,
        "relation": {
          "from": 29,
          "op": "nextWeek",
          "occlude": true
        },
        "stem": "One week after the 29th of February is ? (it is in March)."
      }
    },
    {
      "params": {
        "days": 30,
        "startDay": "Wednesday",
        "header": "A 30-day month",
        "caption": "This month has 30 days and starts on a Wednesday."
      }
    }
  ]
}
