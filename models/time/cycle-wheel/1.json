{
  "ref": "time/cycle-wheel@1",
  "family": "time",
  "name": "cycle-wheel",
  "version": 1,
  "title": "Cycle wheel",
  "responseModes": [],
  "interface": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "cycle": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "preset": {
            "type": "string",
            "enum": [
              "months",
              "days",
              "seasons"
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "short": {
            "type": "boolean"
          },
          "periodName": {
            "type": "string"
          }
        }
      },
      "pointer": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "at": {
            "type": [
              "string",
              "integer"
            ]
          },
          "show": {
            "type": "boolean"
          },
          "occlude": {
            "type": "boolean"
          }
        }
      },
      "jump": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": [
              "string",
              "integer"
            ]
          },
          "by": {
            "type": "integer"
          },
          "to": {
            "type": [
              "string",
              "integer"
            ]
          },
          "occlude": {
            "type": "string",
            "enum": [
              "target",
              "count"
            ]
          },
          "label": {
            "type": "string"
          }
        }
      },
      "highlight": {
        "type": "array",
        "items": {
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "draggable": {
        "type": "boolean"
      },
      "show": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "neighbours": {
            "type": "boolean"
          }
        }
      },
      "header": {
        "type": "string"
      },
      "caption": {
        "type": "string"
      },
      "stem": {
        "type": "string"
      }
    }
  },
  "examples": [
    {
      "params": {
        "cycle": {
          "preset": "months"
        },
        "pointer": {
          "at": "April"
        },
        "show": {
          "neighbours": true
        },
        "header": "The months of the year",
        "stem": "This month is April. Last month was March and next month is May."
      }
    },
    {
      "params": {
        "cycle": {
          "preset": "days"
        },
        "pointer": {
          "show": false
        },
        "caption": "Start at Monday and name the days of the week in order."
      }
    },
    {
      "params": {
        "cycle": {
          "preset": "seasons"
        },
        "pointer": {
          "at": "Autumn"
        },
        "jump": {
          "by": 1,
          "occlude": "target"
        },
        "stem": "The season after Autumn is ?"
      }
    },
    {
      "params": {
        "cycle": {
          "preset": "months"
        },
        "pointer": {
          "at": "November"
        },
        "jump": {
          "from": "November",
          "by": 3
        },
        "stem": "3 months after November is February."
      }
    },
    {
      "params": {
        "cycle": {
          "preset": "months"
        },
        "pointer": {
          "at": "April"
        },
        "jump": {
          "from": "April",
          "to": "April"
        },
        "header": "A whole year"
      }
    },
    {
      "params": {
        "cycle": {
          "items": [
            "Day 1",
            "Day 2",
            "Day 3",
            "Day 4",
            "Day 5",
            "Day 6"
          ],
          "periodName": "timetable cycle"
        },
        "pointer": {
          "at": "Day 4"
        },
        "jump": {
          "from": "Day 4",
          "by": 1
        },
        "caption": "A class follows a six-day timetable. After Day 6 it starts again at Day 1."
      }
    }
  ]
}
